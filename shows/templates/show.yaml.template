# Generated by scripts/scaffold_show.py — review before first production run.
name: "{show_name}"
slug: {slug}
description: "{description}"

weekly_recap_on_sunday: {weekly_recap}

sources:
{sources_block}

web_search_queries:
{web_search_block}

keywords:
{keywords_block}

min_articles: {min_articles}
min_articles_skip: {min_articles_skip}

llm:
  provider: xai
  system_prompt_file: shows/prompts/{slug}_system.txt
  digest_prompt_file: shows/prompts/{slug}_digest.txt
  podcast_prompt_file: shows/prompts/{slug}_podcast.txt
  digest_temperature: {digest_temperature}
  podcast_temperature: {podcast_temperature}
  max_tokens: {max_tokens}
  podcast_max_tokens: {podcast_max_tokens}
  min_podcast_words: {min_podcast_words}

tts: {{}}

audio:
  music_file: {music_file}
  transition_sting: assets/music/transition_sting.mp3

publishing:
  rss_file: {rss_file}
  rss_title: "{show_name}"
  rss_description: "{rss_description}"
  rss_link: https://nerranetwork.com/{show_page}
  rss_author: Patrick
  rss_email: patrick@planetterrian.com
  rss_image: https://nerranetwork.com/assets/covers/{cover_file}
  rss_category: {rss_category}
  rss_keywords: "{rss_keywords}"
  guid_prefix: {guid_prefix}
  base_url: https://nerranetwork.com
  audio_subdir: digests/{slug}
  summaries_json: digests/{slug}/summaries_{slug}.json
  summaries_podcast_name: {slug}
  player_html: {show_page}
  summaries_html: {summaries_page}
  x_enabled: {x_enabled}
  x_env_prefix: "{x_env_prefix}"

episode:
  prefix: {episode_prefix}
  filename_pattern: "{{prefix}}_Ep{{num:03d}}_{{date:%Y%m%d}}.mp3"
  output_dir: digests/{slug}
  mp3_glob: "{episode_prefix}_Ep*.mp3"

chapters:
  enabled: true
  section_markers:
    - pattern: "welcome to {show_name_spoken}"
      title: "Welcome"
    - pattern: "top story|big story|headline"
      title: "Top Story"
    - pattern: "quick hits|quick bits|before we go"
      title: "Quick Hits"
    - pattern: "that's it for today|see you tomorrow"
      title: "Closing"

newsletter:
  enabled: true
  platform: buttondown
  api_key_env: BUTTONDOWN_API_KEY
  status: about_to_send
  tag: "{show_name}"
  short_label: "{short_label}"
  emoji: "{emoji}"
  newsletter_start_date: "{newsletter_start_date}"
  requires_financial_disclaimer: false
  length_target_words: {length_target_words}

slow_news:
  enabled: true

content_tracking:
  section_patterns: {{}}

youtube:
  enabled: false
  channel: en
  category_id: {youtube_category_id}
  privacy_status: public
  image_queries:
{image_queries_block}
  image_query_prefix: ""
  image_provider: pexels
