# Environment variables
.env
.env.local

# Newsletter same-day double-send guardrail (per-show timestamp file).
# Runtime state — never commit. See engine/newsletter.py:_record_send.
digests/*/_newsletter_lastsend.txt
digests/*/.published_*.json
# Remembered "this account cannot send yet" state. Same convention as the
# guardrail above: runtime state, never committed. See
# engine/newsletter.py:sending_block_reason.
digests/_newsletter_sending_blocked.json

# OAuth client secrets (Google Cloud Console download)
client_secret*.json
client_secrets.json
youtube_token*.json
youtube_refresh_token*.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log

# Episode audio files (hosted on Cloudflare R2, not tracked in git)
digests/**/*.mp3
digests/*.mp3

# Episode video clips + raw WAV are episode media too (landmine #1: media
# at HEAD bloats every clone). The final YouTube MP4s upload directly and
# never need git; per-clip video (e.g. digests/spacex/videos_epNNN/*.mp4)
# and intermediate WAVs are regenerated and must stay untracked.
digests/**/*.mp4
digests/*.mp4
digests/**/*.wav
digests/*.wav

# Keep music stings tracked
!assets/music/*.mp3

# Content Lake (regenerated via backfill)
data/content_lake.db

# YouTube pipeline intermediate render outputs. Operator caught
# (Tesla Ep469, May 11 2026) GitHub rejecting a push because a
# 115.98 MB slideshow MP4 in youtube_tmp/ exceeded GitHub's 100 MB
# per-file limit. PR #346 stretched slideshow scene_duration to
# span the full audio, which pushed long-episode slideshow MP4s
# past the cap. These files are regeneratable intermediates — the
# final long-form / Shorts MP4s are uploaded to YouTube directly
# and never need git for distribution.
digests/*/youtube_tmp/*_slides.mp4
digests/*/youtube_tmp/*_short_slides.mp4
digests/*/youtube_tmp/*_short_short_slides.mp4
# Grok Imagine source scene JPEGs — also intermediate, only used to
# render the slideshow MP4.
digests/*/youtube_tmp/scenes_*/
# The composited long-form / Shorts MP4s and the final thumbnail
# are regenerated every run too and can grow large.
digests/*/youtube_tmp/*.mp4
digests/*/youtube_tmp/*_thumb.jpg
digests/*/youtube_tmp/*_thumb_v*.jpg
# PNG intermediates (thumbnails, end cards, hook overlays) — same
# regeneratable class as the JPGs/MP4s above. 221 of them (~78 MB,
# growing ~140 MB/month) were silently tracked because only mp4/jpg/
# srt/ass had rules here while run-show.yml does `git add -A digests/`
# (landmine #1 regression, untracked June 2026).
digests/*/youtube_tmp/*.png
# SRT / ASS subtitles for the slideshow burn-in are derivable from
# the committed transcript files.
digests/*/youtube_tmp/*.srt
digests/*/youtube_tmp/*.ass

# Keep data/ and outputs/ directories tracked
!data/.gitkeep
!outputs/.gitkeep

# Book build products (EPUB/M4B/track MP3s) — R2 is the durable store
# (books/<volume_id>/ keyspace); committing them is the landmine-#1
# repo-size shape. The committed record is books/catalog.json.
outputs/books/


# Node artifacts anywhere, including the repo root. Running `npx` from
# the root (rather than from workers/gallery) creates a root-level
# node_modules/ holding tool caches — which was untracked and therefore
# a candidate to be committed. This repo's largest problem is git
# history size (landmine #1); 200 MB of dependencies is the last thing
# it needs.
node_modules/
.vite/

# Cloudflare Worker (workers/gallery) build + local-dev artifacts.
workers/**/node_modules/
workers/**/.wrangler/
workers/**/.dev.vars
workers/**/dist/

# SnapTrade live-account mirror — the repo is public; balances/positions
# must never be committed (execution/ Phase 1; CI uploads an artifact).
digests/modern_investing/live_account_mirror.json
# Full live-execution audit trail — real account activity never committed
# (public repo); the id-only index in live_execution_state.json IS committed.
digests/modern_investing/live_ledger.json

# Patch files handed over for review live in the repo root while they are
# being applied. A `git add -A` sweeps them into the commit if they are
# not ignored — which happened on 27 July 2026 and made a docs-only
# patch fail to apply, because it tried to create a patch file that was
# already sitting in the working directory.
*.patch

# Local scratch/working directories — never part of a commit.
_claude_upload/
_to_delete/
broll_cuts/
nasa_broll/

# Sep 4 2026 flagship pass — three more regenerable youtube_tmp classes
# that the `git add -A digests/` commit step was tracking (656 files /
# 54 MB at HEAD, ~1.6 MB per 4 days): the square episode-art JPEG is
# uploaded to R2 by engine/episode_art.py, the .social.json sidecar is
# consumed in the same run by engine/social_publisher.py, and the
# ffmetadata chapter file is an ffmpeg input derived from chapters_ep*.json.
digests/*/youtube_tmp/*_square.jpg
digests/*/youtube_tmp/*.social.json
digests/*/youtube_tmp/*.chapters.ffmeta
