    if (!st.label) { return s.date ? '<span class="me-older">' + esc(s.date) + '</span>' : ''; }
    var today = st.day === easternDay();
    var rel = today && st.has_time ? ago(st.iso) : '';
    return (today ? '<span class="lt-today">Today</span> ' : '')
      + '<time datetime="' + esc(st.iso) + '" title="' + esc(st.label) + '">' + esc(rel || (today ? st.label.replace(/^[A-Z][a-z]{2} \d+, /, '') : st.short || st.label)) + '</time>';
  }
  function playBtn(s, round) {
    if (!safeUrl(s.audio_url)) { return ''; }
    var played = isPlayed(s.audio_url);
    return '<button type="button" class="me-play' + (round ? ' is-round' : '') + '" data-play="' + esc(s.slug) + '|' + esc(s.episode_num) + '"'
      + ' aria-label="Play ' + esc(showName(s.slug)) + ' episode ' + esc(s.episode_num) + '"><span class="ic"></span>'
      + (round ? '' : (s.duration_s ? '<span class="me-len">' + mins(s.duration_s) + ' min</span>' : 'Play')) + '</button>'
