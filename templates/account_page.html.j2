{% extends "base.html.j2" %}

{# /account.html — "My Nerra", the member home (Aug 30 2026 redesign).

   v1 was a bare settings console; the operator asked for a real
   logged-in landing page — dashboards, data, customization, and a
   surface that keeps selling the subscription. Still a static page:
   identity + preferences come from api.nerranetwork.com (cookie),
   content comes from the committed same-origin JSON the pipeline
   already refreshes (api/episodes.json, api/tsla.json, api/spcx.json).

   Drift-guarded ids (tests/test_nerra_personal.py) — keep them:
   nn-feed-cancelled, nn-starter-note, nn-city-nudge, nn-tier-badge. #}

{% block head_extra %}
    {# A member console, not content: kept out of the sitemap on purpose,
       and noindexed so a signed-out shell never becomes a search result. #}
    <meta name="robots" content="noindex,follow">
    <style>
        .nn-account { max-width: 1080px; margin: 0 auto; padding: calc(var(--nav-height) + var(--sp-8)) var(--sp-6) var(--sp-12); }
        .nn-account h1 { font-family: var(--font-heading); margin: 0; font-size: clamp(1.6rem, 4vw, 2.3rem); }
        .nn-card { border: 1px solid var(--nn-border); border-radius: 16px; background: var(--nn-surface); padding: var(--sp-5); margin-bottom: var(--sp-5); }
        .nn-card h2 { margin: 0 0 var(--sp-3); font-size: 1.05rem; font-family: var(--font-heading); }
        .nn-account input[type=email], .nn-account input[type=text] { width: 100%; padding: 0.7rem 0.9rem; border-radius: 10px; border: 1px solid var(--nn-border); background: var(--nn-bg, transparent); color: inherit; }
        .nn-account button { padding: 0.65rem 1.4rem; border-radius: 10px; border: none; background: var(--nn-gradient); color: #fff; font-weight: 600; cursor: pointer; }
        .nn-account button.ghost { background: transparent; border: 1px solid var(--nn-border); color: inherit; }

        /* Dashboard hero */
        .nn-dash-hero { border: 1px solid var(--nn-border); border-radius: 20px; background: var(--nn-surface); padding: var(--sp-6); margin-bottom: var(--sp-6); position: relative; overflow: hidden; }
        .nn-dash-hero::before { content: ""; position: absolute; inset: 0; background:
            radial-gradient(ellipse at 90% 0%, rgba(0,212,255,0.14), transparent 55%),
            radial-gradient(ellipse at 0% 100%, rgba(107,71,255,0.10), transparent 50%); pointer-events: none; }
        .nn-dash-hero > * { position: relative; }
        .nn-dash-date { font-family: var(--font-ui); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--nn-text-muted); margin-bottom: 0.35rem; }
        .nn-tier-pill { display: inline-block; font-family: var(--font-ui); font-size: 0.75rem; padding: 0.25rem 0.7rem; border-radius: 999px; border: 1px solid var(--nn-border); color: var(--nn-text-muted); margin-left: 0.6rem; vertical-align: middle; }
        .nn-tier-pill.active { border-color: rgba(0,212,255,0.5); color: #00D4FF; }
        .nn-hero-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: var(--sp-4); }
        .nn-hero-actions a { text-decoration: none; }

        /* Two-column dashboard */
        .nn-dash-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, 1fr); gap: var(--sp-5); align-items: start; }
        @media (max-width: 860px) { .nn-dash-grid { grid-template-columns: 1fr; } }

        /* Today rail */
        .nn-today-stats { display: flex; gap: var(--sp-5); margin: 0 0 var(--sp-4); }
        .nn-today-stats .tile strong { display: block; font-family: var(--font-heading); font-size: 1.5rem; line-height: 1.1; }
        .nn-today-stats .tile span { font-family: var(--font-ui); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--nn-text-muted); }
        .nn-ep-card { display: grid; grid-template-columns: 52px minmax(0,1fr); gap: 0.8rem; padding: 0.8rem 0.2rem; border-bottom: 1px dashed var(--nn-border); }
        .nn-ep-card:last-child { border-bottom: none; }
        .nn-ep-card img { width: 52px; height: 52px; border-radius: 10px; }
        .nn-ep-show { font-family: var(--font-ui); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; }
        .nn-ep-title { font-size: 0.95rem; line-height: 1.35; margin: 0.15rem 0 0.3rem; }
        .nn-ep-meta { font-size: 0.78rem; color: var(--nn-text-muted); }
        .nn-ep-card audio { width: 100%; height: 32px; border-radius: 8px; margin-top: 0.4rem; }
        .nn-ep-more { margin-top: var(--sp-3); font-size: 0.85rem; }

        /* Market tiles — single-value stat tiles; delta wears a status
           color WITH an arrow glyph (never color alone). */
        .nn-mkt { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
        .nn-mkt .tile { border: 1px solid var(--nn-border); border-radius: 12px; padding: 0.75rem 0.9rem; }
        .nn-mkt .sym { font-family: var(--font-ui); font-size: 0.72rem; letter-spacing: 0.1em; color: var(--nn-text-muted); }
        .nn-mkt .px { font-family: var(--font-heading); font-size: 1.35rem; line-height: 1.2; }
        .nn-mkt .chg { font-size: 0.8rem; }
        .nn-mkt .chg.up { color: #2fbf71; }
        .nn-mkt .chg.down { color: #e5484d; }

        /* Lineup editor */
        .nn-lineup-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.45rem 0.2rem; border-bottom: 1px dashed var(--nn-border); }
        .nn-lineup-row img { width: 34px; height: 34px; border-radius: 8px; }
        .nn-lineup-row .movers { margin-left: auto; display: flex; gap: 0.25rem; }
        .nn-lineup-row .movers button { padding: 0.15rem 0.55rem; font-size: 0.9rem; }
        .nn-lineup-row.off { opacity: 0.55; }

        .nn-feedurl { font-family: var(--font-mono, monospace); font-size: 0.78rem; word-break: break-all; background: var(--nn-bg, rgba(0,0,0,0.15)); padding: 0.6rem 0.8rem; border-radius: 8px; }

        /* Add-on toggle cards */
        .nn-addon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(215px, 1fr)); gap: 0.6rem; margin-top: var(--sp-3); }
        .nn-addon { display: grid; grid-template-columns: auto 1fr; gap: 0.55rem; align-items: start; border: 1px solid var(--nn-border); border-radius: 12px; padding: 0.65rem 0.75rem; cursor: pointer; user-select: none; }
        .nn-addon.on { border-color: rgba(0,212,255,0.55); background: color-mix(in srgb, #00D4FF 7%, transparent); }
        .nn-addon.locked { opacity: 0.55; cursor: default; }
        .nn-addon .em { font-size: 1.2rem; line-height: 1.2; }
        .nn-addon .name { font-weight: 600; font-size: 0.9rem; }
        .nn-addon .desc { font-size: 0.76rem; color: var(--nn-text-muted); margin-top: 0.15rem; }
        .nn-list { display: grid; gap: 0.4rem; max-width: 420px; }
        .nn-list input[disabled] { opacity: 0.45; }
        .nn-pnn-card { border-color: rgba(0,212,255,0.45); }
        .nn-pnn-card ul { margin: 0.4rem 0 0.8rem 1.1rem; padding: 0; font-size: 0.9rem; }
        .nn-whoami { font-size: 0.82rem; color: var(--nn-text-muted); margin-top: 0.6rem; }
        .nn-whoami button { background: none; border: none; color: var(--nn-text-muted); text-decoration: underline; padding: 0; margin-left: 0.4rem; font: inherit; cursor: pointer; }
        .nn-tomorrow { border: 1px dashed var(--nn-border); border-radius: 12px; padding: 0.7rem 0.85rem; margin-top: 0.8rem; font-size: 0.88rem; }
        .nn-tomorrow strong { display: block; font-family: var(--font-heading); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--nn-text-muted); margin-bottom: 0.3rem; }
        .nn-tomorrow li { margin: 0.15rem 0; }
        .nn-tomorrow ul { margin: 0; padding-left: 1.1rem; }
        .nn-savebar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: var(--nn-surface); border-top: 1px solid var(--nn-border); box-shadow: 0 -6px 24px rgba(0,0,0,0.35); padding: 0.7rem var(--sp-6); display: flex; gap: 0.8rem; align-items: center; justify-content: center; flex-wrap: wrap; }
        .nn-savebar .msg { font-size: 0.9rem; }
        .nn-road li.done { opacity: 0.6; }
        .nn-lib { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.8rem; margin-top: var(--sp-3); }
        .nn-book { border: 1px solid var(--nn-border); border-radius: 12px; overflow: hidden; background: var(--nn-bg, transparent); display: flex; flex-direction: column; }
        .nn-book img { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; display: block; background: #0d151a; }
        .nn-book .b { padding: 0.55rem 0.6rem 0.65rem; display: flex; flex-direction: column; gap: 0.25rem; flex: 1; }
        .nn-book .t { font-weight: 600; font-size: 0.82rem; line-height: 1.25; }
        .nn-book .s { font-size: 0.72rem; color: var(--nn-text-muted); line-height: 1.3; }
        .nn-book .a { margin-top: auto; padding-top: 0.35rem; font-size: 0.78rem; }
        .nn-book .a a { text-decoration: none; }
        .nn-book .a button { padding: 0.35rem 0.7rem; font-size: 0.78rem; width: 100%; }
        .nn-book .price { color: var(--nn-text-muted); }
        .nn-road li.done strong::after { content: " ✓ shipped"; color: #00D4FF; font-weight: 500; font-size: 0.8rem; }
        .nn-addon .lock { font-size: 0.7rem; color: var(--nn-text-muted); border: 1px solid var(--nn-border); border-radius: 999px; padding: 0.05rem 0.45rem; margin-left: 0.35rem; }

        /* Recent editions list */
        .nn-edition { padding: 0.55rem 0; border-bottom: 1px dashed var(--nn-border); }
        .nn-edition:last-child { border-bottom: none; }
        .nn-edition .t { font-size: 0.85rem; line-height: 1.3; }
        .nn-edition .d { font-size: 0.74rem; color: var(--nn-text-muted); }
        .nn-edition audio { width: 100%; height: 30px; border-radius: 8px; margin-top: 0.3rem; }
        .nn-perk { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px dashed var(--nn-border); }
        .nn-perk:last-child { border-bottom: none; }
        .nn-road li { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem; padding: 0.35rem 0; color: var(--nn-text-muted); font-size: 0.9rem; }
        .nn-road { list-style: none; margin: 0; padding: 0; }
        .nn-muted { color: var(--nn-text-muted); font-size: 0.9rem; }
        #nn-status { min-height: 1.2rem; font-size: 0.9rem; }
        [hidden] { display: none !important; }
    </style>
{% endblock %}

{% block content %}
<div class="nn-account">
    <p id="nn-status" class="nn-muted">Loading your Nerra…</p>

    <!-- Signed-out: magic-link request + pitch -->
    <div id="nn-guest" hidden>
        <div class="nn-dash-hero">
            <div class="nn-dash-date">Nerra Personal</div>
            <h1>Sign in to your Nerra</h1>
            <p class="nn-muted" style="max-width:560px;">Your member home: today's
               episodes from your shows, your private feed, your lineup and
               perks — all behind one email, no passwords.</p>
        </div>
        <div class="nn-dash-grid">
            <div class="nn-card" id="nn-signin">
                <h2>Sign in</h2>
                <p class="nn-muted">Enter the email you joined with and we'll
                   send you a sign-in link.</p>
                <form onsubmit="NN.login(this);return false;" style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                    <input type="email" name="email" placeholder="you@example.com" required style="flex:1;min-width:220px;">
                    <button type="submit">Email me a link</button>
                </form>
                <p class="nn-muted" style="margin-top:0.75rem;">New here?
                    <a href="{{ path_prefix }}join.html">Create your free account →</a>
                    · <a href="{{ path_prefix }}login.html">Full sign-in page →</a></p>
            </div>
            <div class="nn-card">
                <h2>What members get</h2>
                <ul class="nn-road">
                    <li><span>🎙️</span><span>A private daily show built from your lineup, anchored by Mira</span></li>
                    <li><span>📬</span><span>The network newsletter, per-show topics</span></li>
                    <li><span>🖼️</span><span>Full-resolution gallery downloads</span></li>
                    <li><span>📚</span><span>Member discounts on the book series</span></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="nn-savebar" id="nn-savebar" hidden>
        <span class="msg">You have unsaved changes — they reach tomorrow morning's edition once saved.</span>
        <button onclick="NN.save()">Save preferences</button>
        <button class="ghost" onclick="NN.load()">Discard</button>
    </div>

    <div id="nn-member" hidden>
        <!-- Dashboard hero -->
        <div class="nn-dash-hero">
            <div class="nn-dash-date" id="nn-date"></div>
            <h1><span id="nn-greeting">Welcome back</span><span id="nn-tier-badge" class="nn-tier-pill" hidden></span></h1>
            <p class="nn-muted" id="nn-hero-sub" style="margin:0.5rem 0 0;max-width:620px;"></p>
            <div class="nn-hero-actions">
                <a class="nn-btn nn-btn-primary" href="{{ path_prefix }}player.html">Open the player</a>
                <a class="nn-btn" href="{{ path_prefix }}gallery.html">Browse the gallery</a>
                <a class="nn-btn" href="{{ path_prefix }}blog/index.html">Read the blog</a>
            </div>
            <p class="nn-whoami">Signed in as <span id="nn-email"></span><button type="button" onclick="NN.logout()">Sign out</button></p>
        </div>

        <div class="nn-dash-grid">
            <div><!-- main column -->

                <!-- Today from your shows -->
                <div class="nn-card">
                    <h2>Today from your shows</h2>
                    <div class="nn-today-stats" id="nn-today-stats" hidden>
                        <div class="tile"><strong id="nn-stat-count">–</strong><span>new episodes</span></div>
                        <div class="tile"><strong id="nn-stat-mins">–</strong><span>minutes of listening</span></div>
                        <div class="tile"><strong id="nn-stat-shows">–</strong><span>shows in your lineup</span></div>
                    </div>
                    <div id="nn-today"><p class="nn-muted">Loading episodes…</p></div>
                    <p class="nn-ep-more"><a href="{{ path_prefix }}index.html#latest">See everything published across the network →</a></p>
                </div>

                <!-- Lineup + preferences -->
                <div class="nn-card">
                    <h2>Your lineup</h2>
                    <p class="nn-muted">Choose at least two shows; order them the way
                       you want your morning to run. Mira handles the rest — and this
                       page's "Today" rail follows the same picks.</p>
                    <div id="nn-lineup"></div>
                    <div style="margin-top:var(--sp-4);">
                        <label>First name <span class="nn-muted">(Mira greets you by it)</span>
                            <input type="text" id="nn-name" maxlength="40" placeholder="Optional" style="max-width:320px;"></label>
                    </div>
                </div>

                <!-- Add-ons: customize the edition itself (Aug 30 2026) -->
                <div class="nn-card">
                    <h2>Your add-ons</h2>
                    <p class="nn-muted">Tell Mira what to research for
                       <em>your</em> edition — she reads it in her own words,
                       names her sources aloud, and skips anything she can't
                       verify rather than padding.</p>
                    <div style="margin:var(--sp-3) 0;">
                        <label>Locations <span class="nn-muted" id="nn-cities-help">(any city or town — the add-ons below follow it)</span></label>
                        {# Up to three inputs; the page enables as many as the
                           tier allows (1 on Personal, 3 on PNN). Extra ones a
                           member typed before a downgrade are kept, greyed,
                           and applied again on upgrade — the Worker stores
                           three whatever the plan; the builder enforces. #}
                        <div class="nn-list" id="nn-cities">
                            <input type="text" id="nn-city" class="nn-city" maxlength="80" placeholder="e.g. Vancouver, BC">
                            <input type="text" class="nn-city" maxlength="80" placeholder="Second location (Personal News Network)">
                            <input type="text" class="nn-city" maxlength="80" placeholder="Third location (Personal News Network)">
                        </div>
                    </div>
                    <p class="nn-muted" id="nn-city-nudge" hidden style="margin-top:0.5rem;">
                       You haven't set a location yet — add one above and save so
                       Mira can open your edition with your morning brief.</p>
                    <div id="nn-addons" class="nn-addon-grid"></div>
                    <div style="margin:var(--sp-4) 0 0;">
                        <label>Your topics <span class="nn-muted" id="nn-topics-help">(subjects you follow — Mira researches each one daily, sources named)</span></label>
                        <div class="nn-list" id="nn-topics">
                            <input type="text" class="nn-topic" maxlength="60" placeholder="e.g. Starship">
                            <input type="text" class="nn-topic" maxlength="60" placeholder="e.g. BC housing policy">
                            <input type="text" class="nn-topic" maxlength="60" placeholder="e.g. open-source AI models">
                            <input type="text" class="nn-topic" maxlength="60" placeholder="Fourth topic">
                            <input type="text" class="nn-topic" maxlength="60" placeholder="Fifth topic">
                        </div>
                    </div>
                    <p class="nn-muted" id="nn-addon-upsell" hidden style="margin-top:0.6rem;">
                       On Personal your brief is the <strong>taster</strong>: one city, one
                       item per section. <strong>Personal News Network</strong> ($8.99/mo)
                       goes to three items per section, three locations, and your
                       five topics —
                       {# Two different doors on purpose (Sep 13 2026). An
                          existing subscriber switches plans inside Stripe's
                          portal (prorated, same subscription). The old link
                          here opened a FRESH checkout, which would have
                          created a second subscription. A free account has
                          nothing to switch, so it goes to checkout. #}
                       <a href="#" id="nn-switch-portal" hidden onclick="NN.portal();return false;">switch plans →</a>{% if stripe_personal_local_url and stripe_personal_local_url != '#' %}<a href="{{ stripe_personal_local_url }}" id="nn-switch-checkout" data-checkout hidden>start Personal News Network →</a>{% endif %}.
                       The markets minute is included on every paid tier.</p>
                    <p style="margin-top:var(--sp-4);"><button onclick="NN.save()">Save preferences</button>
                       <span id="nn-save-status" class="nn-muted"></span></p>
                    <p class="nn-muted" style="margin:0.5rem 0 0;">Changes reach
                       tomorrow morning's edition.</p>
                </div>
            </div>

            <div><!-- side column -->

                <!-- Personal feed -->
                <div class="nn-card">
                    <h2>Your personal daily show</h2>
                    <div id="nn-feed-active" hidden>
                        <p class="nn-muted" style="margin-top:0;">Mira builds your edition every
                           morning. Add this private feed to any podcast app — it's
                           yours alone; sharing the URL shares your subscription.</p>
                        <p class="nn-feedurl" id="nn-feed-url"></p>
                        <button class="ghost" onclick="NN.copyFeed()">Copy feed URL</button>
                        <button class="ghost" id="nn-portal-btn" hidden onclick="NN.portal()" style="margin-left:0.4rem;">Manage plan &amp; billing</button>
                        <p class="nn-muted" id="nn-ends-note" hidden style="margin-top:0.6rem;"></p>
                        <p class="nn-muted" id="nn-feed-note" style="margin-top:0.6rem;">
                           Just subscribed? Your first edition lands with the next
                           morning build — the feed link works from then on.</p>
                        <div class="nn-tomorrow" id="nn-tomorrow" hidden>
                            <strong>Tomorrow's edition, as configured</strong>
                            <ul id="nn-tomorrow-list"></ul>
                        </div>
                        <p class="nn-muted" id="nn-starter-note" hidden>
                           You haven't picked your shows yet, so Mira is using the
                           <strong>starter lineup</strong> (SpaceX, Tesla, Models &amp;
                           Agents, Planetterrian, DP Pod). Choose 2+ shows and
                           save to make it yours — changes reach tomorrow's edition.</p>
                        <div id="nn-editions" style="margin-top:var(--sp-3);" hidden>
                            <h2 style="margin-bottom:0.4rem;">Listen here</h2>
                            <div id="nn-editions-list"></div>
                        </div>
                    </div>
                    <div id="nn-feed-cancelled" hidden>
                        <p class="nn-muted" style="margin-top:0;">Your subscription has ended and
                           the private feed is off. Your lineup and preferences are
                           saved — restart any time and tomorrow's edition picks up
                           where you left off.</p>
                        {% if stripe_personal_url and stripe_personal_url != '#' %}
                        <p>
                            <a href="{{ stripe_personal_url }}" data-checkout><button>Restart Personal — $4.99/mo</button></a>
                            {% if stripe_personal_local_url and stripe_personal_local_url != '#' %}
                            <a href="{{ stripe_personal_local_url }}" data-checkout><button class="ghost" style="margin-top:0.4rem;">Personal News Network — $8.99/mo</button></a>
                            {% endif %}
                        </p>
                        {% endif %}
                    </div>
                    <div id="nn-feed-upsell" hidden>
                        <p class="nn-muted" style="margin-top:0;">Pick your shows and order, then
                           start your subscription — Mira builds your first private
                           episode within a day.</p>
                        {% if stripe_personal_url and stripe_personal_url != '#' %}
                        <p style="display:grid;gap:0.4rem;">
                            <a href="{{ stripe_personal_url }}" data-checkout><button style="width:100%;">Personal — $4.99/mo</button></a>
                            {% if stripe_personal_local_url and stripe_personal_local_url != '#' %}
                            <a href="{{ stripe_personal_local_url }}" data-checkout><button class="ghost" style="width:100%;">Personal News Network — $8.99/mo</button></a>
                            {% endif %}
                        </p>
                        <p class="nn-muted">Your purchase attaches to this account
                           automatically, whichever card or wallet you pay with.</p>
                        {% else %}
                        <p class="nn-muted">Personal feeds are launching soon — your
                           saved lineup will be ready on day one.</p>
                        {% endif %}
                    </div>
                </div>

                <!-- What Personal News Network adds (shown to Personal members) -->
                <div class="nn-card nn-pnn-card" id="nn-pnn-card" hidden>
                    <h2>Personal News Network</h2>
                    <p class="nn-muted" style="margin-top:0;">Your edition, all the way yours. Upgrade adds:</p>
                    <ul>
                        <li>Up to <strong>three items</strong> per section in your brief, not one</li>
                        <li>Up to <strong>three locations</strong> on the same feed</li>
                        <li><strong>Your topics</strong> — five subjects Mira researches daily</li>
                        <li><strong>Every Nerra book</strong> as an EPUB download, yours to keep</li>
                    </ul>
                    <button class="ghost" id="nn-pnn-switch" hidden onclick="NN.portal()">Switch to Personal News Network — $8.99/mo</button>
                    {% if stripe_personal_local_url and stripe_personal_local_url != '#' %}
                    <a href="{{ stripe_personal_local_url }}" data-checkout id="nn-pnn-checkout" hidden><button class="ghost">Start Personal News Network — $8.99/mo</button></a>
                    {% endif %}
                    <p class="nn-muted" style="margin:0.6rem 0 0;">Prorated; switch back any time.</p>
                </div>

                <!-- Market snapshot (public pipeline data, refreshed daily) -->
                <div class="nn-card" id="nn-mkt-card" hidden>
                    <h2>Market snapshot</h2>
                    <div class="nn-mkt" id="nn-mkt"></div>
                    <p class="nn-muted" style="margin:0.6rem 0 0;" id="nn-mkt-asof"></p>
                </div>

                <!-- Member perks -->
                <div class="nn-card">
                    <h2>Member perks</h2>
                    <div class="nn-perk"><span>Newsletter</span>
                        <span class="nn-muted">On the list — manage topics in any email's footer</span></div>
                    <div class="nn-perk"><span>Gallery downloads</span>
                        <a href="{{ path_prefix }}gallery.html">Browse →</a></div>
                    <div class="nn-perk"><span>Books</span>
                        <span id="nn-book-perk" class="nn-muted">—</span></div>
                    <div class="nn-perk"><span>Support the network</span>
                        <a href="{{ path_prefix }}support.html">Donate →</a></div>
                </div>

                <!-- Your library (Sep 14 2026): every Nerra book, included with PNN -->
                <div class="nn-card" id="nn-library-card">
                    <h2>Your library</h2>
                    <p class="nn-muted" id="nn-library-lede" style="margin-top:0;"></p>
                    <div class="nn-lib">
                    {% for b in library %}
                        <div class="nn-book" data-volume="{{ b.volume_id }}" data-epub="{{ b.epub }}">
                            {% if b.cover %}<img src="{{ b.cover }}" alt="" loading="lazy">{% endif %}
                            <div class="b">
                                <div class="t">{{ b.title }}</div>
                                {% if b.subtitle %}<div class="s">{{ b.subtitle }}</div>{% endif %}
                                <div class="a">
                                    <a class="nn-book-dl" hidden href="https://api.nerranetwork.com/api/books/{{ b.volume_id }}/{{ b.epub }}"><button>Download EPUB</button></a>
                                    <span class="nn-book-locked price">{% if b.price_usd %}${{ '%.2f'|format(b.price_usd|float) }}{% endif %} · included with Personal News Network</span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                    </div>
                    {% if not library %}<p class="nn-muted">The first volumes are on their way.</p>{% endif %}
                    <p class="nn-muted" id="nn-library-foot" style="margin:0.8rem 0 0;"></p>
                </div>

                <!-- Roadmap: the page keeps selling what membership funds -->
                <div class="nn-card">
                    <h2>Built for members next</h2>
                    <ul class="nn-road">
                        <li class="done"><span>📍</span><span><strong>Multiple locations</strong> — up to three cities on Personal News Network</span></li>
                        <li class="done"><span>🧭</span><span><strong>Your topics</strong> — five subjects Mira researches daily</span></li>
                        <li class="done"><span>📚</span><span><strong>Books included</strong> — every Nerra EPUB as a download on Personal News Network</span></li>
                        <li><span>🎧</span><span><strong>Audiobooks included</strong> — the M4B editions in your library too</span></li>
                        <li><span>🌅</span><span><strong>Before your morning</strong> — editions built to land ahead of your local commute</span></li>
                        <li><span>📌</span><span><strong>A real location picker</strong> — confirm the exact place, never the wrong Vancouver</span></li>
                        <li><span>⚽</span><span><strong>Sports scores</strong> — your teams in the markets-minute slot</span></li>
                        <li><span>📊</span><span><strong>Listening stats</strong> — your streaks and hours, right here</span></li>
                        <li><span>🎚️</span><span><strong>Mira, your way</strong> — pace and framing options for your edition</span></li>
                        <li><span>🌍</span><span><strong>More languages</strong> — FR/RU personal editions</span></li>
                    </ul>
                    <p class="nn-muted" style="margin:0.6rem 0 0;">Membership funds the
                       roadmap — new value lands here first.
                       <a href="{{ path_prefix }}join.html">See everything included →</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
var NN = (function () {
  var API = 'https://api.nerranetwork.com';
  var state = { shows: [], all: [], names: {},
                addons: null, addonsTouched: false, tier: 'none', active: false };
  var SHOW_META = {{ personal_shows | tojson }};
  var META = {}; SHOW_META.forEach(function (s) { META[s.slug] = s; });
  var STARTER = ['spacex', 'tesla', 'models_agents', 'planetterrian', 'dp_pod'];
  var ADDONS = {{ personal_addons | tojson }};
  var DEFAULT_ADDONS = {{ default_addons | tojson }};

  function el(id) { return document.getElementById(id); }
  function esc(s) { var d = document.createElement('span'); d.textContent = s || ''; return d.innerHTML; }

  function coverImg(slug, size) {
    var m = META[slug] || {};
    var src = m.cover_webp || m.cover || '';
    return src ? '<img src="' + src + '" alt="" width="' + size + '" height="' + size + '" loading="lazy">' : '';
  }

  function renderLineup() {
    var box = el('nn-lineup');
    box.innerHTML = '';
    var chosen = state.shows.slice();
    var rest = state.all.filter(function (s) { return chosen.indexOf(s) === -1; });
    chosen.concat(rest).forEach(function (slug) {
      var idx = chosen.indexOf(slug);
      var row = document.createElement('div');
      row.className = 'nn-lineup-row' + (idx === -1 ? ' off' : '');
      var cb = document.createElement('input');
      cb.type = 'checkbox'; cb.checked = idx !== -1;
      cb.onchange = function () {
        if (cb.checked) { state.shows.push(slug); }
        else { state.shows = state.shows.filter(function (s) { return s !== slug; }); }
        renderLineup(); renderToday(); checkDirty();
      };
      var img = document.createElement('span');
      img.innerHTML = coverImg(slug, 34);
      var label = document.createElement('span');
      label.textContent = (idx !== -1 ? (idx + 1) + '. ' : '')
        + ((META[slug] && META[slug].name) || slug);
      row.appendChild(cb); row.appendChild(img); row.appendChild(label);
      if (idx !== -1) {
        var movers = document.createElement('span');
        movers.className = 'movers';
        [['↑', -1], ['↓', 1]].forEach(function (m) {
          var b = document.createElement('button');
          b.className = 'ghost'; b.textContent = m[0]; b.type = 'button';
          b.setAttribute('aria-label', (m[1] < 0 ? 'Move up: ' : 'Move down: ')
            + ((META[slug] && META[slug].name) || slug));
          b.onclick = function () {
            var j = idx + m[1];
            if (j < 0 || j >= state.shows.length) return;
            state.shows.splice(idx, 1);
            state.shows.splice(j, 0, slug);
            renderLineup(); renderToday(); checkDirty();
          };
          movers.appendChild(b);
        });
        row.appendChild(movers);
      }
      box.appendChild(row);
    });
  }

  // ------- Add-on toggles
  function addonOn(id) {
    var chosen = state.addons === null ? DEFAULT_ADDONS : state.addons;
    return chosen.indexOf(id) !== -1;
  }
  function addonAllowed(a) {
    if (!state.active) return false;
    return a.tier === 'personal' || state.tier === 'personal_local';
  }
  // Tier ceilings — mirror engine.personal_edition.TIER_LIMITS.
  var LIMITS = { personal: { cities: 1, topics: 0 }, personal_local: { cities: 3, topics: 5 } };
  function limits() { return LIMITS[state.tier] || { cities: 0, topics: 0 }; }
  function cityInputs() { return Array.prototype.slice.call(document.querySelectorAll('#nn-cities .nn-city')); }
  function topicInputs() { return Array.prototype.slice.call(document.querySelectorAll('#nn-topics .nn-topic')); }
  function renderLists(prefs) {
    var lim = limits();
    var cities = prefs.cities || (prefs.city ? [prefs.city] : []);
    cityInputs().forEach(function (inp, i) {
      inp.value = cities[i] || '';
      // A free account can still type its first city — it's saved and
      // used the day they subscribe. Beyond the tier's count is greyed.
      inp.disabled = i > 0 && i >= lim.cities;
    });
    var topics = prefs.topics || [];
    topicInputs().forEach(function (inp, i) {
      inp.value = topics[i] || '';
      inp.disabled = i >= lim.topics;
    });
    el('nn-topics-help').textContent = lim.topics
      ? '(subjects you follow — Mira researches each one daily, sources named)'
      : '(Personal News Network — up to five subjects Mira researches daily)';
    el('nn-cities-help').textContent = lim.cities > 1
      ? '(up to three cities or towns — each gets its own brief)'
      : '(any city or town — the add-ons below follow it)';
  }
  function listValues(inputs) {
    return inputs.map(function (i) { return i.value.trim(); }).filter(Boolean);
  }
  // ------- Dirty state: the settings live in two cards, so a sticky bar
  // follows the member instead of a Save button they have to find.
  function snapshot() {
    return JSON.stringify({
      shows: state.shows, name: el('nn-name').value.trim(),
      cities: listValues(cityInputs()), topics: listValues(topicInputs()),
      addons: state.addons,
    });
  }
  function markClean() { state.clean = snapshot(); checkDirty(); }
  function checkDirty() {
    var dirty = state.clean !== undefined && snapshot() !== state.clean;
    el('nn-savebar').hidden = !dirty;
    renderTomorrow();
  }
  // ------- What tomorrow's build will contain, from the current settings
  function renderTomorrow() {
    var box = el('nn-tomorrow'); if (!box) return;
    if (!state.active) { box.hidden = true; return; }
    var lim = limits();
    var shows = state.shows.length >= 2 ? state.shows : STARTER;
    var names = shows.map(function (s) { return (META[s] && META[s].name) || s; });
    var addons = state.addons === null ? DEFAULT_ADDONS : state.addons;
    var cities = listValues(cityInputs()).slice(0, lim.cities);
    var topics = listValues(topicInputs()).slice(0, lim.topics);
    var local = addons.filter(function (a) { return a !== 'markets'; });
    var items = [];
    items.push('<li>Mira opens, greeting ' + (el('nn-name').value.trim() ? esc(el('nn-name').value.trim()) : 'you') + ' by name</li>');
    if (cities.length && local.length) {
      var depth = state.tier === 'personal_local' ? 'up to three items per section' : 'one item per section';
      items.push('<li>' + (cities.length === 1 ? 'Your ' + esc(cities[0]) + ' brief' : cities.length + ' city briefs (' + esc(cities.join(', ')) + ')')
        + ' — ' + esc(local.map(function (a) { var m = ADDONS.filter(function (x) { return x.id === a; })[0]; return m ? m.label.toLowerCase() : a; }).join(', '))
        + ', ' + depth + '</li>');
    } else if (!cities.length) {
      items.push('<li class="nn-muted">No location set — add one above for a morning brief</li>');
    }
    if (topics.length) { items.push('<li>Your topics: ' + esc(topics.join(', ')) + '</li>'); }
    if (addons.indexOf('markets') !== -1) { items.push('<li>Markets minute</li>'); }
    items.push('<li>' + shows.length + ' shows in your order: ' + esc(names.join(' → ')) + '</li>');
    items.push('<li>Sign-off' + (state.tier === 'personal' && cities.length && local.length ? ' (with a one-line note about Personal News Network on Mondays)' : '') + '</li>');
    el('nn-tomorrow-list').innerHTML = items.join('');
    box.hidden = false;
  }
  function renderAddons() {
    var box = el('nn-addons');
    if (!box) return;
    box.innerHTML = '';
    var anyLocked = false;
    ADDONS.forEach(function (a) {
      var allowed = addonAllowed(a);
      if (!allowed) anyLocked = true;
      var on = allowed && addonOn(a.id);
      var d = document.createElement('div');
      d.className = 'nn-addon' + (on ? ' on' : '') + (allowed ? '' : ' locked');
      d.setAttribute('role', 'switch');
      d.setAttribute('aria-checked', on ? 'true' : 'false');
      d.setAttribute('tabindex', allowed ? '0' : '-1');
      d.innerHTML = '<span class="em">' + a.emoji + '</span><span>'
        + '<span class="name">' + esc(a.label) + '</span>'
        + (allowed ? '' : '<span class="lock">'
            + (a.tier === 'personal_local' ? '🔒 Local tier' : '🔒 Paid tier') + '</span>')
        + '<div class="desc">' + esc(a.desc) + '</div></span>';
      if (allowed) {
        var toggle = function () {
          var chosen = (state.addons === null ? DEFAULT_ADDONS.slice() : state.addons.slice());
          var i = chosen.indexOf(a.id);
          if (i === -1) { chosen.push(a.id); } else { chosen.splice(i, 1); }
          state.addons = chosen; state.addonsTouched = true;
          renderAddons(); checkDirty();
        };
        d.onclick = toggle;
        d.onkeydown = function (ev) {
          if (ev.key === ' ' || ev.key === 'Enter') { ev.preventDefault(); toggle(); }
        };
      }
      box.appendChild(d);
    });
    // The upsell now reads on every active Personal member (the add-ons
    // all run on Personal since 13 Sep 2026; what's locked is depth).
    el('nn-addon-upsell').hidden = !(state.active && state.tier === 'personal');
  }

  // ------- Recent editions (the member's own private feed, CORS-enabled)
  function loadEditions(feedUrl) {
    fetch(feedUrl, { credentials: 'omit' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
      .then(function (xml) {
        var doc = new DOMParser().parseFromString(xml, 'text/xml');
        var items = Array.prototype.slice.call(doc.querySelectorAll('item'), 0, 5);
        if (!items.length) return;
        var box = el('nn-editions-list');
        box.innerHTML = items.map(function (it) {
          var q = function (sel) { var n = it.querySelector(sel); return n ? n.textContent : ''; };
          var enc = it.querySelector('enclosure');
          var url = enc ? enc.getAttribute('url') : '';
          var date = (q('pubDate') || '').split(' ').slice(0, 4).join(' ');
          return '<div class="nn-edition">'
            + '<div class="t">' + esc(q('title')) + '</div>'
            + '<div class="d">' + esc(date) + '</div>'
            + (url ? '<audio controls preload="none" src="' + esc(url) + '"></audio>' : '')
            + '</div>';
        }).join('');
        el('nn-editions').hidden = false;
        el('nn-feed-note').hidden = true;   // editions exist: not "just subscribed"
      })
      .catch(function () {});
  }

  // ------- Today rail (same-origin api/episodes.json, pipeline-refreshed)
  var EPISODES = null;
  function minutesOf(dur) {
    var m = /([0-9]+):([0-9]{2})/.exec(dur || '');
    return m ? (parseInt(m[1], 10) + parseInt(m[2], 10) / 60) : 0;
  }
  function renderToday() {
    var box = el('nn-today');
    if (!box || EPISODES === null) return;
    var lineup = state.shows.length >= 2 ? state.shows : STARTER;
    var order = {}; lineup.forEach(function (s, i) { order[s] = i; });
    var eps = EPISODES.filter(function (e) { return order[e.show_id] !== undefined; });
    // newest date first; inside a day, the member's own order
    var newest = eps.length ? eps.map(function (e) { return e.date; }).sort().pop() : null;
    var today = eps.filter(function (e) { return e.date === newest; })
      .sort(function (a, b) { return order[a.show_id] - order[b.show_id]; });
    if (!today.length) {
      box.innerHTML = '<p class="nn-muted">No episodes yet from your picks — try adding a couple more shows.</p>';
      el('nn-today-stats').hidden = true;
      return;
    }
    var mins = 0;
    box.innerHTML = today.map(function (e) {
      mins += minutesOf(e.duration);
      return '<div class="nn-ep-card">'
        + '<span>' + coverImg(e.show_id, 52) + '</span>'
        + '<span>'
        + '<span class="nn-ep-show" style="color:' + esc(e.brand_color || '#00D4FF') + ';">' + esc(e.show_name) + '</span>'
        + '<div class="nn-ep-title">' + (e.blog_url
            ? '<a href="' + esc(e.blog_url) + '" style="color:inherit;text-decoration:none;">' + esc(e.title) + '</a>'
            : esc(e.title)) + '</div>'
        + '<span class="nn-ep-meta">' + esc(e.date) + (e.duration ? ' · ' + esc(e.duration.replace('~', '')) : '') + '</span>'
        + (e.audio_url ? '<audio controls preload="none" src="' + esc(e.audio_url) + '"></audio>' : '')
        + '</span></div>';
    }).join('');
    el('nn-stat-count').textContent = today.length;
    el('nn-stat-mins').textContent = Math.round(mins) || '–';
    el('nn-stat-shows').textContent = lineup.length;
    el('nn-today-stats').hidden = false;
  }
  function loadEpisodes() {
    fetch('api/episodes.json')
      .then(function (r) { return r.json(); })
      .then(function (d) { EPISODES = d.episodes || []; renderToday(); })
      .catch(function () {
        EPISODES = [];
        el('nn-today').innerHTML = '<p class="nn-muted">Could not load today’s episodes.</p>';
      });
  }

  // ------- Market tiles (single-value stat tiles; delta = status color + arrow)
  function mktTile(sym, price, deltaPct, href) {
    if (price === undefined || price === null) return '';
    var up = deltaPct >= 0;
    var cls = up ? 'up' : 'down';
    var arrow = up ? '▲' : '▼';
    return '<a class="tile" href="' + href + '" style="text-decoration:none;color:inherit;">'
      + '<div class="sym">' + sym + '</div>'
      + '<div class="px">$' + Number(price).toFixed(2) + '</div>'
      + '<div class="chg ' + cls + '">' + arrow + ' ' + Math.abs(deltaPct).toFixed(1) + '%</div>'
      + '</a>';
  }
  function loadMarkets() {
    Promise.all([
      fetch('api/tsla.json').then(function (r) { return r.json(); }).catch(function () { return null; }),
      fetch('api/spcx.json').then(function (r) { return r.json(); }).catch(function () { return null; })
    ]).then(function (res) {
      var t = res[0], s = res[1], html = '';
      if (t && t.price) {
        var tp = (typeof t.change_pct === 'number') ? t.change_pct
          : (t.prev_close ? (t.price - t.prev_close) / t.prev_close * 100 : 0);
        html += mktTile('TSLA', t.price, tp, 'tesla-dashboard.html');
      }
      if (s && s.price) {
        var sp = s.prev_close ? (s.price - s.prev_close) / s.prev_close * 100 : 0;
        html += mktTile('SPCX', s.price, sp, 'spacex-dashboard.html');
      }
      if (html) {
        el('nn-mkt').innerHTML = html;
        var asof = (t && t.fetched_at) || (s && s.updated_at) || '';
        el('nn-mkt-asof').textContent = asof ? 'As of ' + asof.slice(0, 10) + ' · from the shows’ own data pipeline' : '';
        el('nn-mkt-card').hidden = false;
      }
    });
  }

  function greet(name) {
    var h = new Date().getHours();
    var part = h < 5 ? 'Good evening' : h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
    el('nn-greeting').textContent = part + (name ? ', ' + name : '') + ' —';
    el('nn-date').textContent = new Date().toLocaleDateString(undefined,
      { weekday: 'long', month: 'long', day: 'numeric' });
  }

  // Every checkout link on the page carries an opaque one-hour reference
  // so the Worker attaches the purchase to THIS account, even when the
  // wallet reports a different email (Apple Pay / Link do). No email in
  // the URL — the ref is random and resolves server-side.
  function attachCheckoutRefs() {
    var links = document.querySelectorAll('a[data-checkout]');
    if (!links.length) { return; }
    fetch(API + '/api/account/checkout-ref', { method: 'POST', credentials: 'include' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || !d.ref) { return; }
        links.forEach(function (a) {
          var base = a.getAttribute('href').split('?')[0];
          a.href = base + '?client_reference_id=' + encodeURIComponent(d.ref);
        });
      })
      .catch(function () {});
  }

  function load() {
    fetch(API + '/api/account', { credentials: 'include' })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function (data) {
        el('nn-status').textContent = '';
        el('nn-member').hidden = false;
        state.all = data.shows || [];
        var prefs = (data.member && data.member.preferences) || {};
        state.shows = prefs.shows || [];
        state.addons = (prefs.addons === undefined) ? null : prefs.addons;
        el('nn-name').value = prefs.first_name || '';
        greet(prefs.first_name || '');
        var feedUrl = data.member && data.member.feed_url;
        var tier = (data.member && data.member.tier) || 'none';
        var status = (data.member && data.member.status) || 'none';
        var cancelled = status === 'cancelled';
        state.tier = tier; state.active = status === 'active';
        el('nn-email').textContent = data.email || '';
        renderLineup();
        renderLists(prefs);
        renderAddons();
        markClean();
        ['nn-name'].concat(cityInputs().map(function (i) { return i; }), topicInputs())
          .forEach(function (x) {
            var node = typeof x === 'string' ? el(x) : x;
            if (node && !node._nnWired) { node._nnWired = true; node.addEventListener('input', checkDirty); }
          });
        loadEpisodes();
        loadMarkets();
        el('nn-feed-active').hidden = !feedUrl;
        el('nn-feed-upsell').hidden = !!feedUrl || cancelled;
        el('nn-feed-cancelled').hidden = !cancelled || !!feedUrl;
        if (feedUrl) { el('nn-feed-url').textContent = feedUrl; loadEditions(feedUrl); }
        var pill = el('nn-tier-badge');
        if (status === 'active') {
          pill.textContent = tier === 'personal_local' ? 'Personal News Network' : 'Personal';
          pill.className = 'nn-tier-pill active'; pill.hidden = false;
        } else if (cancelled) {
          pill.textContent = 'subscription ended';
          pill.className = 'nn-tier-pill'; pill.hidden = false;
        } else {
          pill.textContent = 'free account';
          pill.className = 'nn-tier-pill'; pill.hidden = false;
        }
        el('nn-hero-sub').textContent = feedUrl
          ? 'Your private edition is live — here’s what your shows published, and everything your membership includes.'
          : 'Here’s what your shows published today. Your lineup is saved — one step from your own private daily edition.';
        // A paying member with <2 chosen shows rides the starter lineup
        // until they save their own (the Worker fills it server-side).
        el('nn-starter-note').hidden = !(feedUrl && state.shows.length < 2);
        el('nn-city-nudge').hidden = !(
          status === 'active' && !listValues(cityInputs()).length
        );

        // Plan switching (Sep 13 2026): an existing subscriber changes
        // plan or cancels inside Stripe's portal; the account page never
        // opens a second checkout for them.
        var portal = !!(data.member && data.member.billing_portal);
        state.portal = portal;
        el('nn-portal-btn').hidden = !(portal && status === 'active');
        var switchPortal = el('nn-switch-portal'), switchCheckout = el('nn-switch-checkout');
        if (switchPortal) { switchPortal.hidden = !(portal && status === 'active'); }
        if (switchCheckout) { switchCheckout.hidden = (portal && status === 'active'); }
        var endsAt = data.member && data.member.ends_at;
        el('nn-ends-note').hidden = !endsAt;
        if (endsAt) {
          el('nn-ends-note').textContent = 'Your subscription is set to end on ' + endsAt
            + '. Your feed keeps building until then; resume any time from Manage plan & billing.';
        }
        // Personal members see what the next tier adds; the button is the
        // portal (existing subscription) — never a second checkout.
        el('nn-pnn-card').hidden = !(status === 'active' && tier === 'personal');
        el('nn-pnn-switch').hidden = !(portal && status === 'active');
        var pnnCheckout = el('nn-pnn-checkout');
        if (pnnCheckout) { pnnCheckout.hidden = (portal && status === 'active'); }
        attachCheckoutRefs();
        // Library: links answer only for active PNN (the Worker gates the
        // bytes; this just decides what the page shows).
        var lib = !!(data.perks && data.perks.library);
        document.querySelectorAll('.nn-book-dl').forEach(function (a) { a.hidden = !lib; });
        document.querySelectorAll('.nn-book-locked').forEach(function (x) { x.hidden = lib; });
        el('nn-library-lede').textContent = lib
          ? 'Every Nerra book, yours to keep on this plan. EPUB opens in Apple Books, Kindle (via Send to Kindle), Kobo and any reader.'
          : (status === 'active'
              ? 'Every Nerra book is included with Personal News Network — switch plans and the downloads unlock here.'
              : 'Every Nerra book is included with Personal News Network.');
        el('nn-library-foot').textContent = lib
          ? 'New volumes appear here the day they are built. Audiobook editions are next.'
          : '';
        var code = data.perks && data.perks.book_discount_code;
        el('nn-book-perk').innerHTML = lib
          ? 'Included — see your library below'
          : (code
              ? 'Use code <strong>' + esc(code) + '</strong> at the book store — '
                + '<a href="{{ path_prefix }}books.html">see the books →</a>'
              : 'Included with Personal News Network; member store codes appear here as volumes launch');
      })
      .catch(function () {
        el('nn-status').textContent = '';
        el('nn-guest').hidden = false;
      });
  }

  return {
    login: function (form) {
      var btn = form.querySelector('button');
      btn.disabled = true; btn.textContent = 'Sending…';
      fetch(API + '/api/login?email=' + encodeURIComponent(form.email.value))
        .then(function () { btn.textContent = 'Check your inbox'; })
        .catch(function () { btn.textContent = 'Try again'; btn.disabled = false; });
    },
    save: function () {
      el('nn-save-status').textContent = 'Saving…';
      var body = {
        shows: state.shows,
        first_name: el('nn-name').value,
        cities: listValues(cityInputs()),
        topics: listValues(topicInputs()),
      };
      // Send addons only once the member has a real choice — an untouched
      // page must not overwrite "never saved" (defaults) with a snapshot.
      if (state.addonsTouched || state.addons !== null) { body.addons = state.addons; }
      fetch(API + '/api/account/preferences', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      }).then(function (r) {
        el('nn-save-status').textContent = r.ok
          ? 'Saved — changes reach tomorrow’s edition'
          : 'Save failed (are personal accounts live yet?)';
        if (r.ok) { greet(el('nn-name').value); markClean(); }
      }).catch(function () { el('nn-save-status').textContent = 'Save failed'; });
    },
    copyFeed: function () {
      navigator.clipboard.writeText(el('nn-feed-url').textContent);
    },
    logout: function () {
      fetch(API + '/api/logout', { method: 'POST', credentials: 'include' })
        .catch(function () {})
        .then(function () { window.location.href = '{{ path_prefix }}login.html'; });
    },
    portal: function () {
      var btn = el('nn-portal-btn');
      if (btn) { btn.disabled = true; btn.textContent = 'Opening…'; }
      fetch(API + '/api/account/portal', { method: 'POST', credentials: 'include' })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then(function (d) { window.location.href = d.url; })
        .catch(function () {
          if (btn) { btn.disabled = false; btn.textContent = 'Manage plan & billing'; }
          el('nn-save-status').textContent = 'Billing portal unavailable right now — try again shortly.';
        });
    },
    load: load,
  };
})();
NN.load();
</script>
{% endblock %}
