{% extends "base.html.j2" %}

{# /account.html — "My Nerra", the member home.

   Oct 28 2026 redesign: the member's own front page. The page is static;
   identity and preferences come from api.nerranetwork.com (cookie), the
   stories from api/personal_front.json (written with every homepage build
   from the homepage's own story data — generate_html.personal_front_payload),
   and the stocks the member follows live from the markets route
   (assets/js/nn-markets.js; Oct 29 2026). It borrows the front
   page's design (_landing_styles.html.j2, the lt-* classes) and lays it out
   for one person: their lineup in their order, the stories on their topics
   and places, their edition, and a studio that shows what tomorrow's
   edition will hold while they change it.

   Drift-guarded ids (tests/test_nerra_personal.py) — keep them:
   nn-feed-cancelled, nn-starter-note, nn-city-nudge, nn-tier-badge. #}

{% block head_extra %}
    {# A member console, not content: kept out of the sitemap on purpose,
       and noindexed so a signed-out shell never becomes a search result. #}
    <meta name="robots" content="noindex,follow">
    {% include "_landing_styles.html.j2" %}
    <style>
        .nn-me [hidden], .nn-savebar[hidden] { display: none !important; }
        .me-status { font-family: var(--font-ui); color: var(--lt-muted); min-height: 1.2rem; font-size: 0.92rem; margin: var(--sp-4) 0; }
        .me-link { background: none; border: 0; padding: 0; color: var(--lt-cyan); font: inherit; font-weight: 600; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
        .me-link:hover { color: var(--nn-white); }
        .me-muted { color: var(--lt-muted); }
        .me-p { font-family: var(--font-ui); font-size: 0.92rem; line-height: 1.55; color: var(--lt-ink); margin: 0 0 var(--sp-3); }
        .me-p a:not([class]), .me-fine a:not([class]), .me-card li a:not([class]) { color: var(--lt-cyan); text-decoration: underline; text-underline-offset: 2px; }
        .me-fine { font-family: var(--font-ui); font-size: 0.8rem; line-height: 1.5; color: var(--lt-muted); margin: var(--sp-2) 0 0; }

        /* ---- Masthead ---- */
        .me-mast { border-bottom: 3px double var(--lt-rule-strong); padding-bottom: var(--sp-5); margin-bottom: var(--sp-6); }
        .me-mast .lt-masthead-meta { margin-bottom: var(--sp-5); }
        .me-tier { font-family: var(--font-ui); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--lt-rule-strong); color: var(--lt-muted); }
        .me-tier.is-active { border-color: color-mix(in srgb, var(--lt-cyan) 60%, transparent); color: var(--lt-cyan); background: color-mix(in srgb, var(--lt-cyan) 8%, transparent); }
        .me-whoami { margin-left: auto; }
        .me-mast-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--sp-4) var(--sp-8); align-items: end; }
        .me-title { font-family: var(--lt-head); font-weight: 700; font-size: clamp(2rem, 4.6vw, 3.1rem); line-height: 1.06; letter-spacing: -0.015em; margin: 0 0 var(--sp-3); color: var(--nn-white); }
        .me-title em { font-style: normal; background: var(--nn-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .me-mast-actions { display: flex; flex-wrap: wrap; gap: var(--sp-2); justify-content: flex-end; }
        .me-mast-actions .lt-btn { white-space: nowrap; }
        .lt-btn { font-family: var(--font-ui); font-weight: 700; font-size: 0.92rem; padding: 0.62rem 1.1rem; border-radius: 999px; border: 1px solid var(--lt-rule-strong); background: transparent; color: var(--nn-white); cursor: pointer; display: inline-flex; align-items: center; gap: 8px; line-height: 1.2; text-decoration: none; }
        .lt-btn[disabled] { opacity: 0.55; cursor: default; }
        .lt-btn--primary { color: #fff; }
        .me-btn-grad { background: var(--nn-gradient); border-color: transparent; color: #fff; }
        .me-btn-grad:hover { filter: brightness(1.08); border-color: transparent; }
        .me-stats { display: flex; flex-wrap: wrap; gap: var(--sp-3) var(--sp-8); margin: var(--sp-6) 0 0; padding: 0; }
        .me-stats div { min-width: 0; }
        .me-stats dt { font-family: var(--font-ui); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lt-muted); order: 2; }
        .me-stats dd { margin: 0; font-family: var(--lt-head); font-size: 1.9rem; font-weight: 700; line-height: 1.05; color: var(--nn-white); font-variant-numeric: tabular-nums; }
        .me-stats div { display: flex; flex-direction: column-reverse; }
        .me-quotes { display: flex; flex-wrap: wrap; gap: 4px var(--sp-5); margin-left: auto; align-self: end; font-family: var(--font-ui); font-size: 0.84rem; }
        .me-quotes a { color: var(--lt-ink); }
        .me-quotes #nn-mkt { display: inline-flex; flex-wrap: wrap; gap: 4px var(--sp-5); }
        .me-quotes a:hover .lt-quote-sym { text-decoration: underline; }
        .me-quotes small { color: var(--lt-muted); font-size: 0.72rem; }

        /* ---- Your markets (Oct 29 2026) ---- */
        .me-mkt-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: var(--sp-3); }
        .me-mkt { position: relative; border: 1px solid var(--lt-rule); border-radius: 14px; padding: 14px 16px; background: rgba(255,255,255,0.02); font-family: var(--font-ui); }
        .me-mkt .sym { font-weight: 800; letter-spacing: 0.04em; color: var(--nn-white); }
        .me-mkt .nm { display: block; color: var(--lt-muted); font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 26px; }
        .me-mkt .px { display: block; font-family: var(--lt-head); font-size: 1.5rem; font-weight: 700; margin-top: 6px; font-variant-numeric: tabular-nums; color: var(--nn-white); }
        .me-mkt .chg { font-weight: 700; font-size: 0.9rem; font-variant-numeric: tabular-nums; }
        .me-mkt.is-up .chg { color: #34D399; } .me-mkt.is-down .chg { color: #F87171; } .me-mkt.is-flat .chg { color: var(--lt-muted); }
        .me-mkt .when { display: block; color: var(--lt-muted); font-size: 0.74rem; margin-top: 4px; }
        .me-mkt .in { display: block; font-size: 0.8rem; margin-top: 8px; color: var(--lt-ink); }
        .me-mkt .in a { color: var(--nn-cyan); }
        .me-mkt .rm { position: absolute; top: 10px; right: 10px; width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--lt-rule); background: transparent; color: var(--lt-muted); cursor: pointer; line-height: 1; }
        .me-mkt .rm:hover, .me-mkt .rm:focus-visible { color: var(--nn-white); border-color: var(--nn-cyan); }
        .me-mkt.is-missing .px { font-size: 1rem; color: var(--lt-muted); }
        .me-mkt-add { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: var(--sp-4); }
        .me-mkt-add .me-input { max-width: 280px; text-transform: uppercase; }
        .me-app { margin: var(--sp-6) 0 0; }
        .me-app .nn-app-card { margin: 0; }
        .me-code { margin-top: var(--sp-4); padding-top: var(--sp-4); border-top: 1px solid var(--lt-rule); }
        .me-code[hidden] { display: none; }
        .me-code-row { display: flex; gap: 8px; margin-top: 6px; }
        .me-code-row .me-input { max-width: 160px; font-size: 1.2rem; letter-spacing: 0.2em; text-align: center; font-variant-numeric: tabular-nums; }
        .me-mkt-add [role="status"] { font-family: var(--font-ui); font-size: 0.86rem; color: var(--lt-muted); }
        @media (max-width: 560px) {
            .me-mkt-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-2); }
            .me-mkt { padding: 12px; }
            .me-mkt .px { font-size: 1.15rem; }
            .me-mkt-add .me-input { flex: 1 1 0; min-width: 0; }
        }

        /* ---- Your edition ---- */
        .me-edition { margin-top: 0; }
        .me-edition .lt-edition-inner { grid-template-columns: 168px minmax(0, 1fr); align-items: start; }
        .me-edition .lt-edition-cover img { width: 168px; height: 168px; object-fit: cover; display: block; }
        .me-ed-actions { display: flex; flex-wrap: wrap; gap: var(--sp-2); align-items: center; margin-top: var(--sp-4); }
        .me-build { display: flex; gap: 10px; align-items: flex-start; margin-top: var(--sp-3); font-family: var(--font-ui); font-size: 0.9rem; }
        .me-build .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--lt-muted); flex: none; margin-top: 5px; }
        .me-build .dot.on { background: #34D399; box-shadow: 0 0 0 4px rgba(52,211,153,0.16); }
        .me-build .dot.busy { background: #FBBF24; animation: me-pulse 1.2s ease-in-out infinite; }
        @keyframes me-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }
        .me-build small { display: block; color: var(--lt-muted); margin-top: 2px; font-size: 0.82rem; }
        .me-ed-cols { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--sp-6); margin-top: var(--sp-5); padding-top: var(--sp-5); border-top: 1px solid var(--lt-rule-strong); }
        .me-ed-list { list-style: none; margin: 0; padding: 0; }
        .me-ed-list li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--lt-rule); }
        .me-ed-list li:last-child { border-bottom: 0; }
        .me-ed-list .t { font-family: var(--font-ui); font-size: 0.9rem; font-weight: 600; color: var(--nn-white); line-height: 1.3; }
        .me-ed-list .d { font-family: var(--font-ui); font-size: 0.78rem; color: var(--lt-muted); }
        .me-feedurl { font-family: var(--font-mono, ui-monospace, monospace); font-size: 0.76rem; word-break: break-all; background: rgba(0,0,0,0.28); border: 1px solid var(--lt-rule); padding: 0.55rem 0.75rem; border-radius: 8px; margin: 0 0 var(--sp-2); color: var(--lt-ink); }
        .me-apps { display: flex; flex-wrap: wrap; gap: 6px; margin: var(--sp-2) 0 0; align-items: center; font-family: var(--font-ui); font-size: 0.84rem; }
        .me-apps a { padding: 5px 12px; border: 1px solid var(--lt-rule-strong); border-radius: 999px; font-weight: 600; color: var(--nn-white); }
        .me-apps a:hover, .me-apps a:focus-visible { border-color: var(--lt-cyan); }
        .me-upsell-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: var(--sp-6); align-items: start; }
        .me-cta-stack { display: grid; gap: var(--sp-2); max-width: 340px; }
        .me-cta-stack .lt-btn { justify-content: center; }
        .me-sample { background: rgba(0,0,0,0.25); border: 1px solid var(--lt-rule); border-radius: 12px; padding: var(--sp-4); }
        .me-sample .lt-sublabel { margin-bottom: var(--sp-2); }

        /* ---- Play buttons ---- */
        .me-play { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-ui); font-size: 0.82rem; font-weight: 700; color: var(--nn-white);
            background: color-mix(in srgb, var(--show-color, var(--nn-purple)) 30%, rgba(255,255,255,0.04)); border: 1px solid color-mix(in srgb, var(--show-color, var(--nn-purple)) 60%, transparent);
            border-radius: 999px; padding: 5px 12px 5px 9px; cursor: pointer; line-height: 1.2; }
        .me-play:hover { filter: brightness(1.15); }
        .me-play .ic { width: 0; height: 0; border-left: 8px solid currentColor; border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
        .me-play.is-playing .ic { width: 8px; height: 10px; border: 0; border-left: 3px solid currentColor; border-right: 3px solid currentColor; }
        .me-play.is-round { width: 36px; height: 36px; padding: 0; justify-content: center; }
        .me-play.is-round .ic { margin-left: 2px; }
        .me-play.is-round.is-playing .ic { margin-left: 0; }
        .me-played { font-family: var(--font-ui); font-size: 0.72rem; font-weight: 700; color: #34D399; letter-spacing: 0.02em; }
        .me-len { font-variant-numeric: tabular-nums; }

        /* ---- Front page tweaks ---- */
        .me-front-note { font-family: var(--font-ui); font-size: 0.86rem; color: var(--lt-muted); margin: calc(-1 * var(--sp-2)) 0 var(--sp-5); }
        .me-front-grid { margin-top: var(--sp-8); }
        .me-card-tag { font-family: var(--font-ui); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--lt-muted); border: 1px solid var(--lt-rule-strong); padding: 1px 7px; border-radius: 4px; }
        .me-older { color: var(--lt-muted); }
        .me-locked { border: 1px dashed var(--lt-rule-strong); border-radius: var(--lt-radius); padding: var(--sp-5); display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: var(--sp-4); align-items: center; }
        .me-locked img { width: 64px; height: 64px; border-radius: 10px; }
        .me-empty { font-family: var(--font-ui); color: var(--lt-muted); border: 1px dashed var(--lt-rule-strong); border-radius: 12px; padding: var(--sp-6); text-align: center; }

        /* ---- Topics ---- */
        .me-topics { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--sp-5) var(--sp-6); }
        .me-topic h3 { font-family: var(--font-ui); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--nn-white); margin: 0 0 var(--sp-2); display: flex; gap: 8px; align-items: baseline; }
        .me-topic h3 span { color: var(--lt-muted); font-weight: 600; letter-spacing: 0.02em; text-transform: none; }
        .me-topic ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--lt-rule-strong); }
        .me-topic li { padding: 10px 0; border-bottom: 1px solid var(--lt-rule); }
        .me-topic .lt-hl { font-size: 1rem; font-weight: 600; line-height: 1.32; }
        .me-topic mark { background: color-mix(in srgb, var(--lt-cyan) 22%, transparent); color: var(--nn-white); border-radius: 3px; padding: 0 2px; }
        .me-topic .none { font-family: var(--font-ui); font-size: 0.86rem; color: var(--lt-muted); padding: 10px 0; }
        .me-add-show { font-family: var(--font-ui); font-size: 0.74rem; font-weight: 700; background: none; border: 1px solid var(--lt-rule-strong); color: var(--lt-cyan); border-radius: 999px; padding: 1px 9px; cursor: pointer; }
        .me-add-show:hover { border-color: var(--lt-cyan); }
        .me-topics-empty { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--sp-4); align-items: center; border: 1px dashed var(--lt-rule-strong); border-radius: 12px; padding: var(--sp-5) var(--sp-6); }

        /* ---- Watch ---- */
        .me-watch-rail { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(200px, 1fr); gap: var(--sp-4); overflow-x: auto; padding-bottom: 6px; scroll-snap-type: x mandatory; }
        .me-vid { scroll-snap-align: start; position: relative; display: block; border-radius: 12px; overflow: hidden; background: #111827; color: var(--nn-white); text-decoration: none; aspect-ratio: 16 / 10; }
        .me-vid.is-short { aspect-ratio: 9 / 13; }
        .me-vid img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
        .me-vid::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(0,0,0,0.85)); }
        .me-vid-txt { position: absolute; left: 12px; right: 12px; bottom: 10px; z-index: 1; font-family: var(--font-ui); }
        .me-vid-txt b { display: block; font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--show-color-text, var(--lt-cyan)); }
        .me-vid-txt span { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.9rem; font-weight: 600; line-height: 1.3; }
        .me-vid-play { position: absolute; top: 10px; left: 10px; z-index: 1; font: 700 0.68rem/1 var(--font-ui); padding: 5px 8px; border-radius: 999px; background: rgba(0,0,0,0.6); }
        .me-vid:hover img { transform: scale(1.03); transition: transform 0.3s; }
        .me-vid:focus-visible { outline: 2px solid var(--lt-cyan); outline-offset: 3px; }
        .lt-meta .me-watch-link { margin-left: 4px; }

        /* ---- Catch up ---- */
        .me-catchup { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--sp-8); list-style: none; margin: 0; padding: 0; }
        .me-catchup li { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: var(--sp-3); align-items: center; padding: 12px 0; border-bottom: 1px solid var(--lt-rule); }
        .me-catchup img { width: 56px; height: 56px; border-radius: 8px; object-fit: cover; }
        .me-catchup .lt-hl { font-size: 0.98rem; font-weight: 600; line-height: 1.3; }
        .me-catchup .lt-kicker { font-size: 0.66rem; margin-bottom: 2px; }

        /* ---- The studio ---- */
        .me-studio-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: var(--sp-8); align-items: start; }
        .me-panel { border: 1px solid var(--lt-rule-strong); border-radius: 16px; background: var(--lt-panel); padding: var(--sp-6); margin: 0 0 var(--sp-5); min-width: 0; }
        .me-panel > h3 { font-family: var(--lt-head); font-size: 1.35rem; font-weight: 700; margin: 0 0 4px; color: var(--nn-white); display: flex; gap: 12px; align-items: baseline; }
        .me-step { font-family: var(--font-ui); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; color: var(--lt-cyan); text-transform: uppercase; }
        .me-panel-lede { font-family: var(--font-ui); font-size: 0.9rem; color: var(--lt-muted); line-height: 1.5; margin: 0 0 var(--sp-5); max-width: 42rem; }
        .me-field { display: grid; gap: 6px; margin: 0 0 var(--sp-5); }
        .me-field:last-child { margin-bottom: 0; }
        .me-label { font-family: var(--font-ui); font-size: 0.86rem; font-weight: 700; color: var(--nn-white); }
        .me-label small { font-weight: 500; color: var(--lt-muted); }
        .me-help { font-family: var(--font-ui); font-size: 0.8rem; line-height: 1.5; color: var(--lt-muted); margin: 0; }
        .me-input, .nn-me textarea.me-input { width: 100%; box-sizing: border-box; font-family: var(--font-ui); font-size: 0.95rem; line-height: 1.4; color: var(--nn-white);
            background: rgba(0,0,0,0.28); border: 1px solid var(--lt-rule-strong); border-radius: 10px; padding: 0.68rem 0.85rem; transition: border-color 150ms, box-shadow 150ms; }
        .me-input::placeholder { color: rgba(255,255,255,0.42); }
        .me-input:focus { outline: none; border-color: var(--lt-cyan); box-shadow: 0 0 0 3px color-mix(in srgb, var(--lt-cyan) 22%, transparent); }
        .me-input[disabled] { opacity: 0.45; cursor: not-allowed; }
        textarea.me-input { min-height: 92px; resize: vertical; }
        .me-inputs { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; }

        /* Shows: the order, then everything else */
        .me-order { list-style: none; margin: 0 0 var(--sp-5); padding: 0; counter-reset: me-order; display: grid; gap: 6px; }
        .me-order li { display: grid; grid-template-columns: 20px 26px 44px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 8px 10px; border: 1px solid var(--lt-rule-strong);
            border-left: 3px solid var(--show-color, var(--lt-rule-strong)); border-radius: 10px; background: rgba(255,255,255,0.02); }
        .me-order li.is-drag { opacity: 0.4; }
        .me-order li.is-over { box-shadow: 0 -2px 0 var(--lt-cyan); }
        .me-handle { cursor: grab; color: var(--lt-muted); font-size: 1rem; line-height: 1; user-select: none; text-align: center; }
        .me-pos { font-family: var(--lt-head); font-weight: 700; font-size: 1.05rem; color: var(--nn-white); text-align: center; }
        .me-order img, .me-tile img { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; display: block; }
        .me-order .txt, .me-tile .txt { display: block; min-width: 0; line-height: 1.25; }
        .me-order .nm { display: block; font-family: var(--font-ui); font-weight: 700; font-size: 0.92rem; color: var(--nn-white); line-height: 1.25; }
        .me-order .sub { display: block; font-family: var(--font-ui); font-size: 0.76rem; color: var(--lt-muted); margin-top: 2px; }
        .me-movers { display: flex; gap: 4px; }
        .me-icon-btn { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--lt-rule-strong); background: transparent; color: var(--nn-white); cursor: pointer; font-size: 0.9rem; line-height: 1; display: inline-flex; align-items: center; justify-content: center; }
        .me-icon-btn:hover { border-color: var(--lt-cyan); }
        .me-icon-btn[disabled] { opacity: 0.3; cursor: default; }
        .me-shows-tools { display: flex; flex-wrap: wrap; gap: var(--sp-3); align-items: center; justify-content: space-between; margin: 0 0 var(--sp-3); }
        .me-shows-tools .me-input { max-width: 280px; }
        .me-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px; }
        .me-tile { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 10px; border: 1px solid var(--lt-rule); border-radius: 10px; background: rgba(255,255,255,0.015); min-width: 0; }
        .me-tile .nm { display: block; font-family: var(--font-ui); font-weight: 700; font-size: 0.86rem; color: var(--nn-white); line-height: 1.25; }
        .me-tile .sub { margin-top: 2px; font-family: var(--font-ui); font-size: 0.74rem; color: var(--lt-muted); line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .me-tile .lock { display: block; margin-top: 3px; font-family: var(--font-ui); font-size: 0.66rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #F5C860; }
        .me-tile .me-icon-btn { color: var(--lt-cyan); font-size: 1.1rem; }

        /* Edition length: a segmented control */
        .me-seg { display: flex; flex-wrap: wrap; gap: 6px; border: 0; padding: 0; margin: 0; }
        .me-seg input { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
        .me-seg label { font-family: var(--font-ui); font-size: 0.86rem; font-weight: 600; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--lt-rule-strong); color: var(--lt-ink); cursor: pointer; }
        .me-seg input:checked + label { background: color-mix(in srgb, var(--lt-cyan) 16%, transparent); border-color: var(--lt-cyan); color: var(--nn-white); }
        .me-seg input:focus-visible + label { outline: 2px solid var(--lt-cyan); outline-offset: 2px; }

        /* Add-ons: switches */
        .me-addons { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 8px; margin: var(--sp-3) 0 0; }
        .me-addon { display: grid; grid-template-columns: 28px minmax(0, 1fr) 40px; gap: 10px; align-items: start; text-align: left; width: 100%; padding: 12px; border: 1px solid var(--lt-rule-strong);
            border-radius: 12px; background: rgba(255,255,255,0.015); color: var(--lt-ink); cursor: pointer; font: inherit; }
        .me-addon:hover { border-color: color-mix(in srgb, var(--lt-cyan) 50%, var(--lt-rule-strong)); }
        .me-addon[aria-checked="true"] { border-color: color-mix(in srgb, var(--lt-cyan) 65%, transparent); background: color-mix(in srgb, var(--lt-cyan) 7%, transparent); }
        .me-addon[aria-disabled="true"] { cursor: default; opacity: 0.72; }
        .me-addon[aria-disabled="true"]:hover { border-color: var(--lt-rule-strong); }
        .me-addon .em { font-size: 1.2rem; line-height: 1.3; }
        .me-addon .nm { font-family: var(--font-ui); font-weight: 700; font-size: 0.9rem; color: var(--nn-white); display: block; }
        .me-addon .ds { font-family: var(--font-ui); font-size: 0.78rem; line-height: 1.45; color: var(--lt-muted); display: block; margin-top: 3px; }
        .me-addon .lk { display: inline-block; margin-top: 6px; font-family: var(--font-ui); font-size: 0.66rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #F5C860; white-space: nowrap; }
        .me-sw { width: 38px; height: 22px; border-radius: 999px; background: rgba(255,255,255,0.14); position: relative; margin-top: 2px; transition: background 150ms; }
        .me-sw::after { content: ""; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform 150ms; }
        .me-addon[aria-checked="true"] .me-sw { background: var(--lt-cyan); }
        .me-addon[aria-checked="true"] .me-sw::after { transform: translateX(16px); }
        .me-addon[aria-disabled="true"] .me-sw { opacity: 0.35; }
        .me-save-row { display: flex; flex-wrap: wrap; gap: var(--sp-3); align-items: center; margin-top: var(--sp-2); }
        #nn-save-status { font-family: var(--font-ui); font-size: 0.88rem; color: var(--lt-muted); }

        /* Tomorrow's edition (the live preview) */
        .me-preview { position: sticky; top: calc(var(--nav-height, 72px) + var(--sp-4)); border: 1px solid var(--lt-rule-strong); border-radius: 16px; overflow: hidden;
            background: linear-gradient(170deg, color-mix(in srgb, var(--nn-purple) 22%, #0B0F1A) 0%, #0F1424 45%); }
        .me-preview-head { padding: var(--sp-5) var(--sp-5) var(--sp-4); border-bottom: 1px solid var(--lt-rule-strong); }
        .me-preview-head .lt-edition-label { margin: 0 0 4px; }
        .me-preview-head h3 { font-family: var(--lt-head); font-size: 1.3rem; margin: 0; color: var(--nn-white); line-height: 1.2; }
        .me-est { font-family: var(--font-ui); font-size: 0.86rem; color: var(--lt-ink); margin: 8px 0 0; }
        .me-est strong { font-family: var(--lt-head); font-size: 1.5rem; color: var(--nn-white); margin-right: 4px; }
        .me-timeline { list-style: none; margin: 0; padding: var(--sp-4) var(--sp-5); max-height: 52vh; overflow-y: auto; }
        .me-timeline li { position: relative; padding: 0 0 12px 22px; font-family: var(--font-ui); font-size: 0.86rem; line-height: 1.4; color: var(--lt-ink); }
        .me-timeline li::before { content: ""; position: absolute; left: 4px; top: 6px; width: 8px; height: 8px; border-radius: 50%; background: var(--dot, var(--lt-cyan)); }
        .me-timeline li::after { content: ""; position: absolute; left: 7.5px; top: 16px; bottom: 0; width: 1px; background: var(--lt-rule-strong); }
        .me-timeline li:last-child::after { display: none; }
        .me-timeline .tm { color: var(--lt-muted); font-variant-numeric: tabular-nums; margin-left: 6px; font-size: 0.78rem; }
        .me-timeline li.is-off { color: var(--lt-muted); }
        .me-timeline li.is-off::before { background: transparent; border: 1px solid var(--lt-muted); }
        .me-preview-foot { padding: var(--sp-4) var(--sp-5) var(--sp-5); border-top: 1px solid var(--lt-rule-strong); }
        .me-warn { font-family: var(--font-ui); font-size: 0.82rem; color: #F5C860; margin: 0 0 var(--sp-2); }

        /* ---- Membership ---- */
        .me-member-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5); align-items: start; }
        .me-card { border: 1px solid var(--lt-rule-strong); border-radius: 16px; background: var(--lt-panel); padding: var(--sp-5); min-width: 0; }
        .me-card h3 { font-family: var(--lt-head); font-size: 1.2rem; margin: 0 0 var(--sp-3); color: var(--nn-white); }
        .me-card ul { margin: 0 0 var(--sp-3) 1.1rem; padding: 0; font-family: var(--font-ui); font-size: 0.88rem; line-height: 1.55; }
        .me-perk { display: flex; justify-content: space-between; gap: 1rem; padding: 9px 0; border-bottom: 1px solid var(--lt-rule); font-family: var(--font-ui); font-size: 0.88rem; }
        .me-perk:last-child { border-bottom: 0; }
        .me-perk a { color: var(--lt-cyan); font-weight: 600; }
        .me-pnn { border-color: color-mix(in srgb, var(--lt-cyan) 45%, transparent); }
        .me-lib { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--sp-4); margin-top: var(--sp-3); }
        .me-book { border: 1px solid var(--lt-rule); border-radius: 12px; overflow: hidden; background: rgba(0,0,0,0.2); display: flex; flex-direction: column; }
        .me-book img { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; display: block; background: #0d151a; }
        .me-book .b { padding: 0.6rem 0.65rem 0.7rem; display: flex; flex-direction: column; gap: 0.25rem; flex: 1; font-family: var(--font-ui); }
        .me-book .t { font-weight: 700; font-size: 0.82rem; line-height: 1.25; color: var(--nn-white); }
        .me-book .s { font-size: 0.72rem; color: var(--lt-muted); line-height: 1.3; }
        .me-book .a { margin-top: auto; padding-top: 0.35rem; font-size: 0.76rem; color: var(--lt-muted); }
        .me-book .a .lt-btn { font-size: 0.78rem; padding: 0.4rem 0.8rem; width: 100%; justify-content: center; }
        .me-road { list-style: none; margin: 0; padding: 0; }
        .me-road li { display: grid; grid-template-columns: 26px 1fr; gap: 6px; padding: 5px 0; font-family: var(--font-ui); font-size: 0.86rem; color: var(--lt-ink); }
        .me-road details summary { font-family: var(--font-ui); font-size: 0.84rem; font-weight: 700; color: var(--lt-cyan); cursor: pointer; margin-top: var(--sp-2); }

        /* ---- Signed out ---- */
        .me-guest-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--sp-6); align-items: start; }
        .me-signin form { display: flex; flex-wrap: wrap; gap: 8px; }
        .me-signin .me-input { flex: 1 1 240px; }

        /* ---- Save bar (fixed to the bottom, above the site player, assets/js/nn-player.js) ---- */
        .nn-savebar { position: fixed; left: 0; right: 0; bottom: calc(var(--nn-player-h, 0px) + var(--nn-tabbar-h, 0px)); z-index: 901; background: #141A2E; border-top: 1px solid var(--lt-rule-strong);
            box-shadow: 0 -6px 24px rgba(0,0,0,0.35); padding: 0.65rem var(--sp-6); display: flex; gap: 0.8rem; align-items: center; justify-content: center; flex-wrap: wrap; font-family: var(--font-ui); font-size: 0.9rem; }

        @media (max-width: 1100px) {
            .me-member-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .me-studio-grid { grid-template-columns: minmax(0, 1fr) 320px; }
        }
        @media (max-width: 900px) {
            .me-mast-row, .me-guest-grid, .me-upsell-grid, .me-ed-cols, .me-studio-grid { grid-template-columns: minmax(0, 1fr); }
            .me-mast-actions { justify-content: flex-start; }
            .me-preview { position: static; }
            .me-timeline { max-height: none; }
            .me-catchup { grid-template-columns: minmax(0, 1fr); }
        }
        @media (max-width: 640px) {
            .me-member-grid { grid-template-columns: minmax(0, 1fr); }
            .me-whoami { margin-left: 0; flex-basis: 100%; }
            .me-panel { padding: var(--sp-4); }
            .me-edition .lt-edition-inner { display: block; padding: var(--sp-4); }
            .me-edition .lt-edition-cover { float: left; margin: 0 var(--sp-3) var(--sp-2) 0; }
            .me-edition .lt-edition-cover img { width: 72px; height: 72px; border-radius: 8px; }
            .me-ed-actions, .me-build, .me-ed-cols, .me-upsell-grid { clear: both; }
            .me-ed-list li:nth-child(n+4) { display: none; }
            .me-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-3); width: 100%; }
            .me-stats dt { font-size: 0.6rem; letter-spacing: 0.06em; }
            .me-order li { grid-template-columns: 22px 36px minmax(0, 1fr) auto; }
            .me-order .me-handle { display: none; }
            .me-stats dd { font-size: 1.5rem; }
            .me-topics-empty { grid-template-columns: minmax(0, 1fr); }
            .nn-savebar { padding: 0.5rem var(--sp-4); flex-wrap: nowrap; gap: 0.5rem; }
            .nn-savebar .me-long { display: none; }
        }
        @media (prefers-reduced-motion: reduce) {
            .me-build .dot.busy { animation: none; }
            .me-sw, .me-sw::after, .me-input { transition: none; }
        }
    </style>
{% endblock %}

{% block content %}
<div class="lt-page nn-me" id="nn-me">
<div class="container">
    <p id="nn-status" class="me-status" role="status">Loading your Nerra…</p>

    <!-- ============ Signed out ============ -->
    <div id="nn-guest" hidden>
        <header class="me-mast">
            <div class="lt-masthead-meta"><span class="lt-dateline" id="nn-guest-date"></span><span>Nerra Personal</span></div>
            <h1 class="me-title">Sign in to your Nerra account</h1>
            <p class="lt-standfirst">Your own front page: today's episodes from the shows you
               pick, in your order, the stories on your topics and places, and your private
               daily edition. One email, no passwords.</p>
        </header>
        <div class="me-guest-grid">
            <div class="me-card me-signin" id="nn-signin">
                <h3>Sign in</h3>
                {#- Oct 28 2026: shown when this browser holds a cookie from a
                    signup form, not from an emailed link — the Worker no longer
                    opens a member record to that (personal.ts mayUseRecord). -#}
                <p class="me-p" id="nn-verify-note" hidden>To keep your account private, it
                   opens only from a link we email you. Send one to the address below and
                   open it on this device.</p>
                <p class="me-p" id="nn-signin-lede">Enter the email you joined with and we'll
                   send you a sign-in link.</p>
                <form onsubmit="NN.login(this);return false;">
                    <label for="nn-account-email" class="sr-only">Email address</label>
                    <input type="email" id="nn-account-email" name="email" class="me-input" placeholder="you@example.com" required autocomplete="email">
                    <button type="submit" class="lt-btn me-btn-grad">Email me a link</button>
                </form>
                {#- Oct 29 2026: the installed app keeps its own cookies, and an
                    emailed link opens in the browser (on iPhone always Safari),
                    so the email also carries a six-digit code to type here. -#}
                <form class="me-code" id="nn-code-form" hidden onsubmit="NN.loginCode(this);return false;">
                    <label for="nn-login-code" class="me-label">Got the email? Type its six-digit code</label>
                    <div class="me-code-row">
                        <input type="text" id="nn-login-code" name="code" class="me-input" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7" autocomplete="one-time-code" placeholder="123 456" required>
                        <button type="submit" class="lt-btn">Sign in</button>
                    </div>
                    <p class="me-fine" id="nn-code-status" role="status">The code works on this screen, including the Nerra app on your Home Screen.</p>
                </form>
                <p class="me-fine">New here? Your email has no account yet: <a href="{{ path_prefix }}join.html#join-free">create one free</a>
                   · <a href="{{ path_prefix }}login.html">Full sign-in page</a></p>
            </div>
            <div class="me-card">
                <h3>What your account does</h3>
                <ul class="me-road">
                    <li><span>📰</span><span>A front page of your shows, in your order, with one button to play them all</span></li>
                    <li><span>🔎</span><span>The stories on your topics and your city, from every Nerra show</span></li>
                    <li><span>🎙️</span><span>On Personal: one private edition a day, anchored by Mira, your city's news first</span></li>
                    <li><span>🖼️</span><span>Full-resolution gallery downloads and the newsletter</span></li>
                </ul>
            </div>
        </div>
        <section class="lt-block" id="nn-guest-front" hidden aria-labelledby="nn-guest-front-h">
            <div class="lt-block-head"><h2 id="nn-guest-front-h">Today on Nerra</h2><a href="{{ path_prefix }}join.html">Make a front page of your own →</a></div>
            <div class="lt-grid-4" id="nn-guest-stories"></div>
        </section>
    </div>

    <!-- ============ Signed in ============ -->
    <div id="nn-member" hidden>
        <header class="me-mast">
            <div class="lt-masthead-meta">
                <span class="lt-dateline" id="nn-date"></span>
                <span>My Nerra</span>
                <span id="nn-tier-badge" class="me-tier" hidden></span>
                <span class="me-whoami">Signed in as <span id="nn-email"></span> · <button type="button" class="me-link" onclick="NN.logout()">Sign out</button></span>
            </div>
            <div class="me-mast-row">
                <div>
                    <h1 class="me-title" id="nn-greeting">Welcome back</h1>
                    <p class="lt-standfirst" id="nn-hero-sub"></p>
                </div>
                <div class="me-mast-actions">
                    <button type="button" class="lt-btn me-btn-grad" id="nn-play-all" hidden onclick="NN.playLineup()"><span aria-hidden="true">▶</span> Play today's lineup <span class="me-len" id="nn-play-all-len"></span></button>
                    <button type="button" class="lt-btn" id="nn-watch-all" hidden onclick="NN.watchLineup()"><span aria-hidden="true">▶</span> Watch my lineup <span class="me-len" id="nn-watch-all-n"></span></button>
                    <a class="lt-btn" href="#customize">Customize</a>
                </div>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:var(--sp-4);align-items:end;">
                <dl class="me-stats" id="nn-today-stats" hidden>
                    <div><dt>New today</dt><dd id="nn-stat-count">–</dd></div>
                    <div><dt>Minutes</dt><dd id="nn-stat-mins">–</dd></div>
                    <div><dt>Your shows</dt><dd id="nn-stat-shows">–</dd></div>
                    <div><dt>Followed</dt><dd id="nn-stat-topics">–</dd></div>
                </dl>
                <div class="me-quotes" id="nn-mkt-card" hidden><span id="nn-mkt"></span><small id="nn-mkt-asof"></small></div>
            </div>
        </header>

        <!-- Your edition -->
        <section class="lt-edition me-edition" id="nn-edition" aria-labelledby="nn-ed-h">
            <div class="lt-edition-inner">
                <div class="lt-edition-cover"><img id="nn-ed-cover" src="{{ path_prefix }}assets/covers/nerra-daily.jpg" alt="" width="168" height="168" loading="lazy"></div>
                <div>
                    <div id="nn-feed-active" hidden>
                        <p class="lt-edition-label">Your edition</p>
                        <h2 class="lt-hl" id="nn-ed-h">Your edition</h2>
                        <div class="me-build" id="nn-build" hidden>
                            <span class="dot" id="nn-build-dot"></span>
                            <span><span id="nn-build-txt">Today's edition</span><small id="nn-build-sub"></small></span>
                        </div>
                        <div class="me-ed-actions">
                            <button type="button" class="lt-btn me-btn-grad" id="nn-ed-play" hidden onclick="NN.playEdition(0)"><span aria-hidden="true">▶</span> Play your edition <span class="me-len" id="nn-ed-len"></span></button>
                            <button type="button" class="lt-btn" id="nn-build-btn" hidden onclick="NN.rebuild()">Build my edition now</button>
                            <button type="button" class="lt-btn" id="nn-portal-btn" hidden onclick="NN.portal()">Manage plan &amp; billing</button>
                        </div>
                        <p class="me-fine" id="nn-ends-note" hidden></p>
                        <p class="me-fine" id="nn-feed-note" hidden>Just subscribed? Your first edition
                           lands with the next morning build, and the feed works from then on.</p>
                        <p class="me-fine" id="nn-starter-note" hidden>You haven't picked your shows
                           yet, so Mira is using the <strong>starter lineup</strong> (SpaceX, Tesla,
                           Models &amp; Agents, Planetterrian, DP Pod). Pick two or more below and save,
                           then rebuild today's edition to hear it right away.</p>
                        <div class="me-ed-cols">
                            <div id="nn-editions" hidden>
                                <p class="lt-sublabel">Recent editions</p>
                                <ul class="me-ed-list" id="nn-editions-list"></ul>
                            </div>
                            <div>
                                <p class="lt-sublabel">Listen in your podcast app</p>
                                <p class="me-feedurl" id="nn-feed-url"></p>
                                <div class="me-ed-actions">
                                <button type="button" class="lt-btn" id="nn-copy-feed" onclick="NN.copyFeed()">Copy feed URL</button>
                                {#- Oct 28 2026: one tap into the app a member already uses —
                                    each app's own subscribe link for this feed (filled in by
                                    load(); the copy button stays the fallback). -#}
                                <a class="lt-btn me-btn-grad" id="nn-add-page" href="{{ path_prefix }}add.html">Add to my podcast app</a>
                                </div>
                                <p class="me-fine">One tap for the apps on this device; on a computer it shows a code to scan with your phone.</p>
                                <p class="me-apps" id="nn-addapp" aria-label="Add to a podcast app">
                                    <span class="me-muted">Add to</span>
                                    <a id="nn-add-apple" href="#" rel="nofollow">Apple Podcasts</a>
                                    <a id="nn-add-overcast" href="#" rel="nofollow">Overcast</a>
                                    <a id="nn-add-pocketcasts" href="#" rel="nofollow">Pocket Casts</a>
                                    <a id="nn-add-castro" href="#" rel="nofollow">Castro</a>
                                </p>
                                <p class="me-fine">The feed is yours alone; sharing the URL shares your subscription.</p>
                            </div>
                        </div>
                    </div>

                    <div id="nn-feed-cancelled" hidden>
                        <p class="lt-edition-label">Your edition is paused</p>
                        <h2 class="lt-hl">Pick up where you left off</h2>
                        <p class="lt-edition-note">Your subscription has ended and the private feed is
                           off. Your lineup and settings are saved: restart any time and tomorrow's
                           edition picks up from them.</p>
                        {% if stripe_personal_url and stripe_personal_url != '#' %}
                        <div class="me-ed-actions">
                            <a href="{{ stripe_personal_url }}" data-nn-tier="personal" data-checkout class="lt-btn me-btn-grad">Restart Personal · $4.99/mo</a>
                            {% if stripe_personal_local_url and stripe_personal_local_url != '#' %}
                            <a href="{{ stripe_personal_local_url }}" data-nn-tier="personal_local" data-checkout class="lt-btn">Personal News Network · $8.99/mo</a>
                            {% endif %}
                        </div>
                        {% endif %}
                    </div>

                    <div id="nn-feed-upsell" hidden>
                        <p class="lt-edition-label">Nerra Personal</p>
                        <h2 class="lt-hl">Your shows as one morning edition, with your city first</h2>
                        <div class="me-upsell-grid">
                            <div>
                                <p class="lt-edition-note">Mira joins the shows below into one private
                                   episode in your order, opens with your city's weather and news, greets
                                   you by name, and leaves out a story you already heard. It lands in your
                                   podcast app every morning.</p>
                                {% if stripe_personal_url and stripe_personal_url != '#' %}
                                <div class="me-ed-actions me-cta-stack">
                                    <a href="{{ stripe_personal_url }}" data-nn-tier="personal" data-checkout class="lt-btn me-btn-grad">{% if trial_days %}Start {{ trial_days }} days free · then $4.99/mo{% else %}Personal · $4.99/mo{% endif %}</a>
                                    {% if stripe_personal_local_url and stripe_personal_local_url != '#' %}
                                    <a href="{{ stripe_personal_local_url }}" data-nn-tier="personal_local" data-checkout class="lt-btn">Personal News Network · $8.99/mo</a>
                                    {% endif %}
                                </div>
                                <p class="me-fine">Your purchase attaches to this account, whichever card or
                                   wallet you pay with. Cancel any time; the feed runs to the end of the
                                   period you paid for.</p>
                                {% else %}
                                <p class="me-fine">Personal feeds are launching soon. Your saved lineup will be ready on day one.</p>
                                {% endif %}
                            </div>
                            {% if sample_url %}
                            <div class="me-sample">
                                <p class="lt-sublabel">Hear a sample edition</p>
                                <button type="button" class="lt-btn" data-nn-sample="account" onclick="NN.playSample()"><span aria-hidden="true">▶</span> Play the five-minute sample</button>
                                <p class="me-fine">A real edition for a Vancouver listener: Mira's welcome, the city brief, then the shows.</p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Your front page -->
        {#- Oct 29 2026: My Nerra on the Home Screen. Each card shows only
            where it applies (assets/js/nn-app.js); inside the app none does. -#}
