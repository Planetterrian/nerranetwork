{#- Oct 28 2026 (later): the page's own player became the site's one
    player (assets/js/nn-player.js, loaded by base.html.j2), so a story
    started here keeps its place on every other page. -#}
<script>
var NN = (function () {
  var API = 'https://api.nerranetwork.com';
  var FRONT_URL = '{{ path_prefix }}api/personal_front.json';
  var SAMPLE_URL = {{ sample_url | tojson }};
  var state = { shows: [], all: [], addons: null, addonsTouched: false, tier: 'none', active: false,
                status: 'none', front: null, editions: [], feedUrl: '', tickers: null, quotes: {} };
  var SHOW_META = {{ personal_shows | tojson }};
  var META = {}; SHOW_META.forEach(function (s) { META[s.slug] = s; });
  var STARTER = ['spacex', 'tesla', 'models_agents', 'planetterrian', 'dp_pod'];
  var ADDONS = {{ personal_addons | tojson }};
  var DEFAULT_ADDONS = {{ default_addons | tojson }};
  var LENGTHS = {{ target_minutes_options | tojson }};
  var WEEKDAYS = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];

  function el(id) { return document.getElementById(id); }
  // The same events, with the same parameters, as assets/js/tracking.js
  // sends for an <audio> element (this page plays through one detached
  // Audio object, which tracking.js never sees).
  function track(name, params) {
    try {
      if (typeof window.gtag === 'function') { window.gtag('event', name, params || {}); }
      if (typeof window.plausible === 'function') { window.plausible(name, { props: params || {} }); }
    } catch (e) {}
  }
  function esc(s) { var d = document.createElement('span'); d.textContent = s == null ? '' : String(s); return d.innerHTML.replace(/"/g, '&quot;'); }
  // Only our own kinds of URL reach an attribute: https, or a site-relative path.
  function safeUrl(u) {
    u = String(u || '');
    if (/^https:\/\//i.test(u)) { return u; }
    return /^[A-Za-z0-9_\-./#]+$/.test(u) && u.indexOf('//') !== 0 ? u : '';
  }
  function store(key, val) {
    try {
      if (val === undefined) { return JSON.parse(localStorage.getItem(key) || 'null'); }
      localStorage.setItem(key, JSON.stringify(val));
    } catch (e) { return null; }
    return val;
  }
  function easternDay(d) {
    try {
      return new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).format(d || new Date());
    } catch (e) { return (d || new Date()).toISOString().slice(0, 10); }
  }
  function mins(seconds) { return Math.max(1, Math.round((seconds || 0) / 60)); }
  function clock(s) {
    s = Math.max(0, Math.floor(s || 0));
    var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
    return (h ? h + ':' + (m < 10 ? '0' : '') : '') + m + ':' + (sec < 10 ? '0' : '') + sec;
  }
  function ago(iso) {
    var t = Date.parse(iso || ''); if (!t) { return ''; }
    var m = Math.round((Date.now() - t) / 60000);
    if (m < 1) { return 'just now'; }
    if (m < 60) { return m + ' min ago'; }
    var h = Math.round(m / 60);
    if (h < 24) { return h + (h === 1 ? ' hour ago' : ' hours ago'); }
    return '';
  }

  // ------------------------------------------------------------- show data
  function lineup() { return state.shows.length >= 2 ? state.shows : STARTER; }
  function showEntry(slug) { return (state.front && state.front.shows && state.front.shows[slug]) || null; }
  function showName(slug) { var e = showEntry(slug); return (e && e.name) || (META[slug] && META[slug].name) || slug; }
  function showColor(slug) { var e = showEntry(slug); return (e && e.brand_color) || (META[slug] && META[slug].brand_color) || '#6B47FF'; }
  function coverSrc(slug) { var e = showEntry(slug) || {}; var m = META[slug] || {}; return safeUrl(e.cover_webp || m.cover_webp || e.cover_url || m.cover || ''); }
  function stories(slug) { var e = showEntry(slug); return (e && e.stories) || []; }
  function isToday(story) { return story && story.stamp && story.stamp.day === easternDay(); }
  function typicalSeconds(slug) {
    var d = stories(slug).map(function (s) { return s.duration_s; }).filter(Boolean).sort(function (a, b) { return a - b; });
    return d.length ? d[Math.floor(d.length / 2)] : 0;
  }
  // "Daily" / "Monday" / "Weekdays" — does this show publish on that weekday?
  function runsOn(slug, weekday) {
    var sched = String(((showEntry(slug) || {}).schedule) || (META[slug] && META[slug].schedule) || '').toLowerCase();
    if (!sched || /daily|every day|seven days/.test(sched)) { return true; }
    if (/weekday/.test(sched)) { return weekday >= 1 && weekday <= 5; }
    var named = WEEKDAYS.filter(function (d) { return sched.indexOf(d) !== -1; });
    if (!named.length) { return true; }
    return named.indexOf(WEEKDAYS[weekday]) !== -1;
  }

  // ------------------------------------------------------------- story markup
  function storyHref(s) { return safeUrl(s.post_url) || safeUrl(s.show_page) || '#'; }
  function media(s, eager) {
    var href = esc(storyHref(s));
    if (s.image_url && safeUrl(s.image_url)) {
      return '<a href="' + href + '" class="lt-media' + (s.image_orientation === 'portrait' ? ' is-portrait' : '') + '" tabindex="-1" aria-hidden="true">'
        + '<img src="' + esc(safeUrl(s.image_url)) + '" alt="" width="800" height="450" ' + (eager ? 'fetchpriority="high"' : 'loading="lazy"') + ' decoding="async"></a>';
    }
    return '<a href="' + href + '" class="lt-media is-cover" tabindex="-1" aria-hidden="true">'
      + '<img src="' + esc(coverSrc(s.slug)) + '" alt="" width="400" height="400" loading="lazy" decoding="async"></a>';
