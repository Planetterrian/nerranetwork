  }
  // Watch my lineup (Oct 28 2026): the newest episode with a public video
  // from each of the member's shows, in their order; the full episode when
  // there is one, else its Short. Played by the site player's video dialog.
  function lineupVideos() {
    var out = [];
    lineup().forEach(function (slug) {
      var e = showEntry(slug);
      if (!e || e.members_only) { return; }
      var s = stories(slug).filter(function (x) { return videoOf(x); })[0];
      if (!s) { return; }
      var v = videoOf(s);
      out.push({ url: v.url, kind: v.kind, title: s.hook, show: showName(slug), post: storyHref(s) });
    });
    return out;
  }
  function renderWatch(shows) {
    var box = el('nn-watch');
    if (!box) { return; }
    var rows = [];
    shows.forEach(function (slug) {
      stories(slug).forEach(function (s) {
        var v = s.videos || {};
        if (safeUrl(v.short)) { rows.push({ s: s, v: { url: v.short, kind: 'short' } }); }
        if (safeUrl(v.long)) { rows.push({ s: s, v: { url: v.long, kind: 'long' } }); }
      });
    });
    rows.sort(function (a, b) { return String((b.s.stamp || {}).iso || b.s.date_raw).localeCompare(String((a.s.stamp || {}).iso || a.s.date_raw)); });
    rows = rows.slice(0, 16);
    el('nn-watch-block').hidden = !rows.length;
    var n = lineupVideos().length;
    el('nn-watch-all').hidden = !n;
    el('nn-watch-all-n').textContent = n ? '· ' + n + (n === 1 ? ' video' : ' videos') : '';
    box.innerHTML = rows.map(function (r) {
      var img = safeUrl(r.s.image_url) || coverSrc(r.s.slug);
      return '<a class="me-vid' + (r.v.kind === 'short' ? ' is-short' : '') + '" style="--show-color:' + esc(showColor(r.s.slug)) + ';"' + watchAttrs(r.s, r.v) + '>'
        + (img ? '<img src="' + esc(img) + '" alt="" loading="lazy">' : '')
        + '<span class="me-vid-play">▶ ' + (r.v.kind === 'short' ? 'Short' : 'Video') + '</span>'
        + '<span class="me-vid-txt"><b>' + esc(showName(r.s.slug)) + '</b><span>' + esc(r.s.hook) + '</span></span></a>';
    }).join('');
  }
  function card(s) {
    return '<article class="lt-card" style="--show-color:' + esc(showColor(s.slug)) + ';">' + media(s, false)
      + '<div class="lt-card-body">' + kicker(s, false) + hl(s, 'h3') + meta(s) + '</div></article>';
  }
  function lockedCard(slug) {
    var active = state.active;
    return '<article class="me-locked" style="--show-color:' + esc(showColor(slug)) + ';">'
      + '<img src="' + esc(coverSrc(slug)) + '" alt="" width="64" height="64" loading="lazy">'
      + '<div><p class="lt-kicker"><span class="me-card-tag">Members only</span> ' + esc(showName(slug)) + '</p>'
      + '<p class="me-p" style="margin:0;">' + (active ? 'This desk publishes only inside Personal: its latest episode is in your edition.'
          : 'This desk publishes only inside Nerra Personal. Start your edition to hear it.') + '</p></div></article>';
  }

  // ------------------------------------------------------------- front page
  function renderFront() {
    var box = el('nn-today');
    if (!box || !state.front) { return; }
    var shows = lineup();
    var note = el('nn-front-note');
    note.hidden = state.shows.length >= 2;
    note.textContent = 'Showing the starter lineup. Pick your own shows under Make it yours and this page follows them.';
    var latest = [], locked = [];
    shows.forEach(function (slug) {
      var e = showEntry(slug);
      if (e && e.members_only) { locked.push(slug); return; }
      var s = stories(slug)[0];
      if (s) { latest.push(s); }
    });
    var todays = latest.filter(isToday);
    var lead = todays[0] || latest[0];
    if (!lead && !locked.length) {
      box.innerHTML = '<p class="me-empty">No episodes from your shows yet. Add a couple more under Make it yours.</p>';
      renderStats([], shows);
      return;
    }
    var html = '';
    if (lead) {
      var more = (lead.headlines || []).slice(0, 3);
      html += '<div class="lt-top"><article class="lt-lead" style="--show-color:' + esc(showColor(lead.slug)) + ';">'
        + '<div class="lt-lead-head">' + kicker(lead, true) + hl(lead, 'h3') + '</div>'
        + media(lead, true)
        + '<div class="lt-lead-body">'
        + (more.length ? '<p class="lt-more-label">Also in this episode</p><ul class="lt-more">'
            + more.map(function (h) { return '<li>' + esc(h) + '</li>'; }).join('') + '</ul>' : '')
        + meta(lead) + '</div></article>';
      var rail = latest.filter(function (s) { return s !== lead; })
        .sort(function (a, b) { return String((b.stamp || {}).iso || b.date_raw).localeCompare(String((a.stamp || {}).iso || a.date_raw)); });
      html += '<aside class="lt-latest" aria-labelledby="nn-latest-h"><h3 class="lt-rail-h" id="nn-latest-h">Latest from your shows</h3><ol>'
        + (rail.length ? rail.slice(0, 8).map(function (s) {
            return '<li style="--show-color:' + esc(showColor(s.slug)) + ';"><p class="lt-kicker"><a href="' + esc(safeUrl(s.show_page) || '#') + '">'
              + esc(showName(s.slug)) + '</a> <span class="lt-rail-when">' + whenHtml(s) + '</span></p>' + hl(s, 'h4')
              + '<div style="margin-top:6px;">' + playBtn(s, false) + '</div></li>';
          }).join('') : '<li><p class="me-p me-muted" style="margin:0;">Add more shows to fill this column.</p></li>')
        + '</ol></aside></div>';
      var rest = latest.filter(function (s) { return s !== lead; });
      if (rest.length) {
        html += '<div class="lt-grid-4 me-front-grid">' + rest.map(card).join('') + '</div>';
      }
    }
    if (locked.length) {
      html += '<div class="lt-grid-4 me-front-grid">' + locked.map(lockedCard).join('') + '</div>';
    }
    box.innerHTML = html;
    renderStats(todays, shows);
    renderWatch(shows);
    renderCatchup(shows);
  }
  function renderStats(todays, shows) {
    var total = todays.reduce(function (n, s) { return n + (s.duration_s || 0); }, 0);
    el('nn-stat-count').textContent = String(todays.length);
    el('nn-stat-mins').textContent = total ? String(mins(total)) : '–';
    el('nn-stat-shows').textContent = String(shows.length);
    el('nn-stat-topics').textContent = String(listValues(topicInputs()).length + listValues(cityInputs()).length);
    el('nn-today-stats').hidden = false;
    var playable = todays.filter(function (s) { return safeUrl(s.audio_url); });
    el('nn-play-all').hidden = !playable.length;
    el('nn-play-all-len').textContent = total ? '· ' + mins(total) + ' min' : '';
    state.todays = playable;
    renderHeroSub(todays, total, shows);
  }
  function renderHeroSub(todays, total, shows) {
    var n = todays.length, sub;
    var count = n ? n + ' new episode' + (n === 1 ? '' : 's') + ' from your shows today' + (total ? ', ' + mins(total) + ' minutes in all' : '') + '.'
      : 'No new episodes from your shows yet today; the latest from each is below.';
    if (state.active) {
      var t = state.today || {};
      var built = t.built_at ? new Date(t.built_at) : null;
      sub = (t.building ? 'Mira is building your edition now. '
             : built ? 'Your edition was built at ' + built.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) + '. '
             : 'Your edition builds each morning. ') + count;
    } else if (state.status === 'cancelled') {
      sub = count + ' Your lineup is saved for when you restart your edition.';
    } else {
      sub = count + ' Play them here in your order, or let Mira join them into one edition with your city first.';
    }
    el('nn-hero-sub').textContent = sub;
  }
  function renderCatchup(shows) {
    var rows = [];
    shows.forEach(function (slug) {
      stories(slug).slice(1).forEach(function (s) { if (!isPlayed(s.audio_url)) { rows.push(s); } });
    });
    rows.sort(function (a, b) { return String((b.stamp || {}).iso || b.date_raw).localeCompare(String((a.stamp || {}).iso || a.date_raw)); });
    rows = rows.slice(0, 8);
    el('nn-catchup-block').hidden = !rows.length;
    el('nn-catchup').innerHTML = rows.map(function (s) {
      return '<li style="--show-color:' + esc(showColor(s.slug)) + ';">'
        + '<img src="' + esc(safeUrl(s.image_url) || coverSrc(s.slug)) + '" alt="" width="56" height="56" loading="lazy">'
        + '<div>' + '<p class="lt-kicker">' + esc(showName(s.slug)) + ' <span class="lt-rail-when">' + whenHtml(s) + '</span></p>' + hl(s, 'h3') + '</div>'
        + playBtn(s, true) + '</li>';
    }).join('');
  }

  // ------------------------------------------------------------- topics and places
  var STOP = {};
  ('the a an and or of in on for to with at by from into over about new news is are its it as '
   + 'this that be vs via up out after before more than how why what who').split(' ').forEach(function (w) { STOP[w] = 1; });
  function words(t) {
    var s = String(t || '').toLowerCase();
    try { s = s.normalize('NFD').replace(/[̀-ͯ]/g, ''); } catch (e) {}
    return s.match(/[a-z0-9]+/g) || [];
  }
  function stem(w) { return w.length > 3 && /s$/.test(w) && !/ss$/.test(w) ? w.slice(0, -1) : w; }
  function keysOf(topic) { return words(topic).filter(function (w) { return !STOP[w] && (w.length > 1 || /\d/.test(w)); }).map(stem); }
  function hits(keys, text) {
    var ws = words(text).map(stem);
    var found = keys.filter(function (k) {
      return ws.some(function (w) { return w === k || (k.length >= 4 && w.indexOf(k) === 0); });
    });
    var need = keys.length <= 2 ? keys.length : keys.length - 1;
    return keys.length && found.length >= need;
  }
  function highlight(text, keys) {
    var out = '', re = /[A-Za-z0-9À-ɏ]+|[^A-Za-z0-9À-ɏ]+/g, m;
    while ((m = re.exec(String(text))) !== null) {
      var tok = m[0], ws = words(tok);
      var on = ws.length === 1 && keys.some(function (k) { var w = stem(ws[0]); return w === k || (k.length >= 4 && w.indexOf(k) === 0); });
      out += on ? '<mark>' + esc(tok) + '</mark>' : esc(tok);
    }
    return out;
  }
  function renderTopics() {
    var box = el('nn-topic-results');
    if (!box) { return; }
    var cities = listValues(cityInputs()).map(function (c) { return { label: c.split(',')[0].trim(), kind: 'place' }; });
    var topics = listValues(topicInputs()).map(function (t) { return { label: t, kind: 'topic' }; });
    var all = cities.concat(topics).filter(function (x) { return keysOf(x.label).length; });
    if (!all.length) {
      box.innerHTML = '<div class="me-topics-empty"><div><p class="me-p" style="margin:0 0 4px;"><strong>Follow a city and up to five topics.</strong></p>'
        + '<p class="me-help">This page pulls the stories on them from every Nerra show, not only yours. On Personal News Network, Mira also researches each one for your edition.</p></div>'
        + '<a class="lt-btn" href="#nn-places">Add topics</a></div>';
      return;
    }
    if (!state.front) { box.innerHTML = ''; return; }
    var pool = [];
    Object.keys(state.front.shows || {}).forEach(function (slug) {
      stories(slug).forEach(function (s) {
        pool.push({ s: s, text: s.hook, primary: true });
        (s.headlines || []).forEach(function (h) { pool.push({ s: s, text: h, primary: false }); });
      });
    });
    var mine = lineup();
    box.innerHTML = '<div class="me-topics">' + all.map(function (t) {
      var keys = keysOf(t.label), seen = {}, rows = [], offered = {};
      pool.forEach(function (p) {
        var k = p.s.slug + '|' + p.s.episode_num + '|' + p.text;
        if (seen[k] || !hits(keys, p.text)) { return; }
        seen[k] = 1; rows.push(p);
      });
      rows.sort(function (a, b) { return String((b.s.stamp || {}).iso || b.s.date_raw).localeCompare(String((a.s.stamp || {}).iso || a.s.date_raw)); });
      rows = rows.slice(0, 5);
      var list = rows.length ? rows.map(function (p) {
        var s = p.s, inLineup = mine.indexOf(s.slug) !== -1;
        // One "+ Add" per show per topic, on its newest story.
        var canAdd = !inLineup && META[s.slug] && !offered[s.slug];
        if (canAdd) { offered[s.slug] = 1; }
        return '<li style="--show-color:' + esc(showColor(s.slug)) + ';"><p class="lt-kicker"><a href="' + esc(safeUrl(s.show_page) || '#') + '">' + esc(showName(s.slug)) + '</a>'
          + ' <span class="lt-rail-when">' + whenHtml(s) + '</span>'
          + (canAdd ? ' <button type="button" class="me-add-show" data-add-show="' + esc(s.slug) + '">+ Add to my shows</button>' : '') + '</p>'
          + '<h4 class="lt-hl"><a href="' + esc(storyHref(s)) + '">' + highlight(p.text, keys) + '</a></h4>'
          + '<div style="margin-top:6px;">' + playBtn(s, false) + '</div></li>';
      }).join('') : '<li class="none">Nothing on this in the last few days of episodes.</li>';
      return '<div class="me-topic"><h3>' + esc(t.label) + ' <span>' + (t.kind === 'place' ? 'your place' : 'your topic') + '</span></h3><ul>' + list + '</ul></div>';
    }).join('') + '</div>';
  }

  // ------------------------------------------------------------- lineup editor
  var dragFrom = -1;
  function moveShow(from, to) {
    if (to < 0 || to >= state.shows.length || from === to) { return; }
    var slug = state.shows.splice(from, 1)[0];
    state.shows.splice(to, 0, slug);
    changed();
  }
  function addShow(slug) {
    if (state.shows.indexOf(slug) === -1 && state.all.indexOf(slug) !== -1) { state.shows.push(slug); changed(); }
  }
  function removeShow(slug) { state.shows = state.shows.filter(function (s) { return s !== slug; }); changed(); }
  function subLine(slug) {
    var t = typicalSeconds(slug), sch = (showEntry(slug) || {}).schedule || (META[slug] && META[slug].schedule) || '';
    return [sch, t ? 'about ' + mins(t) + ' min' : ''].filter(Boolean).join(' · ');
  }
  function renderLineup() {
    var box = el('nn-lineup');
    box.innerHTML = '';
    state.shows.forEach(function (slug, idx) {
      var li = document.createElement('li');
      li.style.setProperty('--show-color', showColor(slug));
      li.draggable = true;
      li.innerHTML = '<span class="me-handle" aria-hidden="true">⋮⋮</span><span class="me-pos">' + (idx + 1) + '</span>'
        + '<img src="' + esc(coverSrc(slug)) + '" alt="" width="44" height="44" loading="lazy">'
        + '<span class="txt"><span class="nm">' + esc(showName(slug)) + '</span><span class="sub">' + esc(subLine(slug)) + '</span></span>'
        + '<span class="me-movers">'
        + '<button type="button" class="me-icon-btn" data-move="-1"' + (idx === 0 ? ' disabled' : '') + ' aria-label="Move ' + esc(showName(slug)) + ' up">↑</button>'
        + '<button type="button" class="me-icon-btn" data-move="1"' + (idx === state.shows.length - 1 ? ' disabled' : '') + ' aria-label="Move ' + esc(showName(slug)) + ' down">↓</button>'
        + '<button type="button" class="me-icon-btn" data-remove="1" aria-label="Remove ' + esc(showName(slug)) + '">✕</button></span>';
      li.querySelectorAll('[data-move]').forEach(function (b) {
        b.onclick = function () {
          var dir = Number(b.getAttribute('data-move'));
          moveShow(idx, idx + dir);
          // The list is rebuilt: keep keyboard focus on the moved show and
          // say where it went (Oct 29 2026).
          var at = state.shows.indexOf(slug);
          var row = el('nn-lineup').children[at];
          var again = row && (row.querySelector('[data-move="' + dir + '"]:not([disabled])') || row.querySelector('[data-move]:not([disabled])'));
          if (again) { again.focus(); }
          el('nn-lineup-live').textContent = showName(slug) + ' moved to ' + (at + 1) + ' of ' + state.shows.length + '.';
        };
      });
      li.querySelector('[data-remove]').onclick = function () {
        removeShow(slug);
        el('nn-lineup-live').textContent = showName(slug) + ' removed.';
        var next = el('nn-lineup').querySelector('[data-remove]') || el('nn-show-search');
        if (next) { next.focus(); }
      };
      li.addEventListener('dragstart', function (ev) { dragFrom = idx; li.classList.add('is-drag'); try { ev.dataTransfer.setData('text/plain', slug); } catch (e) {} });
      li.addEventListener('dragend', function () { li.classList.remove('is-drag'); });
      li.addEventListener('dragover', function (ev) { ev.preventDefault(); li.classList.add('is-over'); });
      li.addEventListener('dragleave', function () { li.classList.remove('is-over'); });
      li.addEventListener('drop', function (ev) { ev.preventDefault(); li.classList.remove('is-over'); if (dragFrom !== -1) { moveShow(dragFrom, idx); } dragFrom = -1; });
      box.appendChild(li);
    });
    if (!state.shows.length) {
      box.innerHTML = '<li style="grid-template-columns:1fr;border-style:dashed;"><span class="sub" style="font-family:var(--font-ui);color:var(--lt-muted);">No shows picked yet. Add two or more below; until then your page uses the starter lineup.</span></li>';
    }
    renderShowGrid();
  }
  function renderShowGrid() {
    var q = (el('nn-show-search').value || '').trim().toLowerCase();
    var rest = state.all.filter(function (s) { return state.shows.indexOf(s) === -1; });
    el('nn-shows-count').textContent = '(' + state.shows.length + ' picked, ' + rest.length + ' more)';
    var box = el('nn-show-grid');
    var shown = rest.filter(function (slug) {
      if (!q) { return true; }
      var m = META[slug] || {};
      return (showName(slug) + ' ' + (m.tagline || '')).toLowerCase().indexOf(q) !== -1;
    });
    // Eight tiles until the member asks for all (or searches): the full
    // vocabulary is 26 shows, a screen and a half of tiles on a phone.
    var cap = (q || state.showAll) ? shown.length : 8;
    el('nn-show-all').hidden = shown.length <= cap;
    el('nn-show-all').textContent = 'Show all ' + shown.length + ' shows';
    box.innerHTML = shown.slice(0, cap).map(function (slug) {
      var m = META[slug] || {};
      return '<div class="me-tile" style="--show-color:' + esc(showColor(slug)) + ';">'
        + '<img src="' + esc(coverSrc(slug)) + '" alt="" width="44" height="44" loading="lazy">'
        + '<span class="txt"><span class="nm">' + esc(showName(slug)) + '</span><span class="sub">' + esc(subLine(slug) || m.tagline || '') + '</span>'
        + (m.access_note ? '<span class="lock">' + esc(m.access_note) + '</span>' : '') + '</span>'
        + '<button type="button" class="me-icon-btn" data-add-show="' + esc(slug) + '" aria-label="Add ' + esc(showName(slug)) + '">+</button></div>';
    }).join('') || '<p class="me-help">No show matches that.</p>';
  }

  // ------------------------------------------------------------- add-ons, places, topics
  function addonOn(id) { var chosen = state.addons === null ? DEFAULT_ADDONS : state.addons; return chosen.indexOf(id) !== -1; }
  function addonAllowed(a) { if (!state.active) { return false; } return a.tier === 'personal' || state.tier === 'personal_local'; }
  // Tier ceilings — mirror engine.personal_edition.TIER_LIMITS.
  var LIMITS = { personal: { cities: 1, topics: 0 }, personal_local: { cities: 3, topics: 5 } };
  function limits() { return LIMITS[state.tier] || { cities: 0, topics: 0 }; }
  function cityInputs() { return Array.prototype.slice.call(document.querySelectorAll('#nn-cities .nn-city')); }
  function topicInputs() { return Array.prototype.slice.call(document.querySelectorAll('#nn-topics .nn-topic')); }
  function listValues(inputs) { return inputs.map(function (i) { return i.value.trim(); }).filter(Boolean); }
  function renderLists(prefs) {
    var lim = limits();
    var cities = prefs.cities || (prefs.city ? [prefs.city] : []);
    cityInputs().forEach(function (inp, i) {
      inp.value = cities[i] || '';
      // A free account can still type its first city — saved and used the day
      // they subscribe. Beyond the tier's count is greyed.
      inp.disabled = i > 0 && i >= lim.cities;
    });
    var topics = prefs.topics || [];
    topicInputs().forEach(function (inp, i) { inp.value = topics[i] || ''; inp.disabled = false; });
    el('nn-topics-help').textContent = lim.topics
      ? '(up to five; Mira researches each one daily, sources named)'
      : '(up to five; this page follows them, and Mira researches them on Personal News Network)';
    el('nn-cities-help').textContent = lim.cities > 1
      ? '(up to three cities or towns; each gets its own brief)'
      : '(any city or town; the add-ons below follow it)';
  }
  function renderAddons() {
    var box = el('nn-addons');
    if (!box) { return; }
    box.innerHTML = '';
    ADDONS.forEach(function (a) {
      var allowed = addonAllowed(a);
      var on = allowed && addonOn(a.id);
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'me-addon';
      b.setAttribute('role', 'switch');
      b.setAttribute('aria-checked', on ? 'true' : 'false');
      if (!allowed) { b.setAttribute('aria-disabled', 'true'); }
      b.innerHTML = '<span class="em" aria-hidden="true">' + esc(a.emoji) + '</span><span><span class="nm">' + esc(a.label) + '</span>'
        + '<span class="ds">' + esc(a.desc) + '</span>'
        + (allowed ? '' : '<span class="lk">🔒 ' + (a.tier === 'personal_local' ? 'Personal News Network' : 'Paid plans') + '</span>')
        + '</span><span class="me-sw" aria-hidden="true"></span>';
      b.onclick = function () {
        if (!allowed) {
          // A locked add-on points at the way to unlock it.
          var to = state.active ? el('nn-pnn-card') : el('nn-edition');
          if (to && !to.hidden && to.scrollIntoView) { to.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
          return;
        }
        var chosen = (state.addons === null ? DEFAULT_ADDONS.slice() : state.addons.slice());
        var i = chosen.indexOf(a.id);
        if (i === -1) { chosen.push(a.id); } else { chosen.splice(i, 1); }
        state.addons = chosen; state.addonsTouched = true;
        renderAddons(); checkDirty();
      };
      box.appendChild(b);
    });
    el('nn-addon-upsell').hidden = !(state.active && state.tier === 'personal');
  }
  function getLength() { var r = document.querySelector('input[name="nn-length"]:checked'); return r ? r.value : ''; }
  function setLength(v) {
    var r = document.querySelector('input[name="nn-length"][value="' + (LENGTHS.indexOf(Number(v)) !== -1 ? String(v) : '') + '"]');
    if (r) { r.checked = true; }
  }

  // ------------------------------------------------------------- dirty state + preview
  function snapshot() {
    return JSON.stringify({
      shows: state.shows, name: el('nn-name').value.trim(),
      cities: listValues(cityInputs()), topics: listValues(topicInputs()),
      addons: state.addons, profile: el('nn-profile').value.trim(), length: getLength(),
      tickers: state.tickers,
    });
  }
  function markClean() { state.clean = snapshot(); checkDirty(); }
  function checkDirty() {
    var dirty = state.clean !== undefined && snapshot() !== state.clean;
    el('nn-savebar').hidden = !dirty;
    renderTomorrow();
  }
  function changed() { renderLineup(); renderFront(); renderTopics(); checkDirty(); }
  function easternParts(d) {
    try {
      var f = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).format(d).split('-');
      return { y: Number(f[0]), m: Number(f[1]), d: Number(f[2]) };
    } catch (e) { return { y: d.getFullYear(), m: d.getMonth() + 1, d: d.getDate() }; }
  }
  function renderTomorrow() {
    var list = el('nn-tomorrow-list'); if (!list) { return; }
    var lim = limits();
    var shows = lineup();
    // Oct 29 2026: editions are dated in Eastern time (the builder's
    // clock), so "tomorrow" is tomorrow in New York, whatever the browser's
    // own zone — a Pacific evening visit read the wrong day's lineup.
    var et = easternParts(new Date());
    var tomorrow = new Date(Date.UTC(et.y, et.m - 1, et.d + 1, 12));
    var wd = tomorrow.getUTCDay();
    el('nn-tomorrow-when').textContent = (state.active ? 'Tomorrow, ' : 'Your edition would be, for ')
      + tomorrow.toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
    var name = el('nn-name').value.trim();
    var addons = state.addons === null ? DEFAULT_ADDONS : state.addons;
    var tier = state.active ? state.tier : 'personal';
    var cities = listValues(cityInputs()).slice(0, Math.max(LIMITS[tier] ? LIMITS[tier].cities : 1, 1));
    var topics = listValues(topicInputs()).slice(0, (LIMITS[tier] || {}).topics || 0);
    var local = addons.filter(function (a) { return a !== 'markets' && a !== 'skip_repeats'; });
    var label = function (id) { var m = ADDONS.filter(function (x) { return x.id === id; })[0]; return m ? m.label.toLowerCase() : id; };
    var items = [], total = 120;
    items.push('<li>Mira opens, greeting ' + (name ? esc(name) : 'you') + ' by name</li>');
    if (cities.length && local.length) {
      items.push('<li>' + (cities.length === 1 ? 'Your ' + esc(cities[0]) + ' brief' : 'Briefs for ' + esc(cities.join(', ')))
        + ': ' + esc(local.map(label).join(', ')) + (tier === 'personal_local' ? ', up to three items each' : ', one item each') + '</li>');
      total += 90 * cities.length;
    } else {
      items.push('<li class="is-off">No location yet: <a class="me-link" href="#nn-places">add one</a> for a morning brief</li>');
    }
    if (topics.length) { items.push('<li>Your topics: ' + esc(topics.join(', ')) + '</li>'); total += 60 * topics.length; }
    if (addons.indexOf('markets') !== -1) { items.push('<li>Markets minute: ' + esc(myTickers().join(', ')) + '</li>'); total += 20 + 8 * myTickers().length; }
    var off = [];
    shows.forEach(function (slug) {
      var e = showEntry(slug);
      if (!runsOn(slug, wd)) { off.push(slug); return; }
      var t = typicalSeconds(slug);
      total += t;
      items.push('<li style="--dot:' + esc(showColor(slug)) + ';">' + esc(showName(slug))
        + (e && e.members_only ? ' <span class="me-card-tag">Members only</span>' : '')
        + (t ? '<span class="tm">~' + mins(t) + ' min</span>' : '') + '</li>');
    });
    off.forEach(function (slug) {
      items.push('<li class="is-off">' + esc(showName(slug)) + '<span class="tm">not on ' + WEEKDAYS[wd].charAt(0).toUpperCase() + WEEKDAYS[wd].slice(1) + 's</span></li>');
    });
    if (el('nn-profile').value.trim()) { items.push('<li>Mira knows what you told her, and uses it only where a story connects</li>'); }
    if (addons.indexOf('skip_repeats') !== -1) {
      items.push('<li>A story told twice is trimmed from the later show, and Mira says so</li>');
    }
    items.push('<li>Mira signs off</li>');
    list.innerHTML = items.join('');
    var len = getLength();
    el('nn-est').innerHTML = 'About <strong>' + mins(total) + '</strong> minutes' + (len ? ' · your setting is ' + esc(len) : '');
    var warn = el('nn-preview-warn');
    var msgs = [];
    if (state.shows.length && state.shows.length < 2) { msgs.push('Pick at least two shows; until then the starter lineup is used.'); }
    else if (shows.length >= 2 && shows.length - off.length < 2) {
      msgs.push('Only ' + (shows.length - off.length) + ' of your shows publish that day, and an edition needs two: add a daily show so you get one.');
    }
    if (len && mins(total) > Number(len)) { msgs.push('That runs past your ' + len + '-minute setting, so Mira trims later stories at clean breaks, never a lead.'); }
    warn.hidden = !msgs.length; warn.textContent = msgs.join(' ');
    el('nn-preview-cta').hidden = state.active || state.status === 'cancelled';
  }

  // ------------------------------------------------------------- today's build
  function renderBuild(today) {
    var box = el('nn-build'); if (!box) { return; }
    state.today = today || null;
    if (!state.active || !today) { box.hidden = true; el('nn-feed-note').hidden = !state.active; return; }
    box.hidden = false; el('nn-feed-note').hidden = true;
    var dot = el('nn-build-dot'), txt = el('nn-build-txt'), sub = el('nn-build-sub'), btn = el('nn-build-btn');
    var when = today.built_at ? new Date(today.built_at) : null;
    var hhmm = when ? when.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) : '';
    if (today.building) {
      dot.className = 'dot busy';
      txt.textContent = 'Mira is building your edition now';
      sub.textContent = 'About five minutes. It appears here and in your podcast app when it lands.';
      btn.hidden = true;
      if (!state.todayPoll) { state.todayPoll = setInterval(pollToday, 30000); }
      return;
    }
    if (state.todayPoll) { clearInterval(state.todayPoll); state.todayPoll = null; }
    if (when) {
      dot.className = 'dot on';
      txt.textContent = 'Today’s edition was built at ' + hhmm;
      sub.textContent = today.available
        ? (today.rebuilds_left > 0
            ? 'Changed something? Rebuild it with your new settings (' + today.rebuilds_left + ' rebuild' + (today.rebuilds_left === 1 ? '' : 's') + ' left today).'
            : 'You’ve used today’s rebuilds; tomorrow’s edition picks up every change.')
        : 'Changes reach tomorrow morning’s edition.';
      btn.textContent = 'Rebuild today’s edition';
      btn.hidden = !(today.available && today.rebuilds_left > 0);
    } else {
      dot.className = 'dot';
      txt.textContent = 'No edition yet today';
      sub.textContent = today.available
        ? 'Build one now with your current settings; Mira takes about five minutes.'
        : 'The morning build makes it.';
      btn.textContent = 'Build my edition now';
      btn.hidden = !today.available;
    }
    btn.disabled = false;
  }
  function pollToday() {
    fetch(API + '/api/account', { credentials: 'include' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d) { return; }
        var t = d.member && d.member.today;
        var landed = t && !t.building && state.today && state.today.building;
        renderBuild(t);
        if (landed && d.member.feed_url) { loadEditions(d.member.feed_url); }
      }).catch(function () {});
  }

  // ------------------------------------------------------------- the member's own feed
  function loadEditions(feedUrl) {
    fetch(feedUrl, { credentials: 'omit' })
      .then(function (r) { if (!r.ok) { throw new Error(r.status); } return r.text(); })
      .then(function (xml) {
        var doc = new DOMParser().parseFromString(xml, 'text/xml');
        var img = doc.querySelector('channel > image > url') || null;
        var itImg = doc.getElementsByTagName('itunes:image')[0];
        var cover = (itImg && itImg.getAttribute('href')) || (img && img.textContent) || '';
        if (safeUrl(cover)) { el('nn-ed-cover').src = safeUrl(cover); }
        var items = Array.prototype.slice.call(doc.querySelectorAll('item'), 0, 5);
        state.editions = items.map(function (it) {
          var q = function (sel) { var n = it.querySelector(sel); return n ? n.textContent : ''; };
          var enc = it.querySelector('enclosure');
          var dur = it.getElementsByTagName('itunes:duration')[0];
          var secs = 0;
          if (dur) { (dur.textContent || '').split(':').forEach(function (p) { secs = secs * 60 + (parseInt(p, 10) || 0); }); }
          return { title: q('title'), date: (q('pubDate') || '').split(' ').slice(0, 4).join(' '),
                   url: enc ? enc.getAttribute('url') : '', secs: secs };
        }).filter(function (e) { return safeUrl(e.url); });
        if (!state.editions.length) { return; }
        var first = state.editions[0];
        el('nn-ed-h').textContent = first.title || 'Your edition';
        el('nn-ed-play').hidden = false;
        el('nn-ed-len').textContent = first.secs ? '· ' + mins(first.secs) + ' min' : '';
        el('nn-editions-list').innerHTML = state.editions.map(function (e, i) {
          return '<li><button type="button" class="me-play is-round" data-edition="' + i + '" aria-label="Play ' + esc(e.title) + '"><span class="ic"></span></button>'
            + '<span><span class="t">' + esc(e.title) + '</span><br><span class="d">' + esc(e.date) + (e.secs ? ' · ' + mins(e.secs) + ' min' : '')
            + (isPlayed(e.url) ? ' · <span class="me-played">Played</span>' : '') + '</span></span></li>';
        }).join('');
        el('nn-editions').hidden = false;
        el('nn-feed-note').hidden = true;   // editions exist: not "just subscribed"
      })
      .catch(function () {});
  }

  // ------------------------------------------------------------- the player
  // The site's one player (assets/js/nn-player.js) plays, reports the play
  // to analytics (episode_play, or play_personal_sample for the sample) and
  // keeps positions under the keys this page reads (nnMe.pos, nnMe.played).
  function P() { return window.NNPlayer || null; }
  var player = {
    start: function (items, i) { var p = P(); if (p) { p.start(items, i); } },
    isKey: function (key) { var p = P(); return !!(p && p.isKey(key)); },
    toggle: function () { var p = P(); if (p) { p.toggle(); } },
  };
  var wasPlaying = false;
  function paintPlaying(st) {
    document.querySelectorAll('.me-play').forEach(function (b) {
      var key = b.getAttribute('data-play') || ('ed:' + b.getAttribute('data-edition'));
      b.classList.toggle('is-playing', !!(st && st.playing && st.key === key));
    });
    // Oct 29 2026: when playback stops, the "Played" and "Resume · m:ss"
    // labels are drawn again from the positions the player just saved.
    var playing = !!(st && st.playing);
    if (wasPlaying && !playing && state.front) { try { renderFront(); } catch (e) {} }
    wasPlaying = playing;
  }
  function hookPlayer() { var p = P(); if (p) { p.onChange(paintPlaying); } else { setTimeout(hookPlayer, 50); } }
  hookPlayer();
  function takeDraft() {
    var d = store('nnMe.draft');
    try { localStorage.removeItem('nnMe.draft'); } catch (e) {}
    if (!d || !Array.isArray(d.shows) || Date.now() - (d.ts || 0) > 30 * 86400e3) { return { shows: [], first_name: '', city: '' }; }
    return { shows: d.shows.filter(function (x) { return typeof x === 'string' && /^[a-z0-9_]+$/.test(x); }),
             first_name: typeof d.first_name === 'string' ? d.first_name.slice(0, 40) : '',
             city: typeof d.city === 'string' ? d.city.slice(0, 80) : '' };
  }
  function isPlayed(url) { var p = store('nnMe.played') || {}; return !!(url && p[url]); }
  function markPlayed(url) {
    var p = store('nnMe.played') || {};
    if (p[url]) { return; }
    p[url] = 1; var keys = Object.keys(p); if (keys.length > 400) { delete p[keys[0]]; }
    store('nnMe.played', p);
  }
  function storyItem(s) {
    return { key: s.slug + '|' + s.episode_num, url: safeUrl(s.audio_url), title: s.hook, show: showName(s.slug),
             color: showColor(s.slug), cover: safeUrl(s.image_url) || coverSrc(s.slug), post: storyHref(s) };
  }
  function findStory(key) {
    var parts = String(key).split('|'), slug = parts[0], num = parts[1];
    return stories(slug).filter(function (s) { return String(s.episode_num) === num; })[0] || null;
  }
  document.addEventListener('click', function (ev) {
    var b = ev.target.closest ? ev.target.closest('[data-play],[data-edition],[data-add-show]') : null;
    if (!b) { return; }
    if (b.hasAttribute('data-add-show')) { addShow(b.getAttribute('data-add-show')); return; }
    if (b.hasAttribute('data-edition')) { NN.playEdition(Number(b.getAttribute('data-edition'))); return; }
    var key = b.getAttribute('data-play');
    if (player.isKey(key)) { player.toggle(); return; }
    var s = findStory(key); if (!s) { return; }
    var todays = (state.todays || []);
    var idx = todays.indexOf(s);
    if (idx !== -1) { player.start(todays.map(storyItem), idx); } else { player.start([storyItem(s)], 0); }
  });

  // ------------------------------------------------------------- markets
  // ------------------------------------------------------------- markets
  // Oct 29 2026: quotes come from the markets route (live while the session
  // is open), never the once-a-morning committed files the card used to
  // read — those printed yesterday's close as today's.
  function myTickers() { return (state.tickers && state.tickers.length) ? state.tickers.slice() : NNMarkets.DEFAULT.slice(); }
  // The newest episode of a show (theirs first) whose hook or headlines name
  // this stock: its ticker as written, or its name (a one-word name alone; a
  // longer one whole, so "Advanced" never matches AMD).
  function stockPattern(sym, q) {
    var core = sym.replace(/^\^/, '').split(/[.\-=]/)[0].replace(/[^A-Z0-9]/g, '');
    var name = (NNMarkets.name(q || { symbol: sym }) || '')
      .replace(/[,.]?\s+(inc|incorporated|corp|corporation|co|company|ltd|limited|plc|holdings?|group)\.?$/i, '').trim();
    var parts = [];
    if (core.length >= 2) { parts.push('(?:^|[^A-Za-z$])' + core + '(?![A-Za-z])'); }
    if (name && (name.split(/\s+/).length > 1 || name.length >= 4)) {
      parts.push('\\b' + name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\b');
    }
    return parts.length ? new RegExp(parts.join('|'), 'i') : null;
  }
  function storyFor(sym, q) {
    var front = state.front && state.front.shows;
    var re = stockPattern(sym, q);
    if (!front || !re) { return null; }
    var shows = lineup().concat(Object.keys(front).filter(function (s) { return lineup().indexOf(s) === -1; }));
    for (var i = 0; i < shows.length; i++) {
      var e = front[shows[i]]; if (!e || e.members_only) { continue; }
      var st = (e.stories || [])[0];
      if (!st) { continue; }
      var texts = [st.hook].concat(st.headlines || []);
      for (var j = 0; j < texts.length; j++) {
        // The ticker matches as written (upper case); the name in any case.
        var t = String(texts[j] || '');
        if (re.test(t)) { return { show: e.name, story: st, text: t }; }
      }
    }
    return null;
  }
  function renderMarkets() {
    var grid = el('nn-mkt-grid'); if (!grid) { return; }
    var list = myTickers();
    grid.textContent = '';
    var live = false, any = false;
    list.forEach(function (sym) {
      var q = state.quotes[sym];
      var li = document.createElement('li');
      li.className = 'me-mkt is-' + (q ? NNMarkets.dir(q) : 'flat') + (q ? '' : ' is-missing');
      var top = document.createElement('span'); top.className = 'sym'; top.textContent = sym; li.appendChild(top);
      var nm = document.createElement('span'); nm.className = 'nm'; nm.textContent = q ? NNMarkets.name(q) : ''; li.appendChild(nm);
      var px = document.createElement('span'); px.className = 'px'; px.textContent = q ? NNMarkets.price(q) : 'No quote yet'; li.appendChild(px);
      if (q) {
        any = true; if (q.state === 'live') { live = true; }
        var chg = document.createElement('span'); chg.className = 'chg'; chg.textContent = NNMarkets.change(q); li.appendChild(chg);
        var w = document.createElement('span'); w.className = 'when'; w.textContent = NNMarkets.when(q); li.appendChild(w);
        var hit = storyFor(sym, q);
        if (hit) {
          var inn = document.createElement('span'); inn.className = 'in';
          inn.appendChild(document.createTextNode('In ' + hit.show + ': '));
          var a = document.createElement('a'); a.href = storyHref(hit.story);
          a.textContent = hit.text; inn.appendChild(a); li.appendChild(inn);
        }
      }
      if (state.tickers && state.tickers.length) {
        var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'rm';
        rm.setAttribute('aria-label', 'Stop following ' + sym); rm.textContent = '✕';
        rm.onclick = function () { NN.removeTicker(sym); };
        li.appendChild(rm);
      }
      grid.appendChild(li);
    });
    el('nn-mkt-sub').textContent = !state.tickers || !state.tickers.length
      ? 'Tesla and SpaceX until you add your own'
      : (live ? 'Live while the market is open' : (any ? 'Closing prices' : 'Waiting for quotes'));
    // The header strip: the first four, compact.
    var strip = '';
    list.slice(0, 4).forEach(function (sym) {
      var q = state.quotes[sym]; if (!q) { return; }
      strip += '<a class="lt-quote is-' + NNMarkets.dir(q) + '" href="#nn-markets"><span class="lt-quote-sym">' + esc(sym) + '</span> '
        + '<span class="lt-quote-px">' + esc(NNMarkets.price(q)) + '</span> <span class="lt-quote-chg">' + esc(NNMarkets.change(q)) + '</span></a>';
    });
    el('nn-mkt').innerHTML = strip;
    var first = state.quotes[list[0]];
    el('nn-mkt-asof').textContent = first ? NNMarkets.when(first) : '';
    el('nn-mkt-card').hidden = !strip;
  }
  var mktTimer = null;
  function loadMarkets() {
    clearTimeout(mktTimer);
    if (!window.NNMarkets) { return; }
    NNMarkets.get(myTickers()).then(function (r) {
      Object.keys(r.quotes).forEach(function (k) { state.quotes[k] = r.quotes[k]; });
      state.unknown = r.unknown; state.marketsAnswered = r.answered;
      renderMarkets();
      var live = Object.keys(r.quotes).some(function (k) { return r.quotes[k].state === 'live'; });
      if (document.visibilityState !== 'hidden') { mktTimer = setTimeout(loadMarkets, live ? 60000 : 600000); }
    });
  }
  document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible' && state.shows) { loadMarkets(); } });

  function greet(name) {
    var h = new Date().getHours();
    var part = h < 5 ? 'Good evening' : h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
    var g = el('nn-greeting');
    g.innerHTML = esc(part) + (name ? ', <em>' + esc(name) + '</em>' : '') + '.';
    el('nn-date').textContent = new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' });
  }

  // Every checkout link carries an opaque one-hour reference so the Worker
  // attaches the purchase to THIS account, even when the wallet reports a
  // different email (Apple Pay / Link do). No email in the URL.
  function attachCheckoutRefs() {
    var links = document.querySelectorAll('a[data-checkout]');
    if (!links.length) { return; }
    fetch(API + '/api/account/checkout-ref', { method: 'POST', credentials: 'include' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || !d.ref) { return; }
        links.forEach(function (a) {
          var base = a.getAttribute('href').split('?')[0];
          a.href = base + '?client_reference_id=' + encodeURIComponent(d.ref);
        });
      })
      .catch(function () {});
  }

  function loadFront(then) {
    fetch(FRONT_URL)
      .then(function (r) { if (!r.ok) { throw new Error(r.status); } return r.json(); })
      .then(function (d) { state.front = d || { shows: {} }; })
      .catch(function () { state.front = { shows: {} }; })
      .then(function () { if (then) { then(); } });
  }
  function renderGuestFront() {
    var rows = [];
    Object.keys(state.front.shows || {}).forEach(function (slug) {
      var e = state.front.shows[slug];
      if (!e.personal || e.members_only) { return; }
      var s = (e.stories || [])[0];
      if (s && isToday(s)) { rows.push(s); }
    });
    rows = rows.slice(0, 4);
    if (!rows.length) { return; }
    el('nn-guest-stories').innerHTML = rows.map(card).join('');
    el('nn-guest-front').hidden = false;
  }

  function wireInputs() {
    ['nn-name', 'nn-profile'].map(el).concat(cityInputs(), topicInputs(),
      Array.prototype.slice.call(document.querySelectorAll('input[name="nn-length"]')))
      .forEach(function (node) {
        if (node && !node._nnWired) {
          node._nnWired = true;
          node.addEventListener('input', checkDirty); node.addEventListener('change', checkDirty);
        }
      });
    cityInputs().concat(topicInputs()).forEach(function (node) {
      if (!node._nnTopics) { node._nnTopics = true; node.addEventListener('change', function () { renderTopics(); renderFront(); }); }
    });
    var p = el('nn-profile');
    if (!p._nnCount) { p._nnCount = true; p.addEventListener('input', function () { el('nn-profile-count').textContent = String(p.value.length); }); }
    var q = el('nn-show-search');
    if (!q._nnWired) { q._nnWired = true; q.addEventListener('input', renderShowGrid); }
  }

  function load() {
    el('nn-guest-date').textContent = new Date().toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' });
    // Oct 29 2026: the first load reads the base template's one account
    // request (window.nnAccount); Discard and later reloads ask again.
    var first = !state.loadedOnce && window.nnAccount;
    state.loadedOnce = true;
    (first ? window.nnAccount.then(function (d) { if (!d) { throw new Error('signed out'); } return d; })
           : fetch(API + '/api/account', { credentials: 'include' })
               .then(function (r) { if (!r.ok) { throw new Error(r.status); } return r.json(); }))
      .then(function (data) {
        el('nn-status').textContent = ''; el('nn-status').hidden = true;
        if (data.verify_required) {
          // Signed in by a form: offer the emailed link, prefilled.
          el('nn-guest').hidden = false;
          el('nn-verify-note').hidden = false;
          el('nn-signin-lede').hidden = true;
          if (data.email) { el('nn-account-email').value = data.email; }
          if (document.documentElement.classList.contains('nn-standalone')) { el('nn-code-form').hidden = false; }
          loadFront(renderGuestFront);
          return;
        }
        el('nn-member').hidden = false;
        state.all = data.shows || [];
        var prefs = (data.member && data.member.preferences) || {};
        state.shows = (prefs.shows || []).slice();
        state.addons = (prefs.addons === undefined) ? null : prefs.addons;
        state.tickers = Array.isArray(prefs.tickers) ? NNMarkets.clean(prefs.tickers) : null;
        // Stocks a visitor added on the front page before signing in.
        if (!state.tickers) {
          var local = NNMarkets.stored();
          if (local.length) { state.tickers = local; state.tickersFromBrowser = true; }
        }
        el('nn-name').value = prefs.first_name || '';
        el('nn-profile').value = prefs.profile || '';
        el('nn-profile-count').textContent = String(el('nn-profile').value.length);
        setLength(prefs.target_minutes ? String(prefs.target_minutes) : '');
        greet(prefs.first_name || '');
        var feedUrl = data.member && data.member.feed_url;
        var tier = (data.member && data.member.tier) || 'none';
        var status = (data.member && data.member.status) || 'none';
        var cancelled = status === 'cancelled';
        state.tier = tier; state.status = status; state.active = status === 'active'; state.feedUrl = feedUrl || '';
        state.today = (data.member && data.member.today) || null;
        el('nn-email').textContent = data.email || '';
        renderLists(prefs);
        renderAddons();
        renderLineup();
        wireInputs();
        markClean();
        // Oct 28 2026 (later): shows picked on the front page or the join
        // page before the account existed (localStorage nnMe.draft) become
        // the lineup of an account that has none, saved once.
        var draft = takeDraft();
        if (draft.first_name && !el('nn-name').value) { el('nn-name').value = draft.first_name; greet(draft.first_name); }
        // The city typed in the join builder becomes the first location of
        // an account that has none.
        var draftCity = false;
        if (draft.city && !listValues(cityInputs()).length) { cityInputs()[0].value = draft.city; draftCity = true; }
        draft = draft.shows;
        if (!state.shows.length && draft.length) {
          state.shows = draft.filter(function (x) { return state.all.indexOf(x) !== -1; }).slice(0, 12);
          if (state.shows.length) {
            renderLineup(); checkDirty();
            setTimeout(function () { NN.save(function () { el('nn-save-status').textContent = 'Saved the shows you picked'; }); }, 0);
            draftCity = false;
          }
        }
        if (draftCity) { setTimeout(function () { NN.save(); }, 0); }
        loadFront(function () { renderLineup(); renderFront(); renderTopics(); renderTomorrow(); renderMarkets(); });
        renderMarkets(); loadMarkets();
        if (state.tickersFromBrowser) { setTimeout(function () { NN.save(); }, 0); }
        el('nn-feed-active').hidden = !feedUrl;
        el('nn-feed-upsell').hidden = !!feedUrl || cancelled;
        el('nn-feed-cancelled').hidden = !cancelled || !!feedUrl;
        if (feedUrl) {
          el('nn-feed-url').textContent = feedUrl;
          loadEditions(feedUrl);
          var bare = feedUrl.replace(/^https?:\/\//, '');
          el('nn-add-apple').href = 'podcast://' + bare;
          el('nn-add-overcast').href = 'overcast://x-callback-url/add?url=' + encodeURIComponent(feedUrl);
          el('nn-add-pocketcasts').href = 'pktc://subscribe/' + bare;
          var tok = /\/api\/feed\/([0-9a-f]{32})\/feed\.rss$/.exec(feedUrl);
          if (tok) { el('nn-add-page').href = '{{ path_prefix }}add.html#' + tok[1]; }
          el('nn-add-castro').href = 'castros://subscribe/' + bare;
        }
        renderBuild(state.today);
        var pill = el('nn-tier-badge');
        if (status === 'active') {
          pill.textContent = tier === 'personal_local' ? 'Personal News Network' : 'Personal';
          pill.className = 'me-tier is-active'; pill.hidden = false;
        } else if (cancelled) {
          pill.textContent = 'Subscription ended';
          pill.className = 'me-tier'; pill.hidden = false;
        } else {
          pill.textContent = 'Free account';
          pill.className = 'me-tier'; pill.hidden = false;
        }
        // A paying member with <2 chosen shows rides the starter lineup
        // until they save their own (the Worker fills it server-side).
        el('nn-starter-note').hidden = !(feedUrl && state.shows.length < 2);
        el('nn-city-nudge').hidden = !(status === 'active' && !listValues(cityInputs()).length);

        // Plan switching (Sep 13 2026): an existing subscriber changes plan
        // or cancels inside Stripe's portal; the page never opens a second
        // checkout for them.
        var portal = !!(data.member && data.member.billing_portal);
        state.portal = portal;
        el('nn-portal-btn').hidden = !(portal && status === 'active');
        var switchPortal = el('nn-switch-portal'), switchCheckout = el('nn-switch-checkout');
        if (switchPortal) { switchPortal.hidden = !(portal && status === 'active'); }
        // Oct 28 2026: never a checkout for an active member, portal or not.
        if (switchCheckout) { switchCheckout.hidden = (status === 'active'); }
        var endsAt = data.member && data.member.ends_at;
        var trialEnds = data.member && data.member.trial_ends_at;
        el('nn-ends-note').hidden = !(endsAt || trialEnds);
        if (endsAt) {
          el('nn-ends-note').textContent = 'Your subscription is set to end on ' + endsAt
            + '. Your feed keeps building until then; resume any time from Manage plan & billing.';
        } else if (trialEnds) {
          // Free trial (Sep 17 2026): say plainly when the first charge is.
          el('nn-ends-note').textContent = 'You’re on the free trial. The first charge ('
            + (tier === 'personal_local' ? '$8.99' : '$4.99') + '/mo) is on ' + trialEnds
            + '; cancel before then from Manage plan & billing and you pay nothing.';
        }
        el('nn-pnn-card').hidden = !(status === 'active' && tier === 'personal');
        el('nn-pnn-switch').hidden = !(portal && status === 'active');
        var pnnCheckout = el('nn-pnn-checkout');
        if (pnnCheckout) { pnnCheckout.hidden = (status === 'active'); }
        var pnnHelp = el('nn-pnn-help');
        if (pnnHelp) { pnnHelp.hidden = !(status === 'active' && !portal); }
        attachCheckoutRefs();
        // Library: links answer only for active PNN (the Worker gates the
        // bytes; this decides what the page shows).
        var lib = !!(data.perks && data.perks.library);
        document.querySelectorAll('.nn-book-dl').forEach(function (a) { a.hidden = !lib; });
        document.querySelectorAll('.nn-book-locked').forEach(function (x) { x.hidden = lib; });
        el('nn-library-lede').textContent = lib
          ? 'Every Nerra book, yours to keep on this plan. The EPUB opens in Apple Books, Kindle (Send to Kindle), Kobo and any reader.'
          : (status === 'active'
              ? 'Every Nerra book is included with Personal News Network. Switch plans and the downloads unlock here.'
              : 'Every Nerra book is included with Personal News Network.');
        el('nn-library-foot').textContent = lib ? 'New volumes appear here the day they are built. Audiobook editions are next.' : '';
        var code = data.perks && data.perks.book_discount_code;
        el('nn-book-perk').innerHTML = lib
          ? 'Included: see your library'
          : (code
              ? 'Code <strong>' + esc(code) + '</strong> at the <a href="{{ path_prefix }}books.html">book store</a>'
              : 'Included with Personal News Network');
      })
      .catch(function () {
        el('nn-status').textContent = ''; el('nn-status').hidden = true;
        el('nn-guest').hidden = false;
        // In the installed app an emailed link opens the browser, not the
        // app: the code box is there from the start.
        if (document.documentElement.classList.contains('nn-standalone')) { el('nn-code-form').hidden = false; }
        loadFront(renderGuestFront);
      });
  }

  return {
    login: function (form) {
      var btn = form.querySelector('button');
      btn.disabled = true; btn.textContent = 'Sending…';
      // A 4xx/5xx is a failure, not a sent link (Oct 7 2026: fetch resolves
      // on any HTTP status, so a refused request read "Check your inbox").
      fetch(API + '/api/login?email=' + encodeURIComponent(form.email.value))
        .then(function (r) { if (!r.ok) { throw new Error(r.status); } })
        .then(function () {
          btn.textContent = 'Check your inbox';
          var f = el('nn-code-form'); if (f) { f.hidden = false; f.setAttribute('data-email', form.email.value); }
        })
        .catch(function () { btn.textContent = 'Try again'; btn.disabled = false; });
    },
    loginCode: function (form) {
      var btn = form.querySelector('button'), st = el('nn-code-status');
      var email = form.getAttribute('data-email') || el('nn-account-email').value;
      btn.disabled = true; st.textContent = 'Checking…';
      fetch(API + '/api/login-code', {
        method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, code: String(form.code.value || '').replace(/\D/g, '') }),
      }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { d._s = r.status; return d; }); })
        .then(function (d) {
          if (d._s === 200) { st.textContent = 'Signed in.'; window.location.reload(); return; }
          btn.disabled = false;
          st.textContent = d._s === 429 ? 'Too many tries; wait a few minutes.'
            : d.error === 'wrong code' ? 'That code does not match' + (d.tries_left ? ' (' + d.tries_left + ' tries left).' : '; email yourself a new one.')
            : 'That code has expired; email yourself a new one.';
        })
        .catch(function () { btn.disabled = false; st.textContent = 'Could not check the code; try again.'; });
    },
    addTicker: function (ev) {
      if (ev && ev.preventDefault) { ev.preventDefault(); }
      var inp = el('nn-mkt-input'), msg = el('nn-mkt-msg');
      var sym = String(inp.value || '').trim().toUpperCase().replace(/^\$/, '');
      if (!sym) { return; }
      if (!NNMarkets.valid(sym)) { msg.textContent = sym + ' is not a ticker shape we know.'; return; }
      var list = state.tickers ? state.tickers.slice() : [];
      if (list.indexOf(sym) !== -1) { msg.textContent = 'You already follow ' + sym + '.'; return; }
      if (list.length >= NNMarkets.MAX) { msg.textContent = 'You can follow up to ' + NNMarkets.MAX + '. Remove one first.'; return; }
      msg.textContent = 'Looking up ' + sym + '…';
      NNMarkets.get([sym]).then(function (r) {
        if (r.unknown.indexOf(sym) !== -1) { msg.textContent = 'No quote found for ' + sym + '. Check the suffix (.TO, .L, -USD).'; return; }
        if (r.quotes[sym]) { state.quotes[sym] = r.quotes[sym]; }
        list.push(sym); state.tickers = list; inp.value = '';
        msg.textContent = r.quotes[sym] ? 'Added ' + sym + '. Saving…' : 'Added ' + sym + '; its quote appears once the markets service answers. Saving…';
        renderMarkets();
        NN.save(function () { msg.textContent = 'Following ' + sym + '.'; });
      });
    },
    removeTicker: function (sym) {
      state.tickers = (state.tickers || []).filter(function (t) { return t !== sym; });
      renderMarkets();
      el('nn-mkt-msg').textContent = 'Stopped following ' + sym + '. Saving…';
      NN.save(function () { el('nn-mkt-msg').textContent = 'Stopped following ' + sym + '.'; loadMarkets(); });
      var first = document.querySelector('#nn-mkt-grid .rm'); if (first) { first.focus(); } else { el('nn-mkt-input').focus(); }
    },
    save: function (done) {
      el('nn-save-status').textContent = 'Saving…';
      var len = getLength();
      var body = {
        shows: state.shows,
        first_name: el('nn-name').value,
        cities: listValues(cityInputs()),
        topics: listValues(topicInputs()),
        // Oct 18 2026: sent every save; the Worker scrubs and caps the note
        // and keeps the length to its closed set (anything else = none).
        profile: el('nn-profile').value.trim(),
        target_minutes: len ? Number(len) : null,
      };
      // Oct 29 2026: the stocks they follow (absent = never touched).
      if (state.tickers !== null) { body.tickers = state.tickers; }
      // Send addons only once the member has a real choice — an untouched
      // page must not overwrite "never saved" (defaults) with a snapshot.
      if (state.addonsTouched || state.addons !== null) { body.addons = state.addons; }
      fetch(API + '/api/account/preferences', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      }).then(function (r) {
        el('nn-save-status').textContent = r.ok
          ? (state.today && state.today.available && state.today.built_at && state.today.rebuilds_left > 0
              ? 'Saved. Rebuild today’s edition to hear it now, or it reaches tomorrow’s.'
              : 'Saved. Your changes reach tomorrow’s edition.')
          : (r.status === 403
              ? 'Not saved: open the sign-in link we email you, then save again.'
              : 'Save failed; please try again shortly.');
        if (r.ok) { greet(el('nn-name').value.trim()); markClean(); renderFront(); renderTopics(); }
        if (typeof done === 'function') { done(); }
      }).catch(function () { el('nn-save-status').textContent = 'Save failed'; if (typeof done === 'function') { done(); } });
    },
    rebuild: function () {
      var btn = el('nn-build-btn');
      btn.disabled = true; btn.textContent = 'Starting…';
      // Unsaved changes ride along: save first, then build.
      var pre = (state.clean !== undefined && snapshot() !== state.clean)
        ? new Promise(function (res) { NN.save(res); }) : Promise.resolve();
      pre.then(function () {
        return fetch(API + '/api/account/rebuild', { method: 'POST', credentials: 'include' });
      }).then(function (r) { return r.json().then(function (d) { d._status = r.status; return d; }); })
        .then(function (d) {
          if (d.today) { renderBuild(d.today); }
          if (d._status === 202) { return; }
          btn.disabled = false;
          el('nn-save-status').textContent = d._status === 429
            ? 'You’ve used today’s rebuilds; tomorrow’s edition picks up every change.'
            : d._status === 409 ? 'A build is already running.'
            : 'Couldn’t start a build right now; the morning build will still run.';
          if (d._status !== 409) { renderBuild(state.today); }
        })
        .catch(function () { btn.disabled = false; renderBuild(state.today); });
    },
    copyFeed: function () {
      var btn = el('nn-copy-feed');
      var done = function (msg) {
        if (!btn) { return; }
        btn.textContent = msg;
        setTimeout(function () { btn.textContent = 'Copy feed URL'; }, 2500);
      };
      try {
        navigator.clipboard.writeText(el('nn-feed-url').textContent)
          .then(function () { done('Copied'); }, function () { done('Select the URL above to copy it'); });
      } catch (e) { done('Select the URL above to copy it'); }
    },
    showAllShows: function () { state.showAll = true; renderShowGrid(); },
    watchLineup: function () {
      var vids = lineupVideos();
      var p = P();
      if (!vids.length || !p || !p.watchList) { return; }
      var name = el('nn-name').value.trim();
      var hour = new Date().getHours();
      var part = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
      var names = vids.map(function (v) { return v.show; });
      var mira = { kind: 'mira', title: 'Your lineup', video: '{{ path_prefix }}assets/mira/mira-studio.mp4',
                   poster: '{{ path_prefix }}assets/mira/mira-studio.jpg',
                   greeting: part + (name ? ', ' + name : '') + '. Here is your lineup on video.',
                   lines: [vids.length + (vids.length === 1 ? ' episode' : ' episodes') + ', in your order: ' + names.join(' · '),
                           'Each one plays after the last. Mira is an AI host; this card is an illustration of her.'] };
      p.watchList([mira].concat(vids), 0);
    },
    playLineup: function () { if (state.todays && state.todays.length) { player.start(state.todays.map(storyItem), 0); } },
    playEdition: function (i) {
      var items = state.editions.map(function (e, j) {
        return { key: 'ed:' + j, url: safeUrl(e.url), title: e.title || 'Your edition', show: 'Your edition', color: '#00D4FF',
                 cover: el('nn-ed-cover').src, post: '{{ path_prefix }}account.html#nn-edition' };
      });
      if (items[i]) { player.start(items, i); }
    },
    playSample: function () {
      if (!safeUrl(SAMPLE_URL)) { return; }
      player.start([{ key: 'sample', url: safeUrl(SAMPLE_URL), title: 'A sample Personal edition', show: 'Nerra Personal', color: '#00D4FF',
                      cover: '{{ path_prefix }}assets/covers/nerra-daily.jpg', post: '{{ path_prefix }}join.html#sample', sample: 'account' }], 0);
    },
    logout: function () {
      // Oct 29 2026: a shared device keeps nothing of this account — the
      // edition's URL carries the member's private feed token.
      try { if (window.NNPlayer && NNPlayer.forgetPrivate) { NNPlayer.forgetPrivate(); } } catch (e) {}
      ['nnMe.draft', 'nnMe.tickers'].forEach(function (k) { try { localStorage.removeItem(k); } catch (e) {} });
      fetch(API + '/api/logout', { method: 'POST', credentials: 'include' })
        .catch(function () {})
        .then(function () { window.location.href = '{{ path_prefix }}login.html'; });
    },
    portal: function () {
      var btn = el('nn-portal-btn');
      if (btn) { btn.disabled = true; btn.textContent = 'Opening…'; }
      fetch(API + '/api/account/portal', { method: 'POST', credentials: 'include' })
        .then(function (r) { if (!r.ok) { throw new Error(r.status); } return r.json(); })
        .then(function (d) { window.location.href = d.url; })
        .catch(function () {
          if (btn) { btn.disabled = false; btn.textContent = 'Manage plan & billing'; }
          el('nn-save-status').textContent = 'Billing portal unavailable right now; try again shortly.';
        });
    },
    load: load,
  };
})();
// The shared scripts (nn-markets.js, nn-player.js) load deferred from the
// base template; start once they have run.
if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', NN.load); } else { NN.load(); }
</script>
{% endblock %}
