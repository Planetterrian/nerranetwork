{# Mira interview shows — approval + booking link. Live send is the Worker's inline
   copy (triage-decision handler); keep in sync if you edit tone. #}
<div style="font-family:system-ui,sans-serif;max-width:640px;margin:0 auto;color:#1a202c;line-height:1.6">
  <h2 style="color:{{ brand_color }}">You're invited</h2>
  <p>Hi {{ guest_name }},</p>
  <p>We'd love to have you on {{ show_name }}. Pick a time and Mira — our AI
  host — will call you:</p>
  <p><a href="{{ booking_url }}" style="color:{{ brand_color }}">{{ booking_url }}</a></p>
  <p>About forty-five minutes, recorded, and nothing publishes until you've
  approved the transcript.</p>
  <p>{{ sign_off }}</p>
</div>
