{% extends "base.html.j2" %}

{% block head_extra %}
    {#- Fonts come from base.html.j2 (async media=print onload from #1476).
        Do not add a second Google Fonts <link> here — that was render-blocking
        on /personal-interest.html. main.css is already in base. -#}
    <style>
        .spi-hero {
            position: relative;
            overflow: hidden;
            padding: calc(var(--nav-height) + var(--sp-12)) var(--sp-6) var(--sp-10);
        }
        .spi-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 60% 50% at 18% 12%, rgba(0, 212, 255, 0.14), transparent 65%),
                radial-gradient(ellipse 50% 45% at 88% 72%, rgba(124, 92, 255, 0.12), transparent 65%);
            pointer-events: none;
        }
        .spi-wrap {
            position: relative;
            max-width: 640px;
            margin: 0 auto;
        }
        .spi-eyebrow {
            font-family: var(--font-ui);
            font-size: 0.78rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--nn-cyan, #00D4FF);
            font-weight: 700;
            margin-bottom: var(--sp-3);
        }
        .spi-hero h1 {
            font-family: var(--font-heading);
            font-size: clamp(2rem, 5vw, 2.85rem);
            line-height: 1.12;
            margin: 0 0 var(--sp-5);
        }
        .spi-body {
            font-family: var(--font-ui);
            color: var(--nn-text-muted);
            font-size: 1.05rem;
            line-height: 1.65;
            margin: 0 0 var(--sp-4);
        }
        .spi-body + .spi-body { margin-top: var(--sp-4); }
        .spi-card {
            margin-top: var(--sp-8);
            padding: var(--sp-6);
            border: 1px solid var(--nn-border);
            border-radius: 16px;
            background: var(--nn-surface);
        }
        .spi-field { margin-bottom: var(--sp-4); }
        .spi-field label {
            display: block;
            font-family: var(--font-ui);
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.4rem;
        }
        .spi-field .hint {
            font-weight: 400;
            color: var(--nn-text-muted);
            font-size: 0.82rem;
        }
        .spi-field input[type=email],
        .spi-field input[type=text] {
            width: 100%;
            padding: 0.8rem 1rem;
            border-radius: 10px;
            border: 1px solid var(--nn-border);
            background: var(--nn-bg, #0b0f1a);
            color: inherit;
            font-family: var(--font-ui);
            font-size: 1rem;
            box-sizing: border-box;
        }
        .spi-field input:focus {
            outline: 2px solid var(--nn-cyan, #00D4FF);
            outline-offset: 1px;
        }
        .spi-check {
            display: flex;
            gap: 0.7rem;
            align-items: flex-start;
            margin-bottom: var(--sp-3);
            font-family: var(--font-ui);
            font-size: 0.95rem;
            line-height: 1.45;
        }
        .spi-check input {
            margin-top: 0.25rem;
            flex: none;
            width: 1.05rem;
            height: 1.05rem;
        }
        .spi-actions {
            display: flex;
            flex-wrap: wrap;
            gap: var(--sp-3);
            align-items: center;
            margin-top: var(--sp-5);
        }
        .spi-actions button[type=submit] {
            padding: 0.85rem 1.5rem;
            border-radius: 12px;
            border: none;
            background: var(--nn-gradient);
            color: #fff;
            font-weight: 700;
            font-family: var(--font-ui);
            font-size: 1rem;
        }
        .spi-actions button[type=submit]:disabled {
            opacity: 0.65;
            cursor: wait;
        }
        .spi-actions .spi-secondary {
            font-family: var(--font-ui);
            font-size: 0.95rem;
            color: var(--nn-cyan, #00D4FF);
            text-decoration: none;
            font-weight: 600;
        }
        .spi-actions .spi-secondary:hover { text-decoration: underline; }
        .spi-status {
            margin-top: var(--sp-4);
            font-family: var(--font-ui);
            font-size: 0.95rem;
            line-height: 1.55;
            min-height: 1.4em;
        }
        .spi-status[data-state="ok"] { color: #34d399; }
        .spi-status[data-state="error"] { color: #f87171; }
        .spi-confirm {
            display: none;
            margin-top: var(--sp-6);
            padding: var(--sp-5);
            border-radius: 14px;
            border: 1px solid rgba(52, 211, 153, 0.35);
            background: rgba(52, 211, 153, 0.08);
            font-family: var(--font-ui);
            line-height: 1.6;
        }
        .spi-confirm.is-visible { display: block; }
        .spi-confirm a { color: var(--nn-cyan, #00D4FF); font-weight: 600; }
        .spi-hp {
            position: absolute;
            left: -9999px;
            width: 1px;
            height: 1px;
            overflow: hidden;
        }
        /* Oct 28 2026: the sample edition, so a visitor can hear the
           product before deciding — this page takes the paid traffic
           (313 of 840 sessions in 28 days) and kept 2% of it. */
        .spi-sample {
            margin-top: var(--sp-6);
            padding: var(--sp-4) var(--sp-5);
            border: 1px solid var(--nn-border);
            border-radius: 14px;
            background: rgba(0, 212, 255, 0.05);
        }
        .spi-sample h2 {
            font-family: var(--font-heading);
            font-size: 1.1rem;
            margin: 0 0 var(--sp-2);
        }
        .spi-sample p {
            font-family: var(--font-ui);
            color: var(--nn-text-muted);
            font-size: 0.92rem;
            line-height: 1.55;
            margin: 0 0 var(--sp-3);
        }
        .spi-sample audio { width: 100%; }
        /* Nov 9 2026: the product leads; the button goes to join.html. */
        .spi-sample { margin-top: var(--sp-2); }
        .spi-cta {
            display: flex;
            flex-wrap: wrap;
            gap: var(--sp-3) var(--sp-4);
            align-items: center;
            margin-top: var(--sp-5);
        }
        .spi-cta-btn {
            display: inline-block;
            padding: 0.95rem 1.7rem;
            border-radius: 12px;
            background: var(--nn-gradient);
            color: #fff;
            font-family: var(--font-ui);
            font-weight: 700;
            font-size: 1.05rem;
            text-decoration: none;
        }
        .spi-cta-btn:hover { filter: brightness(1.08); }
        .spi-cta-note {
            font-family: var(--font-ui);
            font-size: 0.9rem;
            color: var(--nn-text-muted);
        }
        .spi-gets {
            margin: var(--sp-6) 0 0;
            padding: 0;
            list-style: none;
            display: grid;
            gap: var(--sp-3);
            font-family: var(--font-ui);
            font-size: 0.98rem;
            line-height: 1.55;
            color: var(--nn-text-muted);
        }
        .spi-gets li { padding-left: 1.4rem; position: relative; }
        .spi-gets li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.55em;
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background: var(--nn-cyan, #00D4FF);
        }
        .spi-gets strong { color: var(--nn-text, inherit); }
        .spi-card-h {
            font-family: var(--font-heading);
            font-size: 1.2rem;
            margin: 0 0 var(--sp-2);
        }
        .spi-card-sub {
            font-family: var(--font-ui);
            color: var(--nn-text-muted);
            font-size: 0.95rem;
            line-height: 1.55;
            margin: 0 0 var(--sp-4);
        }
        .spi-privacy {
            font-family: var(--font-ui);
            margin-top: var(--sp-3);
            font-size: 0.85rem;
            line-height: 1.5;
            color: var(--nn-text-muted);
        }
        .spi-foot {
            font-family: var(--font-ui);
            margin-top: var(--sp-8);
            font-size: 0.85rem;
            color: var(--nn-text-muted);
            text-align: center;
        }
        @media (max-width: 560px) {
            .spi-actions { flex-direction: column; align-items: stretch; }
            .spi-actions button[type=submit],
            .spi-actions .spi-secondary { text-align: center; }
            .spi-cta { flex-direction: column; align-items: stretch; }
            .spi-cta-btn { text-align: center; }
        }
    </style>
{% endblock %}

{% block content %}
{#- Nov 9 2026 (operator: "Rework the ad landing page"). This page takes the
    network's paid traffic (660 sessions in the 28 days to Nov 8, 99% bounce,
    2 signups) and led with a promise of occasional emails about Personal that no
    send ever kept: nothing mails the personal-interest tag. It now leads with
    the product and its five-minute sample, sends a ready visitor to
    join.html, and offers a visitor who is not ready the one email the network
    sends, Nerra Daily (list personal-interest + newsletter, so the Worker tags
    personal-interest and nerra-member; no Worker change). -#}
<section class="spi-hero" aria-labelledby="spi-title">
    <div class="spi-wrap">
        <div class="spi-eyebrow">Nerra Personal</div>
        <h1 id="spi-title">Your shows, one private morning edition, read to you by name</h1>
        <p class="spi-body">Pick the Nerra shows you want, in your order. Mira opens with your name and your city, then every show plays in full, in one private feed in the podcast app you already use. Every Nerra show stays free; Personal is optional.</p>

        <section class="spi-sample" id="sample" aria-labelledby="spi-sample-h">
            <h2 id="spi-sample-h">Hear five minutes of one</h2>
            <p>A sample edition for “Alex” in Vancouver: Mira’s open, the city brief with its sources named, the markets minute, then a taste of two shows (SpaceX Daily included). A real edition plays every show you pick in full.</p>
            <audio controls preload="none" src="{{ sample_url }}" data-nn-sample="personal-interest" data-nn-player data-title="A sample Nerra Personal edition" data-show="Nerra Personal" aria-label="Play a five-minute sample Nerra Personal edition"></audio>
        </section>

        <div class="spi-cta">
            <a class="spi-cta-btn" href="{{ path_prefix }}join.html" data-nn-cta="personal-interest-build">Build yours →</a>
            <span class="spi-cta-note">{% if trial_days %}{{ trial_days }} days free, then from $4.99/mo. Cancel anytime.{% else %}From $4.99/mo. Cancel anytime.{% endif %}</span>
        </div>

        <ul class="spi-gets" aria-label="What a personal edition carries">
            <li><strong>Your lineup, your order.</strong> Any of the network’s English shows, as one edition each morning.</li>
            <li><strong>Mira knows who it’s for.</strong> Your name, your city’s weather, and on Personal News Network a local brief with every source named aloud.</li>
            <li><strong>Your app.</strong> One private feed for Apple Podcasts, Overcast, Pocket Casts and other apps that take one.</li>
        </ul>

        <div class="spi-card" id="spi-form-card">
            <h2 class="spi-card-h">Not ready? Get the free Nerra Daily email</h2>
            <p class="spi-card-sub">The day’s stories from every Nerra show, at 7:00 AM Eastern. No card, and no charge.</p>
            <form id="spi-form" novalidate>
                <div class="spi-field">
                    <label for="spi-email">Email <span class="hint">(required)</span></label>
                    <input type="email" id="spi-email" name="email" autocomplete="email" required
                           placeholder="you@example.com" aria-required="true">
                </div>
                <div class="spi-field">
                    <label for="spi-name">First name <span class="hint">(optional)</span></label>
                    <input type="text" id="spi-name" name="first_name" autocomplete="given-name"
                           maxlength="40" placeholder="How Mira should greet you">
                </div>

                {# Honeypot — leave empty. Screen-reader hidden; bots that fill every field trip it. #}
                <div class="spi-hp" aria-hidden="true">
                    <label for="spi-company">Company</label>
                    <input type="text" id="spi-company" name="company" tabindex="-1" autocomplete="off">
                </div>

                <div class="spi-actions">
                    <button type="submit" id="spi-submit">Send me Nerra Daily</button>
                </div>
                <p class="spi-status" id="spi-status" role="status" aria-live="polite"></p>
                <p class="spi-privacy">
                    One email a day. Unsubscribe anytime.
                    <a href="{{ path_prefix }}privacy-policy.html">Privacy policy</a>.
                </p>
            </form>

            <div class="spi-confirm" id="spi-confirm" role="status">
                <p>You’re on the list. Your first Nerra Daily arrives at 7:00 AM Eastern. Shows stay free either way. When you want Personal, <a href="{{ path_prefix }}join.html">build yours here</a>; cancel anytime.</p>
            </div>
        </div>

        <p class="spi-foot">Already a member? <a href="{{ path_prefix }}account.html">Go to your account →</a></p>
    </div>
</section>

<script>
(function () {
  var API_BASE = "https://api.nerranetwork.com";
  // Default when no utm_source is present — same Jinja global as every
  // other capture form. Prefer URL utm_source via NNSubscribe.resolveSource
  // (assets/js/footer-subscribe.js) so youtube / youtube_ru / youtube_fr
  // land as src-youtube* instead of always src-nerranetwork.
  var SOURCE_DEFAULT = {{ capture_source_site | tojson }};
  var form = document.getElementById("spi-form");
  var statusEl = document.getElementById("spi-status");
  var confirmEl = document.getElementById("spi-confirm");
  var submitBtn = document.getElementById("spi-submit");
  if (!form) return;

  function resolveSource() {
    if (window.NNSubscribe && typeof window.NNSubscribe.resolveSource === "function") {
      // Stamp data-source so the shared helper's fallback matches this page.
      if (!form.getAttribute("data-source")) {
        form.setAttribute("data-source", SOURCE_DEFAULT);
      }
      return window.NNSubscribe.resolveSource(form);
    }
    return SOURCE_DEFAULT;
  }

  function say(text, state) {
    statusEl.textContent = text || "";
    statusEl.setAttribute("data-state", state || "");
  }

  form.addEventListener("submit", function (ev) {
    ev.preventDefault();
    var email = (document.getElementById("spi-email").value || "").trim();
    var firstName = (document.getElementById("spi-name").value || "").trim();
    var company = (document.getElementById("spi-company").value || "").trim();
    var SOURCE = resolveSource();

    if (!email || email.indexOf("@") < 1 || email.indexOf(".") < 0) {
      say("That email doesn’t look right. Try again.", "error");
      document.getElementById("spi-email").focus();
      return;
    }

    submitBtn.disabled = true;
    say("Saving…", "");

    // Nov 9 2026: the form is the Nerra Daily signup. The list stays
    // `personal-interest` (the ads' attribution and conversion), and
    // newsletter: true makes the Worker add `nerra-member`, the tag the
    // Nerra Daily email goes to; "SpaceX Daily" leads their email. Never
    // auto-charge Personal from this form.
    var list = "personal-interest";
    var tags = ["SpaceX Daily"];

    var body = {
      email: email,
      list: list,
      source: SOURCE,
      tags: tags,
      newsletter: true,
      // Honeypot: Worker silently accepts & discards when company is set.
      company: company
    };
    if (firstName) { body.first_name = firstName; }

    fetch(API_BASE + "/api/subscribe", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "include",
      body: JSON.stringify(body)
    }).then(function (resp) {
      return resp.json().catch(function () { return {}; })
        .then(function (data) { return { ok: resp.ok, status: resp.status, data: data }; });
    }).then(function (r) {
      if (r.status === 429) {
        throw new Error("fail");
      }
      if (!r.ok || !r.data || r.data.ok !== true) {
        throw new Error("fail");
      }
      form.hidden = true;
      confirmEl.classList.add("is-visible");
      say("", "");
      // The ads' conversion event, unchanged in name and payload so the
      // Google Ads key event keeps counting; it stays distinct from the
      // footer and show forms' signup event. Enhanced conversions:
      // consent-gated SHA-256 email via NNSubscribe.fireSoftPersonalInterestSubmit
      // (footer-subscribe.js); skip silently without consent.
      if (typeof window.gtag === "function") {
        var softPayload = {
          form_id: "personal-interest",
          page_path: "/personal-interest.html",
          list: list,
          source: SOURCE || "direct"
        };
        var fireShared = window.NNSubscribe &&
          typeof window.NNSubscribe.fireSoftPersonalInterestSubmit === "function";
        if (fireShared) {
          window.NNSubscribe.fireSoftPersonalInterestSubmit(
            email, company, softPayload);
        }
        if (!fireShared) {
          window.gtag("event", "soft_personal_interest_submit", softPayload);
        }
      }
    }).catch(function () {
      submitBtn.disabled = false;
      say("Couldn’t save that just now. Try again in a moment.", "error");
    });
  });
})();
</script>
{% endblock %}
