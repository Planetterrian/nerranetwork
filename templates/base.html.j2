<!DOCTYPE html>
<html lang="{{ page_lang | default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ meta_description }}">
    {% if marketing.gsc_verification %}<meta name="google-site-verification" content="{{ marketing.gsc_verification }}">{% endif %}
    {% if meta_keywords %}<meta name="keywords" content="{{ meta_keywords }}">{% endif %}
    <title>{{ page_title }}</title>
    {% if theme_color %}<meta name="theme-color" content="{{ theme_color }}">{% endif %}

    <!-- Open Graph -->
    <meta property="og:title" content="{{ page_title | default('Nerra Network — Independent Podcast Network') }}">
    <meta property="og:description" content="{{ page_description | default(meta_description | default('11 ad-free daily shows covering AI, Tesla, investing, space, science, environmental policy, and more. Produced in Vancouver, Canada.')) }}">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:image" content="{{ og_image | default(path_prefix ~ 'assets/og-preview.png', boolean=true) }}">
    {% if canonical_url %}<meta property="og:url" content="{{ canonical_url }}">{% endif %}
    <meta property="og:site_name" content="Nerra Network">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="{% block twitter_card %}summary_large_image{% endblock %}">
    <meta name="twitter:title" content="{{ page_title | default('Nerra Network') }}">
    <meta name="twitter:description" content="{{ page_description | default(meta_description | default('11 ad-free daily shows. Feed your curiosity. Not your anxiety.')) }}">
    <meta name="twitter:image" content="{{ og_image | default(path_prefix ~ 'assets/og-preview.png', boolean=true) }}">

    {% if canonical_url %}<link rel="canonical" href="{{ canonical_url }}">{% endif %}
    {% if rss_url %}
    <link rel="alternate" type="application/rss+xml" title="{{ show_name | default('Nerra Network') }} RSS" href="{{ rss_url }}">
    {% endif %}
    {# Bilingual hreflang — English root ↔ Russian root. Only emitted on the
       top-level Nerra landing pages, not per-show pages. #}
    {% if emit_bilingual_hreflang %}
    <link rel="alternate" hreflang="en" href="https://nerranetwork.com/index.html">
    <link rel="alternate" hreflang="ru" href="https://nerranetwork.com/ru/index.html">
    <link rel="alternate" hreflang="x-default" href="https://nerranetwork.com/index.html">
    {% endif %}

    <!-- Google Fonts: DM Sans + Source Serif 4 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='6' fill='%236B47FF'/><circle cx='20' cy='30' r='4' fill='%2300D4FF'/><circle cx='80' cy='30' r='4' fill='%2300D4FF'/><circle cx='25' cy='75' r='4' fill='%2300D4FF'/><circle cx='75' cy='75' r='4' fill='%2300D4FF'/><line x1='50' y1='50' x2='20' y2='30' stroke='%236B47FF' stroke-width='1.5' opacity='0.6'/><line x1='50' y1='50' x2='80' y2='30' stroke='%236B47FF' stroke-width='1.5' opacity='0.6'/><line x1='50' y1='50' x2='25' y2='75' stroke='%236B47FF' stroke-width='1.5' opacity='0.6'/><line x1='50' y1='50' x2='75' y2='75' stroke='%236B47FF' stroke-width='1.5' opacity='0.6'/></svg>">

    {# ---------------------------------------------------------------
       Marketing & Analytics
       Globals: marketing.ga4_measurement_id, marketing.google_ads_id,
                marketing.google_ads_signup_label, marketing.plausible_domain
       Set via env vars in generate_html.py — all empty by default.
       --------------------------------------------------------------- #}
    {% if marketing.ga4_measurement_id or marketing.google_ads_id %}
    <!-- Cookie consent (Google Consent Mode v2) — loads BEFORE gtag.js -->
    <script src="{{ path_prefix }}assets/js/consent.js"></script>
    <!-- gtag.js — covers both GA4 and Google Ads -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ marketing.ga4_measurement_id or marketing.google_ads_id }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      {% if marketing.ga4_measurement_id %}
      gtag('config', '{{ marketing.ga4_measurement_id }}', { 'anonymize_ip': true });
      {% endif %}
      {% if marketing.google_ads_id %}
      gtag('config', '{{ marketing.google_ads_id }}');
      {% if marketing.google_ads_signup_label %}
      window._GOOGLE_ADS_SIGNUP_TARGET = '{{ marketing.google_ads_id }}/{{ marketing.google_ads_signup_label }}';
      {% endif %}
      {% endif %}
    </script>
    {% endif %}
    {% if marketing.plausible_domain %}
    <script defer data-domain="{{ marketing.plausible_domain }}" src="https://plausible.io/js/script.js"></script>
    {% endif %}
    {# Tracking event helper — safe no-op when no analytics configured #}
    <script defer src="{{ path_prefix }}assets/js/tracking.js"></script>

    <!-- Shared CSS -->
    <link rel="stylesheet" href="{{ path_prefix }}styles/main.css">

    {% block head_extra %}{% endblock %}

    {% if show_color %}
    {# `--show-color-text` is a lightened variant for use as TEXT on
       the network's dark-theme background (`--nn-bg: #0B0F1A`). The
       saturated brand colors (Tesla red, FP pink, EI deep green, etc.)
       all measure < 4.1:1 on that surface — fail WCAG AA. Mixing 35 %
       white in srgb pushes every show above 5.6:1. Borders / accents /
       tinted backgrounds keep using `--show-color` directly because
       they're decorative and only need 3:1 (which they already meet). #}
    <style>:root {
      --show-color: {{ show_color }};
      --show-color-dark: {{ show_color_dark | default(show_color) }};
      --show-color-text: color-mix(in srgb, {{ show_color }}, white 35%);
    }</style>
    {% endif %}
    <style>
        @media (max-width: 768px) {
            .nn-footer-grid { grid-template-columns: 1fr; }
            .nn-footer-col h4 {
                cursor: pointer;
                position: relative;
                padding-right: 1.5rem;
            }
            .nn-footer-col h4::after {
                content: '+';
                position: absolute;
                right: 0;
                font-size: 1.2rem;
                color: var(--nn-text-muted);
            }
            .nn-footer-col.expanded h4::after { content: '\2212'; }
            .nn-footer-col > a,
            .nn-footer-col > ul { display: none; }
            .nn-footer-col.expanded > a,
            .nn-footer-col.expanded > ul { display: block; }
        }
    </style>
</head>
<body>
    {#-
      Inline chrome translations. Russian-language pages
      (`page_lang == 'ru'`) get the RU value; everything else falls
      back to EN. Keep this block at the top of <body> so any
      template that extends this base can use the ``t.<key>`` shortcuts
      below. Translated keys are deliberately scoped to chrome
      (nav, footer, subscribe form). Body content (digests, blog
      posts) stays in the source language of each page.
    -#}
    {%- set _is_ru = (page_lang | default('en')) == 'ru' -%}
    {%- set t = {
        'skip_to_content': 'Перейти к содержанию' if _is_ru else 'Skip to content',
        'nav_shows': 'Подкасты' if _is_ru else 'Shows',
        'nav_blog': 'Блог' if _is_ru else 'Blog',
        'nav_start_here': 'Начало' if _is_ru else 'Start Here',
        'nav_listen': 'Где слушать' if _is_ru else 'Listen',
        'nav_about': 'О нас' if _is_ru else 'About',
        'nav_player': 'Плеер' if _is_ru else 'Player',
        'nav_home': 'Главная' if _is_ru else 'Home',
        'nav_how_to_listen': 'Где слушать' if _is_ru else 'How to Listen',
        'mobile_all_shows': 'Все подкасты' if _is_ru else 'All Shows',
        'mobile_blogs': 'Блоги' if _is_ru else 'Blogs',
        'all_blog_posts': 'Все статьи блога' if _is_ru else 'All Blog Posts',
        'show_blog_suffix': 'блог' if _is_ru else 'Blog',
        'toggle_menu': 'Меню' if _is_ru else 'Toggle menu',
        'main_navigation': 'Главная навигация' if _is_ru else 'Main navigation',
        'footer_shows': 'Подкасты' if _is_ru else 'Shows',
        'footer_blog': 'Блог' if _is_ru else 'Blog',
        'footer_listen': 'Слушать' if _is_ru else 'Listen',
        'footer_connect': 'Контакты' if _is_ru else 'Connect',
        'footer_about': 'О сети' if _is_ru else 'About',
        'footer_brand_desc': 'Одиннадцать подкастов. Без рекламы. Независимая сеть из Ванкувера, Канада.' if _is_ru else 'Eleven shows. Zero fluff. Independent podcast network produced in Vancouver, Canada.',
        'footer_network_player': 'Плеер сети' if _is_ru else 'Network Player',
        'footer_network_rss': 'RSS сети' if _is_ru else 'Network RSS',
        'footer_about_network': 'О Nerra Network' if _is_ru else 'About Nerra Network',
        'footer_faq': 'Вопросы и ответы' if _is_ru else 'FAQ',
        'footer_contact': 'Связь' if _is_ru else 'Contact',
        'footer_press': 'Пресс-кит' if _is_ru else 'Press Kit',
        'footer_privacy': 'Конфиденциальность' if _is_ru else 'Privacy',
        'footer_terms': 'Условия' if _is_ru else 'Terms',
        'footer_privacy_policy': 'Политика конфиденциальности' if _is_ru else 'Privacy Policy',
        'footer_terms_of_service': 'Условия использования' if _is_ru else 'Terms of Service',
        'footer_ai_disclosure': 'ИИ-раскрытие' if _is_ru else 'AI Disclosure',
        'footer_network_status': 'Статус сети' if _is_ru else 'Network Status',
        'subscribe_h4': 'Подписка на обновления' if _is_ru else 'Get Show Updates',
        'subscribe_subtitle': 'Выберите подкасты, которые хотите получать на почту:' if _is_ru else 'Pick the shows you want in your inbox:',
        'subscribe_email_placeholder': 'ваш@email.ru' if _is_ru else 'your@email.com',
        'subscribe_email_aria': 'Адрес электронной почты' if _is_ru else 'Email address',
        'subscribe_button': 'Подписаться' if _is_ru else 'Subscribe',
        'subscribe_button_loading': 'Подписка…' if _is_ru else 'Subscribing…',
        'subscribe_button_done': 'Проверьте почту ✓' if _is_ru else 'Check your email ✓',
        'copyright_line': '© 2026 Nerra Network. Все шоу — независимое производство.' if _is_ru else '© 2026 Nerra Network. All shows independently produced.',
        'ai_notice': 'Nerra Network использует ИИ-инструменты в производстве контента.' if _is_ru else 'Nerra Network uses AI tools in content production.',
        'learn_more': 'Подробнее' if _is_ru else 'Learn more',
    } -%}
    <a href="#main-content" class="skip-link">{{ t.skip_to_content }}</a>
    <!-- Navigation -->
    <nav class="nn-nav" aria-label="{{ t.main_navigation }}">
        <div class="nn-nav-inner">
            <a href="{{ path_prefix }}index.html" class="nn-nav-logo">
                <img src="{{ path_prefix }}assets/nerra-logo-icon.svg" alt="Nerra Network" width="36" height="36">
                <span class="gradient-text">Nerra</span> Network
            </a>

            <ul class="nn-nav-links">
                <li class="nn-nav-dropdown">
                    <button class="nn-nav-dropdown-btn" aria-expanded="false" aria-haspopup="true">
                        {{ t.nav_shows }}
                        <svg viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div class="nn-nav-dropdown-menu" role="menu">
                        {% for s in all_shows %}
                        <a href="{{ path_prefix }}{{ s.show_page }}" role="menuitem">
                            <picture><source type="image/webp" srcset="{{ path_prefix }}{{ s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image }}-400.webp"><img src="{{ path_prefix }}{{ s.podcast_image }}" alt="" width="1400" height="1400" loading="lazy"></picture>
                            {{ s.name }}
                        </a>
                        {% endfor %}
                    </div>
                </li>
                <li class="nn-nav-dropdown">
                    <button class="nn-nav-dropdown-btn" aria-expanded="false" aria-haspopup="true">
                        {{ t.nav_blog }}
                        <svg viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div class="nn-nav-dropdown-menu">
                        <a href="{{ path_prefix }}blog/index.html" style="font-weight:600;border-bottom:1px solid var(--nn-border);padding-bottom:8px;margin-bottom:4px">
                            {{ t.all_blog_posts }}
                        </a>
                        {% for s in all_shows %}
                        <a href="{{ path_prefix }}{{ s.blog_page }}">
                            <picture><source type="image/webp" srcset="{{ path_prefix }}{{ s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image }}-400.webp"><img src="{{ path_prefix }}{{ s.podcast_image }}" alt="" width="1400" height="1400" loading="lazy"></picture>
                            {{ s.name }} {{ t.show_blog_suffix }}
                        </a>
                        {% endfor %}
                    </div>
                </li>
                {% block nav_links %}
                <li><a href="{{ path_prefix }}start-here.html">{{ t.nav_start_here }}</a></li>
                <li><a href="{{ path_prefix }}how-to-listen.html">{{ t.nav_listen }}</a></li>
                <li><a href="{{ path_prefix }}about.html">{{ t.nav_about }}</a></li>
                <li><a href="{{ path_prefix }}player.html">{{ t.nav_player }}</a></li>
                <li><a href="{{ path_prefix }}index.html">{{ t.nav_home }}</a></li>
                {% endblock %}
            </ul>

            <button class="nn-hamburger" aria-label="{{ t.toggle_menu }}" aria-expanded="false" onclick="var m=document.getElementById('mobileMenu');m.classList.toggle('open');this.setAttribute('aria-expanded',m.classList.contains('open'));document.body.classList.toggle('menu-open')">&#9776;</button>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="nn-mobile-menu">
        {% block mobile_nav_links %}
        <a href="{{ path_prefix }}start-here.html" onclick="document.getElementById('mobileMenu').classList.remove('open');document.body.classList.remove('menu-open')">{{ t.nav_start_here }}</a>
        <a href="{{ path_prefix }}how-to-listen.html" onclick="document.getElementById('mobileMenu').classList.remove('open');document.body.classList.remove('menu-open')">{{ t.nav_how_to_listen }}</a>
        <a href="{{ path_prefix }}about.html" onclick="document.getElementById('mobileMenu').classList.remove('open');document.body.classList.remove('menu-open')">{{ t.nav_about }}</a>
        <a href="{{ path_prefix }}player.html" onclick="document.getElementById('mobileMenu').classList.remove('open');document.body.classList.remove('menu-open')">{{ t.nav_player }}</a>
        <a href="{{ path_prefix }}index.html" onclick="document.getElementById('mobileMenu').classList.remove('open');document.body.classList.remove('menu-open')">{{ t.nav_home }}</a>
        {% endblock %}
        <div class="nn-mobile-shows">
            <div class="nn-mobile-shows-title">{{ t.mobile_all_shows }}</div>
            {% for s in all_shows %}
            <a href="{{ path_prefix }}{{ s.show_page }}" class="nn-mobile-show-link" onclick="document.getElementById('mobileMenu').classList.remove('open');document.body.classList.remove('menu-open')">
                <picture><source type="image/webp" srcset="{{ path_prefix }}{{ s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image }}-400.webp"><img src="{{ path_prefix }}{{ s.podcast_image }}" alt="" width="1400" height="1400" loading="lazy"></picture>
                {{ s.name }}
            </a>
            {% endfor %}
        </div>
        <div class="nn-mobile-shows">
            <div class="nn-mobile-shows-title">{{ t.mobile_blogs }}</div>
            <a href="{{ path_prefix }}blog/index.html" class="nn-mobile-show-link" style="font-weight:600" onclick="document.getElementById('mobileMenu').classList.remove('open');document.body.classList.remove('menu-open')">
                {{ t.all_blog_posts }}
            </a>
            {% for s in all_shows %}
            <a href="{{ path_prefix }}{{ s.blog_page }}" class="nn-mobile-show-link" onclick="document.getElementById('mobileMenu').classList.remove('open');document.body.classList.remove('menu-open')">
                <picture><source type="image/webp" srcset="{{ path_prefix }}{{ s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image }}-400.webp"><img src="{{ path_prefix }}{{ s.podcast_image }}" alt="" width="1400" height="1400" loading="lazy"></picture>
                {{ s.name }} {{ t.show_blog_suffix }}
            </a>
            {% endfor %}
        </div>
    </div>

    <main id="main-content">
    {% block content %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="nn-footer">
        <div class="container">
            <div class="nn-footer-grid">
                <div>
                    <div class="nn-footer-brand"><span class="gradient-text">Nerra</span> Network</div>
                    <p class="nn-footer-desc">{{ t.footer_brand_desc }}</p>
                </div>
                <div class="nn-footer-col">
                    <h4>{{ t.footer_shows }}</h4>
                    {% for s in all_shows %}
                    <a href="{{ path_prefix }}{{ s.show_page }}">{{ s.name }}</a>
                    {% endfor %}
                </div>
                <div class="nn-footer-col">
                    <h4>{{ t.footer_blog }}</h4>
                    <a href="{{ path_prefix }}blog/index.html">{{ t.all_blog_posts }}</a>
                    {% for s in all_shows %}
                    <a href="{{ path_prefix }}{{ s.blog_page }}">{{ s.name }}</a>
                    {% endfor %}
                    <a href="{{ path_prefix }}blog.rss">{% if _is_ru %}RSS блога (все подкасты){% else %}Blog RSS (All Shows){% endif %}</a>
                </div>
                <div class="nn-footer-col">
                    <h4>{{ t.footer_listen }}</h4>
                    <a href="{{ path_prefix }}how-to-listen.html" style="font-weight:600">{{ t.nav_how_to_listen }}</a>
                    <a href="{{ path_prefix }}player.html" style="font-weight:600">{{ t.footer_network_player }}</a>
                    <a href="{{ 'https://podcasts.apple.com/us/podcast/tesla-shorts-time/id1855142939' | with_utm(campaign='tesla', medium='footer') }}" target="_blank" rel="noopener" data-show="tesla">Apple Podcasts</a>
                    <a href="{{ path_prefix }}network.rss">{{ t.footer_network_rss }}</a>
                    {% for s in all_shows %}
                    <a href="{{ path_prefix }}{{ s.rss_file }}">{{ s.name }} RSS</a>
                    {% endfor %}
                </div>
                <div class="nn-footer-col">
                    <h4>{{ t.footer_connect }}</h4>
                    <a href="https://x.com/teslashortstime" target="_blank" rel="noopener">@teslashortstime</a>
                    <a href="https://x.com/omniviewnews" target="_blank" rel="noopener">@omniviewnews</a>
                    <a href="https://x.com/planetterrian" target="_blank" rel="noopener">@planetterrian</a>
                </div>
            </div>
            <div class="nn-footer-col">
                <h4>{{ t.footer_about }}</h4>
                <a href="{{ path_prefix }}about.html">{{ t.footer_about_network }}</a>
                <a href="{{ path_prefix }}start-here.html">{{ t.nav_start_here }}</a>
                <a href="{{ path_prefix }}how-to-listen.html">{{ t.nav_how_to_listen }}</a>
                <a href="{{ path_prefix }}faq.html">{{ t.footer_faq }}</a>
                <a href="{{ path_prefix }}contact.html">{{ t.footer_contact }}</a>
                <a href="{{ path_prefix }}press.html">{{ t.footer_press }}</a>
                <a href="{{ path_prefix }}privacy-policy.html">{{ t.footer_privacy_policy }}</a>
                <a href="{{ path_prefix }}terms-of-service.html">{{ t.footer_terms_of_service }}</a>
                <a href="{{ path_prefix }}ai-disclosure.html">{{ t.footer_ai_disclosure }}</a>
                <a href="{{ path_prefix }}editorial.html">{% if _is_ru %}Редакционная политика{% else %}Editorial Process{% endif %}</a>
                <a href="{{ path_prefix }}management.html">{{ t.footer_network_status }}</a>
            </div>
            <!-- Newsletter Subscribe -->
            <div class="nn-footer-subscribe">
                <form action="https://buttondown.com/api/emails/embed-subscribe/patricknovak1" method="post" target="popupwindow" class="nn-subscribe-form"
                      onsubmit="var btn=this.querySelector('button[type=submit]');btn.disabled=true;btn.textContent={{ t.subscribe_button_loading | tojson }};setTimeout(function(){btn.textContent={{ t.subscribe_button_done | tojson }};btn.disabled=false;},500);">
                    <h4>{{ t.subscribe_h4 }}</h4>
                    <p>{{ t.subscribe_subtitle }}</p>
                    <div class="nn-subscribe-tags">
                        <label><input type="checkbox" name="tag" value="Tesla Shorts Time"> Tesla Shorts Time</label>
                        <label><input type="checkbox" name="tag" value="Fascinating Frontiers"> Fascinating Frontiers</label>
                        <label><input type="checkbox" name="tag" value="Models & Agents for Beginners"> Models & Agents for Beginners</label>
                        <label><input type="checkbox" name="tag" value="Environmental Intelligence"> Environmental Intelligence</label>
                        <label><input type="checkbox" name="tag" value="Modern Investing Techniques"> Modern Investing Techniques</label>
                        {#- Use ASCII tags here so they match the per-show YAML
                            ``newsletter.tag`` values exactly. Buttondown rejects
                            non-ASCII tags; mismatches between this footer form
                            and the YAML split subscribers across two never-merged
                            tags (operator caught this on FP, May 2026 audit). -#}
                        <label><input type="checkbox" name="tag" value="Finansy Prosto"> Финансы Просто</label>
                        <label><input type="checkbox" name="tag" value="Privet Russian"> Привет, Русский!</label>
                    </div>
                    <div class="nn-subscribe-row">
                        <input type="email" name="email" placeholder="{{ t.subscribe_email_placeholder }}" required aria-label="{{ t.subscribe_email_aria }}">
                        <input type="hidden" value="1" name="embed">
                        <button type="submit">{{ t.subscribe_button }}</button>
                    </div>
                </form>
            </div>
            <div class="nn-footer-bottom">
                <span>{{ t.copyright_line }}</span>
                <a href="{{ path_prefix }}index.html">nerranetwork.com</a>
            </div>
            <div class="nn-footer-legal">
                <p class="ai-notice">{{ t.ai_notice }} <a href="{{ path_prefix }}ai-disclosure.html">{{ t.learn_more }}</a></p>
                <div>
                    <a href="{{ path_prefix }}privacy-policy.html">{{ t.footer_privacy }}</a> &middot;
                    <a href="{{ path_prefix }}terms-of-service.html">{{ t.footer_terms }}</a> &middot;
                    <a href="{{ path_prefix }}ai-disclosure.html">{{ t.footer_ai_disclosure }}</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
    // Toggle aria-expanded on dropdown hover/focus
    document.querySelectorAll('.nn-nav-dropdown').forEach(function(dd) {
        var btn = dd.querySelector('.nn-nav-dropdown-btn');
        if (!btn) return;
        dd.addEventListener('mouseenter', function() { btn.setAttribute('aria-expanded', 'true'); });
        dd.addEventListener('mouseleave', function() { btn.setAttribute('aria-expanded', 'false'); });
        btn.addEventListener('focus', function() { btn.setAttribute('aria-expanded', 'true'); });
        btn.addEventListener('blur', function() {
            setTimeout(function() {
                if (!dd.contains(document.activeElement)) btn.setAttribute('aria-expanded', 'false');
            }, 100);
        });
    });
    // Mobile footer accordions
    if (window.innerWidth <= 768) {
        document.querySelectorAll('.nn-footer-col h4').forEach(function(h4) {
            h4.addEventListener('click', function() {
                h4.parentElement.classList.toggle('expanded');
            });
        });
    }
    </script>
    {% block scripts %}{% endblock %}
</body>
</html>
