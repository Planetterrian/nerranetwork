    <script>
    // Member-aware nav (Aug 30 2026): the "Join" pill becomes "My Nerra"
    // when the api.nerranetwork.com session cookie answers. Fail-silent —
    // signed-out visitors, blocked cookies, or an unreachable Worker all
    // leave the default Join link untouched.
    (function () {
      try {
        fetch('https://api.nerranetwork.com/api/account', { credentials: 'include' })
          .then(function (r) {
            if (!r.ok) return;
            ['nn-nav-account', 'nn-nav-account-m'].forEach(function (id) {
              var a = document.getElementById(id);
              if (a) { a.textContent = 'My Nerra'; a.href = '{{ path_prefix }}account.html'; }
            });
          }).catch(function () {});
      } catch (e) {}
    })();
    </script>
