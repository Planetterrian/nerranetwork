    <script>
    // Nav dropdowns: hover opens via CSS; click / Enter / Space toggle the
    // `.open` class so keyboard and touch users can actually open them
    // (until Sep 2026 focus set aria-expanded="true" while nothing was
    // visible). Escape or an outside click closes any open menu.
    (function () {
        var dropdowns = Array.prototype.slice.call(document.querySelectorAll('.nn-nav-dropdown'));
        function closeAll(except) {
            dropdowns.forEach(function (d) {
                if (d === except) return;
                d.classList.remove('open');
                var b = d.querySelector('.nn-nav-dropdown-btn');
                if (b) b.setAttribute('aria-expanded', 'false');
            });
        }
        dropdowns.forEach(function (dd) {
            var btn = dd.querySelector('.nn-nav-dropdown-btn');
            if (!btn) return;
            dd.addEventListener('mouseenter', function () { btn.setAttribute('aria-expanded', 'true'); });
            dd.addEventListener('mouseleave', function () {
                if (!dd.classList.contains('open')) btn.setAttribute('aria-expanded', 'false');
            });
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                var willOpen = !dd.classList.contains('open');
                closeAll(dd);
                dd.classList.toggle('open', willOpen);
                btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
            });
            dd.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    dd.classList.remove('open');
                    btn.setAttribute('aria-expanded', 'false');
                    btn.focus();
                }
            });
            dd.addEventListener('focusout', function () {
                setTimeout(function () {
                    if (!dd.contains(document.activeElement)) {
                        dd.classList.remove('open');
                        btn.setAttribute('aria-expanded', 'false');
                    }
                }, 100);
            });
        });
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.nn-nav-dropdown')) closeAll(null);
        });
    })();
    // Mobile menu: one delegated close handler for every link inside it.
    (function () {
        var menu = document.getElementById('mobileMenu');
        var burger = document.querySelector('.nn-hamburger');
        if (!menu) return;
        menu.addEventListener('click', function (e) {
            if (!e.target.closest('a')) return;
            menu.classList.remove('open');
            document.body.classList.remove('menu-open');
            if (burger) burger.setAttribute('aria-expanded', 'false');
        });
    })();
    // Footer accordions on narrow screens. Bound at every width (the CSS
    // decides whether the toggle has any visible effect) so a rotate or
    // resize after load can never strand the links hidden; headers are
    // keyboard-operable.
    document.querySelectorAll('.nn-footer-col h4').forEach(function (h4) {
        h4.setAttribute('role', 'button');
        h4.setAttribute('tabindex', '0');
        h4.setAttribute('aria-expanded', 'false');
        function toggle() {
            var on = h4.parentElement.classList.toggle('expanded');
            h4.setAttribute('aria-expanded', on ? 'true' : 'false');
        }
        h4.addEventListener('click', toggle);
        h4.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
        });
    });
    </script>
