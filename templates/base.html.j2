<!DOCTYPE html>
<html lang="{{ page_lang | default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ meta_description }}">
    {% if marketing.gsc_verification %}<meta name="google-site-verification" content="{{ marketing.gsc_verification }}">{% endif %}
    {% if meta_keywords %}<meta name="keywords" content="{{ meta_keywords }}">{% endif %}
    {#- Templates may override ``block title``; the default is the
        ``page_title`` context value. Six templates declared a title
        block that nothing rendered (Sep 2026 review) — the MIT
        performance page shipped an EMPTY <title> because it relied
        on the block alone. Both paths now work. -#}
    <title>{% block title %}{{ page_title }}{% endblock %}</title>
    {% if theme_color %}<meta name="theme-color" content="{{ theme_color }}">{% endif %}

    <!-- Open Graph -->
    <meta property="og:title" content="{{ page_title | default('Nerra Network — Independent Podcast Network') }}">
    <meta property="og:description" content="{{ page_description | default(meta_description | default('Daily ad-free shows covering AI, Tesla, investing, space, science, environmental policy, and more. Produced in Vancouver, Canada.')) }}">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:image" content="{{ og_image | default('https://nerranetwork.com/assets/og-preview.png', boolean=true) }}">
    {% if canonical_url %}<meta property="og:url" content="{{ canonical_url }}">{% endif %}
    <meta property="og:site_name" content="Nerra Network">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="{% block twitter_card %}summary_large_image{% endblock %}">
    <meta name="twitter:title" content="{{ page_title | default('Nerra Network') }}">
    <meta name="twitter:description" content="{{ page_description | default(meta_description | default('Daily ad-free shows. Feed your curiosity. Not your anxiety.')) }}">
    <meta name="twitter:image" content="{{ og_image | default('https://nerranetwork.com/assets/og-preview.png', boolean=true) }}">

    {% if canonical_url %}<link rel="canonical" href="{{ canonical_url }}">{% endif %}
    {% if rss_url %}
    <link rel="alternate" type="application/rss+xml" title="{{ show_name | default('Nerra Network') }} RSS" href="{{ rss_url }}">
    {% endif %}
    {# Bilingual hreflang — English root ↔ Russian root. Only emitted on the
       top-level Nerra landing pages, not per-show pages. #}
    {% if emit_bilingual_hreflang %}
    <link rel="alternate" hreflang="en" href="https://nerranetwork.com/">
    <link rel="alternate" hreflang="ru" href="https://nerranetwork.com/ru/">
    <link rel="alternate" hreflang="x-default" href="https://nerranetwork.com/">
    {% endif %}

    <!-- Google Fonts: DM Sans + Source Serif 4 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%230B0F1A'/><line x1='50' y1='50' x2='28' y2='28' stroke='%236B47FF' stroke-width='5' stroke-linecap='round'/><line x1='50' y1='50' x2='72' y2='28' stroke='%2300D4FF' stroke-width='5' stroke-linecap='round'/><line x1='50' y1='50' x2='28' y2='72' stroke='%236B47FF' stroke-width='5' stroke-linecap='round'/><line x1='50' y1='50' x2='72' y2='72' stroke='%2300D4FF' stroke-width='5' stroke-linecap='round'/><circle cx='28' cy='28' r='8' fill='%2300D4FF'/><circle cx='72' cy='28' r='8' fill='%236B47FF'/><circle cx='28' cy='72' r='8' fill='%236B47FF'/><circle cx='72' cy='72' r='8' fill='%2300D4FF'/><circle cx='50' cy='50' r='13' fill='%236B47FF'/><circle cx='50' cy='50' r='5' fill='white'/></svg>">

    {# ---------------------------------------------------------------
       Marketing & Analytics
       Globals: marketing.ga4_measurement_id, marketing.google_ads_id,
                marketing.google_ads_signup_label, marketing.plausible_domain
       Set via env vars in generate_html.py — all empty by default.
       --------------------------------------------------------------- #}
    {% if marketing.ga4_measurement_id or marketing.google_ads_id %}
    <!-- Cookie consent (Google Consent Mode v2) — loads BEFORE gtag.js -->
    <script src="{{ path_prefix }}assets/js/consent.js"></script>
    <!-- gtag.js — covers both GA4 and Google Ads -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ marketing.ga4_measurement_id or marketing.google_ads_id }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      {% if marketing.ga4_measurement_id %}
      gtag('config', '{{ marketing.ga4_measurement_id }}', { 'anonymize_ip': true });
      {% endif %}
      {% if marketing.google_ads_id %}
      gtag('config', '{{ marketing.google_ads_id }}');
      {% if marketing.google_ads_signup_label %}
      window._GOOGLE_ADS_SIGNUP_TARGET = '{{ marketing.google_ads_id }}/{{ marketing.google_ads_signup_label }}';
      {% endif %}
      {% endif %}
    </script>
    {% endif %}
    {% if marketing.plausible_domain %}
    <script defer data-domain="{{ marketing.plausible_domain }}" src="https://plausible.io/js/script.js"></script>
    {% endif %}
    {# Tracking event helper — safe no-op when no analytics configured #}
    <script defer src="{{ path_prefix }}assets/js/tracking.js"></script>

    <!-- Shared CSS -->
    <link rel="stylesheet" href="{{ path_prefix }}styles/main.css">

    {% block head_extra %}{% endblock %}

    {% if show_color %}
    {# `--show-color-text` is a lightened variant for use as TEXT on
       the network's dark-theme background (`--nn-bg: #0B0F1A`). The
       saturated brand colors (Tesla red, FP pink, EI deep green, etc.)
       all measure < 4.1:1 on that surface — fail WCAG AA. Mixing 35 %
       white in srgb pushes every show above 5.6:1. Borders / accents /
       tinted backgrounds keep using `--show-color` directly because
       they're decorative and only need 3:1 (which they already meet). #}
    <style>:root {
      --show-color: {{ show_color }};
      --show-color-dark: {{ show_color_dark | default(show_color) }};
      --show-color-text: color-mix(in srgb, {{ show_color }}, white 35%);
    }</style>
    {% endif %}
    <style>
        @media (max-width: 768px) {
            .nn-footer-grid { grid-template-columns: 1fr; }
            .nn-footer-col h4 {
                cursor: pointer;
                position: relative;
                padding-right: 1.5rem;
            }
            .nn-footer-col h4::after {
                content: '+';
                position: absolute;
                right: 0;
                font-size: 1.2rem;
                color: var(--nn-text-muted);
            }
            .nn-footer-col.expanded h4::after { content: '\2212'; }
            .nn-footer-col > a,
            .nn-footer-col > ul { display: none; }
            .nn-footer-col.expanded > a,
            .nn-footer-col.expanded > ul { display: block; }
        }
    </style>
</head>
<body>
    {#-
      Inline chrome translations. Russian-language pages
      (`page_lang == 'ru'`) get the RU value; everything else falls
      back to EN. Keep this block at the top of <body> so any
      template that extends this base can use the ``t.<key>`` shortcuts
      below. Translated keys are deliberately scoped to chrome
      (nav, footer, subscribe form). Body content (digests, blog
      posts) stays in the source language of each page.
    -#}
    {%- set _is_ru = (page_lang | default('en')) == 'ru' -%}
    {%- set t = {
        'skip_to_content': 'Перейти к содержанию' if _is_ru else 'Skip to content',
        'nav_shows': 'Подкасты' if _is_ru else 'Shows',
        'nav_blog': 'Блог' if _is_ru else 'Blog',
        'nav_start_here': 'Начало' if _is_ru else 'Start Here',
        'nav_listen': 'Где слушать' if _is_ru else 'Listen',
        'nav_about': 'О нас' if _is_ru else 'About',
        'nav_player': 'Плеер' if _is_ru else 'Player',
        'nav_home': 'Главная' if _is_ru else 'Home',
        'nav_how_to_listen': 'Где слушать' if _is_ru else 'How to Listen',
        'mobile_all_shows': 'Все подкасты' if _is_ru else 'All Shows',
        'mobile_blogs': 'Блоги' if _is_ru else 'Blogs',
        'all_blog_posts': 'Все статьи блога' if _is_ru else 'All Blog Posts',
        'show_blog_suffix': 'блог' if _is_ru else 'Blog',
        'toggle_menu': 'Меню' if _is_ru else 'Toggle menu',
        'main_navigation': 'Главная навигация' if _is_ru else 'Main navigation',
        'footer_shows': 'Подкасты' if _is_ru else 'Shows',
        'footer_blog': 'Блог' if _is_ru else 'Blog',
        'footer_listen': 'Слушать' if _is_ru else 'Listen',
        'footer_connect': 'Контакты' if _is_ru else 'Connect',
        'footer_about': 'О сети' if _is_ru else 'About',
        'footer_brand_desc': 'Без рекламы. Независимая сеть из Ванкувера, Канада.' if _is_ru else 'Zero fluff. Independent podcast network produced in Vancouver, Canada.',
        'footer_network_player': 'Плеер сети' if _is_ru else 'Network Player',
        'footer_network_rss': 'RSS сети' if _is_ru else 'Network RSS',
        'footer_about_network': 'О Nerra Network' if _is_ru else 'About Nerra Network',
        'footer_faq': 'Вопросы и ответы' if _is_ru else 'FAQ',
        'footer_contact': 'Связь' if _is_ru else 'Contact',
        'footer_press': 'Пресс-кит' if _is_ru else 'Press Kit',
        'footer_privacy': 'Конфиденциальность' if _is_ru else 'Privacy',
        'footer_terms': 'Условия' if _is_ru else 'Terms',
        'footer_privacy_policy': 'Политика конфиденциальности' if _is_ru else 'Privacy Policy',
        'footer_terms_of_service': 'Условия использования' if _is_ru else 'Terms of Service',
        'footer_ai_disclosure': 'ИИ-раскрытие' if _is_ru else 'AI Disclosure',
        'footer_network_status': 'Статус сети' if _is_ru else 'Network Status',
        'nav_more': 'Ещё' if _is_ru else 'More',
        'nav_books': 'Книги' if _is_ru else 'Books',
        'nav_gallery': 'Галерея' if _is_ru else 'Image Gallery',
        'nav_data': 'Данные и дашборды' if _is_ru else 'Data & Dashboards',
        'nav_editorial': 'Редакционная политика' if _is_ru else 'Editorial Process',
        'nav_support': 'Поддержать сеть' if _is_ru else 'Support the Network',
        'subscribe_h4': 'Подписка на обновления' if _is_ru else 'Get Show Updates',
        'subscribe_subtitle': 'Выберите подкасты, которые хотите получать на почту:' if _is_ru else 'Pick the shows you want in your inbox:',
        'subscribe_email_placeholder': 'ваш@email.ru' if _is_ru else 'your@email.com',
        'subscribe_email_aria': 'Адрес электронной почты' if _is_ru else 'Email address',
        'subscribe_button': 'Подписаться' if _is_ru else 'Subscribe',
        'subscribe_button_loading': 'Подписка…' if _is_ru else 'Subscribing…',
        'subscribe_button_done': 'Проверьте почту ✓' if _is_ru else 'Check your email ✓',
        'copyright_line': ('© ' ~ current_year ~ ' Nerra Network. Все шоу — независимое производство.') if _is_ru else ('© ' ~ current_year ~ ' Nerra Network. All shows independently produced.'),
        'ai_notice': 'Nerra Network использует ИИ-инструменты в производстве контента.' if _is_ru else 'Nerra Network uses AI tools in content production.',
        'learn_more': 'Подробнее' if _is_ru else 'Learn more',
    } -%}
    <a href="#main-content" class="skip-link">{{ t.skip_to_content }}</a>
    <!-- Navigation -->
    <nav class="nn-nav" aria-label="{{ t.main_navigation }}">
        <div class="nn-nav-inner">
            <a href="{{ path_prefix }}index.html" class="nn-nav-logo">
                <img src="{{ path_prefix }}assets/nerra-logo-icon.svg" alt="Nerra Network" width="36" height="36">
                <span class="gradient-text">Nerra</span> <span class="nn-wordmark-rest">Network</span>
            </a>

            {# Global search (Item 2, May 2026 review) — powered by server-built
               Content Lake FTS index (scripts/build_search_index.py). Single
               fetch of a compact JSON; rich client ranking + all shows + entities.
               Zero ongoing backend cost (static site). #}
            <div class="nn-global-search" style="position:relative;margin-left:auto;margin-right:0.5rem;max-width:200px;flex:0 1 200px;min-width:110px;">
                <input type="search" id="nn-global-search-input"
                       placeholder="Search…"
                       style="width:100%;padding:6px 8px;border-radius:999px;border:1px solid var(--nn-border);background:var(--nn-surface);color:inherit;font-size:0.85rem;"
                       aria-label="Search all episodes across the network">
                <div id="nn-global-search-results"
                     style="display:none;position:absolute;top:100%;left:0;right:0;margin-top:4px;background:var(--nn-surface);border:1px solid var(--nn-border);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.25);max-height:340px;overflow:auto;z-index:1000;font-size:0.85rem;"></div>
            </div>

            {# Audio-language control (multilingual audio, June 2026). Sets a
               site-wide preference for which language episode AUDIO plays in —
               the page text is unaffected (hence the "Audio" label). Reads/
               writes the same `nn-pref-lang` localStorage key the episode +
               show-page players use, and dispatches `nn-langchange` so an
               on-page player switches live. Wired by assets/js/language-control.js. #}
            <style>
                #nn-lang-menu .nn-lang-opt{display:block;width:100%;text-align:left;padding:7px 12px;background:none;border:none;color:inherit;font-size:0.85rem;cursor:pointer;}
                #nn-lang-menu .nn-lang-opt:hover{background:var(--nn-card);}
                #nn-lang-menu .nn-lang-opt[aria-checked="true"]{color:var(--nn-purple,#a78bfa);font-weight:600;}
            </style>
            <div class="nn-lang-control" style="position:relative;margin-right:0.5rem;flex:0 0 auto;">
                <button type="button" id="nn-lang-toggle" aria-haspopup="true" aria-expanded="false"
                        aria-label="Audio language for episodes" title="Choose the audio language for episodes (page text stays the same)"
                        style="display:inline-flex;align-items:center;gap:5px;padding:6px 10px;border-radius:999px;border:1px solid var(--nn-border);background:var(--nn-surface);color:inherit;font-size:0.8rem;cursor:pointer;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    <span id="nn-lang-current">EN</span>
                </button>
                <div id="nn-lang-menu" role="menu" aria-label="Audio language"
                     style="display:none;position:absolute;top:100%;right:0;margin-top:4px;min-width:160px;background:var(--nn-surface);border:1px solid var(--nn-border);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.25);z-index:1000;overflow:hidden;padding-bottom:4px;">
                    <div style="padding:8px 12px 4px;font-size:0.66rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--nn-text-muted);">Episode audio language</div>
                    <button type="button" role="menuitemradio" data-lang="en" class="nn-lang-opt" aria-checked="true">English</button>
                    <button type="button" role="menuitemradio" data-lang="fr" class="nn-lang-opt" aria-checked="false">Français</button>
                    <button type="button" role="menuitemradio" data-lang="ru" class="nn-lang-opt" aria-checked="false">Русский</button>
                    <button type="button" role="menuitemradio" data-lang="zh" class="nn-lang-opt" aria-checked="false">中文</button>
                </div>
            </div>

            <ul class="nn-nav-links">
                <li class="nn-nav-dropdown">
                    <button class="nn-nav-dropdown-btn" aria-expanded="false" aria-haspopup="true">
                        {{ t.nav_shows }}
                        <svg viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div class="nn-nav-dropdown-menu" role="menu">
                        {% for s in all_shows %}
                        <a href="{{ path_prefix }}{{ s.show_page }}" role="menuitem">
                            <picture><source type="image/webp" srcset="{{ path_prefix }}{{ s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image }}-400.webp"><img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" width="1400" height="1400" loading="lazy"></picture>
                            {{ s.name }}
                        </a>
                        {% endfor %}
                    </div>
                </li>
                <li class="nn-nav-dropdown">
                    <button class="nn-nav-dropdown-btn" aria-expanded="false" aria-haspopup="true">
                        {{ t.nav_blog }}
                        <svg viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div class="nn-nav-dropdown-menu">
                        <a href="{{ path_prefix }}blog/index.html" style="font-weight:600;border-bottom:1px solid var(--nn-border);padding-bottom:8px;margin-bottom:4px">
                            {{ t.all_blog_posts }}
                        </a>
                        {% for s in all_shows %}
                        <a href="{{ path_prefix }}{{ s.blog_page }}">
                            <picture><source type="image/webp" srcset="{{ path_prefix }}{{ s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image }}-400.webp"><img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" width="1400" height="1400" loading="lazy"></picture>
                            {{ s.name }} {{ t.show_blog_suffix }}
                        </a>
                        {% endfor %}
                    </div>
                </li>
                {# "More" (Sep 2026 review): Books, the gallery, the data
                   dashboards, the editorial page and the support page are
                   real products that were reachable only from the ~70-link
                   footer. One compact dropdown, mirrored in the mobile menu. #}
                <li class="nn-nav-dropdown">
                    <button class="nn-nav-dropdown-btn" aria-expanded="false" aria-haspopup="true">
                        {{ t.nav_more }}
                        <svg viewBox="0 0 12 12" fill="none"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div class="nn-nav-dropdown-menu nn-nav-dropdown-menu--compact">
                        <a href="{{ path_prefix }}books.html">{{ t.nav_books }}</a>
                        <a href="{{ path_prefix }}gallery.html">{{ t.nav_gallery }}</a>
                        <a href="{{ path_prefix }}data.html">{{ t.nav_data }}</a>
                        <a href="{{ path_prefix }}editorial.html">{{ t.nav_editorial }}</a>
                        <a href="{{ path_prefix }}faq.html">{{ t.footer_faq }}</a>
                        <a href="{{ path_prefix }}press.html">{{ t.footer_press }}</a>
                        <a href="{{ path_prefix }}support.html">{{ t.nav_support }}</a>
                    </div>
                </li>
                {# The logo is the home link; a separate "Home" item was
                   redundant on every page but the homepage (which already
                   overrode it away) — removed Sep 2026. #}
                {% block nav_links %}
                <li><a href="{{ path_prefix }}start-here.html">{{ t.nav_start_here }}</a></li>
                <li><a href="{{ path_prefix }}how-to-listen.html">{{ t.nav_listen }}</a></li>
                <li><a href="{{ path_prefix }}about.html">{{ t.nav_about }}</a></li>
                <li><a href="{{ path_prefix }}player.html">{{ t.nav_player }}</a></li>
                {% endblock %}
                {# Membership entry point (Aug 30 2026): "Join" by default;
                   assets/js/tracking-free member probe below swaps it to
                   "My Nerra" when the api.nerranetwork.com cookie is live,
                   so signed-in visitors always have a one-click path to
                   their dashboard. Deliberately OUTSIDE the nav_links
                   block so per-page nav overrides keep it. #}
                <li><a id="nn-nav-account" href="{{ path_prefix }}join.html"
                       style="border:1px solid var(--nn-border);border-radius:999px;padding:0.3rem 0.85rem;">{{ t.get('nav_join', 'Join') }}</a></li>
            </ul>

            <button class="nn-hamburger" aria-label="{{ t.toggle_menu }}" aria-expanded="false" onclick="var m=document.getElementById('mobileMenu');m.classList.toggle('open');this.setAttribute('aria-expanded',m.classList.contains('open'));document.body.classList.toggle('menu-open')">&#9776;</button>
        </div>
    </nav>

    <!-- Mobile Menu. Closing is handled by ONE delegated listener in the
         script block below (any link tapped closes the menu, clears the
         body scroll lock and resets the hamburger's aria-expanded) — the
         per-link inline onclick handlers were removed Sep 2026 after the
         homepage's override forgot the body class and left the page
         scroll-locked after tapping an in-page anchor. -->
    <div id="mobileMenu" class="nn-mobile-menu">
        <a id="nn-nav-account-m" href="{{ path_prefix }}join.html" style="font-weight:600;">{{ t.get('nav_join', 'Join') }}</a>
        {% block mobile_nav_links %}
        <a href="{{ path_prefix }}start-here.html">{{ t.nav_start_here }}</a>
        <a href="{{ path_prefix }}how-to-listen.html">{{ t.nav_how_to_listen }}</a>
        <a href="{{ path_prefix }}about.html">{{ t.nav_about }}</a>
        <a href="{{ path_prefix }}player.html">{{ t.nav_player }}</a>
        {% endblock %}
        <div class="nn-mobile-shows">
            <div class="nn-mobile-shows-title">{{ t.mobile_all_shows }}</div>
            {% for s in all_shows %}
            <a href="{{ path_prefix }}{{ s.show_page }}" class="nn-mobile-show-link">
                <picture><source type="image/webp" srcset="{{ path_prefix }}{{ s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image }}-400.webp"><img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" width="1400" height="1400" loading="lazy"></picture>
                {{ s.name }}
            </a>
            {% endfor %}
        </div>
        <div class="nn-mobile-shows">
            <div class="nn-mobile-shows-title">{{ t.mobile_blogs }}</div>
            <a href="{{ path_prefix }}blog/index.html" class="nn-mobile-show-link" style="font-weight:600">
                {{ t.all_blog_posts }}
            </a>
            {% for s in all_shows %}
            <a href="{{ path_prefix }}{{ s.blog_page }}" class="nn-mobile-show-link">
                <picture><source type="image/webp" srcset="{{ path_prefix }}{{ s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image }}-400.webp"><img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" width="1400" height="1400" loading="lazy"></picture>
                {{ s.name }} {{ t.show_blog_suffix }}
            </a>
            {% endfor %}
        </div>
        <div class="nn-mobile-shows">
            <div class="nn-mobile-shows-title">{{ t.nav_more }}</div>
            <a href="{{ path_prefix }}books.html" class="nn-mobile-show-link">{{ t.nav_books }}</a>
            <a href="{{ path_prefix }}gallery.html" class="nn-mobile-show-link">{{ t.nav_gallery }}</a>
