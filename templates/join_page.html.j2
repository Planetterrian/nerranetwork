{% block scripts %}
<script>
(function () {
  'use strict';
  var SHOWS = {{ personal_shows | map(attribute='slug') | list | tojson }};
  var META = {};
  {%- for s in personal_shows %}
  META[{{ s.slug | tojson }}] = { name: {{ s.name | tojson }}, cover: {{ (path_prefix ~ (s.cover_webp or s.cover)) | tojson }}, minutes: {{ (s.minutes or 0) | tojson }}, color: {{ s.brand_color | tojson }}, members: {{ (s.access_note | length > 0) | tojson }} };
  {%- endfor %}
  var STARTER = ['spacex', 'tesla', 'models_agents', 'planetterrian'];
  var DRAFT = 'nnMe.draft';
  function load() { try { return JSON.parse(localStorage.getItem(DRAFT) || 'null'); } catch (e) { return null; } }
  function save(d) { try { localStorage.setItem(DRAFT, JSON.stringify(d)); } catch (e) {} }
  function track(name, params) { try { if (typeof window.gtag === 'function') { window.gtag('event', name, params || {}); } } catch (e) {} }
  var d = load() || {};
  var picks = (d.shows || []).filter(function (s) { return META[s]; });
  var nameIn = document.getElementById('jn-name'), cityIn = document.getElementById('jn-city');
  if (nameIn && d.first_name) { nameIn.value = d.first_name; }
  if (cityIn && d.city) { cityIn.value = d.city; }
  function persist() {
    save({ shows: picks, first_name: nameIn ? nameIn.value.trim().slice(0, 40) : '', city: cityIn ? cityIn.value.trim().slice(0, 60) : '', ts: Date.now() });
  }
  function txt(tag, cls, text) { var n = document.createElement(tag); if (cls) { n.className = cls; } n.textContent = text; return n; }
  function render() {
    document.querySelectorAll('.nn-showcard').forEach(function (c) {
      var on = picks.indexOf(c.getAttribute('data-slug')) !== -1;
      c.classList.toggle('is-on', on);
      var b = c.querySelector('[data-jn-toggle]');
      if (b) { b.setAttribute('aria-pressed', on ? 'true' : 'false'); b.textContent = on ? '✓' : '+'; }
    });
    var list = document.querySelector('[data-jn-list]');
    if (!list) { return; }
    var shown = picks.length ? picks : STARTER.filter(function (s) { return META[s]; });
    var name = nameIn && nameIn.value.trim();
    var city = cityIn && cityIn.value.trim();
    var greet = document.querySelector('[data-jn-greet]');
    greet.textContent = '';
    greet.appendChild(document.createTextNode('“Good morning, '));
    greet.appendChild(txt('em', '', name || 'Alex'));
    greet.appendChild(document.createTextNode('. Here\'s your morning.”'));
    list.textContent = '';
    var brief = document.createElement('li'); brief.className = 'is-mira';
    brief.appendChild(txt('span', 'ic', '🌤️')); brief.firstChild.setAttribute('aria-hidden', 'true');
    brief.appendChild(txt('span', 'nm', city ? city.split(',')[0] + "'s morning brief" : "Your city's morning brief"));
    brief.appendChild(txt('span', 'ln', 'Mira'));
    list.appendChild(brief);
    var total = 0;
    shown.forEach(function (slug) {
      var m = META[slug]; if (!m) { return; }
      total += m.minutes || 0;
      var li = document.createElement('li'); li.style.setProperty('--show-color', m.color);
      var img = document.createElement('img'); img.src = m.cover; img.alt = ''; img.width = 34; img.height = 34; img.loading = 'lazy';
      li.appendChild(img);
      li.appendChild(txt('span', 'nm', m.name));
      li.appendChild(txt('span', 'ln', m.members ? 'members' : (m.minutes ? m.minutes + ' min' : '')));
      list.appendChild(li);
    });
    document.querySelector('[data-jn-total]').textContent = total ? String(total) : '–';
    document.querySelector('[data-jn-shows]').textContent = picks.length
      ? picks.length + (picks.length === 1 ? ' show' : ' shows') + ', your order' : shown.length + ' shows · starter lineup';
    var count = document.querySelector('[data-jn-count]');
    if (count) {
      count.textContent = picks.length === 0 ? 'Pick two or more shows.'
        : picks.length === 1 ? '1 show picked. Pick one more.'
        : picks.length + ' shows, about ' + total + ' minutes a morning.';
    }
    var note = document.querySelector('[data-jn-draft-note]');
    if (note) { note.hidden = !picks.length; note.textContent = picks.length ? 'Your ' + picks.length + '-show lineup is saved in this browser and becomes your account\'s lineup when you join.' : ''; }
  }
  document.querySelectorAll('[data-jn-toggle]').forEach(function (b) {
    b.addEventListener('click', function () {
      var slug = b.getAttribute('data-jn-toggle');
      var i = picks.indexOf(slug);
      if (i === -1) { picks.push(slug); } else { picks.splice(i, 1); }
      persist(); render();
    });
  });
  [nameIn, cityIn].forEach(function (n) { if (n) { n.addEventListener('input', function () { persist(); render(); }); } });
  var go = document.querySelector('[data-jn-go]');
  if (go) { go.addEventListener('click', function () { persist(); track('build_lineup_start', { count: picks.length, placement: 'join', location: location.pathname }); }); }
  var form = document.querySelector('[data-nn-subscribe="join"]');
  if (form) { form.addEventListener('submit', function () { if (picks.length) { persist(); } }); }
  render();
})();
</script>
{% endblock %}
