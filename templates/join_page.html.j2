{% extends "base.html.j2" %}
{#- join.html — Nerra Personal's front door (redesigned Oct 28 2026).

    Same design language as the front page and My Nerra (_landing_styles.html.j2,
    the lt-* classes; this page's own are np-* / jn-*). A visitor builds a
    lineup here before they have an account: the picks fill the edition
    preview beside the hero with each show's MEASURED length (median of its
    newest episodes, generate_join_page) and are kept in this browser as
    nnMe.draft, which My Nerra saves as the lineup of the account they create
    (account_page.html.j2 takeDraft). Plays go through the site player
    (assets/js/nn-player.js). Copy rules kept from the earlier page: every
    trial mention sits behind trial_days; no count is typed; the members-only
    desks are badged; the Personal tips-by-email line stays. -#}

{% block head_extra %}
    {% include "_landing_styles.html.j2" %}
    <style>
        .jn [hidden] { display: none !important; }
        .jn { font-family: var(--font-ui); }
        .jn-wrap { max-width: var(--container-max, 1200px); margin: 0 auto; padding: 0 var(--sp-6); }
        .jn h2.jn-h { font-family: var(--lt-head); font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.15; margin: 0 0 var(--sp-2); }
        .jn-lede { color: var(--lt-muted); margin: 0; max-width: 680px; line-height: 1.6; }
        .jn-sec { padding: var(--sp-12) 0 0; }
        .jn-sec-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--sp-4); margin-bottom: var(--sp-6); border-top: 3px solid var(--nn-white); padding-top: var(--sp-4); }

        /* ---------- Hero ---------- */
        .np-hero { position: relative; overflow: hidden; padding: calc(var(--nav-height) + var(--sp-10)) 0 var(--sp-8); }
        .np-hero::before { content: ''; position: absolute; inset: 0; background:
            radial-gradient(ellipse 55% 55% at 15% 10%, rgba(0, 212, 255, 0.15), transparent 65%),
            radial-gradient(ellipse 50% 50% at 90% 70%, rgba(107, 71, 255, 0.18), transparent 65%); pointer-events: none; }
        .np-hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--sp-10); align-items: center; }
        .np-eyebrow { font-size: 0.76rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--lt-cyan); font-weight: 700; margin: 0 0 var(--sp-3); }
        .np-hero h1 { font-family: var(--lt-head); font-size: clamp(2.4rem, 5.6vw, 4rem); line-height: 1.02; letter-spacing: -0.015em; margin: 0 0 var(--sp-4); }
        .np-hero h1 em { font-style: italic; color: var(--lt-cyan); }
        .np-hero-sub { color: var(--lt-muted); font-size: 1.1rem; max-width: 540px; margin: 0 0 var(--sp-6); line-height: 1.6; }
        .np-cta-row { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-bottom: var(--sp-4); }
        .jn-btn { display: inline-flex; align-items: center; gap: 8px; padding: 0.85rem 1.5rem; border-radius: 999px; font: 700 0.98rem/1 var(--font-ui); text-decoration: none; cursor: pointer; border: 1px solid var(--lt-rule-strong); background: transparent; color: var(--nn-white); }
        .jn-btn.primary { background: var(--nn-gradient); border-color: transparent; box-shadow: 0 10px 30px rgba(0, 160, 220, 0.3); }
        .jn-btn.light { background: #fff; color: #0B0F1A; border-color: #fff; }
        .jn-btn .ic { width: 0; height: 0; border-left: 11px solid currentColor; border-top: 7px solid transparent; border-bottom: 7px solid transparent; }
        .jn-btn.is-playing .ic { width: 10px; height: 12px; border: 0; border-left: 3px solid currentColor; border-right: 3px solid currentColor; }
        .np-trust { font-size: 0.86rem; color: var(--lt-muted); margin: 0; }
        .np-trust span { white-space: nowrap; }

        /* ---------- The edition preview ---------- */
        .jn-ed { position: relative; border: 1px solid var(--lt-rule-strong); border-radius: 22px; background: #0D1120; padding: var(--sp-5); box-shadow: 0 30px 70px rgba(0,0,0,0.45), 0 0 0 1px rgba(0,212,255,0.06); }
        .jn-ed::after { content: 'PRIVATE FEED'; position: absolute; top: -12px; right: 20px; font-size: 0.62rem; letter-spacing: 0.14em; font-weight: 800; padding: 0.3rem 0.65rem; border-radius: 999px; background: var(--nn-gradient); color: #fff; }
        .jn-ed-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: 0.78rem; color: var(--lt-muted); margin-bottom: 6px; }
        .jn-ed-top b { color: var(--lt-cyan); letter-spacing: 0.08em; font-size: 0.68rem; }
        .jn-ed-greet { font-family: var(--lt-head); font-size: 1.3rem; line-height: 1.25; margin: 0 0 var(--sp-4); }
        .jn-ed-greet em { font-style: italic; color: var(--lt-cyan); }
        .jn-ed-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; max-height: 330px; overflow: auto; }
        .jn-ed-list li { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 6px 8px; border-radius: 10px; background: rgba(255,255,255,0.04); border-left: 3px solid var(--show-color, transparent); }
        .jn-ed-list img, .jn-ed-list .ic { width: 34px; height: 34px; border-radius: 8px; display: block; object-fit: cover; }
        .jn-ed-list .ic { display: flex; align-items: center; justify-content: center; background: rgba(0,212,255,0.14); font-size: 0.95rem; }
        .jn-ed-list .nm { font-size: 0.9rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .jn-ed-list .ln { font-size: 0.76rem; color: var(--lt-muted); font-variant-numeric: tabular-nums; }
        .jn-ed-list li.is-mira { background: transparent; border: 1px dashed var(--lt-rule-strong); }
        .jn-ed-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: var(--sp-4); padding-top: var(--sp-3); border-top: 1px solid var(--lt-rule); font-size: 0.84rem; color: var(--lt-muted); }
        .jn-ed-foot strong { color: var(--nn-white); font-size: 1.05rem; }
        .jn-ed-note { font-size: 0.74rem; color: var(--lt-muted); margin: var(--sp-2) 0 0; }

        /* ---------- Stats strip ---------- */
        .np-stats { display: flex; flex-wrap: wrap; justify-content: space-around; gap: var(--sp-6); padding: var(--sp-5) 0; border-top: 1px solid var(--lt-rule); border-bottom: 1px solid var(--lt-rule); }
        .np-stat { text-align: center; }
        .np-stat strong { display: block; font-size: 1.8rem; font-family: var(--lt-head); }
        .np-stat span { font-size: 0.76rem; color: var(--lt-muted); letter-spacing: 0.06em; text-transform: uppercase; }

        /* ---------- Builder ---------- */
        .jn-build { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--sp-8); align-items: start; }
        .nn-showgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 10px; }
        .nn-showcard { position: relative; display: grid; grid-template-columns: 52px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 12px; border-radius: 14px; border: 1px solid var(--lt-rule); background: rgba(255,255,255,0.02); }
        .nn-showcard.is-on { border-color: var(--show-color); background: color-mix(in srgb, var(--show-color) 14%, transparent); }
        .nn-showcard img { width: 52px; height: 52px; border-radius: 10px; display: block; }
        .nn-showcard strong { display: block; font-family: var(--lt-head); font-size: 0.98rem; line-height: 1.2; }
        .nn-showcard em { display: block; font-size: 0.7rem; color: var(--lt-cyan); font-style: normal; letter-spacing: 0.04em; margin-top: 2px; }
        .nn-showcard .jn-tag { display: block; font-size: 0.78rem; color: var(--lt-muted); line-height: 1.4; margin-top: 3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .nn-showcard .jn-hear { font-size: 0.74rem; color: var(--lt-cyan); }
        .nn-showcard-access { display: inline-block; margin: 3px 0 0; padding: 1px 7px; border-radius: 999px; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.04em; color: #0B0F1A; background: var(--lt-cyan); }
        .jn-toggle { width: 34px; height: 34px; border-radius: 50%; border: 1.5px solid var(--lt-rule-strong); background: transparent; color: var(--nn-white); cursor: pointer; font-size: 1.15rem; line-height: 1; }
        .nn-showcard.is-on .jn-toggle { background: var(--show-color); border-color: var(--show-color); }
        .jn-toggle:focus-visible { outline: 2px solid var(--lt-cyan); outline-offset: 2px; }
        .jn-side { position: sticky; top: calc(var(--nav-height) + 16px); border: 1px solid var(--lt-rule-strong); border-radius: 18px; padding: var(--sp-5); background: #0D1120; }
        .jn-side h3 { font-family: var(--lt-head); font-size: 1.2rem; margin: 0 0 6px; }
        .jn-side p { color: var(--lt-muted); font-size: 0.9rem; line-height: 1.5; margin: 0 0 var(--sp-3); }
        .jn-side label { display: block; font-size: 0.78rem; color: var(--lt-muted); margin: var(--sp-3) 0 4px; }
        .jn-side input { width: 100%; box-sizing: border-box; padding: 0.7rem 0.9rem; border-radius: 10px; border: 1px solid var(--lt-rule-strong); background: #0B0F1A; color: var(--nn-white); font: 500 0.95rem var(--font-ui); }
        .jn-side input:focus { outline: 2px solid var(--lt-cyan); outline-offset: 1px; }
        .jn-side .jn-count { font-size: 0.9rem; margin: var(--sp-4) 0 var(--sp-3); color: var(--nn-white); }
        .jn-side .jn-btn { width: 100%; justify-content: center; margin-top: 8px; box-sizing: border-box; }

        /* ---------- Sample ---------- */
        .np-sample { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: var(--sp-6); align-items: center; border: 1px solid var(--lt-rule-strong); border-radius: 20px; padding: var(--sp-6);
            background: radial-gradient(ellipse 50% 80% at 0% 50%, rgba(0,212,255,0.12), transparent 70%), #0D1120; }
        .np-sample img { width: 180px; height: 180px; border-radius: 16px; display: block; }
        .np-sample h2 { margin: 0 0 6px; font-family: var(--lt-head); font-size: 1.6rem; }
        .np-sample p { margin: 0 0 var(--sp-4); color: var(--lt-muted); line-height: 1.55; }
        .np-sample .lt-lead-audio { margin: 0 0 var(--sp-3); }
        .np-sample .rundown { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
        .np-sample .rundown li { font-size: 0.78rem; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--lt-rule); color: var(--lt-muted); }

        .np-soft-interest { margin: var(--sp-8) auto 0; max-width: 760px; padding: var(--sp-4) var(--sp-6); border: 1px dashed var(--lt-rule-strong); border-radius: 14px; background: rgba(0,212,255,0.04); text-align: center; }
        .np-soft-interest p { margin: 0 0 var(--sp-2); color: var(--lt-muted); }
        .np-soft-interest a.np-soft-cta { font-weight: 700; color: var(--lt-cyan); text-decoration: none; }

        /* ---------- Plans ---------- */
        .nn-tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5); }
        .nn-tier { border: 1px solid var(--lt-rule-strong); border-radius: 18px; padding: var(--sp-6); background: rgba(255,255,255,0.02); display: flex; flex-direction: column; }
        .nn-tier.featured { border-color: var(--lt-cyan); background: linear-gradient(180deg, rgba(0,212,255,0.08), rgba(107,71,255,0.06)); box-shadow: 0 0 40px rgba(0,212,255,0.12); position: relative; }
        /* Oct 28 2026: was 'MOST POPULAR'. Membership is unmeasured
           (api/member_metrics.json), so a popularity claim had no basis;
           a recommendation is ours to make. */
        .nn-tier.featured::before { content: 'RECOMMENDED'; position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 0.62rem; letter-spacing: 0.14em; font-weight: 800; padding: 0.28rem 0.7rem; border-radius: 999px; background: var(--nn-gradient); color: #fff; }
        .nn-tier h2 { font-family: var(--lt-head); margin: 0 0 var(--sp-1); font-size: 1.35rem; }
        .nn-tier .price { font-size: 2.2rem; font-weight: 700; margin: 0 0 var(--sp-1); font-family: var(--lt-head); }
        .nn-tier .price small { font-size: 0.9rem; font-weight: 400; color: var(--lt-muted); font-family: var(--font-ui); }
        .nn-tier .for { color: var(--lt-muted); font-size: 0.88rem; margin: 0 0 var(--sp-4); }
        .nn-tier ul { list-style: none; padding: 0; margin: 0 0 var(--sp-5); flex: 1; }
        .nn-tier li { padding: 0.45rem 0 0.45rem 1.4rem; border-bottom: 1px solid var(--lt-rule); font-size: 0.93rem; line-height: 1.45; position: relative; }
        .nn-tier li::before { content: '✓'; position: absolute; left: 0; color: var(--lt-cyan); font-weight: 700; }
        .nn-tier .cta { display: block; text-align: center; padding: 0.85rem 1rem; border-radius: 999px; font-weight: 700; text-decoration: none; background: var(--nn-gradient); color: #fff; }
        .nn-tier .cta.secondary { background: transparent; border: 1px solid var(--lt-rule-strong); color: inherit; }
        .nn-tier .cta small { display: block; font-weight: 400; font-size: 0.78rem; opacity: 0.85; margin-top: 0.2rem; }

        /* ---------- Steps, listen anywhere, products, FAQ ---------- */
        .nn-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5); }
        .nn-step { border-top: 1px solid var(--lt-rule-strong); padding-top: var(--sp-4); }
        .nn-step .num { display: inline-flex; width: 2rem; height: 2rem; border-radius: 50%; background: var(--nn-gradient); color: #fff; align-items: center; justify-content: center; font-weight: 700; margin-bottom: var(--sp-3); }
        .nn-step h3 { margin: 0 0 var(--sp-2); font-size: 1.12rem; font-family: var(--lt-head); }
        .nn-step p { margin: 0; color: var(--lt-muted); font-size: 0.94rem; line-height: 1.55; }
        .jn-ways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5); }
        .jn-way { border: 1px solid var(--lt-rule); border-radius: 16px; padding: var(--sp-5); background: rgba(255,255,255,0.02); }
        .jn-way h3 { font-family: var(--lt-head); font-size: 1.15rem; margin: 0 0 6px; }
        .jn-way p { margin: 0 0 var(--sp-3); color: var(--lt-muted); font-size: 0.92rem; line-height: 1.5; }
        .jn-apps { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
        .jn-apps li { font-size: 0.78rem; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,0.06); }
        .jn-way a { color: var(--lt-cyan); font-weight: 600; }
        .nn-products { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-4); }
        .nn-product { border: 1px solid var(--lt-rule); border-radius: 14px; padding: var(--sp-4); background: rgba(255,255,255,0.02); }
        .nn-product h3 { margin: 0 0 var(--sp-1); font-size: 1rem; font-family: var(--lt-head); }
        .nn-product p { margin: 0 0 var(--sp-2); font-size: 0.88rem; color: var(--lt-muted); line-height: 1.5; }
        .nn-product a { color: var(--lt-cyan); font-weight: 600; font-size: 0.88rem; }
        .nn-faq { max-width: 820px; }
        .nn-faq details { border-bottom: 1px solid var(--lt-rule); padding: var(--sp-4) 0; }
        .nn-faq summary { cursor: pointer; font-weight: 700; font-family: var(--lt-head); font-size: 1.05rem; }
        .nn-faq p { color: var(--lt-muted); font-size: 0.95rem; margin: var(--sp-3) 0 0; line-height: 1.6; }
        .nn-join-form { max-width: 560px; margin: var(--sp-12) auto var(--sp-6); text-align: center; border: 1px solid var(--lt-rule-strong); border-radius: 20px; padding: var(--sp-8) var(--sp-6); background: #0D1120; }
        .nn-join-form h2 { font-family: var(--lt-head); margin: 0 0 var(--sp-2); font-size: 1.7rem; }
        .nn-join-form p { color: var(--lt-muted); }
        .nn-join-form form { display: flex; gap: 8px; flex-wrap: wrap; margin-top: var(--sp-4); }
        .nn-join-form input[type=email] { flex: 1 1 240px; padding: 0.85rem 1rem; border-radius: 999px; border: 1px solid var(--lt-rule-strong); background: #0B0F1A; color: inherit; font: 500 0.98rem var(--font-ui); }
        .nn-join-form button { padding: 0.85rem 1.8rem; border-radius: 999px; border: none; background: var(--nn-gradient); color: #fff; font: 700 0.98rem var(--font-ui); cursor: pointer; }
        .jn-draft-note { font-size: 0.86rem; color: var(--lt-cyan); margin: var(--sp-3) 0 0; }
        .nn-join-note { font-size: 0.85rem; color: var(--lt-muted); max-width: 680px; margin: 0 auto var(--sp-12); text-align: center; line-height: 1.55; }
        /* Prose links (Oct 7 2026): the global ``a`` rule inherits colour and
           drops the underline, so a link inside a sentence was invisible.
           Scoped to this page's content and to plain (class-less) links. */
        #main-content p a:not([class]), #main-content li a:not([class]) { color: var(--nn-cyan); text-decoration: underline; text-underline-offset: 2px; }
        #main-content p a:not([class]):hover, #main-content li a:not([class]):hover { color: var(--nn-white); }

        @media (max-width: 1000px) {
            .np-hero-grid, .jn-build { grid-template-columns: minmax(0, 1fr); }
            .jn-side { position: static; }
            .nn-tiers, .nn-steps, .jn-ways { grid-template-columns: minmax(0, 1fr); }
            .nn-products { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }
        @media (max-width: 640px) {
            .jn-wrap { padding: 0 var(--sp-4); }
            .np-sample { grid-template-columns: minmax(0, 1fr); }
            .np-sample img { width: 96px; height: 96px; }
            .nn-products { grid-template-columns: minmax(0, 1fr); }
            .np-stats { justify-content: space-between; gap: var(--sp-4); }
        }
    </style>
{% endblock %}

{% block content %}
<div class="jn">
<section class="np-hero">
    <div class="jn-wrap np-hero-grid">
        <div>
            <p class="np-eyebrow">Nerra Personal</p>
            <h1>Your own <em>morning show.</em></h1>
            {#- Oct 7 2026: the hero counted the whole registry (31, Nerra
                Voices included, which has no episodes) beside a stat of 26 and
                a Step 1 that printed a literal 13. All three read the Personal
                roster now (engine.personal_edition via _personal_shows_list). -#}
            {%- set _gated_n = personal_shows | selectattr('access_note') | list | length %}
            <p class="np-hero-sub">{{ personal_shows|length }} shows to pick from, most of them new every day{% if _gated_n %}, {{ personal_shows|length - _gated_n }} of them free to everyone{% else %}, all free{% endif %}.
               Personal turns the ones you love into one continuous morning
               show: your picks, in your order, anchored by Mira, delivered
               as a private podcast feed that works in any app.</p>
            <div class="np-cta-row">
                <a class="jn-btn primary" href="#builder">Build my edition</a>
                {% if sample_url %}<button type="button" class="jn-btn light" data-nn-play data-nn-sample="join" data-src="{{ sample_url }}" data-key="sample" data-title="A sample Nerra Personal edition" data-show="Nerra Personal" data-cover="{{ path_prefix }}assets/covers/nerra-daily.jpg" data-post="{{ path_prefix }}join.html#sample" data-color="#00D4FF"><span class="ic" aria-hidden="true"></span> Hear a sample</button>{% endif %}
            </div>
            <p class="np-trust">{% if trial_days %}<span>{{ trial_days }} days free, then from $4.99/mo</span> ·{% else %}<span>From $4.99/mo</span> ·{% endif %}
               <span>Cancel in one click</span> ·
               <span>Chapters for every segment</span> ·
               <span>Yours alone, no algorithm</span></p>
        </div>
        {#- The edition preview: the starter lineup with each show's measured
            length until the visitor picks; then their picks, in order. -#}
        <div class="jn-ed" aria-label="Preview of a personal edition" data-jn-preview>
            <div class="jn-ed-top"><span data-jn-day>Tomorrow's edition</span><b>MIRA · AI ANCHOR</b></div>
            <p class="jn-ed-greet" data-jn-greet>“Good morning, <em>Alex</em>. Here's your morning.”</p>
            <ol class="jn-ed-list" data-jn-list>
                <li class="is-mira"><span class="ic" aria-hidden="true">🌤️</span><span class="nm">Your city's morning brief</span><span class="ln">Mira</span></li>
                {% for s in mock_lineup %}
                <li style="--show-color:{{ s.brand_color }};">
                    <img src="{{ path_prefix }}{{ s.cover_webp or s.cover }}" alt="" loading="lazy" width="34" height="34">
                    <span class="nm">{{ s.name }}</span>
                    <span class="ln">{{ s.length }}</span>
                </li>
                {% endfor %}
            </ol>
            <div class="jn-ed-foot"><span data-jn-shows>{{ mock_lineup | length }} shows · starter lineup</span><span>about <strong data-jn-total>{{ mock_total or '–' }}</strong> min</span></div>
            <p class="jn-ed-note">Lengths are each show's typical episode this week. The edition plays every show in full; Mira's handoffs are seconds long.</p>
        </div>
    </div>
</section>

<div class="jn-wrap">
<div class="np-stats" aria-label="Network stats">
    <div class="np-stat"><strong>{{ personal_shows | length }}</strong><span>shows to pick from</span></div>
    <div class="np-stat"><strong>{{ total_episodes }}+</strong><span>episodes shipped</span></div>
    {#- Oct 28 2026: this stat promised there would never be advertising.
        Sponsors are coming to the free shows (engine.brand, Oct 18), and a
        Personal edition splices those shows' published audio, so it was a
        network-wide promise the sponsor plan breaks. The trial (when the
        Payment Links carry one — trial_days) or the one-click cancel is a
        fact of the offer. -#}
    {% if trial_days %}<div class="np-stat"><strong>{{ trial_days }}</strong><span>days free to try</span></div>
    {% else %}<div class="np-stat"><strong>1</strong><span>click to cancel</span></div>{% endif %}
    <div class="np-stat"><strong>1</strong><span>feed made for you</span></div>
</div>

{% if personal_shows %}
<section class="jn-sec" id="builder" aria-labelledby="jn-build-h">
    <div class="jn-sec-head">
        <div>
            <h2 class="jn-h" id="jn-build-h">Build yours in a minute</h2>
            {%- set _gated = personal_shows | selectattr('access_note') | list %}
            <p class="jn-lede">{{ personal_shows | length }} shows to build from. Tap the ones you want, in the order you want them; each is produced daily or weekly by the network and free to hear first from its own page{% if _gated %}, except the {{ _gated | length }} marked for members, which are made only for the editions that carry them{% endif %}.</p>
        </div>
    </div>
    <div class="jn-build">
        <div class="nn-showgrid" aria-label="Shows">
            {% for s in personal_shows %}
            <div class="nn-showcard" data-slug="{{ s.slug }}" style="--show-color:{{ s.brand_color }};">
                {% if s.cover %}
                <img src="{{ path_prefix }}{{ s.cover_webp or s.cover }}" alt="{{ s.name }} cover art" loading="lazy" width="52" height="52">
                {% endif %}
                <span>
                    <strong>{{ s.name }}</strong>
                    {% if s.schedule %}<em>{{ s.schedule }}{% if s.minutes %} · about {{ s.minutes }} min{% endif %}</em>{% endif %}
                    {% if s.access_note %}<b class="nn-showcard-access">{{ s.access_note }}</b>{% endif %}
                    <span class="jn-tag">{{ s.tagline | truncate(100) }}</span>
                    <a class="jn-hear" href="{{ path_prefix }}{{ s.page }}">Hear it free</a>
                </span>
                <button type="button" class="jn-toggle" aria-pressed="false" data-jn-toggle="{{ s.slug }}" aria-label="Add {{ s.name }} to my edition">+</button>
            </div>
            {% endfor %}
        </div>
        <aside class="jn-side" aria-labelledby="jn-side-h">
            <h3 id="jn-side-h">Your edition</h3>
            <p>Mira greets you by name and opens with your city. Both are optional, and you can change everything later in My Nerra.</p>
            <label for="jn-name">First name</label>
            <input id="jn-name" type="text" maxlength="40" autocomplete="given-name" placeholder="Alex">
            <label for="jn-city">City</label>
            <input id="jn-city" type="text" maxlength="60" autocomplete="address-level2" placeholder="Vancouver, BC">
            <p class="jn-count" data-jn-count aria-live="polite">Pick two or more shows.</p>
            <a class="jn-btn primary" href="#join-free" data-jn-go>Save my lineup, free</a>
            {% if stripe_personal_url and stripe_personal_url != '#' %}
            <a class="jn-btn" href="#plans">See the plans</a>
            {% endif %}
        </aside>
    </div>
</section>
{% endif %}

