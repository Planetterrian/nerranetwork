{#- Lead story + Latest list -#}
<section class="lt-top container" aria-label="Lead story">
    {% set s = p.lead %}
    <article class="lt-lead" style="--show-color:{{ s.brand_color }};">
        {{ media(s, eager=true) }}
        <div class="lt-lead-body">
            {{ kicker(s) }}
            <h2 class="lt-hl"{% if s.lang %} lang="{{ s.lang }}"{% endif %}><a href="{{ story_href(s) }}">{{ s.hook | e }}</a></h2>
            {{ meta(s, listen=false) }}
            {{ more_list(s) }}
            <div class="lt-lead-audio">
                {% if s.audio_url %}<audio controls preload="none" src="{{ s.audio_url }}" aria-label="Play {{ s.show_name }} episode {{ s.episode_num }}"></audio>{% endif %}
                {% if s.post_url %}<a class="lt-btn lt-btn--primary" href="{{ path_prefix }}{{ s.post_url }}">Read the full story</a>{% endif %}
                <a class="lt-btn" href="{{ path_prefix }}{{ s.show_page }}">More from {{ s.show_name }}</a>
            </div>
            {%- if lead_share %}
            {#- Each shared URL is built by engine.funnel (engine.blog._share_urls),
                the blog share row's own builder, so a click a reader's share
                earns is attributable to this story and the platform. -#}
            <div class="lt-share" aria-label="Share this story">
                <span>Share</span>
                <a href="https://twitter.com/intent/tweet?url={{ lead_share.x | urlencode }}&amp;text={{ s.hook | urlencode }}" target="_blank" rel="noopener">X</a>
                <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ lead_share.linkedin | urlencode }}" target="_blank" rel="noopener">LinkedIn</a>
                <a href="https://www.facebook.com/sharer/sharer.php?u={{ lead_share.facebook | urlencode }}" target="_blank" rel="noopener">Facebook</a>
                <a href="https://wa.me/?text={{ (s.hook ~ ' — ' ~ lead_share.whatsapp) | urlencode }}" target="_blank" rel="noopener">WhatsApp</a>
                <a href="mailto:?subject={{ s.hook | urlencode }}&amp;body={{ lead_share.email | urlencode }}">Email</a>
            </div>
            {%- endif %}
        </div>
    </article>

    <aside class="lt-latest" id="latest" aria-labelledby="lt-latest-h">
        <h2 class="lt-rail-h" id="lt-latest-h">Latest across the network</h2>
        <ol>
            {% for s in p.latest %}{% if s is not sameas p.lead %}
            <li style="--show-color:{{ s.brand_color }};">
                <p class="lt-kicker"><a href="{{ path_prefix }}{{ s.show_page }}">{{ s.show_name }}</a>{% if s.stamp and s.stamp.label %} <span class="lt-rail-when">{{ when(s.stamp) }}</span>{% endif %}</p>
                <h3 class="lt-hl"{% if s.lang %} lang="{{ s.lang }}"{% endif %}><a href="{{ story_href(s) }}">{{ s.hook | e }}</a></h3>
            </li>
            {% endif %}{% endfor %}
        </ol>
        <p class="lt-rail-more"><a href="{{ path_prefix }}blog/index.html">Every article →</a></p>
    </aside>
</section>

{#- The flagship shows (engine.brand.FLAGSHIP_SHOW_SLUGS): the network's two
    biggest audiences keep a band of their own every day, beside the lead the
    subject rotation picks (Oct 18 2026). A flagship story runs here and in
    the Latest list, never also as the lead or a top story. -#}
{% if p.flagships %}
<section class="lt-block container" id="flagships" aria-labelledby="lt-flag-h">
    <div class="lt-block-head">
        <h2 id="lt-flag-h">Flagship shows</h2>
        <p class="lt-block-sub">The network's two biggest daily shows, in their latest episodes.</p>
    </div>
    <div class="lt-flag-grid">
        {% for f in p.flagships %}
        <article class="lt-flag" style="--show-color:{{ f.brand_color }};">
            <div class="lt-flag-head">
                <a class="lt-flag-cover" href="{{ path_prefix }}{{ f.show_page }}" tabindex="-1" aria-hidden="true">
                    <picture>
                        {% if f.cover_webp %}<source type="image/webp" srcset="{{ path_prefix }}{{ f.cover_webp }}">{% endif %}
                        <img src="{{ path_prefix }}{{ f.cover_url }}" alt="{{ f.show_name }} cover art" width="72" height="72" loading="lazy" decoding="async">
                    </picture>
                </a>
                <div>
                    <p class="lt-flag-name"><a href="{{ path_prefix }}{{ f.show_page }}">{{ f.show_name }}</a></p>
                    {% if f.tagline %}<p class="lt-flag-tag">{{ f.tagline }}</p>{% endif %}
                </div>
                {% if f.quote %}{% set q = f.quote %}
                <p class="lt-flag-quote lt-quote is-{{ q.direction }}" data-symbol="{{ q.symbol }}"><span><b class="lt-quote-sym">{{ q.symbol }}</b> <span class="lt-quote-px">{{ q.price }}</span>{% if q.change %} <span class="lt-quote-chg">{{ q.change }}</span>{% endif %}<small>{{ 'Close' if q.basis == 'close' else 'Last quote' }} · <time datetime="{{ q.as_of_iso }}">{{ q.as_of }}</time></small></span></p>
                {% endif %}
            </div>
            {{ media(f) }}
            <h3 class="lt-hl"{% if f.lang %} lang="{{ f.lang }}"{% endif %}><a href="{{ story_href(f) }}">{{ f.hook | e }}</a></h3>
            {{ meta(f, listen=false, read=false) }}
            {{ more_list(f) }}
            {% if f.launch %}{% set l = f.launch %}
            <p class="lt-flag-launch" data-expires="{{ l.net_iso }}"><b>Next launch</b> {{ l.mission }}{% if l.rocket %} · {{ l.rocket }}{% endif %} · no earlier than <time datetime="{{ l.net_iso }}">{{ l.net }}</time></p>
            {% endif %}
            {% if f.links %}<p class="lt-flag-links">{% for ln in f.links %}<a href="{{ path_prefix }}{{ ln.url }}">{{ ln.label }}</a>{% endfor %}</p>{% endif %}
            <div class="lt-lead-audio">
                {% if f.audio_url %}<audio controls preload="none" src="{{ f.audio_url }}" aria-label="Play {{ f.show_name }} episode {{ f.episode_num }}"></audio>{% endif %}
                {% if f.post_url %}<a class="lt-btn lt-btn--primary" href="{{ path_prefix }}{{ f.post_url }}">Read the episode</a>{% endif %}
            </div>
        </article>
        {% endfor %}
    </div>
</section>
{% endif %}

