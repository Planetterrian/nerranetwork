{#- Topics + Explore -#}
{% if topics or discover_links %}
<section class="lt-block container" id="discover" aria-labelledby="lt-disc-h">
    <div class="lt-block-head"><h2 id="lt-disc-h">Find your subject</h2>{% if discover_links %}<div class="lt-block-links">{% for l in discover_links %}<a href="{{ path_prefix }}{{ l.url }}">{{ l.label }} →</a>{% endfor %}</div>{% endif %}</div>
    {% if topics %}
    <ul class="lt-chips">
        {% for t in topics %}<li><a class="lt-chip" href="{{ path_prefix }}{{ t.url }}">{{ t.heading }}</a></li>{% endfor %}
    </ul>
    {% endif %}
</section>
{% endif %}

{#- Nerra Personal (the paid product; the free path sits beside it). The
    sample lineup lists only shows that are in the Personal lineup: not Nerra
    Daily, not the two interview shows, not the Russian shows. -#}
{#- Members-only series (Oct 18 2026, engine.specials): released series only. -#}
{% if member_specials %}
<section class="lt-block container" id="member-specials" aria-labelledby="lt-specials-h">
    <div class="lt-block-head">
        <h2 id="lt-specials-h">Members-only series</h2>
        <p class="lt-block-sub">Long, sourced deep dives for Nerra Personal members. The trailers are free.</p>
    </div>
    <div class="nn-member-special-grid">
        {% for sp in member_specials %}
        <section class="nn-member-special" aria-label="{{ sp.title | e }}">
            <p class="nn-member-special-kicker">{{ sp.total_parts }} episodes · from {{ sp.host_name }}</p>
            <p class="nn-member-special-title"><a href="{{ path_prefix }}specials.html#{{ sp.id }}">{{ sp.title | e }}</a></p>
            <p class="nn-member-special-text">{{ (sp.teaser or sp.summary) | e }}</p>
            {% if sp.trailer_url %}<audio controls preload="none" src="{{ sp.trailer_url }}" aria-label="Play the {{ sp.title | e }} trailer"></audio>{% endif %}
        </section>
        {% endfor %}
    </div>
</section>
{% endif %}
<section class="lt-block container" id="personal-promo" aria-labelledby="lt-pers-h">
<div class="lt-personal">
    <div>
        <p class="lt-signup-kicker">Nerra Personal</p>
        <h2 id="lt-pers-h">Your own daily show, built from the shows you already love</h2>
        <p>A private daily feed of the shows you pick, in the order you pick them, anchored by {{ mira.host_name }}, the network's AI host, who greets you by name.</p>
        <ul>
            <li>Pick the shows you want; they arrive as one private episode every morning</li>
            <li>A private feed that works in any podcast app, with chapters for every segment</li>
            <li>A free account brings the newsletter, gallery downloads and book discounts</li>
            <li>Every show stays free to hear either way</li>
        </ul>
    </div>
    <div class="lt-personal-cta">
        {% set _lineup_sample = ranked_shows | rejectattr('slug', 'in', ['nerra_daily', 'age_of_ai', 'nerra_voices', 'finansy_prosto', 'privet_russian']) | list %}
        {% if _lineup_sample %}
        <div class="lt-lineup" aria-hidden="true">
            <p class="lt-sublabel">Your morning, one feed</p>
            {% for s in _lineup_sample[:4] %}
            {% set _pbase = s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image %}
            <div class="lt-lineup-row">
                <picture>
                    <source type="image/webp" srcset="{{ path_prefix }}{{ _pbase }}-400.webp">
                    <img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" width="40" height="40" loading="lazy" decoding="async">
                </picture>
                <span>{{ s.name }}</span>
                <small>{{ loop.index }}</small>
            </div>
            {% endfor %}
        </div>
        {% endif %}
        {% if personal and personal.live %}
        <a class="lt-btn lt-btn--primary" href="{{ path_prefix }}{{ personal.plans }}" onclick="if(typeof gtag==='function'){gtag('event','select_personal_upsell',{placement:'homepage'});}">{% if personal.trial_days %}Try it free for {{ personal.trial_days }} days{% else %}See plans{% endif %} →</a>
        {% else %}
        {#- Same rule as join.html: no live Payment Link = "launching soon". -#}
        <a class="lt-btn lt-btn--primary" href="{{ path_prefix }}join.html" onclick="if(typeof gtag==='function'){gtag('event','select_personal_upsell',{placement:'homepage'});}">Launching soon — join free for first access →</a>
        {% endif %}
        <p class="lt-personal-note"><a href="{{ path_prefix }}account.html">Member sign in</a> · <a href="{{ path_prefix }}nerra-daily.html">Try Nerra Daily free</a>{% if personal and personal.support %} · <a href="{{ path_prefix }}{{ personal.support }}">Support the network</a>{% endif %}</p>
        <p class="lt-personal-note" id="soft-interest">{{ soft_personal_interest(path_prefix, compact=true) }}</p>
    </div>
</div>
</section>

{#- Books + the image gallery -#}
{% if books or gallery %}
<section class="lt-block container" id="shelf" aria-labelledby="lt-shelf-h">
    <div class="lt-block-head"><h2 id="lt-shelf-h">Books &amp; the image gallery</h2></div>
    <div class="lt-shelf"{% if not (books and gallery) %} style="grid-template-columns:minmax(0,1fr);"{% endif %}>
        {% if books %}
        <div>
            <p class="lt-sublabel">Books from the shows</p>
            <ul class="lt-books">
                {% for b in books %}
                <li class="lt-book" style="--show-color:{{ b.brand_color }};">
                    <a class="lt-book-cover" href="{{ path_prefix }}books.html" tabindex="-1" aria-hidden="true"><b>{{ b.title | e }}</b><small>Volume {{ b.volume_number }}{% if b.author %} · {{ b.author }}{% endif %}</small></a>
                    <div>
                        <p class="lt-kicker">{{ b.show_name }}</p>
                        <h3 class="lt-hl"><a href="{{ path_prefix }}books.html">{{ b.full_title | e }}</a></h3>
                        {% if b.subtitle %}<p class="lt-dek">{{ b.subtitle | e }}{% if b.chapters %} · {{ b.chapters }} chapters{% endif %}</p>{% endif %}
                    </div>
                </li>
                {% endfor %}
            </ul>
            <p class="lt-links-row"><a href="{{ path_prefix }}books.html">Ebooks and audiobooks →</a></p>
        </div>
        {% endif %}
        {% if gallery %}
        <div>
            <p class="lt-sublabel">From the image gallery{% if gallery_license %} · free to reuse under {{ gallery_license }}{% endif %}</p>
            <ul class="lt-gallery-grid">
                {% for g in gallery %}
                <li><a href="{{ path_prefix }}gallery.html"><img src="{{ g.url }}" alt="AI-generated scene from {{ g.show_name }} episode {{ g.episode_num }}" width="800" height="450" loading="lazy" decoding="async"><span>{{ g.show_name }}</span></a></li>
                {% endfor %}
            </ul>
            <p class="lt-links-row"><a href="{{ path_prefix }}gallery.html">Browse the gallery →</a></p>
        </div>
        {% endif %}
    </div>
</section>
{% endif %}

{#- Every public show, as the shared card (_macros.show_card — /explore.html
    renders the same one), most-listened first. -#}
{% if ranked_shows %}
<section class="lt-block container" id="shows" aria-labelledby="lt-shows-h">
    <div class="lt-block-head"><h2 id="lt-shows-h">All shows</h2><p class="lt-block-sub">Every show is free and independently produced; each card says how often it publishes.</p><a href="{{ path_prefix }}explore.html">Browse by subject →</a></div>
    <div class="show-showcase" id="show-showcase-grid">
        {% for s in ranked_shows %}
        {{ show_card(s, path_prefix) }}
        {% endfor %}
    </div>
</section>
{% endif %}

{#- Subscribe everywhere: every feed, in any podcast app. -#}
<section class="lt-block container" id="subscribe" aria-labelledby="lt-sub-h">
    <div class="lt-block-head"><h2 id="lt-sub-h">Subscribe everywhere</h2><p class="lt-block-sub">Every show has its own RSS feed. Paste it into any podcast app — Apple Podcasts, Spotify, Pocket Casts, Overcast — and new episodes arrive automatically.</p></div>
    {% set le = listen_everywhere %}
    <div class="lt-apps">
        <div>
            {% if le and le.platforms %}
            <p class="lt-sublabel">The most-listened shows in your podcast app</p>
            <ul class="lt-app-list">
                {% for a in le.platforms %}
                <li style="--show-color:{{ a.brand_color }};">
                    <a class="lt-app-name" href="{{ path_prefix }}{{ a.show_page }}">{{ a.name }}</a>
                    <span class="lt-app-links">
                        {% if a.apple %}<a href="{{ a.apple }}" target="_blank" rel="noopener" aria-label="{{ a.name }} on Apple Podcasts">Apple</a>{% endif %}
                        {% if a.spotify %}<a href="{{ a.spotify }}" target="_blank" rel="noopener" aria-label="{{ a.name }} on Spotify">Spotify</a>{% endif %}
                        {% if a.rss %}<a href="{{ path_prefix }}{{ a.rss }}" aria-label="{{ a.name }} RSS feed">RSS</a>{% endif %}
                    </span>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
            <details class="subscribe-all">
                <summary>Every show's feed, Apple and Spotify links ({{ ranked_shows|length }} shows)</summary>
                <ul class="lt-app-list">
                    {% for s in ranked_shows %}
                    <li style="--show-color:{{ s.brand_color }};">
                        <a class="lt-app-name" href="{{ path_prefix }}{{ s.show_page }}">{{ s.name }}</a>
                        <span class="lt-app-links">
                            {% if s.apple_podcasts_url %}<a href="{{ s.apple_podcasts_url }}" target="_blank" rel="noopener" aria-label="Subscribe to {{ s.name }} on Apple Podcasts">Apple</a>{% endif %}
                            {% if s.spotify_url %}<a href="{{ s.spotify_url }}" target="_blank" rel="noopener" aria-label="Subscribe to {{ s.name }} on Spotify">Spotify</a>{% endif %}
                            {% if s.has_feed %}<a href="{{ path_prefix }}{{ s.rss_file }}" aria-label="Subscribe to {{ s.name }} via RSS">RSS</a>{% endif %}
                        </span>
                    </li>
                    {% endfor %}
                </ul>
            </details>
        </div>
        <div>
            {% if le and (le.languages or le.ru_pages) %}
            <p class="lt-sublabel">In other languages</p>
            <ul class="lt-chips">
                {% for l in le.languages %}<li><a class="lt-chip" href="{{ path_prefix }}{{ le.how_to_listen or 'how-to-listen.html' }}#feeds" lang="{{ l.lang }}">{{ l.label }}<small class="lt-chip-count" lang="en">{{ l.count }} {{ "feed" if l.count == 1 else "feeds" }}</small></a></li>{% endfor %}
                {% if le.ru_pages %}<li><a class="lt-chip" href="{{ path_prefix }}{{ le.ru_pages }}" lang="ru">Подкасты на русском</a></li>{% endif %}
            </ul>
            {% endif %}
            <p class="lt-sublabel" style="margin-top:var(--sp-5);">Everything in one feed</p>
            <ul class="lt-chips">
                <li><a class="lt-chip" href="{{ path_prefix }}network.rss">Network RSS (all shows)</a></li>
                <li><a class="lt-chip" href="{{ path_prefix }}blog.rss">Network blog RSS</a></li>
            </ul>
            <p class="lt-links-row">
                <a href="{{ path_prefix }}how-to-listen.html">How to listen</a>
                <a href="{{ path_prefix }}player.html">Network player</a>
                <a href="{{ path_prefix }}start-here.html">New here? Start here</a>
            </p>
        </div>
    </div>
</section>

{#- About the network. The count is computed; the subject list names public
    shows only (the members-only desks are not listed). -#}
<section class="lt-block container" id="about" aria-labelledby="lt-about-h">
    <div class="lt-block-head"><h2 id="lt-about-h">About Nerra Network</h2><a href="{{ path_prefix }}about.html">More about us →</a></div>
    <div class="lt-about">
        <div class="lt-about-text">
            <p><strong>{{ network_tagline }}</strong></p>
            <p>{{ network_promise() }}</p>
            <p>Nerra Network is an independent news and podcast network of free shows covering world news, space and astronomy, science, AI for experts and beginners, AI chips and data centres, markets and modern investing, the Magnificent Seven, prediction markets, SpaceX, Tesla, longevity and peptide research, environmental policy, first-principles thinking, the unintended consequences of big decisions, good news with something you can do about it (The DP Pod), Canada's offshore ocean-racing story (Offshore North), local news from Vancouver and Collingwood, live AI-hosted interviews (The Age of AI and Nerra Voices), and financial literacy and language learning in Russian &mdash; plus Nerra Daily, the whole network in one daily edition. All produced in Vancouver, Canada by Patrick Novak, with AI doing the writing and narration and a human owning the standards. <a href="{{ path_prefix }}ai-disclosure.html">How we use AI</a>.</p>
            <p>Our mission: stimulating conversation, supporting positive developments that benefit all, and providing unbiased coverage with varying perspectives.</p>
        </div>
        <ul class="lt-values">
            <li><span aria-hidden="true">&#9889;</span><div><b>Sourced, not vibes.</b> News episodes are built from named sources and each article links to them. A source-integrity gate checks cited claims against those sources and marks any it cannot verify — the public <a href="{{ path_prefix }}claims.html">claims ledger</a> shows the status. <a href="{{ path_prefix }}editorial.html">See how an episode is made</a>.</div></li>
            <li><span aria-hidden="true">&#127911;</span><div><b>Free, and independent.</b> {{ sponsor_policy.summary }} <a href="{{ path_prefix }}join.html">Nerra Personal</a> is the optional upgrade for people who want one custom feed.</div></li>
            <li><span aria-hidden="true">&#127758;</span><div><b>Every side, in its strongest form.</b> Omni View argues each side of a story at its best, and across the network we draw on diverse sources rather than one echo chamber.</div></li>
            <li><span aria-hidden="true">&#128197;</span><div><b>A cadence you can set your morning by.</b> Most shows publish every day; the rest weekly or when an interview is ready, and each show's card says which.</div></li>
            <li><span aria-hidden="true">&#127464;&#127462;</span><div><b>Made in Canada.</b> Independently produced in Vancouver by Patrick Novak. No corporate backing, no editorial interference.</div></li>
            {% if listen_everywhere and listen_everywhere.languages %}
            <li><span aria-hidden="true">&#128266;</span><div><b>{{ listening_language_count }} listening languages.</b> English originals with {% for l in listen_everywhere.languages %}<span lang="{{ l.lang }}">{{ l.label }}</span>{% if not loop.last %} and {% endif %}{% endfor %} audio tracks, plus two shows made natively in Russian. Pick your audio language with the globe in the menu.</div></li>
            {% endif %}
        </ul>
    </div>
</section>

{% if partners %}
<div class="container"><nav class="lt-partners" aria-label="For partners and guests">
    <strong>Partners &amp; guests</strong>
    {% for l in partners %}<a href="{{ path_prefix }}{{ l.url }}">{{ l.label }}</a>{% endfor %}
</nav></div>
{% endif %}

<p class="lt-note container">Headlines are each episode's own headline; pictures are the AI-generated scene art made for that episode, or the show's cover where an episode has none. Times are Eastern. Every episode is written and narrated by AI — <a href="{{ path_prefix }}ai-disclosure.html">how we use AI</a>.</p>

</div>
{% endblock %}

{% block scripts %}
{#- Relative timestamps (BBC / Guardian convention): the server prints the
    absolute Eastern time; this rewrites it to "2 hours ago" / "Yesterday",
    keeps the absolute stamp as the tooltip, drops a "Today" marker whose
    Eastern date has passed, retires a launch whose time has come, and marks
    the schedule rows that have already gone out. Nothing is fetched. -#}
<script>
(function () {
  var now = new Date();
  var etDay = function (d) {
    try { return new Intl.DateTimeFormat('en-CA', {timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit'}).format(d); }
    catch (e) { return ''; }
  };
  var today = etDay(now);
  var yest = etDay(new Date(now.getTime() - 864e5));
  document.querySelectorAll('time[data-rel]').forEach(function (el) {
    var raw = el.getAttribute('datetime') || '';
    var day = '', mins = null;
    if (raw.indexOf('T') > 0) {
      var t = new Date(raw);
      if (isNaN(t)) return;
      mins = Math.round((now - t) / 6e4);
      day = etDay(t);
    } else { day = raw; }
    var text = '';
    if (mins !== null && mins >= 0 && mins < 60) text = mins <= 1 ? 'Just now' : mins + ' minutes ago';
    else if (mins !== null && mins >= 60 && mins < 1440) { var h = Math.round(mins / 60); text = h + (h === 1 ? ' hour ago' : ' hours ago'); }
    else if (day && day === today) text = 'Today';
    else if (day && day === yest) text = 'Yesterday';
    if (text) el.textContent = text;
  });
  document.querySelectorAll('[data-today]').forEach(function (el) {
    if (today && el.getAttribute('data-today') !== today) el.remove();
  });
  document.querySelectorAll('[data-expires]').forEach(function (el) {
    var t = new Date(el.getAttribute('data-expires'));
    if (!isNaN(t) && t < now) el.remove();
  });
  document.querySelectorAll('li[data-at]').forEach(function (el) {
    var t = new Date(el.getAttribute('data-at'));
    if (el.getAttribute('data-day') === today && !isNaN(t) && t <= now) el.classList.add('is-past');
  });
})();
</script>
{% endblock %}
