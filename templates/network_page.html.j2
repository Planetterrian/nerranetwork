                {% endfor %}
            </ol>
        </div>
        {% endif %}
    </div>
</section>
{% endif %}

{#- Our record: the network by the numbers, the claims ledger and the latest
    corrections — the numbers are the ones claims.html prints. -#}
{% if glance or trust or corrections %}
<section class="lt-block container" id="numbers" aria-labelledby="lt-num-h">
    <div class="lt-block-head"><h2 id="lt-num-h">Our record</h2>{% if glance %}<p class="lt-block-sub">Counted from the feeds, the claims ledger and the analytics the network publishes.</p>{% endif %}</div>
    {% if glance %}
    <div class="lt-tiles">
        {% for t in glance %}<div class="lt-tile"><div class="lt-tile-num">{{ t.value }}</div><div class="lt-tile-label">{{ t.label }}</div></div>{% endfor %}
        {#- Counted from the feed files at build time (the old homepage hero's
            "episodes shipped"), never typed. -#}
        {% if total_episodes %}<div class="lt-tile"><div class="lt-tile-num">{{ '{:,}'.format(total_episodes) }}</div><div class="lt-tile-label">episodes in the network's podcast feeds</div></div>{% endif %}
    </div>
    {% endif %}
    {% if trust %}
    {% set tt = trust.totals %}
    <div class="lt-trust lt-panel">
        <div>
            <h3>Every claim, on the record</h3>
            <p>Each episode's factual claims are checked against the source they cite, and what cannot be confirmed is published and marked rather than hidden. Last {{ tt.days }} days, every show:</p>
        </div>
        <div>
            <div class="lt-tiles">
                <div class="lt-tile"><div class="lt-tile-num">{{ '{:,}'.format(tt.claims) }}</div><div class="lt-tile-label">claims on the ledger across {{ tt.episodes }} episodes</div></div>
                {% if tt.verified_share_pct is not none %}<div class="lt-tile lt-tile--verified"><div class="lt-tile-num">{{ tt.verified_share_pct }}%</div><div class="lt-tile-label">verified against their source</div></div>{% endif %}
                {% if tt.flagged is not none %}<div class="lt-tile lt-tile--flagged"><div class="lt-tile-num">{{ '{:,}'.format(tt.flagged) }}</div><div class="lt-tile-label">published and marked, not yet verified</div></div>{% endif %}
                <div class="lt-tile"><div class="lt-tile-num">{{ tt.corrections }}</div><div class="lt-tile-label">corrections filed</div></div>
            </div>
            {% if trust_links %}<p class="lt-links-row">{% for l in trust_links %}<a href="{{ path_prefix }}{{ l.url }}">{{ l.label }}</a>{% endfor %}</p>{% endif %}
        </div>
    </div>
    {% endif %}
    {% if corrections %}
    <div class="lt-corrections" id="latest-corrections">
        <h3 class="lt-chart-h">Latest corrections</h3>
        <p class="lt-chart-sub">When we get something wrong we say so on the episode's page and in the next episode's show notes.</p>
        <ol>
            {% for c in corrections %}
            <li>
                <p class="lt-kicker"><a href="{{ path_prefix }}{{ c.show_page }}">{{ c.show_name }}</a> <time datetime="{{ c.date }}">{{ c.date_label }}</time></p>
                <p class="lt-corr-text"><a href="{{ path_prefix }}{{ c.post_url or c.show_page }}">Correction to episode {{ c.episode }}</a>: {{ c.text | e }}</p>
            </li>
            {% endfor %}
        </ol>
    </div>
    {% endif %}
</section>
{% endif %}

{#- Live dashboards + Story Trackers -#}
