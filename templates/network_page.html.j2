    owns. -#}
<div class="lt-soft container">
{{ soft_personal_hero_band(path_prefix, 'network', capture_source_site, wrapper_id='home-soft-personal') }}
</div>

{% if p.lead %}
{#- Today: Nerra Daily (the whole network in one episode, hosted by Mira) and
    when the day's editions go out. -#}
{% if edition or schedule %}
<section class="lt-block container" id="today" aria-label="Today on Nerra">
<div class="lt-today-grid{% if not (edition and schedule) %} is-single{% endif %}">
    {% if edition %}
    {% set e = edition %}
    <div class="lt-edition" style="--show-color:{{ e.brand_color }};">
        <div class="lt-edition-inner">
            <a class="lt-edition-cover" href="{{ path_prefix }}{{ e.show_page }}" tabindex="-1" aria-hidden="true">
                <picture>
                    {% if e.cover_webp %}<source type="image/webp" srcset="{{ path_prefix }}{{ e.cover_webp }}">{% endif %}
                    <img src="{{ path_prefix }}{{ e.cover_url }}" alt="{{ e.show_name }} cover art" width="180" height="180" loading="lazy" decoding="async">
                </picture>
            </a>
            <div>
                <p class="lt-edition-label">{{ e.show_name }} · hosted by Mira{% if e.stamp and e.stamp.label %} · {{ when(e.stamp) }}{% elif e.date %} · {{ e.date }}{% endif %}</p>
                <h2 class="lt-hl" id="lt-edition-h"><a href="{{ path_prefix }}{{ e.post_url or e.show_page }}">{{ e.hook | e }}</a></h2>
                <p class="lt-edition-note">The network's English shows in one daily episode, with Mira, the network's AI host, introducing each one. <a href="{{ path_prefix }}mira.html">Meet Mira</a>.</p>
                <div class="lt-lead-audio">
                    {% if e.audio_url %}<audio controls preload="none" src="{{ e.audio_url }}" aria-label="Play {{ e.show_name }} episode {{ e.episode_num }}"></audio>{% endif %}
                    {% if e.post_url %}<a class="lt-btn" href="{{ path_prefix }}{{ e.post_url }}">{% if e.stamp and e.stamp.is_today %}Today's rundown{% else %}Read the rundown{% endif %}</a>{% endif %}
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    {% if schedule %}
    <div class="lt-schedule lt-panel">
        <h2 class="lt-rail-h">Today on Nerra</h2>
        <p class="lt-chart-sub">When the day's editions go out, Eastern time.</p>
        <ol>
            {% for r in schedule %}
            <li data-at="{{ r.iso }}" data-day="{{ masthead.date_iso }}"><span class="lt-sched-time">{{ r.when }}</span><span class="lt-sched-what"><b>{{ r.label | e }}</b> {{ r.detail | e }}</span></li>
            {% endfor %}
        </ol>
    </div>
    {% endif %}
</div>
</section>
{% endif %}

{{ watch_block() }}

{#- Topic sections -#}
{% for sec in p.sections %}
<section class="lt-block container" id="section-{{ sec.id }}" aria-labelledby="lt-sec-{{ sec.id }}">
    <div class="lt-block-head">
        <h2 id="lt-sec-{{ sec.id }}">{{ sec.heading }}</h2>
        {% if sec.hub_url %}<a href="{{ path_prefix }}{{ sec.hub_url }}" aria-label="More {{ sec.heading | lower }}">More<span class="lt-hide-sm"> {{ sec.heading | lower }}</span> →</a>{% endif %}
    </div>
    {% if sec.stories|length == 2 %}
    <div class="lt-pair">
        {% for f in sec.stories %}
        <article class="lt-feature" style="--show-color:{{ f.brand_color }};">
            {{ media(f) }}
            <div class="lt-card-body">
                {{ kicker(f, false) }}
                <h3 class="lt-hl"{% if f.lang %} lang="{{ f.lang }}"{% endif %}><a href="{{ story_href(f) }}">{{ f.hook | e }}</a></h3>
                {{ meta(f) }}
                {{ more_list(f) }}
            </div>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <div class="lt-section-grid">
        {% set f = sec.stories[0] %}
        <article class="lt-feature" style="--show-color:{{ f.brand_color }};">
            {{ media(f) }}
            <div class="lt-card-body">
                {{ kicker(f, false) }}
                <h3 class="lt-hl"{% if f.lang %} lang="{{ f.lang }}"{% endif %}><a href="{{ story_href(f) }}">{{ f.hook | e }}</a></h3>
                {{ meta(f) }}
                {{ more_list(f) }}
            </div>
        </article>
        <ul class="lt-stack">
            {% for s in sec.stories[1:] %}{{ row(s) }}{% endfor %}
        </ul>
    </div>
    {% endif %}
</section>
{% endfor %}

{% if p.more %}
<section class="lt-block container" id="section-more" aria-labelledby="lt-more-h">
    <div class="lt-block-head"><h2 id="lt-more-h">More from the network</h2><a href="{{ path_prefix }}topics/index.html">Browse by topic →</a></div>
    <ul class="lt-stack lt-grid-3">
        {% for s in p.more %}{{ row(s, true) }}{% endfor %}
    </ul>
</section>
{% endif %}
{% endif %}{#- p.lead -#}

{#- Most Played This Week (OP3) and most read on the site (GA4), each only
    when its committed snapshot is fresh. -#}
{% if popular_episodes or most_read %}
<section class="lt-block container" id="popular" aria-labelledby="lt-pop-h">
    <div class="lt-block-head"><h2 id="lt-pop-h">Most popular</h2></div>
    <div class="lt-charts{% if not (popular_episodes and most_read) %} is-single{% endif %}">
        {% if popular_episodes %}
        <div class="lt-popular">
            <h3 class="lt-chart-h">Most Played This Week</h3>
            <p class="lt-chart-sub">Podcast downloads over the last seven days, measured by OP3; at most two per show</p>
            <ol>
                {% for ep in popular_episodes %}
                <li style="--show-color:{{ ep.brand_color or '#6B47FF' }};">
                    <div>
                        <p class="lt-kicker"><a href="{{ path_prefix }}{{ ep.show_page }}">{{ ep.show_name }}</a></p>
                        <h4 class="lt-hl"><a href="{{ path_prefix }}{{ ep.blog_url or ep.show_page }}">{{ ep.title | e }}</a></h4>
                    </div>
                </li>
                {% endfor %}
            </ol>
        </div>
        {% endif %}
        {% if most_read %}
        <div class="lt-popular">
            <h3 class="lt-chart-h">Most read on the site</h3>
            <p class="lt-chart-sub">Article views, last {{ most_read_days or 28 }} days</p>
            <ol>
                {% for ep in most_read %}
                <li style="--show-color:{{ ep.brand_color }};">
                    <div>
                        <p class="lt-kicker"><a href="{{ path_prefix }}{{ ep.show_page }}">{{ ep.show_name }}</a></p>
                        <h4 class="lt-hl"><a href="{{ path_prefix }}{{ ep.blog_url }}">{{ ep.title | e }}</a></h4>
                        {% if ep.dek %}<p class="lt-dek">{{ ep.dek }}</p>{% endif %}
                    </div>
