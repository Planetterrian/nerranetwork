{% extends "base.html.j2" %}

{#- index.html — the network's homepage, laid out as a news front page.

    Promoted from the Oct 17 2026 landing test on Oct 18 2026 (operator: "make
    the landing page test the new landing page"). Every public show's newest
    episode as a lead story, a Latest list, developing stories, top stories and
    topic sections, with the rest of the site (interviews, video, the claims
    record, dashboards, topics, Nerra Personal, books, the gallery, every way
    to listen) folded in. Data: engine/landing_test.py (stories) and
    engine/newsroom.py (timestamps, developing stories, markets, corrections,
    today's schedule); design notes: docs/landing_test.md (v1-v3).

    Rules this template keeps:
    * It is the homepage: indexable, canonical = the bare origin, in the
      sitemap; the site's own nav and footer.
    * The homepage's one email ask is the Soft Personal band (Oct 9 2026
      "Homepage Soft-only"): no per-show newsletter form here, and the footer
      form is suppressed (``suppress_footer_newsletter_form``).
    * Headlines are the episodes' own hooks and the digests' own story
      headlines, printed whole. Only the one-line ticker clips, through
      engine.titles (``ticker_text``).
    * A picture is that episode's own scene, else the show's cover art.
    * Every story says when it went out (the summary record's time, in ET);
      a value without its date — a quote, a launch — is not printed.
    * Members-only shows never appear in the page body.
    * Brand colours are fills and rules only; text uses --show-color-text.
    * Internal links carry no utm_* tag.
    * Nothing here fetches: the page is server-rendered; one small inline
      script only rewrites timestamps to "2 hours ago" and retires a "Today"
      marker or a launch once they no longer hold. -#}

{% block head_extra %}
{#- Built as dicts in generate_html and piped through tojson (always-valid
    JSON, <>& escaped). Organization (with every public show as a
    PodcastSeries) and WebSite carry over from the pre-Oct-18 homepage; the
    ItemList names the stories on today's front. #}
<script type="application/ld+json">{{ org_ld | tojson }}</script>
<script type="application/ld+json">{{ website_ld | tojson }}</script>
{%- if item_list %}
<script type="application/ld+json">{{ item_list | tojson }}</script>
{%- endif %}
{% include "_landing_styles.html.j2" %}
{% endblock %}

{#- ---------------------------------------------------------------------- -#}
{%- from "_macros.html.j2" import show_card, mira_claim, soft_personal_interest, soft_personal_hero_band -%}
{%- macro story_href(s) -%}{{ path_prefix }}{{ s.post_url or s.show_page }}{%- endmacro -%}

{%- macro media(s, eager=false) -%}
{%- if s.image_url -%}
<a href="{{ story_href(s) }}" class="lt-media{% if s.image_orientation == 'portrait' %} is-portrait{% endif %}" tabindex="-1" aria-hidden="true">
    <img src="{{ s.image_url }}" alt="AI-generated scene illustrating {{ s.show_name }} episode {{ s.episode_num }}"
         width="{{ 450 if s.image_orientation == 'portrait' else 800 }}" height="{{ 800 if s.image_orientation == 'portrait' else 450 }}"
         {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
</a>
{%- else -%}
<a href="{{ story_href(s) }}" class="lt-media is-cover" tabindex="-1" aria-hidden="true">
    <picture>
        {% if s.cover_webp %}<source type="image/webp" srcset="{{ path_prefix }}{{ s.cover_webp }}">{% endif %}
        <img src="{{ path_prefix }}{{ s.cover_url }}" alt="{{ s.show_name }} cover art" width="400" height="400"
             {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
    </picture>
</a>
{%- endif -%}
{%- endmacro -%}

{%- macro kicker(s, with_hub=true) -%}
<p class="lt-kicker">
    {% if with_hub and s.hub_heading %}<span class="lt-hub">{{ s.hub_heading }}</span>{% endif %}
    <a href="{{ path_prefix }}{{ s.show_page }}">{{ s.show_name }}</a>
</p>
{%- endmacro -%}

{#- A story's publication stamp: absolute Eastern time server-side (the
    summary record's own time; a record without one prints its date only),
    upgraded to "2 hours ago" by the script at the end of the page, which
    keeps the absolute stamp as the tooltip. -#}
{%- macro when(st, today=true) -%}
{%- if st and st.label -%}
{%- if today and st.is_today %}<span class="lt-today" data-today="{{ st.day }}">Today</span> {% endif -%}
<time datetime="{{ st.iso }}" data-rel title="{{ st.label | e }}">{{ st.label | e }}</time>
{%- endif -%}
{%- endmacro -%}

{%- macro meta(s, listen=true, read=true) -%}
<div class="lt-meta">
    {% if s.stamp and s.stamp.label %}<span class="lt-when">{{ when(s.stamp) }}</span>{% elif s.date %}<time datetime="{{ s.date_raw }}">{{ s.date }}</time>{% endif %}
    {% if read and s.post_url %}<span class="lt-dot" aria-hidden="true">•</span><a href="{{ path_prefix }}{{ s.post_url }}">Read</a>{% endif %}
    {% if listen %}<span class="lt-dot" aria-hidden="true">•</span><a href="{{ path_prefix }}{{ s.show_page }}">Listen</a>{% endif %}
</div>
{%- endmacro -%}

{%- macro more_list(s) -%}
{%- if s.more and s.post_url -%}
<p class="lt-more-label">Also in this episode</p>
<ul class="lt-more">
    {% for h in s.more %}<li{% if s.lang %} lang="{{ s.lang }}"{% endif %}><a href="{{ path_prefix }}{{ s.post_url }}">{{ h | e }}</a></li>{% endfor %}
</ul>
{%- endif -%}
{%- endmacro -%}

{%- macro row(s, with_hub=false) -%}
<li class="lt-row" style="--show-color:{{ s.brand_color }};">
    <div>
        {{ kicker(s, with_hub) }}
        <h3 class="lt-hl"{% if s.lang %} lang="{{ s.lang }}"{% endif %}><a href="{{ story_href(s) }}">{{ s.hook | e }}</a></h3>
        {{ meta(s) }}
    </div>
    {{ media(s) }}
</li>
{%- endmacro -%}

{#- Conversations: the interview shows, the site's strongest web draw. The
    claim comes from engine.brand through the mira_claim macro, never typed
    here; the guest's terms are the claim's own basis paragraph. -#}
{%- macro conversations_block() -%}
{%- if conversations -%}
{% set c = conversations[0] %}
{% set cl = conversation_links %}
<section class="lt-block container" id="conversations" aria-labelledby="lt-convo-h">
    <div class="lt-block-head">
        <h2 id="lt-convo-h">Conversations</h2>
        <p class="lt-block-sub">Real people, interviewed live by {{ mira.host_name }}, the network's AI host.</p>
        <div class="lt-block-links">
            {% if cl.hub %}<a href="{{ path_prefix }}{{ cl.hub }}">All interviews →</a>{% endif %}
            {% if cl.mira %}<a href="{{ path_prefix }}{{ cl.mira }}">Meet {{ mira.host_name }} →</a>{% endif %}
        </div>
    </div>
    <div class="lt-convo-grid">
        <article class="lt-convo-feature" style="--show-color:{{ c.brand_color }};">
            <div class="lt-convo-top">
                <a href="{{ path_prefix }}{{ c.post_url }}" tabindex="-1" aria-hidden="true">
                    <picture>
                        {% if c.cover_webp %}<source type="image/webp" srcset="{{ path_prefix }}{{ c.cover_webp }}">{% endif %}
                        <img src="{{ path_prefix }}{{ c.cover_url }}" alt="{{ c.show_name }} cover art" width="132" height="132" loading="lazy" decoding="async">
                    </picture>
                </a>
                <div>
                    <p class="lt-kicker"><a href="{{ path_prefix }}{{ c.show_page }}">{{ c.show_name }}</a>{% if c.date %} <span class="lt-hub" style="color:var(--lt-muted);">{{ c.date }}</span>{% endif %}</p>
                    <h3 class="lt-guest"><a href="{{ path_prefix }}{{ c.post_url }}">{{ c.guest | e }}</a></h3>
                    {% if c.identifier %}<p class="lt-guest-id">{{ c.identifier | e }}</p>{% endif %}
                </div>
            </div>
            {% if c.hook %}<p class="lt-convo-hook">{{ c.hook | e }}</p>{% endif %}
            <div class="lt-meta">
                {% if c.run_time %}<span>{{ c.run_time }}</span><span class="lt-dot" aria-hidden="true">•</span>{% endif %}
                <span>Hosted by {{ mira.host_name }}{% if c.cohost %} with {{ c.cohost | e }}{% endif %}</span>
            </div>
            <div class="lt-lead-audio">
                {% if c.audio_url %}<audio controls preload="none" src="{{ c.audio_url }}" aria-label="Play {{ c.show_name }} episode {{ c.episode }} with {{ c.guest | e }}"></audio>{% endif %}
                <a class="lt-btn lt-btn--primary" href="{{ path_prefix }}{{ c.post_url }}">Read the conversation</a>
            </div>
        </article>
        <div>
            {% if conversations|length > 1 %}
            <p class="lt-sublabel">More conversations</p>
            <ul class="lt-convo-list">
                {% for x in conversations[1:] %}
                <li style="--show-color:{{ x.brand_color }};">
                    <p class="lt-kicker"><a href="{{ path_prefix }}{{ x.show_page }}">{{ x.show_name }}</a>{% if x.date %} <time style="color:var(--lt-muted);font-weight:500;letter-spacing:0;text-transform:none;">{{ x.date }}</time>{% endif %}</p>
                    <h3 class="lt-hl"><a href="{{ path_prefix }}{{ x.post_url }}">{{ x.guest | e }}</a></h3>
                    {% if x.identifier %}<p class="lt-guest-id">{{ x.identifier | e }}</p>{% endif %}
                </li>
                {% endfor %}
            </ul>
            {% endif %}
            {% if cl.apply %}
            <div class="lt-apply">
                <h3>Be interviewed by {{ mira.host_name }}</h3>
                <p>Tell us what you are building or have learned.{% if cl.guest_picks %} Every guest's book, tool and bet are on <a href="{{ path_prefix }}{{ cl.guest_picks }}" style="color:var(--lt-cyan);text-decoration:underline;">the guest picks page</a>.{% endif %}</p>
                <div class="lt-signup-actions">
                    {% for a in cl.apply %}<a class="lt-btn{% if loop.first %} lt-btn--primary{% endif %}" href="{{ path_prefix }}{{ a.url }}">Apply to {{ a.show_name }}</a>{% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    <div class="lt-claim-wrap">
        {{ mira_claim() }}
    </div>
</section>
{%- endif -%}
{%- endmacro -%}

{#- Watch: the newest English long-form per show and the newest hook Short
    per show, from the committed youtube_videos.json indexes. The picture is
    the episode's own scene art (gallery), else a titled card — never a
    YouTube-hosted thumbnail. -#}
{%- macro watch_block() -%}
{%- if watch and (watch.longs or watch.shorts) -%}
<section class="lt-block container" id="watch" aria-labelledby="lt-watch-h">
    <div class="lt-block-head">
        <h2 id="lt-watch-h">Watch</h2>
        <p class="lt-block-sub">Every episode is also a video. Subscribe on YouTube:</p>
        {% if watch.channels %}
        <div class="lt-channels">
            {% for ch in watch.channels %}<a class="lt-chip" href="{{ ch.url }}" target="_blank" rel="noopener"{% if ch.lang %} lang="{{ ch.lang }}"{% endif %}><span class="lt-yt-badge" aria-hidden="true">▶</span>{{ ch.handle }} <small class="lt-chip-count">{{ ch.label }}</small></a>{% endfor %}
        </div>
        {% endif %}
    </div>
    {% if watch.longs %}
    <div class="lt-watch-grid">
        {% for v in watch.longs %}
        <article class="lt-video" style="--show-color:{{ v.brand_color }};">
            {% if v.image_url %}
            <a href="{{ v.watch_url }}" class="lt-media" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <img src="{{ v.image_url }}" alt="AI-generated scene from {{ v.show_name | e }} episode {{ v.episode }}" width="{{ 450 if v.image_orientation == 'portrait' else 800 }}" height="{{ 800 if v.image_orientation == 'portrait' else 450 }}" loading="lazy" decoding="async">
            </a>
            {% else %}
            <a href="{{ v.watch_url }}" class="lt-media is-card" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><span>{{ v.show_name | e }}</span></a>
            {% endif %}
            <div>
                <h3 class="lt-hl"><a href="{{ v.watch_url }}" target="_blank" rel="noopener">{{ v.display_title | e }}</a></h3>
                <p class="lt-kicker" style="margin-top:6px;"><a href="{{ path_prefix }}{{ v.show_page }}">{{ v.show_name | e }}</a> <time datetime="{{ v.date_raw }}" style="color:var(--lt-muted);font-weight:500;letter-spacing:0;text-transform:none;">{{ v.date }}</time></p>
            </div>
        </article>
        {% endfor %}
    </div>
    {% endif %}
    {% if watch.shorts and not watch.longs %}
    <p class="lt-links-row"><a href="#shorts">Today's Shorts from every show ↑</a></p>
    {% endif %}
</section>
{%- endif -%}
{%- endmacro -%}

{#- The Shorts reel (Oct 18 2026, operator: "build the video Shorts into the
    landing page … discovery of shows"). One hook Short per public show
    (engine.landing_test.pick_videos + order_shorts_for_discovery: one per
    beat first), each a 9:16 card on the episode's own portrait scene (never
    a YouTube-hosted thumbnail) with two actions — Play, in an in-page player,
    and the show page. Rules this keeps:
    * Nothing from YouTube loads until a visitor presses Play: the player is
      a facade, and its frame is the privacy-enhanced youtube-nocookie.com
      embed. Each Play is a real link to the Short, so with no script (or a
      modified click) it opens YouTube; a row whose watch_url has no
      parseable id is only ever that link.
    * A muted preview loop (preview_url, engine.short_preview) plays only
      while its card is on screen, never under prefers-reduced-motion, and
      preloads nothing; without one the card is its still.
    * Brand colours are fills; text uses --show-color-text. -#}
{%- macro shorts_reel() -%}
{%- if watch and watch.shorts -%}
{%- set reel = watch.shorts -%}
<section class="lt-block container lt-reel-block" id="shorts" aria-labelledby="lt-shorts-h">
    <div class="lt-block-head lt-reel-head">
        <h2 id="lt-shorts-h">Shorts</h2>
        <p class="lt-block-sub">A minute from each show: the newest Short from {{ reel|length }} shows. Play one here, then open the show you like.</p>
        <div class="lt-reel-nav" data-reel-nav hidden>
            <button type="button" class="lt-reel-arrow" data-reel-prev aria-label="Scroll Shorts back" aria-controls="lt-reel-track"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <button type="button" class="lt-reel-arrow" data-reel-next aria-label="Scroll Shorts forward" aria-controls="lt-reel-track"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
        {#- Oct 22 2026: click-to-load fallback when IntersectionObserver
            is missing or the visitor wants the reel before scrolling. -#}
        <p class="lt-reel-load-wrap">
            <button type="button" class="lt-btn lt-btn--ghost" id="lt-reel-load" data-reel-load hidden>Load Shorts</button>
        </p>
    </div>
    <div class="lt-reel" data-reel data-at-start data-reel-lazy="1">
        <ol class="lt-reel-track" id="lt-reel-track" data-reel-track aria-label="Shorts, one per show">
            {% for v in reel %}
            <li class="lt-reel-card" style="--show-color:{{ v.brand_color }};" data-reel-item>
                <div class="lt-reel-frame{% if not v.image_url %} is-card{% endif %}">
                    {% if v.image_url %}
                    <img class="lt-reel-img" data-src="{{ v.image_url }}" alt="AI-generated scene from {{ v.show_name | e }} episode {{ v.episode }}" width="{{ 450 if v.image_orientation == 'portrait' else 800 }}" height="{{ 800 if v.image_orientation == 'portrait' else 450 }}" loading="lazy" decoding="async"{% if v.image_orientation != 'portrait' %} data-landscape{% endif %} data-reel-media>
                    {% elif v.cover_url %}
                    <img class="lt-reel-cover" data-src="{{ path_prefix }}{{ v.cover_url }}" alt="{{ v.show_name | e }} cover art" width="160" height="160" loading="lazy" decoding="async" data-reel-media>
                    {% endif %}
                    {% if v.preview_url %}
                    <video class="lt-reel-preview" data-src="{{ v.preview_url }}"{% if v.image_url %} data-poster="{{ v.image_url }}"{% endif %} muted loop playsinline preload="none" disablepictureinpicture disableremoteplayback aria-hidden="true" tabindex="-1" data-reel-preview data-reel-media></video>
                    {% endif %}
                    <span class="lt-reel-badge" aria-hidden="true"><span class="lt-chip-dot"></span><span class="lt-reel-badge-name">{{ v.show_name | e }}</span></span>
                    <span class="lt-reel-glyph" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span>
                    <div class="lt-reel-caption">
                        <h3 class="lt-reel-title">{{ v.display_title | e }}</h3>
                        <time class="lt-reel-date" datetime="{{ v.date_raw }}">{{ v.date }}</time>
                    </div>
                    {% if v.embed_url %}
                    <a class="lt-reel-hit" href="{{ v.watch_url }}" target="_blank" rel="noopener" data-reel-play="{{ loop.index0 }}" aria-haspopup="dialog" aria-controls="lt-player">
                        <span class="sr-only">Play the Short: {{ v.display_title | e }}, from {{ v.show_name | e }}</span>
                    </a>
                    {% else %}
                    <a class="lt-reel-hit" href="{{ v.watch_url }}" target="_blank" rel="noopener">
                        <span class="sr-only">Watch on YouTube: {{ v.display_title | e }}, from {{ v.show_name | e }} (opens in a new tab)</span>
                    </a>
                    {% endif %}
                </div>
                <a class="lt-reel-show" href="{{ path_prefix }}{{ v.show_page }}">Listen to <b>{{ v.show_name | e }}</b><span class="lt-reel-arrowtext" aria-hidden="true">&nbsp;→</span></a>
            </li>
            {% endfor %}
        </ol>
    </div>
    {#- The player's data: the ids and links the cards already carry, as one
        JSON blob (tojson: <>& escaped). No embed loads until Play. -#}
    {%- set ns = namespace(items=[]) -%}
    {%- for v in reel -%}
    {%- set _ = ns.items.append({
        "id": v.video_id or "",
        "embed": v.embed_url or "",
        "title": v.display_title or "",
        "show": v.show_name or "",
        "color": v.brand_color or "",
        "show_page": path_prefix ~ v.show_page,
        "post": (path_prefix ~ v.post_url) if v.post_url else "",
        "watch": v.watch_url or "",
        "poster": v.image_url or "",
    }) -%}
    {%- endfor %}
    <script type="application/json" id="lt-reel-data">{{ ns.items | tojson }}</script>
    <dialog class="lt-player" id="lt-player" aria-labelledby="lt-player-title" aria-describedby="lt-player-note" aria-modal="true" data-player>
        <div class="lt-player-shell">
            <div class="lt-player-stage">
                <div class="lt-player-frame" data-player-frame></div>
                <div class="lt-player-fallback" data-player-fallback hidden>
                    <p>This Short can't play here.</p>
                    <a class="lt-btn lt-btn--primary" href="#" target="_blank" rel="noopener" data-player-fallback-watch>Watch on YouTube <span aria-hidden="true">↗</span></a>
                    <button type="button" class="lt-btn" data-player-fallback-next>Next Short <span aria-hidden="true">→</span></button>
                </div>
                <button type="button" class="lt-player-step is-prev" data-player-prev aria-label="Previous Short"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
                <button type="button" class="lt-player-step is-next" data-player-next aria-label="Next Short"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="lt-player-info">
                <p class="lt-player-show"><span class="lt-chip-dot" aria-hidden="true"></span><span data-player-show></span><span class="lt-player-count" data-player-count></span></p>
                <h2 class="lt-player-title" id="lt-player-title" data-player-title></h2>
                <div class="lt-player-actions">
                    <a class="lt-btn lt-btn--primary" href="#" data-player-show-link>Listen to the show</a>
                    <a class="lt-btn" href="#" data-player-post>Read the episode</a>
                    <a class="lt-btn" href="#" target="_blank" rel="noopener" data-player-watch>Watch on YouTube <span aria-hidden="true">↗</span></a>
                </div>
                <p class="lt-player-note" id="lt-player-note">Plays from YouTube in privacy-enhanced mode, and only after you press play. Use the arrow keys or swipe for the next show. <a href="{{ path_prefix }}privacy-policy.html">Privacy</a></p>
            </div>
            <button type="button" class="lt-player-close" data-player-close aria-label="Close the player"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
        </div>
    </dialog>
</section>
{%- endif -%}
{%- endmacro -%}

{% block content %}
<div class="lt-page">
{% set p = page %}

<header class="lt-masthead container"><div class="lt-masthead-inner">
    <div class="lt-masthead-meta">
        <time class="lt-dateline" datetime="{{ masthead.date_iso }}">{{ masthead.date }}</time>
        <span>Updated <time datetime="{{ masthead.updated_iso }}">{{ masthead.updated }}</time></span>
        {% if p.today_new %}<span>{{ p.today_new }} new {{ 'episode' if p.today_new == 1 else 'episodes' }} today</span>{% endif %}
        {% if p.story_count %}<span>Stories from across the network</span>{% endif %}
    </div>
    <div class="lt-masthead-row">
        <div class="lt-brandline">
            <h1 class="lt-wordmark">Nerra Network <span>Today</span></h1>
            <p class="lt-tagline">{{ network_tagline }}</p>
        </div>
        <div class="lt-standfirst-wrap">
            <p class="lt-standfirst">{{ network_promise() }}</p>
            {#- Where a first-time reader goes next: today's whole-network
                episode, the show finder and the feeds. Each is a page that
                exists; the edition link only when an edition was built. -#}
            <p class="lt-masthead-actions">
                {% if edition %}<a class="is-primary" href="{{ path_prefix }}{{ edition.post_url or edition.show_page }}">{% if edition.stamp and edition.stamp.is_today %}Play today's {{ edition.show_name }}{% else %}Play the latest {{ edition.show_name }}{% endif %}</a>{% endif %}
                {# The same destination as the nav's "Find your show" (Oct 18 2026:
                   this one went to start-here.html, the nav to explore.html). #}
                <a href="{{ path_prefix }}explore.html">Find your show</a>
                <a href="{{ path_prefix }}how-to-listen.html">Listen in any app</a>
            </p>
        </div>
    </div>
</div></header>

{#- Markets & launches: committed files only, each value under its as-of
    date (engine.newsroom.market_strip). A stale or undated value is absent. -#}
{%- set mk = markets -%}
{% if mk and (mk.groups or mk.launch) %}
<div class="container"><aside class="lt-markets" id="markets" aria-label="Markets and launches"{% if live_ticker %} data-live-markets="{{ live_ticker.markets_api }}" data-every="{{ live_ticker.quotes_every_s }}"{% endif %}>
    <span class="lt-markets-h">Markets &amp; launches</span>
    <button type="button" class="lt-tape-pause" hidden aria-pressed="false" data-pause="Pause" data-play="Play">Pause</button>
    <ul>
        {% for g in mk.groups %}
        <li class="lt-mk-group" data-quotes><span class="lt-mk-label">{{ g.label }} · <time datetime="{{ g.as_of_iso }}">{{ g.as_of }}</time></span>
            {% for q in g.quotes %}<span class="lt-quote is-{{ q.direction }}" data-symbol="{{ q.symbol }}"><b class="lt-quote-sym">{{ q.symbol }}</b> <span class="lt-quote-px">{{ q.price }}</span>{% if q.change %} <span class="lt-quote-chg">{{ q.change }}</span>{% endif %}</span>{% endfor %}
        </li>
        {% endfor %}
        {% if mk.launch %}
        {% set l = mk.launch %}
        <li class="lt-mk-group lt-launch" data-expires="{{ l.net_iso }}"><span class="lt-mk-label">Next SpaceX launch · schedule of <time datetime="{{ l.as_of_iso }}">{{ l.as_of_short }}</time></span>
            <span class="lt-launch-name">{{ l.mission }}{% if l.rocket %} · {{ l.rocket }}{% endif %}</span>
            <span class="lt-quote-px">no earlier than <time datetime="{{ l.net_iso }}">{{ l.net }}</time></span>
        </li>
        {% endif %}
    </ul>
    <a class="lt-markets-more" href="#dashboards">Dashboards →</a>
</aside></div>
{% endif %}

