{% extends "base.html.j2" %}

{# May 2026 operator request: homepage nav previously read just
   ``Latest | Subscribe`` — inconsistent with the rest of the site
   which carries ``Start Here | Listen | About | Player`` in the
   top-right. Switched to that 4-link set + the in-page ``Latest``
   and ``Subscribe`` anchors so the homepage matches every other
   page while still exposing the homepage-specific jump links. #}
{% block nav_links %}
<li><a href="{{ path_prefix }}start-here.html">{{ t.nav_start_here }}</a></li>
<li><a href="{{ path_prefix }}how-to-listen.html">{{ t.nav_how_to_listen }}</a></li>
<li><a href="{{ path_prefix }}about.html">{{ t.nav_about }}</a></li>
<li><a href="{{ path_prefix }}player.html">{{ t.nav_player }}</a></li>
<li><a href="#latest">Latest</a></li>
<li><a href="#subscribe">Subscribe</a></li>
{% endblock %}

{# Mobile links carry no inline onclick: base.html.j2 closes the menu (and
   clears the body scroll lock) with one delegated listener. The previous
   per-link handlers here forgot the body class, so tapping "Latest" or
   "Subscribe" left the homepage scroll-locked (Sep 2026 review). #}
{% block mobile_nav_links %}
<a href="{{ path_prefix }}start-here.html">{{ t.nav_start_here }}</a>
<a href="{{ path_prefix }}how-to-listen.html">{{ t.nav_how_to_listen }}</a>
<a href="{{ path_prefix }}about.html">{{ t.nav_about }}</a>
<a href="{{ path_prefix }}player.html">{{ t.nav_player }}</a>
<a href="#latest">Latest</a>
<a href="#subscribe">Subscribe</a>
{% endblock %}

{% block head_extra %}
    <!-- Schema.org: Organization + PodcastSeries -->
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Nerra Network",
  "url": "https://nerranetwork.com",
  "description": "Independent podcast network featuring daily ad-free shows covering AI, Tesla, investing, space, science, environmental policy, and more. Produced in Vancouver, Canada.",
  "logo": "https://nerranetwork.com/assets/nerra-logo-icon.svg",
  "hasPart": [
    {% for s in all_shows %}
    {
      "@type": "PodcastSeries",
      "name": "{{ s.name }}",
      "description": "{{ s.description_long[:200] | e }}",
      "webFeed": "https://nerranetwork.com/{{ s.rss_file }}",
      "image": "https://nerranetwork.com/{{ s.podcast_image }}",
      "url": "https://nerranetwork.com/{{ s.show_page }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
    </script>
    {# Orbit float, CTA pulse and their reduced-motion gates live in
       styles/main.css (`.orbit-card` uses the per-card `--i` delay). The
       inline copy that used to sit here overrode them with a second,
       conflicting keyframe set and an nth-child stagger that stopped at
       the 11th show — removed Sep 2026. #}
{% endblock %}

{% block content %}
    <!-- Hero -->
    <section class="network-hero">
        <div class="network-hero-bg">
            <!-- Animated gradient orbs -->
            <div class="hero-orb hero-orb-1"></div>
            <div class="hero-orb hero-orb-2"></div>
            <div class="hero-orb hero-orb-3"></div>
            <!-- Grid overlay -->
            <div class="hero-grid"></div>
        </div>
        <div class="network-hero-content">
            <div class="hero-badge">Independent Podcast Network</div>
            <h1><span class="gradient-text">Nerra</span> Network</h1>
            <p class="network-hero-tagline">Feed your curiosity. Not your anxiety.</p>
            <p class="hero-subtitle">{{ all_shows|length }} ad-free shows on Tesla, SpaceX, AI, markets, space, science, world news, first-principles thinking and more — most of them new every day, in four listening languages. Independently produced in Vancouver, Canada.</p>
            <div class="hero-show-orbit">
                {% for s in all_shows %}
                {% set _pbase = s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image %}
                <a href="{{ path_prefix }}{{ s.show_page }}" class="orbit-card" style="--i: {{ loop.index0 }};" title="{{ s.name }}">
                    <picture>
                        <source type="image/webp" srcset="{{ path_prefix }}{{ _pbase }}-400.webp 400w, {{ path_prefix }}{{ _pbase }}-800.webp 800w" sizes="120px">
                        {#- Only the first row of covers competes for early bandwidth;
                            17 `fetchpriority=high` images starved the hero text and
                            font CSS (Sep 2026 review). -#}
                        <img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" width="1400" height="1400"{% if loop.index0 < 7 %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %} />
                    </picture>
                </a>
                {% endfor %}
            </div>
            <div class="hero-cta-row">
                <a href="#shows" class="nn-btn nn-btn-primary nn-btn-lg hero-cta-primary" style="--show-color:var(--nn-purple);">Explore Shows</a>
                <a href="{{ path_prefix }}start-here.html" class="nn-btn nn-btn-lg">Start Here</a>
                <a href="{{ path_prefix }}player.html" class="nn-btn nn-btn-lg">Open Player</a>
                <a href="#subscribe" class="nn-btn nn-btn-lg">Subscribe Free</a>
            </div>

            <!-- Network proof stats -->
            <div class="hero-proof-stats" aria-label="Network stats">
                <div class="proof-stat">
                    <strong>{{ all_shows|length }}</strong>
                    <span>shows</span>
                </div>
                <div class="proof-stat">
                    <strong>{{ '{:,}'.format(total_episodes) }}</strong>
                    <span>episodes shipped</span>
                </div>
                <div class="proof-stat">
                    <strong>0</strong>
                    <span>ads</span>
                </div>
                <div class="proof-stat">
                    <strong>4</strong>
                    <span>listening languages</span>
                </div>
            </div>
        </div>
    </section>

    {# Decorative ticker, driven from the registry so it can never drift
       from the lineup (the hand-maintained list was stuck at 15 of 17
       shows). Hidden from assistive tech — it duplicates the show grid. #}
    <div class="topic-ticker" aria-hidden="true">
        <div class="ticker-track">
            {% for _pass in range(2) %}{% for s in all_shows %}
            <span>{{ s.name }}</span>
            {% endfor %}{% endfor %}
        </div>
    </div>

    {# The legacy standalone stats bar was removed Aug 30 2026: it repeated
       the hero-proof-stats band verbatim two screens apart (operator
       screenshot — "duplicating elements"). The hero band is the one that
       stays; do not reintroduce a second cadence/episodes/languages/ads
       strip below the ticker. #}

    {# May 2026 operator request: "Find Your Show" interactive picker
       was removed and replaced by the Fresh Episodes / Blog / Why Nerra
       triplet (in that order) — these three sections used to live
       BELOW the Show Showcase grid; they now sit in the prime slot
       between the stats bar and the show grid so the page leads with
       what listeners actually came for (recent episodes + recent
       writing + the network's pitch) before showing the full
       show-grid catalogue. The old triplet positions below have been
       removed in the same edit to avoid duplication. #}

    <!-- Latest Across the Network -->
    <section id="latest" class="nn-section" style="background:var(--nn-bg-alt);">
        <div class="container">
            <div class="nn-section-header">
                <div class="section-label">Fresh Episodes</div>
                <h2>Latest Across the Network</h2>
                <p>The ten newest episodes across the network, freshest first.</p>
            </div>
        </div>
        {% if latest_episodes %}
        <div class="latest-scroll-row">
            {% for ep in latest_episodes %}
            <div class="latest-scroll-card glass-card">
                <div class="episode-card-show" style="background:{{ ep.brand_color }};">{{ ep.show_name }}</div>
                {% if ep.blog_url %}
                <a href="{{ path_prefix }}{{ ep.blog_url }}" class="episode-card-title" style="display:block;color:inherit;text-decoration:none;">{{ ep.title }}</a>
                {% else %}
                <div class="episode-card-title">{{ ep.title }}</div>
                {% endif %}
                <div class="episode-card-date">{{ ep.date_display }}</div>
                {% if ep.audio_url %}
                <audio controls preload="none" src="{{ ep.audio_url }}" aria-label="{{ ep.show_name }} episode audio" style="width:100%;height:36px;border-radius:8px;margin-top:var(--sp-2);"></audio>
                {% endif %}
                {% if ep.blog_url %}
                <a href="{{ path_prefix }}{{ ep.blog_url }}" style="display:inline-block;margin-top:var(--sp-2);font-family:var(--font-ui);font-size:0.8rem;color:{{ ep.brand_color }};text-decoration:none;">Read article →</a>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="latest-scroll-row">
            <p style="color:var(--nn-text-muted);padding:2rem;text-align:center;width:100%;">Episodes will appear here once available.</p>
        </div>
        {% endif %}
    </section>

    <!-- Nerra Personal promo (Aug 2026: the paid product had no homepage
         presence beyond a footer link; Aug 30: promoted into the prime
         slot after Fresh Episodes and rebuilt as a real product band —
         features + lineup covers + both entry points). -->
    <section class="nn-section" id="personal-promo">
        <div class="container" style="max-width:1040px;">
            <div style="border:1px solid var(--nn-border);border-radius:20px;background:var(--nn-surface);position:relative;overflow:hidden;">
                <div style="position:absolute;inset:0;background:
                    radial-gradient(ellipse at 88% 10%, rgba(0,212,255,0.14), transparent 55%),
                    radial-gradient(ellipse at 5% 95%, rgba(107,71,255,0.12), transparent 50%);pointer-events:none;"></div>
                <div style="position:relative;display:grid;grid-template-columns:minmax(300px,1.2fr) minmax(260px,1fr);gap:2rem;padding:2.4rem 2.2rem;align-items:center;" class="personal-promo-grid">
                    <div>
                        <div class="section-label">Nerra Personal</div>
                        <h2 style="font-family:var(--font-heading);margin:0.4rem 0 0.7rem;font-size:1.9rem;line-height:1.15;">Your own daily show, built from the shows you already love</h2>
                        <p style="color:var(--nn-text-muted);margin:0 0 1.1rem;">
                            Pick your shows and their order. Every morning Mira
                            assembles them into <strong>one private podcast
                            episode made just for you</strong> — greeting you by
                            name, with chapters for every segment.</p>
                        <ul style="list-style:none;margin:0 0 1.4rem;padding:0;display:grid;gap:0.45rem;color:var(--nn-text-muted);font-size:0.95rem;">
                            <li>✓ One feed, your lineup, your order — in any podcast app</li>
                            <li>✓ Mira anchors it and greets you by name</li>
                            <li>✓ Free account: newsletter, gallery downloads, book discounts</li>
                            <li>✓ $4.99/mo · cancel any time · no ads, ever</li>
                        </ul>
                        <p style="margin:0;display:flex;gap:0.6rem;flex-wrap:wrap;">
                            <a class="nn-btn nn-btn-primary" href="{{ path_prefix }}join.html">Build your show →</a>
                            <a class="nn-btn" href="{{ path_prefix }}account.html">Member sign in</a>
                            <a class="nn-btn" href="{{ path_prefix }}nerra-daily.html">Try Nerra Daily free</a>
                        </p>
                    </div>
                    <div aria-hidden="true" style="display:grid;gap:0.6rem;">
                        <div style="font-family:var(--font-ui);font-size:0.72rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--nn-text-muted);">Your morning, one feed</div>
                        {#- Sample lineup: only shows that are actually in the
                            Personal lineup (Nerra Daily and the two Mira
                            interview shows are not). -#}
                        {% set _lineup_sample = all_shows | rejectattr('slug', 'in', ['nerra_daily', 'age_of_ai', 'nerra_voices', 'finansy_prosto', 'privet_russian']) | list %}
                        {% for s in _lineup_sample[:4] %}
                        {% set _pbase = s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image %}
                        <div style="display:flex;align-items:center;gap:0.7rem;border:1px solid var(--nn-border);border-radius:12px;padding:0.5rem 0.7rem;background:color-mix(in srgb, var(--nn-surface) 70%, transparent);">
                            <picture>
                                <source type="image/webp" srcset="{{ path_prefix }}{{ _pbase }}-400.webp">
                                <img src="{{ path_prefix }}{{ s.podcast_image }}" alt="" width="44" height="44" loading="lazy" style="width:44px;height:44px;border-radius:8px;">
                            </picture>
                            <span style="font-size:0.9rem;">{{ s.name }}</span>
                            <span style="margin-left:auto;font-size:0.75rem;color:var(--nn-text-muted);">{{ loop.index }}</span>
                        </div>
                        {% endfor %}
                        <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.8rem;color:var(--nn-cyan,#00D4FF);">
                            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:currentColor;"></span>
                            PRIVATE FEED · chapters + Mira's links between shows
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <style>@media (max-width: 760px){ .personal-promo-grid { grid-template-columns: 1fr !important; } }</style>

    {% if popular_episodes %}
    <!-- Most Played This Week (OP3 download data, refreshed nightly) -->
    <section id="popular" class="nn-section">
        <div class="container">
            <div class="nn-section-header">
                <div class="section-label">Listener Favorites</div>
                <h2>Most Played This Week</h2>
                <p>The episodes listeners played most over the last seven days — at most two per show, so you see the breadth of the network.</p>
            </div>
        </div>
        <div class="latest-scroll-row">
            {% for ep in popular_episodes %}
            <div class="latest-scroll-card glass-card">
                <div class="episode-card-show" style="background:{{ ep.brand_color }};">#{{ ep.rank }} · {{ ep.show_name }}</div>
                {% if ep.blog_url %}
                <a href="{{ path_prefix }}{{ ep.blog_url }}" class="episode-card-title" style="display:block;color:inherit;text-decoration:none;">{{ ep.title }}</a>
                {% else %}
                <div class="episode-card-title">{{ ep.title }}</div>
                {% endif %}
                {% if ep.audio_url %}
                <audio controls preload="none" src="{{ ep.audio_url }}" aria-label="{{ ep.show_name }} episode audio" style="width:100%;height:36px;border-radius:8px;margin-top:var(--sp-2);"></audio>
                {% endif %}
                {% if ep.blog_url %}
                <a href="{{ path_prefix }}{{ ep.blog_url }}" style="display:inline-block;margin-top:var(--sp-2);font-family:var(--font-ui);font-size:0.8rem;color:{{ ep.brand_color }};text-decoration:none;">Read article →</a>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <!-- Latest from the Blog -->
    {% if latest_blog_posts %}
    <section class="nn-section">
        <div class="container">
            <div class="nn-section-header">
                <div class="section-label">Blog</div>
                <h2>Latest from the Blog</h2>
                <p>In-depth articles from our latest episodes.</p>
            </div>
            <div class="blog-idx-grid" style="max-width:900px;margin:0 auto;padding-bottom:var(--sp-8)">
                {% for post in latest_blog_posts %}
                <a href="{{ path_prefix }}blog/{{ post.show_slug }}/ep{{ '%03d' % post.episode_num }}.html"
                   class="blog-idx-card"
                   style="--card-show-color: {{ post.show_color }}">
                    <div class="blog-idx-card-top">
                        <span class="blog-idx-show-badge" style="background:color-mix(in srgb, {{ post.show_color }} 15%, transparent);color:{{ post.show_color }}">{{ post.show_name }}</span>
                        <span class="blog-idx-date">{{ post.date }}</span>
                        <span class="blog-idx-ep">Ep {{ post.episode_num }}</span>
                        <span class="blog-idx-reading">{{ post.reading_time_min }} min</span>
                    </div>
                    <h3>{{ post.title }}</h3>
                    {#- The hook IS the title on most shows (blog.py falls back
                        to it); don't print the same sentence twice. -#}
                    {% if post.hook and post.hook != post.title %}
                    <p>{{ post.hook[:140] }}{% if post.hook|length > 140 %}&hellip;{% endif %}</p>
                    {% endif %}
                    <span class="blog-idx-read-more" style="color:{{ post.show_color }}">Read article &rarr;</span>
                </a>
                {% endfor %}
            </div>
            <div style="text-align:center">
                <a href="{{ path_prefix }}blog/index.html" class="nn-btn nn-btn-primary" style="font-size:0.9rem;padding:var(--sp-3) var(--sp-8)">View all blog posts</a>
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Why Nerra -->
    <section class="nn-section" style="background:var(--nn-bg-alt);">
        <div class="container">
            <div class="nn-section-header">
                <div class="section-label">Why Nerra</div>
                <h2>Built different</h2>
            </div>
            <div class="features-grid">
                <div class="feature-card glass-card">
                    <div class="feature-icon">&#9889;</div>
                    <h3>Sourced, Not Vibes</h3>
                    <p>Every episode is built from dozens of named sources, and every article links to them. A source-integrity gate checks that cited claims actually appear where we say they do. <a href="{{ path_prefix }}editorial.html">See how an episode is made</a>.</p>
                </div>
                <div class="feature-card glass-card">
                    <div class="feature-icon">&#127911;</div>
                    <h3>Zero Ads. Zero Sponsors.</h3>
                    <p>No ad reads, no sponsor segments, no clickbait. Every episode on every show is free; <a href="{{ path_prefix }}join.html">Nerra Personal</a> is the optional upgrade for people who want one custom feed.</p>
                </div>
                <div class="feature-card glass-card">
                    <div class="feature-icon">&#127758;</div>
                    <h3>Multi-Perspective Coverage</h3>
                    <p>Omni View argues each side of a story in its strongest form. Across the network we pull from diverse sources to present balanced, nuanced takes &mdash; not echo chambers.</p>
                </div>
                <div class="feature-card glass-card">
                    <div class="feature-icon">&#128197;</div>
                    <h3>A Cadence You Can Set Your Morning By</h3>
                    <p>Most shows publish every day; the rest weekly or when an interview is ready, and each show page says which. Build a daily habit you can rely on.</p>
                </div>
                <div class="feature-card glass-card">
                    <div class="feature-icon">&#127463;&#127464;</div>
                    <h3>Made in Canada</h3>
                    <p>Independently produced in Vancouver by Patrick Novak. No corporate backing, no editorial interference.</p>
                </div>
                <div class="feature-card glass-card">
                    <div class="feature-icon">&#128266;</div>
                    <h3>Four Listening Languages</h3>
                    <p>English originals with Fran&ccedil;ais, Русский and 中文 audio tracks, plus two shows made natively in Russian. Pick your audio language with the globe in the menu.</p>
                </div>
            </div>
        </div>
    </section>

    {# --- Find Your Show picker REMOVED (May 2026) — original chip
       set retained below as a comment for easy resurrection if the
       operator changes their mind. ---
       (chip list previously here — three rows of topic / audience /
       language buttons + clear-filters action — all removed.) --- #}

    <!-- Show Showcase -->
    <section id="shows" class="nn-section">
        <div class="container">
            <div class="nn-section-header">
                <div class="section-label">Our Shows</div>
                <h2>Daily intelligence on the topics that matter</h2>
                <p>Every show is ad-free and independently produced; most publish every day. Pick one, or let <a href="{{ path_prefix }}nerra-daily.html">Nerra Daily</a> hand you the whole network in one episode.</p>
            </div>
            <div class="show-showcase" id="show-showcase-grid">
                {% for s in all_shows %}
                <div class="show-card-wrap"
                     data-slug="{{ s.slug }}"
                     data-topics="{{ s.picker_tags.topics | default([]) | join(' ') }}"
                     data-audience="{{ s.picker_tags.audience | default([]) | join(' ') }}"
                     data-language="{{ s.picker_tags.language | default([]) | join(' ') }}"
                     style="--show-color:{{ s.brand_color }};">
                    {% set _scbase = s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image %}
                    <a href="{{ path_prefix }}{{ s.show_page }}" class="show-card glass-card">
                        <picture>
                            <source type="image/webp" srcset="{{ path_prefix }}{{ _scbase }}-400.webp 400w, {{ path_prefix }}{{ _scbase }}-800.webp 800w" sizes="(max-width: 600px) 180px, 280px">
                            <img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" class="show-card-image" width="1400" height="1400" loading="lazy">
                        </picture>
                        <div class="show-card-name">{{ s.name }}</div>
                        <div class="show-card-badges">
                            {% if s.schedule %}<span class="show-card-badge">{{ s.schedule }}</span>{% endif %}
                            {% if s.episode_length %}<span class="show-card-badge">{{ s.episode_length }}</span>{% endif %}
                            {% if s.picker_tags and s.picker_tags.language and 'russian' in s.picker_tags.language %}<span class="show-card-badge">In Russian</span>{% endif %}
                        </div>
                        <div class="show-card-tagline">{{ s.description_long | default(s.tagline) }}</div>
                        {% if s.audience %}
                        {# Strip the leading "For " some audience strings use so we don't double it. #}
                        <div class="show-card-audience"><strong>For:</strong>
                            {{ s.audience | replace('For ', '', 1) if s.audience.startswith('For ') else s.audience }}
                        </div>
                        {% endif %}
                        {% if s.source_highlights %}
                        <div class="show-card-sources">Sources: {{ s.source_highlights | join(', ') }}</div>
                        {% endif %}
                        <div class="show-card-listen">
                            Listen
                            <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                    </a>
                    <a href="{{ path_prefix }}{{ s.blog_page }}" class="show-card-blog-link">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        Read Blog
                    </a>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# Fresh Episodes / Blog / Why Nerra triplet was moved ABOVE the
       Show Showcase as part of the May 2026 homepage restructure
       (operator request). The original positions here are now empty
       to avoid duplicating those sections on the page. #}

    <!-- About the Network -->
    <section class="nn-section" style="background:var(--nn-bg-alt);">
        <div class="container">
            <div class="nn-section-header">
                <div class="section-label">About</div>
                <h2>About Nerra Network</h2>
            </div>
            <div class="about-section-text">
                <p><strong>Ad-free shows on the ideas shaping tomorrow.</strong></p>
                <p>Nerra Network is an independent podcast network of {{ all_shows|length }} shows covering Tesla, SpaceX, AI for experts and beginners, modern investing, balanced world news, space and astronomy, science and longevity, environmental policy, first-principles thinking, the unintended consequences of big decisions, good news with something you can do about it (The DP Pod), Canada's offshore energy story (Offshore North), live AI-hosted interviews (The Age of AI), and financial literacy and language learning in Russian &mdash; plus Nerra Daily, the whole network in one daily edition. All produced in Vancouver, Canada by Patrick Novak, with AI doing the writing and narration and a human owning the standards. <a href="{{ path_prefix }}ai-disclosure.html">How we use AI</a>.</p>
                <p>Our mission: stimulating conversation, supporting positive developments that benefit all, and providing unbiased coverage with varying perspectives.</p>
            </div>
        </div>
    </section>

    <!-- Subscribe -->
    <section id="subscribe" class="nn-section" style="border-top:1px solid var(--nn-border);">
        <div class="container">
            <div class="nn-section-header">
                <div class="section-label">Listen Anywhere</div>
                <h2>Subscribe Everywhere</h2>
                <p>Every show has its own RSS feed. Paste it into any podcast app — Apple Podcasts, Spotify, Pocket Casts, Overcast — and new episodes arrive automatically.</p>
            </div>
            <div class="subscribe-badges">
                <a href="{{ path_prefix }}network.rss" class="subscribe-badge">
                    Network RSS (All Shows)
                </a>
                <a href="{{ path_prefix }}blog.rss" class="subscribe-badge">
                    Network Blog RSS
                </a>
            </div>
            <div class="subscribe-show-list">
                {% for s in all_shows %}
                {% set _subbase = s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image %}
                <div class="subscribe-show-row">
                    <picture>
                        <source type="image/webp" srcset="{{ path_prefix }}{{ _subbase }}-400.webp">
                        <img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" width="1400" height="1400" loading="lazy">
                    </picture>
                    <div class="subscribe-show-meta">
                        <div class="subscribe-show-name">{{ s.name }}</div>
                        <div class="subscribe-show-tagline">{{ s.tagline }}</div>
                    </div>
                    <div class="subscribe-show-links">
                        {% if s.apple_podcasts_url %}
                        <a href="{{ s.apple_podcasts_url | with_utm(campaign=s.slug) }}" target="_blank" rel="noopener" class="subscribe-link-btn" aria-label="Subscribe to {{ s.name }} on Apple Podcasts" data-show="{{ s.slug }}">Apple</a>
                        {% endif %}
                        {% if s.spotify_url %}
                        <a href="{{ s.spotify_url | with_utm(campaign=s.slug) }}" target="_blank" rel="noopener" class="subscribe-link-btn" aria-label="Subscribe to {{ s.name }} on Spotify" data-show="{{ s.slug }}">Spotify</a>
                        {% endif %}
                        <a href="{{ path_prefix }}{{ s.rss_file }}" class="subscribe-link-btn subscribe-link-rss" aria-label="Subscribe to {{ s.name }} via RSS" data-show="{{ s.slug }}">RSS</a>
                    </div>
                </div>
                {% endfor %}
            </div>
            <p style="text-align:center;color:var(--nn-text-muted);font-family:var(--font-ui);font-size:0.88rem;margin-top:var(--sp-6);">Every feed works in every podcast app today &mdash; copy the RSS link into yours. Apple Podcasts and Spotify buttons appear as each show's directory listing goes live. <a href="{{ path_prefix }}how-to-listen.html" style="color:var(--nn-text-muted);">How to listen</a>.</p>
        </div>
    </section>

    <!-- Newsletter -->
    <section id="newsletter" class="nn-section" style="border-top:1px solid var(--nn-border);background:radial-gradient(ellipse at 50% 0%, rgba(124,92,255,0.12), transparent 70%);">
        <div class="container" style="max-width:680px;">
            <div class="nn-section-header">
                <div class="section-label">Episode briefings by email</div>
                <h2>Get the shows you follow in your inbox</h2>
                <p>Each show sends a short briefing when a new episode lands: the sources, the key numbers, and a link to listen. Pick the shows; unsubscribe anytime.</p>
                {% if newsletter_subscriber_count %}
                <p style="font-family:var(--font-ui);font-size:0.85rem;color:var(--nn-text-muted);margin-top:var(--sp-2);">Join {{ "{:,}".format(newsletter_subscriber_count) }}+ readers already subscribed.</p>
                {% endif %}
            </div>
            {# Posts to the account Worker like every other signup form on the
               site (Sep 2026 review). This form was the last one still
               POSTing straight to Buttondown's embed endpoint: it opened the
               raw response in a new tab, declared "Check your email ✓" on a
               timer whether or not the request worked, and — because it
               bypassed the Worker — created no Nerra account, so homepage
               subscribers never got the gallery downloads and book discount
               the join page promises. #}
            <form class="nn-subscribe-form" style="max-width:none;"
                  onsubmit="var f=this,boxes=f.querySelectorAll('input[name=tag]:checked');if(boxes.length===0){alert('Please pick at least one show to subscribe to.');return false;}var btn=f.querySelector('button[type=submit]');btn.disabled=true;btn.textContent='Subscribing…';var tags=Array.prototype.map.call(boxes,function(c){return c.value;});fetch('https://api.nerranetwork.com/api/subscribe',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:f.email.value,list:'member',tags:tags})}).then(function(r){btn.textContent=r.ok?'Check your email ✓':'Something went wrong — try again';if(r.ok){var a=f.querySelector('.nn-account-link');if(a)a.style.display='inline';}}).catch(function(){btn.textContent='Something went wrong — try again';}).then(function(){btn.disabled=false;});return false;">
                <p style="font-family:var(--font-ui);font-size:0.85rem;color:var(--nn-text-muted);margin-bottom:var(--sp-3);">
                    Pick the shows you want — everything's selected by default. Uncheck any you'd rather skip.
                    <a href="#" onclick="event.preventDefault();this.closest('form').querySelectorAll('input[name=tag]').forEach(function(b){b.checked=false;});return false;" style="color:var(--nn-text-muted);font-size:0.8rem;">Clear all</a>
                    ·
                    <a href="#" onclick="event.preventDefault();this.closest('form').querySelectorAll('input[name=tag]').forEach(function(b){b.checked=true;});return false;" style="color:var(--nn-text-muted);font-size:0.8rem;">Select all</a>
                </p>
                <div class="nn-subscribe-tags" style="margin-bottom:var(--sp-4);">
                    {% for s in all_shows %}
                    <label><input type="checkbox" name="tag" value="{{ s.newsletter_tag or s.name }}" checked> {{ s.name }}</label>
                    {% endfor %}
                </div>
                <div class="nn-subscribe-row">
                    <input type="email" name="email" placeholder="your@email.com" required aria-label="Email address">
                    <button type="submit">Subscribe</button>
                </div>
                <p style="font-family:var(--font-ui);font-size:0.75rem;color:var(--nn-text-muted);margin-top:var(--sp-2);">
                    Subscribing creates a free Nerra account (gallery downloads, member perks). No spam, and we never share your email. Read our
                    <a href="{{ path_prefix }}privacy-policy.html" style="color:var(--nn-text-muted);">privacy policy</a>.
                    <a class="nn-account-link" href="{{ path_prefix }}account.html" style="display:none;margin-left:0.5rem;color:var(--nn-cyan);">Your account →</a>
                </p>
            </form>
        </div>
    </section>

    {# --- May 2026: "Find Your Show" picker styles + JS were
       removed when the section came out. The non-picker styles
       below (``.show-card-wrap`` filter classes, ``.show-card-audience``,
       ``.subscribe-show-list``) are still referenced by other
       sections so they stay. --- #}
    <style>
      /* Show-card filter states — used by future picker reinstatement
         or any other selector that wants to dim non-matching cards. */
      .show-card-wrap.is-dimmed { opacity: 0.32; filter: grayscale(0.5); }
      .show-card-wrap.is-dimmed .show-card { pointer-events: none; }
      .show-card-wrap.is-match {
        box-shadow: 0 0 0 2px color-mix(in srgb, var(--show-color, #6B47FF) 70%, transparent);
        border-radius: 16px;
      }
      .show-card-audience {
        font-size: 0.82rem; color: var(--nn-text-muted);
        margin-top: 4px; line-height: 1.4;
      }
      .show-card-audience strong { color: var(--nn-text); font-weight: 600; }

      /* Subscribe-section per-show rows — independent of the picker. */
      .subscribe-show-list {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 12px; margin: 24px auto 0; max-width: 1100px;
      }
      .subscribe-show-row {
        display: flex; align-items: center; gap: 12px;
        background: var(--nn-surface, #161a24); border: 1px solid var(--nn-border);
        border-radius: 12px; padding: 12px 14px;
      }
      .subscribe-show-row img { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; flex-shrink: 0; }
      .subscribe-show-meta { flex: 1; min-width: 0; }
      .subscribe-show-name { font-weight: 600; font-size: 0.95rem; color: var(--nn-text); }
      .subscribe-show-tagline { font-size: 0.78rem; color: var(--nn-text-muted); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .subscribe-show-links { display: flex; gap: 6px; flex-shrink: 0; }
      .subscribe-link-btn {
        font-size: 0.75rem; padding: 6px 10px; border-radius: 6px;
        border: 1px solid var(--nn-border); background: rgba(124,92,255,0.08);
        color: var(--nn-text); text-decoration: none; font-family: var(--font-ui);
      }
      .subscribe-link-btn:hover { background: rgba(124,92,255,0.22); }
      .subscribe-link-rss { background: rgba(255,140,0,0.12); }
    </style>
{% endblock %}
