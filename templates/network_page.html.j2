{% block scripts %}
{%- if watch and watch.shorts %}
{#- Oct 22 2026: load shorts-reel.js only when #shorts scrolls into view
    (IntersectionObserver), with a click-to-load fallback. Media uses
    data-src until then so the homepage does not pay for the reel up front.
    YouTube still loads only on Play. #}
<script>
(function () {
  var loaded = false;
  var section = document.getElementById('shorts');
  if (!section) return;
  var btn = document.getElementById('lt-reel-load');
  var scriptSrc = {{ (path_prefix ~ 'assets/js/shorts-reel.js') | tojson }};

  function hydrateMedia() {
    var nodes = section.querySelectorAll('[data-reel-media]');
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      var src = el.getAttribute('data-src');
      if (src && !el.getAttribute('src')) el.setAttribute('src', src);
      var poster = el.getAttribute('data-poster');
      if (poster && !el.getAttribute('poster')) el.setAttribute('poster', poster);
      el.removeAttribute('data-src');
      el.removeAttribute('data-poster');
    }
  }

  function loadReel() {
    if (loaded) return;
    loaded = true;
    if (btn) btn.hidden = true;
    hydrateMedia();
    var s = document.createElement('script');
    s.src = scriptSrc;
    s.defer = true;
    document.body.appendChild(s);
  }

  if (btn) {
    btn.addEventListener('click', loadReel);
    if (!('IntersectionObserver' in window)) btn.hidden = false;
  }

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          io.disconnect();
          loadReel();
          return;
        }
      }
    }, { rootMargin: '240px 0px' });
    io.observe(section);
  } else if (btn) {
    btn.hidden = false;
  }
})();
</script>
{%- endif %}
{#- Oct 19 2026: live quotes from the Worker, Latest headlines re-read from
    this page's newest build, and both rows moving as a tape. -#}
<script src="{{ path_prefix }}assets/js/live-ticker.js" defer></script>
{#- Relative timestamps (BBC / Guardian convention): the server prints the
    absolute Eastern time; this rewrites it to "2 hours ago" / "Yesterday",
    keeps the absolute stamp as the tooltip, drops a "Today" marker whose
    Eastern date has passed, retires a launch whose time has come, and marks
    the schedule rows that have already gone out. Nothing is fetched. -#}
<script>
(function () {
  var now = new Date();
  var etDay = function (d) {
    try { return new Intl.DateTimeFormat('en-CA', {timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit'}).format(d); }
    catch (e) { return ''; }
  };
  var today = etDay(now);
  var yest = etDay(new Date(now.getTime() - 864e5));
  document.querySelectorAll('time[data-rel]').forEach(function (el) {
    var raw = el.getAttribute('datetime') || '';
    var day = '', mins = null;
    if (raw.indexOf('T') > 0) {
      var t = new Date(raw);
      if (isNaN(t)) return;
      mins = Math.round((now - t) / 6e4);
      day = etDay(t);
    } else { day = raw; }
    var text = '';
    if (mins !== null && mins >= 0 && mins < 60) text = mins <= 1 ? 'Just now' : mins + ' minutes ago';
    else if (mins !== null && mins >= 60 && mins < 1440) { var h = Math.round(mins / 60); text = h + (h === 1 ? ' hour ago' : ' hours ago'); }
    else if (day && day === today) text = 'Today';
    else if (day && day === yest) text = 'Yesterday';
    if (text) el.textContent = text;
  });
  document.querySelectorAll('[data-today]').forEach(function (el) {
    if (today && el.getAttribute('data-today') !== today) el.remove();
  });
  document.querySelectorAll('[data-expires]').forEach(function (el) {
    var t = new Date(el.getAttribute('data-expires'));
    if (!isNaN(t) && t < now) el.remove();
  });
  document.querySelectorAll('li[data-at]').forEach(function (el) {
    var t = new Date(el.getAttribute('data-at'));
    if (el.getAttribute('data-day') === today && !isNaN(t) && t <= now) el.classList.add('is-past');
  });
})();
</script>
{% endblock %}
