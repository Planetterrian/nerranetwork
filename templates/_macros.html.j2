{#- =======================================================================
    Nerra Network — shared template macros
    ----------------------------------------------------------------------- -#}

{#- cover_img: render a cover-art <picture> with WebP source + JPG fallback.

    Arguments:
      src            : JPG path (e.g. "assets/covers/tesla-shorts-time.jpg")
      alt            : accessible alt text
      width, height  : intrinsic dimensions (default 1400×1400)
      loading        : 'lazy' (default) or 'eager'
      fetchpriority  : '' (default) or 'high' for LCP images
      classes        : extra class names on the <img>
      sizes          : CSS sizes attribute; enables 400/800/1400 srcset when set
      img_style      : inline style on the <img>
      onerror        : inline JS onerror handler
-#}
{%- macro cover_img(src, alt, width=1400, height=1400, loading='lazy',
                    fetchpriority='', classes='', sizes='',
                    img_style='', onerror='') -%}
{%- set base = src[:-4] if src.endswith('.jpg') else src -%}
<picture>
{%- if sizes -%}
<source type="image/webp" srcset="{{ base }}-400.webp 400w, {{ base }}-800.webp 800w, {{ base }}.webp 1400w" sizes="{{ sizes }}">
{%- else -%}
<source type="image/webp" srcset="{{ base }}.webp">
{%- endif %}
<img src="{{ src }}" alt="{{ alt }}" width="{{ width }}" height="{{ height }}"
{%- if classes %} class="{{ classes }}"{% endif -%}
{%- if loading %} loading="{{ loading }}"{% endif -%}
{%- if fetchpriority %} fetchpriority="{{ fetchpriority }}"{% endif -%}
{%- if img_style %} style="{{ img_style }}"{% endif -%}
{%- if onerror %} onerror="{{ onerror }}"{% endif -%}>
</picture>
{%- endmacro -%}

{#- ai_badge: a small, honest "made with AI — transparently" chip that links to
    the network AI-disclosure page. Turns the AI question into a trust signal
    (and gets ahead of platform disclosure norms). Inline-styled so it renders
    consistently regardless of which page embeds it.

    Arguments:
      path_prefix : relative path back to site root (for the disclosure link)
      is_ru       : render the label in Russian for the RU shows
-#}
{%- macro ai_badge(path_prefix='', is_ru=false) -%}
<a href="{{ path_prefix }}ai-disclosure.html" class="nn-ai-badge" rel="nofollow"
   title="{% if is_ru %}Как мы используем ИИ — прозрачно{% else %}How we use AI — full transparency{% endif %}"
   style="display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border:1px solid var(--nn-border);border-radius:100px;font-family:var(--font-ui);font-size:0.72rem;font-weight:600;color:var(--nn-text-muted);text-decoration:none;line-height:1.4;white-space:nowrap;">
  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v.01M11 12h1v4h1"/></svg>
  {% if is_ru %}Создано с ИИ — прозрачно{% else %}Made with AI — transparently{% endif %}
</a>
{%- endmacro -%}

{#- mira_claim: the network's novelty claim, its basis, and the invitation to
    correct it — always all three, always from engine/brand.py.

    The claim is deliberately narrow ("the guest decides whether it is
    published"), because the broad version ("an AI host interviews people")
    is not ours to claim: other people were doing that first. Do not
    paraphrase it in a template and do not render the claim without the
    basis — a superlative with no basis is exactly what the AI-disclosure
    page exists to rule out, and this network's honesty is the asset the
    claim trades on.

    Reads the ``mira`` Jinja global (registered in generate_html.py's
    ``_get_jinja_env``), so any page can call it with no generator change.

    Arguments:
      heading     : optional <h2>/<h3> text above the claim ('' = no heading)
      level       : heading tag to use (default 'h2')
      classes     : extra class names on the wrapper
      show_footnote : render the correction invitation (default true)
-#}
{%- macro mira_claim(heading='', level='h2', classes='', show_footnote=true) -%}
<div class="nn-mira-claim {{ classes }}">
  {%- if heading %}
  <{{ level }} class="nn-mira-claim__heading">{{ heading }}</{{ level }}>
  {%- endif %}
  <p class="nn-mira-claim__claim"><strong>{{ mira.claim }}</strong></p>
  <p class="nn-mira-claim__basis">{{ mira.basis }}</p>
  {%- if show_footnote %}
  <p class="nn-mira-claim__footnote"><em>{{ mira.footnote }}</em></p>
  {%- endif %}
</div>
{%- endmacro -%}

{#- The interview steps, as the numbered list /mira.html has always shown.

    Reads the ``mira_steps`` / ``mira_steps_compact`` Jinja globals, which
    generate_html registers from engine.brand.MIRA_INTERVIEW_STEPS — so the
    hub and the show pages cannot tell a guest two different stories about
    what happens after they apply. ``compact`` renders the subset a show page
    shows beside its Hosted-by-Mira band; the styles are ``.mira-steps`` in
    styles/main.css.
-#}
{%- macro mira_steps_list(compact=false, classes='') -%}
<ol class="mira-steps{% if compact %} mira-steps--compact{% endif %} {{ classes }}">
  {%- for title, detail in (mira_steps_compact if compact else mira_steps) %}
  <li>
    <h3>{{ title }}</h3>
    <p>{{ detail }}</p>
  </li>
  {%- endfor %}
</ol>
{%- endmacro -%}

{#- One show card, used by the homepage grid and by /explore.html.

    Extracted 2026-09-21 when /explore.html needed the same card: it carries the
    `data-topics` / `data-audience` / `data-language` attributes the chip filters
    read, and a second hand-maintained copy would drift from the homepage's the
    first time a badge changed. The homepage's rendered card is unchanged apart
    from leading whitespace. -#}
{%- macro show_card(s, path_prefix='') -%}
<div class="show-card-wrap"
     data-slug="{{ s.slug }}"
     data-strand="{{ s.strand | default('') }}"
     data-topics="{{ s.picker_tags.topics | default([]) | join(' ') }}"
     data-audience="{{ s.picker_tags.audience | default([]) | join(' ') }}"
     data-language="{{ s.picker_tags.language | default([]) | join(' ') }}"
     style="--show-color:{{ s.brand_color }};">
    {% set _scbase = s.podcast_image[:-4] if s.podcast_image.endswith('.jpg') else s.podcast_image %}
    <a href="{{ path_prefix }}{{ s.show_page }}" class="show-card glass-card">
        <picture>
            <source type="image/webp" srcset="{{ path_prefix }}{{ _scbase }}-400.webp 400w, {{ path_prefix }}{{ _scbase }}-800.webp 800w" sizes="(max-width: 600px) 180px, 280px">
            <img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" class="show-card-image" width="1400" height="1400" loading="lazy">
        </picture>
        <div class="show-card-name">{{ s.name }}</div>
        <div class="show-card-badges">
            {#- The strand badge is first: the three shows Mira
                hosts are the network's most differentiated and
                display_order scatters them through this grid. #}
            {% if s.strand == 'mira' %}<span class="show-card-badge show-card-badge--strand">Hosted by Mira</span>{% endif %}
            {% if s.schedule %}<span class="show-card-badge">{{ s.schedule }}</span>{% endif %}
            {% if s.episode_length %}<span class="show-card-badge">{{ s.episode_length }}</span>{% endif %}
            {% if s.picker_tags and s.picker_tags.language and 'russian' in s.picker_tags.language %}<span class="show-card-badge">In Russian</span>{% endif %}
        </div>
        <div class="show-card-tagline">{{ s.description_long | default(s.tagline) }}</div>
        {% if s.audience %}
        {# Strip the leading "For " some audience strings use so we don't double it. #}
        <div class="show-card-audience"><strong>For:</strong>
            {{ s.audience | replace('For ', '', 1) if s.audience.startswith('For ') else s.audience }}
        </div>
        {% endif %}
        {% if s.source_highlights %}
        <div class="show-card-sources">Sources: {{ s.source_highlights | join(', ') }}</div>
        {% endif %}
        <div class="show-card-listen">
            Listen
            <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
    </a>
    <a href="{{ path_prefix }}{{ s.blog_page }}" class="show-card-blog-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Read Blog
    </a>
</div>
{%- endmacro -%}
