{#- =======================================================================
    Nerra Network — shared template macros
    ----------------------------------------------------------------------- -#}

{#- cover_img: render a cover-art <picture> with WebP source + JPG fallback.

    Arguments:
      src            : JPG path (e.g. "assets/covers/tesla-shorts-time.jpg")
      alt            : accessible alt text
      width, height  : intrinsic dimensions (default 1400×1400)
      loading        : 'lazy' (default) or 'eager'
      fetchpriority  : '' (default) or 'high' for LCP images
      classes        : extra class names on the <img>
      sizes          : CSS sizes attribute; enables 400/800/1400 srcset when set
      img_style      : inline style on the <img>
      onerror        : inline JS onerror handler
-#}
{%- macro cover_img(src, alt, width=1400, height=1400, loading='lazy',
                    fetchpriority='', classes='', sizes='',
                    img_style='', onerror='') -%}
{%- set base = src[:-4] if src.endswith('.jpg') else src -%}
<picture>
{%- if sizes -%}
<source type="image/webp" srcset="{{ base }}-400.webp 400w, {{ base }}-800.webp 800w, {{ base }}.webp 1400w" sizes="{{ sizes }}">
{%- else -%}
<source type="image/webp" srcset="{{ base }}.webp">
{%- endif %}
<img src="{{ src }}" alt="{{ alt }}" width="{{ width }}" height="{{ height }}"
{%- if classes %} class="{{ classes }}"{% endif -%}
{%- if loading %} loading="{{ loading }}"{% endif -%}
{%- if fetchpriority %} fetchpriority="{{ fetchpriority }}"{% endif -%}
{%- if img_style %} style="{{ img_style }}"{% endif -%}
{%- if onerror %} onerror="{{ onerror }}"{% endif -%}>
</picture>
{%- endmacro -%}

{#- ai_badge: a small, honest "made with AI — transparently" chip that links to
    the network AI-disclosure page. Turns the AI question into a trust signal
    (and gets ahead of platform disclosure norms). Inline-styled so it renders
    consistently regardless of which page embeds it.

    Arguments:
      path_prefix : relative path back to site root (for the disclosure link)
      is_ru       : render the label in Russian for the RU shows
-#}
{%- macro ai_badge(path_prefix='', is_ru=false) -%}
<a href="{{ path_prefix }}ai-disclosure.html" class="nn-ai-badge" rel="nofollow"
   title="{% if is_ru %}Как мы используем ИИ — прозрачно{% else %}How we use AI — full transparency{% endif %}"
   style="display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border:1px solid var(--nn-border);border-radius:100px;font-family:var(--font-ui);font-size:0.72rem;font-weight:600;color:var(--nn-text-muted);text-decoration:none;line-height:1.4;white-space:nowrap;">
  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v.01M11 12h1v4h1"/></svg>
  {% if is_ru %}Создано с ИИ — прозрачно{% else %}Made with AI — transparently{% endif %}
</a>
{%- endmacro -%}
