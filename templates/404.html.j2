{% extends "base.html.j2" %}

{% block head_extra %}
    {# Error pages must never be indexed — without this the 404 page is a
       crawlable "content" page (June 2026 website review). #}
    <meta name="robots" content="noindex">
    <style>
        .error-page {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 60vh;
            text-align: center;
            padding: var(--sp-12) var(--sp-6);
        }
        .error-code {
            font-family: var(--font-heading);
            font-size: clamp(4rem, 10vw, 8rem);
            font-weight: 700;
            background: linear-gradient(135deg, var(--nn-purple), var(--nn-cyan));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1;
            margin-bottom: var(--sp-4);
        }
        .error-page h1 {
            font-family: var(--font-heading);
            font-size: clamp(1.2rem, 3vw, 1.6rem);
            font-weight: 600;
            color: var(--nn-white);
            margin: 0 0 var(--sp-4);
        }
        .error-page p {
            font-family: var(--font-body);
            font-size: 1rem;
            color: var(--nn-text-muted);
            line-height: 1.6;
            max-width: 420px;
            margin: 0 0 var(--sp-8);
        }
        .error-links {
            display: flex;
            flex-wrap: wrap;
            gap: var(--sp-3);
            justify-content: center;
        }
        .error-links a {
            display: inline-flex;
            align-items: center;
            gap: var(--sp-2);
            padding: var(--sp-3) var(--sp-6);
            border-radius: 100px;
            font-family: var(--font-ui);
            font-size: 0.9rem;
            font-weight: 500;
            text-decoration: none;
            transition: all var(--duration) var(--ease);
        }
        .error-links .primary {
            background: linear-gradient(135deg, var(--nn-purple), var(--nn-cyan));
            color: #fff;
        }
        .error-links .primary:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }
        .error-links .secondary {
            border: 1px solid var(--nn-border);
            color: var(--nn-text-muted);
        }
        .error-links .secondary:hover {
            border-color: var(--nn-purple);
            color: var(--nn-white);
        }
    </style>
{% endblock %}

{% block content %}
    {# base.html.j2 already wraps {% block content %} in <main id="main-content">,
       so this child uses a <div> to avoid the nested-main HTML5 invalidity. #}
    <div class="error-page">
        <div class="error-code">404</div>
        <h1>Page not found</h1>
        <p>The page you're looking for doesn't exist or has been moved. The search box in the top bar covers every episode ever published, or try one of these:</p>
        <div class="error-links">
            <a href="{{ path_prefix }}index.html" class="primary">Go Home</a>
            <a href="{{ path_prefix }}start-here.html" class="secondary">Start Here</a>
            <a href="{{ path_prefix }}index.html#shows" class="secondary">All Shows</a>
            <a href="{{ path_prefix }}player.html" class="secondary">Player</a>
            <a href="{{ path_prefix }}blog/index.html" class="secondary">Browse Blog</a>
        </div>
    </div>
    {#- A static host serves this page for every dead URL, so GA4 records the
        404 as an ordinary page_view of the path that was asked for. That is how
        the Sep 2026 audit found that 26% of landing sessions were hitting URLs
        with no file — by inference, from a report that looked like traffic.
        A named event makes the same fact a first-class metric instead:
        scripts/audit_dead_urls.py reads landing pages, this reads the misses
        nobody lands twice on. -#}
    <script>
      (function () {
        if (typeof gtag !== 'function') return;
        gtag('event', 'page_not_found', {
          requested_path: window.location.pathname,
          requested_query: window.location.search,
          referrer: document.referrer || '(none)'
        });
      })();
    </script>
{% endblock %}
