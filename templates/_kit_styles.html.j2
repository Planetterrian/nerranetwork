{#- The kit pages' shared styles: the media kit (press.html) and the
    sponsorship kit (sponsor.html) read as one family (Oct 21 2026). -#}
    <style>
        .mk { max-width: 1040px; margin: 0 auto; padding: 0 var(--sp-6); }
        .mk-hero { padding: calc(var(--nav-height) + var(--sp-12)) 0 var(--sp-8); }
        .mk-eyebrow { font-family: var(--font-ui); font-size: .78rem; letter-spacing: .12em;
            text-transform: uppercase; color: var(--nn-purple-text); margin: 0 0 var(--sp-3); }
        .mk-hero h1 { font-family: var(--font-heading); font-size: clamp(2.2rem, 6vw, 3.4rem);
            font-weight: 700; line-height: 1.05; color: var(--nn-white); margin: 0 0 var(--sp-4);
            letter-spacing: -.02em; }
        .mk-hero h1 span { background: var(--nn-gradient); -webkit-background-clip: text;
            background-clip: text; color: transparent; }
        .mk-lede { font-family: var(--font-body); font-size: 1.15rem; line-height: 1.6;
            color: var(--nn-text); max-width: 720px; margin: 0 0 var(--sp-5); }
        .mk-meta { font-family: var(--font-ui); font-size: .85rem; color: var(--nn-text-muted); margin: 0 0 var(--sp-6); }
        .mk-actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
        .mk-btn { display: inline-flex; align-items: center; gap: .5rem; padding: .7rem 1.2rem;
            border-radius: 100px; font-family: var(--font-ui); font-weight: 600; font-size: .92rem;
            text-decoration: none; border: 1px solid var(--nn-border-hover); color: var(--nn-white);
            background: var(--nn-card); cursor: pointer; }
        .mk-btn:hover, .mk-btn:focus-visible { border-color: var(--nn-cyan); }
        .mk-btn-primary { background: var(--nn-gradient); border-color: transparent; color: #fff; }
        .mk-toc { display: flex; flex-wrap: wrap; gap: .4rem .9rem; padding: var(--sp-4) 0;
            border-top: 1px solid var(--nn-border); border-bottom: 1px solid var(--nn-border);
            margin-bottom: var(--sp-6); }
        .mk-toc a { font-family: var(--font-ui); font-size: .88rem; color: var(--nn-text-muted); text-decoration: none; }
        .mk-toc a:hover { color: var(--nn-white); }
        .mk-section { padding: var(--sp-8) 0; border-bottom: 1px solid var(--nn-border); scroll-margin-top: calc(var(--nav-height) + 1rem); }
        .mk-section:last-of-type { border-bottom: 0; }
        .mk-section h2 { font-family: var(--font-heading); font-size: clamp(1.5rem, 3.5vw, 2rem);
            font-weight: 700; color: var(--nn-white); margin: 0 0 var(--sp-2); }
        .mk-section h3 { font-family: var(--font-heading); font-size: 1.12rem; font-weight: 600;
            color: var(--nn-white); margin: var(--sp-6) 0 var(--sp-2); }
        .mk-section p, .mk-section li { font-family: var(--font-body); color: var(--nn-text); line-height: 1.65; }
        .mk-section p { margin: 0 0 var(--sp-4); max-width: 760px; }
        .mk-sub { color: var(--nn-text-muted) !important; font-size: .98rem; }
        .mk-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); margin: var(--sp-5) 0; }
        .mk-stats.four { grid-template-columns: repeat(4, 1fr); }
        .mk-stat { background: var(--nn-card); border: 1px solid var(--nn-border); border-radius: 14px; padding: var(--sp-4); }
        .mk-stat-v { font-family: var(--font-heading); font-size: 1.9rem; font-weight: 700; color: var(--nn-white); line-height: 1.1; }
        .mk-stat-l { font-family: var(--font-ui); font-size: .82rem; color: var(--nn-text-muted); margin-top: .35rem; line-height: 1.4; }
        .mk-card { background: var(--nn-card); border: 1px solid var(--nn-border); border-radius: 14px; padding: var(--sp-5); margin-bottom: var(--sp-4); }
        .mk-facts { display: grid; grid-template-columns: max-content 1fr; gap: .55rem 1.4rem; margin: 0; }
        .mk-facts dt { font-family: var(--font-ui); font-size: .85rem; color: var(--nn-text-muted); }
        .mk-facts dd { margin: 0; font-family: var(--font-body); color: var(--nn-text); }
        .mk-table { width: 100%; border-collapse: collapse; font-family: var(--font-ui); font-size: .9rem; }
        .mk-table th, .mk-table td { text-align: left; padding: .6rem .5rem; border-bottom: 1px solid var(--nn-border); color: var(--nn-text); }
        .mk-table th { color: var(--nn-text-muted); font-weight: 500; font-size: .8rem; }
        .mk-table td.num, .mk-table th.num { text-align: right; font-variant-numeric: tabular-nums; }
        .mk-table-wrap { overflow-x: auto; }
        .mk-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--sp-4); }
        .mk-bars { list-style: none; padding: 0; margin: 0; }
        .mk-bars li { display: grid; grid-template-columns: 7.5rem 1fr 2.6rem; align-items: center; gap: .6rem;
            font-family: var(--font-ui); font-size: .86rem; margin: .4rem 0; }
        .mk-bar { height: 8px; border-radius: 4px; background: var(--nn-surface); overflow: hidden; }
        .mk-bar i { display: block; height: 100%; background: var(--nn-gradient); }
        .mk-show { display: grid; grid-template-columns: 96px 1fr; gap: var(--sp-4); align-items: start; }
        .mk-show img { width: 96px; height: 96px; border-radius: 12px; object-fit: cover; }
        .mk-show h3 { margin-top: 0; }
        .mk-pills { display: flex; flex-wrap: wrap; gap: .4rem; margin: .4rem 0 .8rem; padding: 0; list-style: none; }
        .mk-pills li { font-family: var(--font-ui); font-size: .78rem; padding: .25rem .65rem; border-radius: 100px;
            border: 1px solid var(--nn-border-hover); color: var(--nn-text); }
        .mk-guests { columns: 2 220px; column-gap: var(--sp-5); padding-left: 1.1rem; margin: .4rem 0 0; }
        .mk-guests li { break-inside: avoid; margin: .15rem 0; }
        .mk-guests small { color: var(--nn-text-muted); font-family: var(--font-ui); }
        .mk-check { list-style: none; padding: 0; margin: 0; }
        .mk-check li { padding-left: 1.6rem; position: relative; margin: .45rem 0; }
        .mk-check li::before { content: "✓"; position: absolute; left: 0; color: var(--nn-cyan); font-weight: 700; }
        .mk-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: var(--sp-3); }
        .mk-tile { background: var(--nn-card); border: 1px solid var(--nn-border); border-radius: 12px; padding: var(--sp-3);
            display: flex; gap: var(--sp-3); align-items: center; text-decoration: none; }
        .mk-tile:hover { border-color: var(--nn-border-hover); }
        .mk-tile img { width: 52px; height: 52px; border-radius: 8px; object-fit: cover; flex-shrink: 0; }
        .mk-tile b { display: block; font-family: var(--font-heading); font-size: .92rem; color: var(--nn-white); }
        .mk-tile span { font-family: var(--font-ui); font-size: .76rem; color: var(--nn-text-muted); }
        .mk-founder { display: grid; grid-template-columns: 64px 1fr; gap: var(--sp-4); }
        .mk-avatar { width: 64px; height: 64px; border-radius: 50%; background: var(--nn-gradient); display: grid; place-items: center;
            font-family: var(--font-heading); font-weight: 700; color: #fff; font-size: 1.2rem; }
        .mk-role { font-family: var(--font-ui); font-size: .85rem; color: var(--nn-text-muted); margin: 0 0 .6rem; }
        .mk-copy { position: relative; }
        .mk-copy blockquote { margin: 0; font-family: var(--font-body); color: var(--nn-text); line-height: 1.65; }
        .mk-copy-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: .6rem; }
        .mk-copy-head b { font-family: var(--font-heading); color: var(--nn-white); }
        .mk-copy-head small { font-family: var(--font-ui); color: var(--nn-text-muted); }
        .mk-copy-btn { font-family: var(--font-ui); font-size: .78rem; padding: .3rem .8rem; border-radius: 6px;
            border: 1px solid var(--nn-border-hover); background: var(--nn-surface); color: var(--nn-text); cursor: pointer; }
        .mk-copy-btn:hover, .mk-copy-btn:focus-visible { border-color: var(--nn-cyan); color: var(--nn-white); }
        .mk-logos { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--sp-3); }
        .mk-logo { border: 1px solid var(--nn-border); border-radius: 12px; overflow: hidden; }
        .mk-logo-art { height: 120px; display: grid; place-items: center; padding: 1rem; background: #0B0F1A; }
        .mk-logo-art.light { background: #F5F6FA; }
        .mk-logo-art img { width: 100%; height: 80px; object-fit: contain; }
        .mk-logo-cap { padding: .7rem .9rem; font-family: var(--font-ui); font-size: .82rem; color: var(--nn-text);
            display: flex; justify-content: space-between; gap: .5rem; }
        .mk-swatches { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin: var(--sp-3) 0; padding: 0; list-style: none; }
        .mk-swatches li { display: flex; align-items: center; gap: .6rem; font-family: var(--font-ui); font-size: .85rem; color: var(--nn-text); }
        .mk-swatches i { width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--nn-border-hover); display: block; }
        .mk-art { width: 100%; max-width: 600px; border-radius: 12px; border: 1px solid var(--nn-border); display: block; }
        .mk-faq dt { font-family: var(--font-heading); font-weight: 600; color: var(--nn-white); margin-top: var(--sp-4); }
        .mk-faq dd { margin: .35rem 0 0; font-family: var(--font-body); color: var(--nn-text); line-height: 1.6; max-width: 760px; }
        .mk-wordmark { font-family: var(--font-heading); font-size: clamp(2.4rem, 7vw, 3.8rem); font-weight: 700;
            line-height: 1.02; color: var(--nn-white); margin: 0 0 var(--sp-3); letter-spacing: -.02em; }
        .mk-wordmark span { background: var(--nn-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .mk-tagline { font-family: var(--font-heading); font-size: clamp(1.25rem, 3vw, 1.6rem); font-weight: 600;
            color: var(--nn-white); margin: 0 0 var(--sp-4); }
        .mk-headline { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem .9rem; margin: var(--sp-4) 0 var(--sp-2); }
        .mk-headline b { font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 2.8rem); color: var(--nn-white); line-height: 1; }
        .mk-headline span { font-family: var(--font-ui); color: var(--nn-text-muted); font-size: .95rem; }
        .mk-up { color: var(--nn-cyan); font-weight: 600; }
        .mk-chart-card h3 { margin-top: 0; }
        .mk-chart { display: block; width: 100%; height: auto; margin: .4rem 0 .2rem; }
        .mk-chart .mk-bar-mark { fill: var(--nn-cyan); }
        .mk-chart .mk-bar-mark:hover { fill: var(--nn-white); }
        .mk-chart .mk-grid-line { stroke: var(--nn-border); stroke-width: 1; }
        .mk-chart .mk-axis { fill: var(--nn-text-muted); font-family: var(--font-ui); font-size: 16px; }
        .mk-chart .mk-value { fill: var(--nn-white); font-family: var(--font-ui); font-size: 18px; font-weight: 600; }
        .mk-details summary { font-family: var(--font-ui); font-size: .82rem; color: var(--nn-text-muted); cursor: pointer; margin-top: .4rem; }
        .mk-details table { margin-top: .5rem; }
        .mk-plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--sp-3); }
        .mk-plans .mk-card { margin: 0; }
        .mk-plans h3 { margin-top: 0; }
        .mk-plans p { margin: 0; }
        .mk-art-table img { width: 48px; height: 48px; border-radius: 8px; object-fit: cover; display: block; }
        .mk-art-table td { vertical-align: middle; }
        .mk-dl { white-space: nowrap; }
        .mk-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--sp-3); }
        .mk-cards figure { margin: 0; border: 1px solid var(--nn-border); border-radius: 12px; overflow: hidden; background: var(--nn-card); }
        .mk-cards img { width: 100%; height: auto; aspect-ratio: 1200 / 630; display: block; }
        .mk-cards figcaption { padding: .6rem .8rem; font-family: var(--font-ui); font-size: .82rem; color: var(--nn-text);
            display: flex; justify-content: space-between; gap: .5rem; }
        .mk-rules { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--sp-4); }
        .mk-rules ul { margin: 0; padding-left: 1.1rem; }
        .mk-no li::marker { content: "✕  "; color: var(--nn-text-muted); }
        @media (max-width: 640px) {
            .mk { padding: 0 16px; }
            .mk-stats, .mk-stats.four { grid-template-columns: repeat(2, 1fr); }
            .mk-stat-v { font-size: 1.5rem; }
            .mk-facts { grid-template-columns: 1fr; gap: .1rem; }
            .mk-facts dd { margin-bottom: .6rem; }
            .mk-show { grid-template-columns: 64px 1fr; }
            .mk-show img { width: 64px; height: 64px; }
            .mk-bars li { grid-template-columns: 6rem 1fr 2.4rem; }
            .mk-art-table .mk-hide-sm { display: none; }
        }
        @media print {
            .nn-nav, nav, footer, .mk-actions, .mk-toc, .mk-copy-btn, .mobile-menu { display: none !important; }
            body, .page-main { background: #fff !important; }
            .mk-hero { padding-top: 0; }
            .mk-section, .mk-card, .mk-stat, .mk-tile { break-inside: avoid; }
            .mk h1, .mk h2, .mk h3, .mk p, .mk li, .mk dd, .mk dt, .mk td, .mk th, .mk-stat-v, .mk-tile b,
            .mk blockquote, .mk-copy-head b { color: #111 !important; }
            .mk-hero h1 span { color: #4B2FD6 !important; background: none; }
            .mk-card, .mk-stat, .mk-tile, .mk-logo { border-color: #ccc !important; background: #fff !important; }
            .mk a { color: #2A1FA8 !important; }
        }
    </style>
