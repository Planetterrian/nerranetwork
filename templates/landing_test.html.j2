{% extends "base.html.j2" %}

{#- /landing-test.html — the network as a news front page (Oct 17 2026, TEST).

    Operator-directed experiment. Every public show's newest episode, laid out
    the way a news front is: lead story with a big picture, a Latest list
    beside it, a top-stories grid, topic sections, a most-played list and a
    Listen rail. Data: engine/landing_test.py (its docstring holds the honesty
    rules); design notes: docs/landing_test.md.

    Rules this template keeps:
    * noindex, not in the sitemap, linked from no nav — it is a test.
    * Headlines are the episodes' own hooks and the digests' own story
      headlines, printed whole. Only the one-line ticker clips, through
      engine.titles (``ticker_text``).
    * A picture is that episode's own scene, else the show's cover art.
    * Brand colours are fills and rules only; text uses --show-color-text.
    * Internal links carry no utm_* tag.
    * Nothing here fetches: the whole page is server-rendered. -#}

{% block head_extra %}
<meta name="robots" content="noindex, follow">
<style>
.lt-page {
  --lt-ink: var(--nn-text);
  --lt-muted: var(--nn-text-muted);
  --lt-rule: var(--nn-border);
  --lt-rule-strong: rgba(255, 255, 255, 0.16);
  --lt-panel: var(--nn-bg-alt);
  --lt-panel-2: rgba(255, 255, 255, 0.035);
  --lt-accent: var(--nn-purple);
  --lt-accent-text: var(--nn-purple-text);
  --lt-cyan: var(--nn-cyan);
  --lt-flag-bg: rgba(240, 180, 41, 0.14);
  --lt-flag-text: #F5C860;
  --lt-head: 'Source Serif 4', Georgia, serif;
  --lt-ui: var(--font-ui);
  --lt-radius: 10px;
  padding-top: calc(var(--nav-height, 72px) + var(--sp-4));
  padding-bottom: var(--sp-12);
  color: var(--lt-ink);
}
/* Component links: the site-wide prose-link rule (cyan + underline on a bare
   <a> inside p/li) is for running text; on a front page every headline is a
   link and gets its own hover treatment below. Running-text links that
   remain (.lt-note, the edition note) are underlined explicitly. */
.lt-page a { color: inherit; text-decoration: none; }
.lt-page a:focus-visible { outline: 2px solid var(--lt-cyan); outline-offset: 2px; border-radius: 4px; }
.lt-page .container { padding-left: var(--sp-6); padding-right: var(--sp-6); }

/* ---- Masthead ---- */
.lt-masthead-inner { border-bottom: 3px double var(--lt-rule-strong); padding-bottom: var(--sp-4); margin-bottom: var(--sp-3); }
.lt-masthead-meta {
  display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-4); align-items: center;
  font-family: var(--lt-ui); font-size: 0.82rem; color: var(--lt-muted);
  border-bottom: 1px solid var(--lt-rule); padding-bottom: var(--sp-2); margin-bottom: var(--sp-4);
}
.lt-flag {
  background: var(--lt-flag-bg); color: var(--lt-flag-text); font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.7rem;
  padding: 3px 8px; border-radius: 999px;
}
.lt-masthead-meta time { color: var(--lt-ink); font-weight: 600; }
.lt-masthead-row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--sp-3) var(--sp-8); }
.lt-wordmark {
  font-family: var(--lt-head); font-weight: 700; letter-spacing: -0.02em;
  font-size: clamp(2.1rem, 5.2vw, 3.6rem); line-height: 1; margin: 0;
}
.lt-wordmark span { background: var(--nn-gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.lt-standfirst { font-family: var(--lt-ui); color: var(--lt-muted); font-size: 0.98rem; max-width: 34rem; margin: 0; line-height: 1.5; }

/* ---- Section nav (in-page anchors) ---- */
.lt-secnav { margin: 0 0 var(--sp-3); }
.lt-secnav ul {
  list-style: none; display: flex; gap: var(--sp-1) var(--sp-5); margin: 0; padding: 0 0 var(--sp-2);
  overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--lt-rule);
}
.lt-secnav ul::-webkit-scrollbar { display: none; }
.lt-secnav a {
  display: block; white-space: nowrap; font-family: var(--lt-ui); font-size: 0.86rem; font-weight: 600;
  color: var(--lt-ink); padding: 6px 0; border-bottom: 2px solid transparent;
}
.lt-secnav a:hover { border-bottom-color: var(--lt-accent); color: var(--nn-white); }

/* ---- Ticker ---- */
.lt-ticker { display: flex; align-items: stretch; gap: var(--sp-3); margin-bottom: var(--sp-6); min-width: 0; }
.lt-ticker-label {
  flex: none; display: flex; align-items: center; gap: 6px;
  font-family: var(--lt-ui); font-weight: 700; font-size: 0.74rem; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--nn-white); background: var(--lt-accent);
  padding: 0 10px; border-radius: 6px;
}
.lt-ticker-label::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--lt-cyan); }
.lt-ticker ul {
  list-style: none; margin: 0; padding: 0; display: flex; gap: var(--sp-5); min-width: 0;
  overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none;
  -webkit-mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 48px), transparent);
  mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 48px), transparent);
}
.lt-ticker ul::-webkit-scrollbar { display: none; }
.lt-ticker li { flex: none; scroll-snap-align: start; padding: 6px 0; font-family: var(--lt-ui); font-size: 0.86rem; white-space: nowrap; }
.lt-ticker li a { color: var(--lt-ink); }
.lt-ticker li a:hover { color: var(--nn-white); text-decoration: underline; }
.lt-ticker-show { font-weight: 700; color: var(--show-color-text); margin-right: 6px; }

/* ---- Shared story atoms ---- */
.lt-kicker {
  font-family: var(--lt-ui); font-size: 0.74rem; font-weight: 700; letter-spacing: 0.07em;
  text-transform: uppercase; color: var(--show-color-text); display: flex; flex-wrap: wrap; gap: 4px 8px;
  align-items: center; margin: 0 0 6px;
}
.lt-kicker a { color: inherit; }
.lt-kicker a:hover { text-decoration: underline; }
.lt-kicker .lt-hub { color: var(--lt-muted); }
.lt-kicker .lt-hub::after { content: "/"; margin-left: 8px; color: var(--lt-rule-strong); }
.lt-hl { font-family: var(--lt-head); font-weight: 700; line-height: 1.22; letter-spacing: -0.005em; margin: 0; color: var(--lt-ink); }
.lt-hl a { color: inherit; }
.lt-hl a:hover { color: var(--nn-white); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
.lt-meta { font-family: var(--lt-ui); font-size: 0.8rem; color: var(--lt-muted); display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; margin-top: 8px; }
.lt-meta a { color: var(--lt-ink); font-weight: 600; }
.lt-meta a:hover { color: var(--nn-white); text-decoration: underline; }
.lt-meta .lt-dot { color: var(--lt-rule-strong); }

.lt-media {
  position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--lt-radius);
  background: radial-gradient(120% 120% at 20% 10%, color-mix(in srgb, var(--show-color) 55%, #0B0F1A), #0B0F1A 70%);
  border-bottom: 3px solid var(--show-color);
}
.lt-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms var(--ease); }
.lt-media.is-portrait img { object-position: center 30%; }
.lt-media.is-cover img { width: auto; height: 74%; aspect-ratio: 1; position: absolute; inset: 0; margin: auto; border-radius: 8px; box-shadow: 0 12px 30px rgba(0,0,0,0.45); object-fit: cover; }
a.lt-media:hover img { transform: scale(1.03); }
.lt-media.is-cover:hover img { transform: none; }
.lt-feature .lt-media.is-cover, .lt-pair .lt-media.is-cover, .lt-card .lt-media.is-cover { aspect-ratio: 21 / 9; }
.lt-feature .lt-media.is-cover img, .lt-pair .lt-media.is-cover img, .lt-card .lt-media.is-cover img { height: 82%; }

.lt-more { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 6px; }
.lt-more li { font-family: var(--lt-ui); font-size: 0.86rem; line-height: 1.4; padding-left: 14px; position: relative; color: var(--lt-ink); }
.lt-more li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 6px; height: 6px; border-radius: 1px; background: var(--show-color); }
.lt-more a:hover { color: var(--nn-white); text-decoration: underline; }
.lt-more-label { font-family: var(--lt-ui); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--lt-muted); margin: 14px 0 0; }

/* ---- Lead + Latest ---- */
.lt-top { display: grid; grid-template-columns: minmax(0, 2.15fr) minmax(0, 1fr); gap: var(--sp-8); }
.lt-lead .lt-media { border-radius: 12px; }
.lt-lead-body { padding-top: var(--sp-4); }
.lt-lead .lt-hl { font-size: clamp(1.7rem, 3.2vw, 2.6rem); line-height: 1.12; }
.lt-lead-audio { margin-top: var(--sp-4); display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-3); }
.lt-lead-audio audio { width: min(100%, 420px); height: 40px; }
.lt-btn {
  display: inline-flex; align-items: center; gap: 6px; font-family: var(--lt-ui); font-weight: 700; font-size: 0.86rem;
  padding: 9px 14px; border-radius: 8px; border: 1px solid var(--lt-rule-strong); color: var(--nn-white); background: var(--lt-panel-2);
}
.lt-btn:hover { border-color: var(--lt-cyan); }
.lt-btn--primary { background: var(--lt-accent); border-color: var(--lt-accent); }
.lt-btn--primary:hover { background: var(--nn-accent-hover); }

.lt-latest { border-left: 1px solid var(--lt-rule); padding-left: var(--sp-6); min-width: 0; }
.lt-rail-h {
  font-family: var(--lt-ui); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--nn-white); margin: 0 0 var(--sp-3); padding-top: 8px; border-top: 3px solid var(--lt-accent);
}
.lt-latest ol { list-style: none; margin: 0; padding: 0; }
.lt-latest li { padding: 11px 0; border-bottom: 1px solid var(--lt-rule); }
.lt-latest li:last-child { border-bottom: 0; }
.lt-latest .lt-kicker { font-size: 0.68rem; margin-bottom: 3px; }
.lt-latest .lt-hl { font-size: 1.02rem; font-weight: 600; line-height: 1.32; }
.lt-latest time { font-family: var(--lt-ui); font-size: 0.74rem; color: var(--lt-muted); font-weight: 500; letter-spacing: 0; text-transform: none; }

/* ---- Top stories ---- */
.lt-block { margin-top: var(--sp-10); }
.lt-block-head {
  display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-4);
  border-top: 3px solid var(--lt-ink); padding-top: 8px; margin-bottom: var(--sp-5); flex-wrap: wrap;
}
.lt-block-head h2 { font-family: var(--lt-head); font-size: 1.55rem; font-weight: 700; margin: 0; letter-spacing: -0.01em; }
.lt-block-head a { font-family: var(--lt-ui); font-size: 0.84rem; font-weight: 700; color: var(--lt-accent-text); text-align: right; }
.lt-block-head a:hover { color: var(--nn-white); }
.lt-grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-6); }
.lt-card .lt-card-body { padding-top: 12px; }
.lt-card .lt-hl { font-size: 1.14rem; }

/* ---- Edition strip (Nerra Daily / Mira) ---- */
.lt-edition {
  margin-top: var(--sp-10); border-radius: 16px; overflow: hidden; position: relative;
  background: linear-gradient(120deg, color-mix(in srgb, var(--nn-purple) 38%, #0B0F1A) 0%, #111627 55%, color-mix(in srgb, var(--nn-cyan) 18%, #0B0F1A) 100%);
  border: 1px solid var(--lt-rule-strong);
}
.lt-edition-inner { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: var(--sp-6); padding: var(--sp-6); align-items: center; }
.lt-edition-cover img { width: 180px; height: 180px; border-radius: 12px; box-shadow: 0 16px 40px rgba(0,0,0,0.5); }
.lt-edition-label { font-family: var(--lt-ui); font-size: 0.76rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--lt-cyan); margin: 0 0 6px; }
.lt-edition .lt-hl { font-size: clamp(1.3rem, 2.4vw, 1.8rem); }
.lt-edition p.lt-edition-note { font-family: var(--lt-ui); font-size: 0.92rem; color: var(--lt-ink); opacity: 0.85; margin: 8px 0 0; line-height: 1.5; }
.lt-edition .lt-lead-audio { margin-top: var(--sp-3); }

/* ---- Topic sections ---- */
.lt-section-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--sp-6) var(--sp-8); }
.lt-feature .lt-hl { font-size: 1.42rem; }
.lt-feature .lt-card-body { padding-top: 12px; }
.lt-stack { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; align-content: start; }
.lt-row { display: grid; grid-template-columns: minmax(0, 1fr) 132px; gap: var(--sp-4); padding: 14px 0; border-bottom: 1px solid var(--lt-rule); align-items: start; }
.lt-stack .lt-row:first-child { padding-top: 0; }
.lt-stack .lt-row:last-child { border-bottom: 0; }
.lt-row .lt-hl { font-size: 1.04rem; font-weight: 600; line-height: 1.3; }
.lt-row .lt-media { border-radius: 8px; border-bottom-width: 2px; }
.lt-row .lt-media.is-cover img { height: 80%; border-radius: 6px; }

.lt-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-8); }
.lt-pair .lt-hl { font-size: 1.3rem; }

/* ---- More from the network ---- */
.lt-grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--sp-8); }
.lt-grid-3 .lt-row { padding-top: 14px; }

/* ---- Most played ---- */
.lt-popular ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-2) var(--sp-8); counter-reset: lt-pop; }
.lt-popular li { counter-increment: lt-pop; display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); gap: var(--sp-2); padding: 12px 0; border-bottom: 1px solid var(--lt-rule); }
.lt-popular li::before { content: counter(lt-pop); font-family: var(--lt-head); font-weight: 700; font-size: 2rem; line-height: 1; color: var(--lt-accent-text); }
.lt-popular .lt-hl { font-size: 1rem; font-weight: 600; line-height: 1.32; }

/* ---- Listen rail ---- */
.lt-listen ul {
  list-style: none; margin: 0; padding: 0 0 var(--sp-3); display: flex; gap: var(--sp-4); overflow-x: auto;
  scroll-snap-type: x mandatory; scrollbar-width: thin;
  -webkit-mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 56px), transparent);
  mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 56px), transparent);
}
.lt-listen li { flex: 0 0 150px; scroll-snap-align: start; }
.lt-listen img { width: 150px; height: 150px; border-radius: 10px; border-bottom: 3px solid var(--show-color); object-fit: cover; }
.lt-listen-name { font-family: var(--lt-ui); font-weight: 700; font-size: 0.88rem; line-height: 1.3; margin: 8px 0 2px; color: var(--lt-ink); }
.lt-listen-name a:hover { color: var(--nn-white); text-decoration: underline; }
.lt-listen-sched { font-family: var(--lt-ui); font-size: 0.75rem; color: var(--lt-muted); margin: 0; }
.lt-listen-links { font-family: var(--lt-ui); font-size: 0.78rem; display: flex; gap: 10px; margin-top: 4px; }
.lt-listen-links a { color: var(--show-color-text); font-weight: 700; }
.lt-listen-links a:hover { text-decoration: underline; }

/* ---- Newsletter band ---- */
.lt-signup {
  margin-top: var(--sp-12); border: 1px solid var(--lt-rule-strong); border-radius: 16px; padding: var(--sp-8) var(--sp-6);
  display: grid; grid-template-columns: minmax(0, 1.4fr) auto; gap: var(--sp-6); align-items: center;
  background: linear-gradient(135deg, rgba(107, 71, 255, 0.16), rgba(0, 212, 255, 0.06));
}
.lt-signup h2 { font-family: var(--lt-head); font-size: 1.6rem; margin: 0 0 6px; }
.lt-signup p { font-family: var(--lt-ui); color: var(--lt-muted); margin: 0; line-height: 1.5; }
.lt-signup .lt-signup-actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); }
.lt-note { font-family: var(--lt-ui); font-size: 0.8rem; color: var(--lt-muted); margin-top: var(--sp-8); line-height: 1.5; }
.lt-note a, .lt-edition-note a { color: var(--lt-cyan); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

.lt-empty { padding: var(--sp-12) 0; font-family: var(--lt-ui); color: var(--lt-muted); }

/* ---- Responsive ---- */
@media (max-width: 1100px) {
  .lt-grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .lt-grid-3, .lt-popular ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 900px) {
  .lt-top { grid-template-columns: minmax(0, 1fr); gap: var(--sp-6); }
  .lt-latest { border-left: 0; padding-left: 0; }
  /* Stacked under the lead, the full Latest list pushed the top stories
     three screens down; the ticker above already carries every headline. */
  .lt-latest li:nth-child(n+6) { display: none; }
  .lt-section-grid { grid-template-columns: minmax(0, 1fr); }
  .lt-pair { gap: var(--sp-6); }
  .lt-signup { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 640px) {
  .lt-page .container { padding-left: var(--sp-4); padding-right: var(--sp-4); }
  .lt-page { padding-top: calc(var(--nav-height, 72px) + var(--sp-2)); }
  .lt-lead .lt-media { border-radius: 8px; }
  .lt-grid-4 { grid-template-columns: minmax(0, 1fr); gap: 0; }
  /* On a phone the top stories read as a list: headline beside a thumbnail,
     the BBC/Guardian mobile pattern, not four full-width pictures. */
  .lt-grid-4 .lt-card { display: grid; grid-template-columns: minmax(0, 1fr) 112px; gap: var(--sp-3); padding: 14px 0; border-bottom: 1px solid var(--lt-rule); }
  .lt-grid-4 .lt-card .lt-media { order: 2; border-radius: 6px; border-bottom-width: 2px; }
  .lt-grid-4 .lt-card .lt-card-body { order: 1; padding-top: 0; }
  .lt-grid-4 .lt-card .lt-hl { font-size: 1.02rem; }
  .lt-grid-4 .lt-card .lt-more, .lt-grid-4 .lt-card .lt-more-label { display: none; }
  .lt-row { grid-template-columns: minmax(0, 1fr) 112px; }
  .lt-pair { grid-template-columns: minmax(0, 1fr); }
  .lt-feature .lt-hl, .lt-pair .lt-hl { font-size: 1.24rem; }
  .lt-grid-3, .lt-popular ol { grid-template-columns: minmax(0, 1fr); }
  .lt-edition-inner { display: block; padding: var(--sp-4); }
  .lt-edition-inner::after { content: ""; display: table; clear: both; }
  .lt-edition-cover { float: left; margin: 0 var(--sp-3) var(--sp-2) 0; }
  .lt-edition-cover img { width: 76px; height: 76px; border-radius: 8px; }
  .lt-edition .lt-edition-note, .lt-edition .lt-lead-audio { clear: both; }
  .lt-edition .lt-lead-audio audio { width: 100%; }
  .lt-feature .lt-more, .lt-feature .lt-more-label, .lt-pair .lt-more, .lt-pair .lt-more-label { display: none; }
  .lt-block-head h2 { font-size: 1.3rem; }
  .lt-hide-sm { display: none; }
  .lt-listen li { flex-basis: 128px; }
  .lt-listen img { width: 128px; height: 128px; }
  .lt-signup { padding: var(--sp-6) var(--sp-4); }
}
@media (prefers-reduced-motion: reduce) {
  .lt-media img { transition: none; }
  a.lt-media:hover img { transform: none; }
}
</style>
{% endblock %}

{#- ---------------------------------------------------------------------- -#}
{%- macro story_href(s) -%}{{ path_prefix }}{{ s.post_url or s.show_page }}{%- endmacro -%}

{%- macro media(s, eager=false) -%}
{%- if s.image_url -%}
<a href="{{ story_href(s) }}" class="lt-media{% if s.image_orientation == 'portrait' %} is-portrait{% endif %}" tabindex="-1" aria-hidden="true">
    <img src="{{ s.image_url }}" alt="AI-generated scene illustrating {{ s.show_name }} episode {{ s.episode_num }}"
         width="{{ 450 if s.image_orientation == 'portrait' else 800 }}" height="{{ 800 if s.image_orientation == 'portrait' else 450 }}"
         {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
</a>
{%- else -%}
<a href="{{ story_href(s) }}" class="lt-media is-cover" tabindex="-1" aria-hidden="true">
    <picture>
        {% if s.cover_webp %}<source type="image/webp" srcset="{{ path_prefix }}{{ s.cover_webp }}">{% endif %}
        <img src="{{ path_prefix }}{{ s.cover_url }}" alt="{{ s.show_name }} cover art" width="400" height="400"
             {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
    </picture>
</a>
{%- endif -%}
{%- endmacro -%}

{%- macro kicker(s, with_hub=true) -%}
<p class="lt-kicker">
    {% if with_hub and s.hub_heading %}<span class="lt-hub">{{ s.hub_heading }}</span>{% endif %}
    <a href="{{ path_prefix }}{{ s.show_page }}">{{ s.show_name }}</a>
</p>
{%- endmacro -%}

{%- macro meta(s, listen=true) -%}
<div class="lt-meta">
    {% if s.date %}<time datetime="{{ s.date_raw }}">{{ s.date }}</time>{% endif %}
    {% if s.post_url %}<span class="lt-dot" aria-hidden="true">•</span><a href="{{ path_prefix }}{{ s.post_url }}">Read</a>{% endif %}
    {% if listen %}<span class="lt-dot" aria-hidden="true">•</span><a href="{{ path_prefix }}{{ s.show_page }}">Listen</a>{% endif %}
</div>
{%- endmacro -%}

{%- macro more_list(s) -%}
{%- if s.more and s.post_url -%}
<p class="lt-more-label">Also in this episode</p>
<ul class="lt-more">
    {% for h in s.more %}<li{% if s.lang %} lang="{{ s.lang }}"{% endif %}><a href="{{ path_prefix }}{{ s.post_url }}">{{ h }}</a></li>{% endfor %}
</ul>
{%- endif -%}
{%- endmacro -%}

{%- macro row(s, with_hub=false) -%}
<li class="lt-row" style="--show-color:{{ s.brand_color }};">
    <div>
        {{ kicker(s, with_hub) }}
        <h3 class="lt-hl"{% if s.lang %} lang="{{ s.lang }}"{% endif %}><a href="{{ story_href(s) }}">{{ s.hook }}</a></h3>
        {{ meta(s) }}
    </div>
    {{ media(s) }}
</li>
{%- endmacro -%}

{% block content %}
<div class="lt-page">
{% set p = page %}

<header class="lt-masthead container"><div class="lt-masthead-inner">
    <div class="lt-masthead-meta">
        <span class="lt-flag">Test page</span>
        {% if p.edition_date %}<time>{{ p.edition_date }}</time>{% endif %}
        {% if p.story_count %}<span>{{ p.today_count }} new {{ 'episode' if p.today_count == 1 else 'episodes' }} on the newest day · stories from {{ p.story_count }} shows</span>{% endif %}
    </div>
    <div class="lt-masthead-row">
        <h1 class="lt-wordmark">Nerra Network <span>Today</span></h1>
        <p class="lt-standfirst">The newest story from every show in the network. Read the article, or hear the episode it came from.</p>
    </div>
</div></header>

{% if not p.lead %}
<div class="container lt-empty">
    <p>No stories to show right now. Every show is on <a href="{{ path_prefix }}explore.html">the shows page</a>.</p>
</div>
{% else %}

{% if p.sections %}
<div class="container"><nav class="lt-secnav" aria-label="Sections on this page">
    <ul>
        <li><a href="#top-stories">Top stories</a></li>
        {% for sec in p.sections %}<li><a href="#section-{{ sec.id }}">{{ sec.heading }}</a></li>{% endfor %}
        {% if p.more %}<li><a href="#section-more">More</a></li>{% endif %}
        <li><a href="#listen">All shows</a></li>
    </ul>
</nav></div>
{% endif %}

<div class="lt-ticker container" role="region" aria-label="Latest headlines">
    <span class="lt-ticker-label">Latest</span>
    <ul>
        {% for s in p.latest %}
        <li style="--show-color:{{ s.brand_color }};"><a href="{{ story_href(s) }}"><span class="lt-ticker-show">{{ s.show_name }}</span><span{% if s.lang %} lang="{{ s.lang }}"{% endif %}>{{ s.ticker_text }}</span></a></li>
        {% endfor %}
    </ul>
</div>

{#- Lead story + Latest list -#}
<section class="lt-top container" aria-label="Lead story">
    {% set s = p.lead %}
    <article class="lt-lead" style="--show-color:{{ s.brand_color }};">
        {{ media(s, eager=true) }}
        <div class="lt-lead-body">
            {{ kicker(s) }}
            <h2 class="lt-hl"{% if s.lang %} lang="{{ s.lang }}"{% endif %}><a href="{{ story_href(s) }}">{{ s.hook }}</a></h2>
            {{ meta(s, listen=false) }}
            {{ more_list(s) }}
            <div class="lt-lead-audio">
                {% if s.audio_url %}<audio controls preload="none" src="{{ s.audio_url }}" aria-label="Play {{ s.show_name }} episode {{ s.episode_num }}"></audio>{% endif %}
                {% if s.post_url %}<a class="lt-btn lt-btn--primary" href="{{ path_prefix }}{{ s.post_url }}">Read the full story</a>{% endif %}
                <a class="lt-btn" href="{{ path_prefix }}{{ s.show_page }}">More from {{ s.show_name }}</a>
            </div>
        </div>
    </article>

    <aside class="lt-latest" aria-labelledby="lt-latest-h">
        <h2 class="lt-rail-h" id="lt-latest-h">Latest across the network</h2>
        <ol>
            {% for s in p.latest %}{% if s is not sameas p.lead %}
            <li style="--show-color:{{ s.brand_color }};">
                <p class="lt-kicker"><a href="{{ path_prefix }}{{ s.show_page }}">{{ s.show_name }}</a>{% if s.date %} <time datetime="{{ s.date_raw }}">{{ s.date }}</time>{% endif %}</p>
                <h3 class="lt-hl"{% if s.lang %} lang="{{ s.lang }}"{% endif %}><a href="{{ story_href(s) }}">{{ s.hook }}</a></h3>
            </li>
            {% endif %}{% endfor %}
        </ol>
    </aside>
</section>

{#- Top stories -#}
{% if p.top %}
<section class="lt-block container" id="top-stories" aria-labelledby="lt-top-h">
    <div class="lt-block-head"><h2 id="lt-top-h">Top stories</h2></div>
    <div class="lt-grid-4">
        {% for s in p.top %}
        <article class="lt-card" style="--show-color:{{ s.brand_color }};">
            {{ media(s) }}
            <div class="lt-card-body">
                {{ kicker(s) }}
                <h3 class="lt-hl"{% if s.lang %} lang="{{ s.lang }}"{% endif %}><a href="{{ story_href(s) }}">{{ s.hook }}</a></h3>
                {{ meta(s) }}
                {{ more_list(s) }}
            </div>
        </article>
        {% endfor %}
    </div>
</section>
{% endif %}

{#- Nerra Daily: the whole network in one episode, hosted by Mira -#}
{% if edition %}
{% set e = edition %}
<section class="container" aria-labelledby="lt-edition-h">
<div class="lt-edition" style="--show-color:{{ e.brand_color }};">
    <div class="lt-edition-inner">
        <a class="lt-edition-cover" href="{{ path_prefix }}{{ e.show_page }}" tabindex="-1" aria-hidden="true">
            <picture>
                {% if e.cover_webp %}<source type="image/webp" srcset="{{ path_prefix }}{{ e.cover_webp }}">{% endif %}
                <img src="{{ path_prefix }}{{ e.cover_url }}" alt="{{ e.show_name }} cover art" width="180" height="180" loading="lazy" decoding="async">
            </picture>
        </a>
        <div>
            <p class="lt-edition-label">{{ e.show_name }} · hosted by Mira{% if e.date %} · {{ e.date }}{% endif %}</p>
            <h2 class="lt-hl" id="lt-edition-h"><a href="{{ path_prefix }}{{ e.post_url or e.show_page }}">{{ e.hook }}</a></h2>
            <p class="lt-edition-note">The network's English shows in one daily episode, with Mira, the network's AI host, introducing each one. <a href="{{ path_prefix }}mira.html">Meet Mira</a>.</p>
            <div class="lt-lead-audio">
                {% if e.audio_url %}<audio controls preload="none" src="{{ e.audio_url }}" aria-label="Play {{ e.show_name }} episode {{ e.episode_num }}"></audio>{% endif %}
                {% if e.post_url %}<a class="lt-btn" href="{{ path_prefix }}{{ e.post_url }}">Today's rundown</a>{% endif %}
            </div>
        </div>
    </div>
</div>
</section>
{% endif %}

{#- Topic sections -#}
{% for sec in p.sections %}
<section class="lt-block container" id="section-{{ sec.id }}" aria-labelledby="lt-sec-{{ sec.id }}">
    <div class="lt-block-head">
        <h2 id="lt-sec-{{ sec.id }}">{{ sec.heading }}</h2>
        {% if sec.hub_url %}<a href="{{ path_prefix }}{{ sec.hub_url }}" aria-label="More {{ sec.heading | lower }}">More<span class="lt-hide-sm"> {{ sec.heading | lower }}</span> →</a>{% endif %}
    </div>
    {% if sec.stories|length == 2 %}
    <div class="lt-pair">
        {% for f in sec.stories %}
        <article class="lt-feature" style="--show-color:{{ f.brand_color }};">
            {{ media(f) }}
            <div class="lt-card-body">
                {{ kicker(f, false) }}
                <h3 class="lt-hl"{% if f.lang %} lang="{{ f.lang }}"{% endif %}><a href="{{ story_href(f) }}">{{ f.hook }}</a></h3>
                {{ meta(f) }}
                {{ more_list(f) }}
            </div>
        </article>
        {% endfor %}
    </div>
    {% else %}
    <div class="lt-section-grid">
        {% set f = sec.stories[0] %}
        <article class="lt-feature" style="--show-color:{{ f.brand_color }};">
            {{ media(f) }}
            <div class="lt-card-body">
                {{ kicker(f, false) }}
                <h3 class="lt-hl"{% if f.lang %} lang="{{ f.lang }}"{% endif %}><a href="{{ story_href(f) }}">{{ f.hook }}</a></h3>
                {{ meta(f) }}
                {{ more_list(f) }}
            </div>
        </article>
        <ul class="lt-stack">
            {% for s in sec.stories[1:] %}{{ row(s) }}{% endfor %}
        </ul>
    </div>
    {% endif %}
</section>
{% endfor %}

{% if p.more %}
<section class="lt-block container" id="section-more" aria-labelledby="lt-more-h">
    <div class="lt-block-head"><h2 id="lt-more-h">More from the network</h2><a href="{{ path_prefix }}topics/index.html">Browse by topic →</a></div>
    <ul class="lt-stack lt-grid-3">
        {% for s in p.more %}{{ row(s, true) }}{% endfor %}
    </ul>
</section>
{% endif %}

{#- Most played this week (OP3), when the data is fresh -#}
{% if popular %}
<section class="lt-block lt-popular container" aria-labelledby="lt-pop-h">
    <div class="lt-block-head"><h2 id="lt-pop-h">Most played this week</h2></div>
    <ol>
        {% for ep in popular %}
        <li style="--show-color:{{ ep.brand_color or '#6B47FF' }};">
            <div>
                <p class="lt-kicker"><a href="{{ path_prefix }}{{ ep.show_page }}">{{ ep.show_name }}</a></p>
                <h3 class="lt-hl"><a href="{{ path_prefix }}{{ ep.blog_url or ep.show_page }}">{{ ep.title }}</a></h3>
            </div>
        </li>
        {% endfor %}
    </ol>
</section>
{% endif %}

{% endif %}{#- p.lead -#}

{#- Every public show: cover, page, blog -#}
{% if listen %}
<section class="lt-block lt-listen container" id="listen" aria-labelledby="lt-listen-h">
    <div class="lt-block-head"><h2 id="lt-listen-h">Listen to every show</h2><a href="{{ path_prefix }}explore.html">Find a show →</a></div>
    <ul>
        {% for s in listen %}
        <li style="--show-color:{{ s.brand_color }};">
            <a href="{{ path_prefix }}{{ s.show_page }}" tabindex="-1" aria-hidden="true">
                <picture>
                    {% if s.cover_webp %}<source type="image/webp" srcset="{{ path_prefix }}{{ s.cover_webp }}">{% endif %}
                    <img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" width="150" height="150" loading="lazy" decoding="async">
                </picture>
            </a>
            <p class="lt-listen-name"><a href="{{ path_prefix }}{{ s.show_page }}">{{ s.name }}</a></p>
            {% if s.schedule %}<p class="lt-listen-sched">{{ s.schedule }}</p>{% endif %}
            <div class="lt-listen-links">
                <a href="{{ path_prefix }}{{ s.show_page }}" aria-label="Listen to {{ s.name }}">Listen</a>
                {% if s.blog_url %}<a href="{{ path_prefix }}{{ s.blog_url }}" aria-label="{{ s.name }} articles">Articles</a>{% endif %}
            </div>
        </li>
        {% endfor %}
    </ul>
</section>
{% endif %}

<section class="container" aria-labelledby="lt-signup-h">
<div class="lt-signup">
    <div>
        <h2 id="lt-signup-h">Get the shows you pick by email</h2>
        <p>Pick the shows you want in your inbox. It's free, and every show stays free to hear either way.</p>
    </div>
    <div class="lt-signup-actions">
        <a class="lt-btn lt-btn--primary" href="#newsletter-signup">Choose your shows</a>
        <a class="lt-btn" href="{{ path_prefix }}how-to-listen.html">Other ways to listen</a>
    </div>
</div>
</section>

<p class="lt-note container">This is a test layout. Headlines are each episode's own headline; pictures are the AI-generated scene art made for that episode, or the show's cover where an episode has none. Every episode is written and narrated by AI — <a href="{{ path_prefix }}ai-disclosure.html">how we use AI</a>.</p>

</div>
{% endblock %}
