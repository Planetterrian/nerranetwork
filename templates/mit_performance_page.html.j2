{% extends "base.html.j2" %}

{% block title %}Modern Investing Techniques — Performance & Lessons Learned{% endblock %}

{% block content %}
<div class="container" style="max-width: 1100px; padding: calc(var(--nav-height) + var(--sp-12)) 0 var(--sp-8);">
  <style>
    @media (max-width: 640px) {
      .glass-card { padding: 12px !important; }
      table { font-size: 11px !important; }
    }
    .mit-area-svg { width:100%; height:220px; display:block; overflow:visible; }
    .mit-area-svg .grid { stroke:rgba(120,160,255,0.14); stroke-width:1; }
    .mit-area-svg .gl { fill:#8ea3d6; font-size:10px; }
    .mit-area-svg .xl { fill:#8ea3d6; font-size:10px; text-anchor:middle; }
    .mit-area-svg .ln { fill:none; stroke:#10b981; stroke-width:2.5; stroke-linejoin:round; stroke-linecap:round; filter:drop-shadow(0 2px 8px rgba(16,185,129,0.35)); }
    .mit-area-svg .ln.neg { stroke:#ef4444; filter:drop-shadow(0 2px 8px rgba(239,68,68,0.35)); }
    .mit-area-svg .zero { stroke:rgba(255,255,255,0.25); stroke-dasharray:3 3; }
    .mit-area-svg .dot { fill:#fff; stroke:#10b981; stroke-width:2; }
    .mit-bars { display:flex; align-items:flex-end; gap:8px; height:150px; }
    .mit-bw { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; gap:4px; height:100%; justify-content:flex-end; }
    .mit-bar { width:100%; border-radius:6px 6px 2px 2px; min-height:2px; transition:height .6s cubic-bezier(.2,.7,.2,1); position:relative; }
    .mit-bar .cnt { position:absolute; top:-17px; left:0; right:0; text-align:center; font-size:0.66rem; font-weight:700; color:#cbd5e1; }
    .mit-blab { font-size:0.62rem; color:#8ea3d6; white-space:nowrap; max-width:100%; overflow:hidden; text-overflow:ellipsis; text-transform:capitalize; }
    .mit-wl { display:flex; height:26px; border-radius:8px; overflow:hidden; margin:6px 0 10px; }
    .mit-wl span { height:100%; }
    .mit-wl-legend { display:flex; gap:16px; font-size:0.82rem; flex-wrap:wrap; }
    .mit-wl-legend .it { display:flex; align-items:center; gap:6px; }
    .mit-wl-legend .sw { width:11px; height:11px; border-radius:3px; }
    .mit-rt { display:flex; align-items:center; gap:10px; padding:0.45rem 0; border-bottom:1px solid var(--nn-border); font-size:0.88rem; }
    .mit-rt:last-child{ border-bottom:none; }
    .mit-rt .sym { font-weight:700; min-width:54px; }
    .mit-rt .stg { flex:1; color:var(--nn-text-muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .mit-rt .pnl { font-weight:700; font-variant-numeric:tabular-nums; }
    .mit-rt .pnl.up{ color:#10b981; } .mit-rt .pnl.down{ color:#ef4444; }
  </style>

  <div style="margin-bottom: var(--sp-8);">
    <h1 style="font-size: 2.4rem; margin-bottom: 0.5rem;">Performance &amp; Lessons</h1>
    <p style="font-size: 1.1rem; color: var(--nn-text-muted); max-width: 720px;">
      This page shows exactly how our AI-driven simulated portfolio is performing against the NASDAQ, 
      what we are learning in real time, and the principles we are currently operating under.
      Everything here is transparent, data-driven, and updated automatically.
    </p>
    <p style="font-size: 0.9rem; color: var(--nn-text-muted); margin-top: 0.5rem;">
      <strong>Important:</strong> All trades are simulated for education. No real money is at risk. This is a learning laboratory.
    </p>
  </div>

  {% if performance_data and performance_data.available %}
    <!-- Core Performance Snapshot -->
    <div class="glass-card" style="padding: var(--sp-6); margin-bottom: var(--sp-8);">
      <h2 style="margin-top:0; font-size:1.4rem;">Current Track Record vs NASDAQ</h2>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--sp-4); margin: var(--sp-6) 0;">
        <div>
          <div style="font-size:0.8rem; color:var(--nn-text-muted); text-transform:uppercase;">Cumulative Alpha vs NASDAQ</div>
          <div style="font-size:2.2rem; font-weight:700; color: {% if (performance_data.alpha.inception_to_date_pct or 0) >= 0 %}#10b981{% else %}#ef4444{% endif %};">
            {{ "{:+.2f}".format(performance_data.alpha.inception_to_date_pct or 0) }}%
          </div>
          <div style="font-size:0.85rem;">Since inception</div>
        </div>
        
        <div>
          <div style="font-size:0.8rem; color:var(--nn-text-muted); text-transform:uppercase;">YTD Alpha</div>
          <div style="font-size:2.2rem; font-weight:700; color: {% if (performance_data.alpha.ytd_pct or 0) >= 0 %}#10b981{% else %}#ef4444{% endif %};">
            {{ "{:+.2f}".format(performance_data.alpha.ytd_pct or 0) }}%
          </div>
        </div>

        <div>
          <div style="font-size:0.8rem; color:var(--nn-text-muted); text-transform:uppercase;">Win Rate</div>
          <div style="font-size:2.2rem; font-weight:700;">
            {{ "{:.0f}".format(performance_data.summary.win_rate_pct or 0) }}%
          </div>
          <div style="font-size:0.85rem;">{{ performance_data.summary.wins or 0 }}W / {{ performance_data.summary.losses or 0 }}L / {{ performance_data.summary.breakeven or 0 }}BE</div>
        </div>

        <div>
          <div style="font-size:0.8rem; color:var(--nn-text-muted); text-transform:uppercase;">Total Simulated Trades</div>
          <div style="font-size:2.2rem; font-weight:700;">{{ performance_data.summary.total_trades or 0 }}</div>
        </div>
      </div>

      <div style="font-size:0.85rem; color:var(--nn-text-muted);">
        Last updated: {{ performance_data.last_updated or "recently" }} • All figures are simulated with $1,000 per position for tracking purposes only.
      </div>
    </div>

    {% if mit_charts and mit_charts.equity_curve %}
    <!-- Equity curve -->
    <div class="glass-card" style="padding:var(--sp-6); margin-bottom:var(--sp-8);">
      <h2 style="margin-top:0; font-size:1.3rem;">Cumulative return — simulated portfolio</h2>
      <p style="color:var(--nn-text-muted); font-size:0.9rem; margin-top:0;">Running sum of every closed practice trade's result (percentage points, $1,000 per position). Education only.</p>
      <svg class="mit-area-svg" id="mitEquity" preserveAspectRatio="none" role="img" aria-label="Cumulative simulated return"></svg>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:var(--sp-3); margin-top:var(--sp-4);">
        <div><div style="font-size:0.74rem;color:var(--nn-text-muted);text-transform:uppercase;">Cumulative return</div><div id="mitCum" style="font-size:1.6rem;font-weight:800;">—</div><div style="font-size:0.72rem;color:var(--nn-text-muted);">sum of trade % points</div></div>
        <div><div style="font-size:0.74rem;color:var(--nn-text-muted);text-transform:uppercase;">Simulated P&amp;L</div><div id="mitDollars" style="font-size:1.6rem;font-weight:800;">—</div><div style="font-size:0.72rem;color:var(--nn-text-muted);">$1,000 / position</div></div>
        <div><div style="font-size:0.74rem;color:var(--nn-text-muted);text-transform:uppercase;">Best trade</div><div id="mitBest" style="font-size:1.6rem;font-weight:800;color:#10b981;">—</div></div>
        <div><div style="font-size:0.74rem;color:var(--nn-text-muted);text-transform:uppercase;">Worst trade</div><div id="mitWorst" style="font-size:1.6rem;font-weight:800;color:#ef4444;">—</div></div>
        <div><div style="font-size:0.74rem;color:var(--nn-text-muted);text-transform:uppercase;">Longest win streak</div><div id="mitStreak" style="font-size:1.6rem;font-weight:800;">—</div></div>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--sp-6); margin-bottom:var(--sp-8);" class="mit-two">
      <div class="glass-card" style="padding:var(--sp-6);">
        <h2 style="margin-top:0; font-size:1.2rem;">Win / loss split</h2>
        <div class="mit-wl" id="mitWL"></div>
        <div class="mit-wl-legend" id="mitWLLegend"></div>
      </div>
      <div class="glass-card" style="padding:var(--sp-6);">
        <h2 style="margin-top:0; font-size:1.2rem;">P&amp;L by sector</h2>
        <div class="mit-bars" id="mitSectors"></div>
      </div>
    </div>
    <style>@media (max-width:640px){ .mit-two{ grid-template-columns:1fr !important; } }</style>

    {% if mit_charts.recent_trades %}
    <div class="glass-card" style="padding:var(--sp-6); margin-bottom:var(--sp-8);">
      <h2 style="margin-top:0; font-size:1.2rem;">Recent closed trades</h2>
      <div id="mitRecent"></div>
    </div>
    {% endif %}

    <script id="mit-chart-data" type="application/json">{{ mit_charts | tojson }}</script>
    <script>
    (function(){
      var D; try { D = JSON.parse(document.getElementById('mit-chart-data').textContent); } catch(e){ return; }
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function countUp(id,target,fmt){ var el=document.getElementById(id); if(!el||target==null) return;
        fmt=fmt||function(v){return (v>=0?'+':'')+v.toFixed(1)+'%';};
        if(reduce){ el.textContent=fmt(target); return; }
        var t0=performance.now(); (function step(t){ var k=Math.min(1,(t-t0)/900),e=1-Math.pow(1-k,3);
          el.textContent=fmt(target*e); if(k<1) requestAnimationFrame(step); })(t0); }
      var h=D.headline||{};
      var eq=D.equity_curve||[]; var finalCum = eq.length ? eq[eq.length-1].cum : null;
      countUp('mitCum', finalCum);  // cumulative % points (matches the curve)
      countUp('mitDollars', h.cumulative_pnl, function(v){ return (v>=0?'+$':'-$')+Math.abs(v).toFixed(0); });
      countUp('mitBest', h.best);
      countUp('mitWorst', h.worst);
      var st=document.getElementById('mitStreak'); if(st&&h.longest_win_streak!=null) st.textContent=h.longest_win_streak;

      // equity curve
      (function(){ var s=D.equity_curve||[]; var svg=document.getElementById('mitEquity'); if(!svg||s.length<2) return;
        var W=1000,H=220,padL=44,padR=10,padT=12,padB=22, xs=W-padL-padR, ys=H-padT-padB;
        var vals=s.map(function(p){return p.cum;}); var max=Math.max.apply(null,vals.concat([0])), min=Math.min.apply(null,vals.concat([0])); var n=s.length;
        var X=function(i){return padL+(i/(n-1))*xs;}, Y=function(v){return padT+ys-((v-min)/((max-min)||1))*ys;};
        var line='',area='M'+X(0)+','+Y(0);
        s.forEach(function(p,i){var x=X(i),y=Y(p.cum); line+=(i?'L':'M')+x+','+y+' '; area+='L'+x+','+y+' ';});
        area+='L'+X(n-1)+','+Y(0)+'Z';
        var grid=''; [0,0.5,1].forEach(function(f){var v=min+(max-min)*f,y=Y(v); grid+='<line class="grid" x1="'+padL+'" y1="'+y+'" x2="'+(W-padR)+'" y2="'+y+'"/><text class="gl" x="0" y="'+(y+3)+'">'+Math.round(v)+'%</text>';});
        var zero='<line class="zero" x1="'+padL+'" y1="'+Y(0)+'" x2="'+(W-padR)+'" y2="'+Y(0)+'"/>';
        var xl=''; var step=Math.max(1,Math.floor(n/5)); for(var i=0;i<n;i+=step){ xl+='<text class="xl" x="'+X(i)+'" y="'+(H-6)+'">'+s[i].date.slice(2,7)+'</text>'; }
        var last=s[n-1], up=last.cum>=0;
        svg.setAttribute('viewBox','0 0 '+W+' '+H);
        svg.innerHTML='<defs><linearGradient id="mitGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="rgba(16,185,129,0.34)"/><stop offset="100%" stop-color="rgba(16,185,129,0.02)"/></linearGradient></defs>'+grid+zero+
          '<path d="'+area+'" fill="url(#mitGrad)"/><path class="ln'+(up?'':' neg')+'" d="'+line+'"/>'+
          '<circle class="dot" cx="'+X(n-1)+'" cy="'+Y(last.cum)+'" r="4"/>'+
          '<text x="'+X(n-1)+'" y="'+(Y(last.cum)-10)+'" text-anchor="end" fill="#fff" font-size="12" font-weight="700">'+(last.cum>=0?'+':'')+last.cum.toFixed(0)+'%</text>'+xl;
      })();

      // win/loss bar
      (function(){ var w=D.winloss||{}; var wl=document.getElementById('mitWL'); if(!wl) return;
        var parts=[['Wins',w.wins||0,'#10b981'],['Breakeven',w.breakeven||0,'#94a3b8'],['Losses',w.losses||0,'#ef4444']];
        var total=parts.reduce(function(a,p){return a+p[1];},0)||1;
        wl.innerHTML=parts.map(function(p){return '<span style="width:'+(100*p[1]/total)+'%;background:'+p[2]+'" title="'+p[0]+': '+p[1]+'"></span>';}).join('');
        document.getElementById('mitWLLegend').innerHTML=parts.map(function(p){return '<span class="it"><span class="sw" style="background:'+p[2]+'"></span>'+p[0]+' '+p[1]+'</span>';}).join('');
      })();

      // sector P&L bars (diverging colors)
      (function(){ var s=D.sector_pnl||[]; var wrap=document.getElementById('mitSectors'); if(!wrap||!s.length) return;
        var max=Math.max.apply(null,s.map(function(x){return Math.abs(x.pnl);}).concat([1]));
        wrap.innerHTML=s.map(function(x){ var hgt=Math.round(Math.abs(x.pnl)/max*120)+2; var col=x.pnl>=0?'linear-gradient(180deg,#34d399,#10b981)':'linear-gradient(180deg,#f87171,#ef4444)';
          return '<div class="mit-bw"><div class="mit-bar" style="height:0;background:'+col+'" data-h="'+hgt+'"><span class="cnt">'+(x.pnl>=0?'+':'')+x.pnl.toFixed(0)+'</span></div><div class="mit-blab">'+x.sector+'</div></div>'; }).join('');
        requestAnimationFrame(function(){ wrap.querySelectorAll('.mit-bar').forEach(function(b){ b.style.height=b.dataset.h+'px'; }); });
      })();

      // recent trades
      (function(){ var s=D.recent_trades||[]; var wrap=document.getElementById('mitRecent'); if(!wrap||!s.length) return;
        wrap.innerHTML=s.map(function(t){ var up=(t.pnl||0)>=0;
          return '<div class="mit-rt"><span class="sym">'+(t.symbol||'')+'</span><span class="stg">'+(t.strategy||'')+'</span><span class="pnl '+(up?'up':'down')+'">'+(up?'+':'')+(t.pnl!=null?t.pnl.toFixed(2):'—')+'%</span></div>'; }).join('');
      })();
    })();
    </script>
    {% endif %}

    <!-- Current Operating Principles (The Heart of the Recursive Loop) -->
    {% set principles = performance_data.derived_principles or tracker.get('derived_principles', []) if tracker else [] %}
    {% if principles %}
    <div class="glass-card" style="padding: var(--sp-6); margin-bottom: var(--sp-8); border-left: 5px solid var(--show-color, #047857);">
      <h2 style="margin-top:0;">Current Operating Principles</h2>
      <p style="color:var(--nn-text-muted); font-size:0.95rem;">
        These principles are derived directly from our real (simulated) results. The model is required to reference and obey them when selecting new Practice Investments.
      </p>
      <ul style="margin-top: var(--sp-4); line-height: 1.7;">
        {% for principle in principles %}
        <li style="margin-bottom: var(--sp-3);">
          <strong>{{ principle.title }}</strong><br>
          <span style="font-size:0.92rem;">{{ principle.description }}</span>
          {% if principle.evidence %}
          <div style="font-size:0.8rem; color:var(--nn-text-muted); margin-top:2px;">
            Evidence: {{ principle.evidence }}
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
      <div style="font-size:0.8rem; color:var(--nn-text-muted); margin-top:var(--sp-4);">
        These principles evolve as we collect more data. The goal is continuous, measurable improvement in alpha generation.
      </div>
    </div>
    {% endif %}

    <!-- Lessons Learned (Recursive Feedback) -->
    {% if performance_data.lessons_learned %}
    <div class="glass-card" style="padding: var(--sp-6); margin-bottom: var(--sp-8);">
      <h2 style="margin-top:0;">Active Lessons We're Applying</h2>
      <p style="color:var(--nn-text-muted); font-size:0.92rem;">
        Each of these rules was written by a past episode after analyzing actual outcomes. Future episodes must respect them.
      </p>
      <ul style="margin-top:var(--sp-4);">
        {% for lesson in performance_data.lessons_learned[:12] %}
        <li style="margin-bottom:var(--sp-3);">
          <strong>Ep{{ lesson.episode_num }}:</strong> {{ lesson.observation }}<br>
          <span style="color:var(--show-color, #047857);"><strong>Rule we now follow:</strong></span> {{ lesson.adjustment }}
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    <!-- Strategy & Sector Effectiveness -->
    {% if performance_data.sectors %}
    <div class="glass-card" style="padding:var(--sp-6); margin-bottom:var(--sp-8);">
      <h2 style="margin-top:0;">What the Data Says About Different Approaches</h2>
      <table style="width:100%; border-collapse:collapse; font-size:0.9rem;">
        <thead>
          <tr style="text-align:left; border-bottom:2px solid var(--nn-border);">
            <th style="padding:8px;">Sector / Approach</th>
            <th style="padding:8px; text-align:right;">Trades</th>
            <th style="padding:8px; text-align:right;">Win Rate</th>
            <th style="padding:8px; text-align:right;">Avg Alpha</th>
            <th style="padding:8px; text-align:right;">Total Alpha</th>
          </tr>
        </thead>
        <tbody>
          {% for sec, sec_data in performance_data.sectors.items() | sort(attribute='1.cumulative_alpha', reverse=true) %}
          {% if sec_data.trade_count > 0 %}
          <tr style="border-top:1px solid var(--nn-border);">
            <td style="padding:8px; text-transform:capitalize;">{{ sec | replace('_', ' ') }}</td>
            <td style="padding:8px; text-align:right;">{{ sec_data.trade_count }}</td>
            <td style="padding:8px; text-align:right;">{{ "{:.0f}".format((sec_data.wins or 0) / sec_data.trade_count * 100) }}%</td>
            <td style="padding:8px; text-align:right; color:{% if (sec_data.avg_alpha or 0) >= 0 %}#10b981{% else %}#ef4444{% endif %};">
              {{ "{:+.2f}".format(sec_data.avg_alpha or 0) }}%
            </td>
            <td style="padding:8px; text-align:right; font-weight:600; color:{% if (sec_data.cumulative_alpha or 0) >= 0 %}#10b981{% else %}#ef4444{% endif %};">
              {{ "{:+.2f}".format(sec_data.cumulative_alpha or 0) }}%
            </td>
          </tr>
          {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}

  {% else %}
    <div class="glass-card" style="padding:var(--sp-8); text-align:center;">
      <p>Performance data is being generated. Check back after a few episodes have run.</p>
    </div>
  {% endif %}

  <div style="margin-top: var(--sp-8); font-size:0.85rem; color:var(--nn-text-muted); border-top:1px solid var(--nn-border); padding-top:var(--sp-4);">
    This page and the learning system behind it are part of our commitment to radical transparency in AI-assisted investing education.
    All data comes from the same tracker the podcast uses every day.
  </div>

</div>
{% endblock %}
