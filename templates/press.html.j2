{% extends "base.html.j2" %}
{#- The Nerra Network media kit (Oct 21 2026). Rendered by
    generate_html.generate_press_page from committed data only: every number
    below has a source file and an as-of date, and every sentence about the
    network comes from engine/brand.py. A dash means "not measured yet",
    never zero. Nightly --static-pages keeps it current. -#}

{% block head_extra %}
{% include "_kit_styles.html.j2" %}
{% endblock %}

{% block content %}
{% from "_macros.html.j2" import mira_claim, mira_steps_list %}
{%- set au = audience -%}
<div class="page-main">
<div class="mk">

    <header class="mk-hero">
        <p class="mk-eyebrow">Media kit</p>
        <h1 class="mk-wordmark">Nerra <span>Network</span></h1>
        <p class="mk-tagline">{{ network_tagline }}</p>
        <p class="mk-lede">{{ network_promise() }}</p>
        <p class="mk-meta">Figures measured{% if au.as_of %} as of {{ au.as_of }}{% endif %} and refreshed nightly. Free to use in coverage with a link to <a href="https://nerranetwork.com">nerranetwork.com</a>.</p>
        <div class="mk-actions">
            <a class="mk-btn mk-btn-primary" href="#book-a-guest">Book a guest</a>
            <a class="mk-btn" href="#marketing">Logos, art and posts</a>
            <button type="button" class="mk-btn" data-mk-print>Save as PDF</button>
            <a class="mk-btn" href="mailto:{{ press_email }}?subject=Media%20enquiry">Email the network</a>
        </div>
    </header>

    <nav class="mk-toc" aria-label="On this page">
        <a href="#at-a-glance">At a glance</a>
        <a href="#audience">Audience and growth</a>
        <a href="#growth-next">What's next</a>
        <a href="#book-a-guest">Book a guest</a>
        <a href="#mira">Mira</a>
        <a href="#shows">Shows</a>
        <a href="#trust">Trust record</a>
        <a href="#founders">Founders</a>
        <a href="#boilerplate">Boilerplate</a>
        <a href="#brand">Brand assets</a>
        <a href="#marketing">Share Nerra</a>
        <a href="#questions">Questions</a>
        <a href="#contact">Contact</a>
    </nav>

    <section class="mk-section" id="at-a-glance">
        <h2>At a glance</h2>
        <div class="mk-stats">
            <div class="mk-stat"><div class="mk-stat-v">{{ shows_count }}</div><div class="mk-stat-l">free shows{% if members_shows_count %}, plus {{ members_shows_count }} regional desks for members{% endif %}</div></div>
            <div class="mk-stat"><div class="mk-stat-v">{{ "{:,}".format(total_episodes) }}</div><div class="mk-stat-l">episodes published</div></div>
            <div class="mk-stat"><div class="mk-stat-v">{{ au.downloads_30d }}</div><div class="mk-stat-l">podcast downloads in the last 30 days</div></div>
            <div class="mk-stat"><div class="mk-stat-v">{{ au.youtube_views }}</div><div class="mk-stat-l">YouTube views across three channels</div></div>
            <div class="mk-stat"><div class="mk-stat-v">{{ growth.followers_total }}</div><div class="mk-stat-l">subscribers and followers on the channels that report them</div></div>
            {% if growth.downloads_4w_pct is not none %}<div class="mk-stat"><div class="mk-stat-v">{{ "%+d"|format(growth.downloads_4w_pct) }}%</div><div class="mk-stat-l">podcast downloads, last four weeks on the four before</div></div>{% endif %}
            <div class="mk-stat"><div class="mk-stat-v">{{ language_names|length }}</div><div class="mk-stat-l">languages: {{ language_names|join(", ") }}</div></div>
            {% if trust %}<div class="mk-stat"><div class="mk-stat-v">{{ trust.claims }}</div><div class="mk-stat-l">claims checked against their sources in {{ trust.days }} days</div></div>{% endif %}
        </div>
        <div class="mk-card">
            <dl class="mk-facts">
                <dt>Founded</dt><dd>2024, Vancouver, Canada</dd>
                <dt>Founders</dt><dd>{% for f in founders %}{{ f.name }}{% if not loop.last %} and {% endif %}{% endfor %}</dd>
                <dt>Flagships</dt><dd>{% for s in flagship_shows %}<a href="{{ path_prefix }}{{ s.show_page }}">{{ s.name }}</a>{% if not loop.last %} and {% endif %}{% endfor %}, every day</dd>
                <dt>Daily edition</dt><dd><a href="{{ path_prefix }}nerra-daily.html">Nerra Daily</a>, the morning's shows in one episode by 7 a.m. Eastern, anchored by Mira</dd>
                <dt>Interview shows</dt><dd>{% for s in interview_shows %}<a href="{{ path_prefix }}{{ s.show_page }}">{{ s.name }}</a>{% if not loop.last %} and {% endif %}{% endfor %}, hosted live by Mira, the network's AI host</dd>
                <dt>How it is made</dt><dd>Written and voiced with AI from sources the pipeline fetches, under editorial rules people set; every claim checked against its source (<a href="{{ path_prefix }}ai-disclosure.html">AI disclosure</a>)</dd>
                <dt>Business model</dt><dd>{{ sponsor_policy.summary }} Members can subscribe to a personal daily feed (<a href="{{ path_prefix }}join.html">Nerra Personal</a>).</dd>
                <dt>Where to listen</dt><dd>Any podcast app, YouTube, and as a written article at <a href="https://nerranetwork.com">nerranetwork.com</a> (<a href="{{ path_prefix }}how-to-listen.html">every feed</a>)</dd>
            </dl>
        </div>
    </section>

    <section class="mk-section" id="audience">
        <h2>Audience and growth</h2>
        <p class="mk-sub">Measured, never estimated. Podcast downloads come from OP3, the open podcast analytics service; YouTube figures from YouTube Analytics; followers from each platform. A dash means a figure is not measured yet.</p>
        <div class="mk-headline"><b>{{ au.downloads_30d }}</b><span>podcast downloads in 30 days</span><b>+</b><b>{{ growth.youtube_views_window }}</b><span>YouTube views in {% if growth.youtube_window_days %}{{ growth.youtube_window_days }} days{% else %}the last 30 days{% endif %}</span></div>
        <p class="mk-sub">Total audience across podcast apps and YouTube{% if growth.as_of %}, to {{ growth.as_of }}{% endif %}.</p>

        <div class="mk-two">
            <div class="mk-card mk-chart-card">
                <h3>Podcast downloads per week</h3>
                {% if growth.downloads_last %}<p class="mk-sub" style="margin:0">{{ growth.downloads_last.value }} in the week of {{ growth.downloads_last.week }}{% if growth.downloads_multiple %}, <span class="mk-up">{{ growth.downloads_multiple }}× the week of {{ growth.downloads_first.week }}</span>{% endif %}.</p>{% endif %}
                {{ growth.downloads_chart | safe }}
                <details class="mk-details"><summary>Show the numbers</summary>
                    <table class="mk-table"><thead><tr><th>Week of</th><th class="num">Downloads</th></tr></thead><tbody>
                    {% for w in growth.weekly_downloads %}<tr><td>{{ w.week }}</td><td class="num">{{ "{:,}".format(w.value) }}</td></tr>{% endfor %}
                    </tbody></table></details>
            </div>
            <div class="mk-card mk-chart-card">
                <h3>YouTube subscribers, three channels</h3>
                {% if growth.subs_first %}<p class="mk-sub" style="margin:0">{{ growth.subs_now }} now, from {{ growth.subs_first.value }} on {{ growth.subs_first.date }}{% if growth.subs_gain_30d %}; <span class="mk-up">{{ growth.subs_gain_30d }} new in 30 days{% if growth.subs_pct_30d is not none %} ({{ "%+d"|format(growth.subs_pct_30d) }}%){% endif %}</span>{% endif %}.</p>{% endif %}
                {{ growth.subs_chart | safe }}
                <details class="mk-details"><summary>Show the numbers</summary>
                    <table class="mk-table"><thead><tr><th>Week ending</th><th class="num">Subscribers</th></tr></thead><tbody>
                    {% for w in growth.weekly_subs %}<tr><td>{{ w.week }}</td><td class="num">{{ "{:,}".format(w.value) }}</td></tr>{% endfor %}
                    </tbody></table></details>
            </div>
        </div>

        <h3>Subscribers and followers, every channel</h3>
        <div class="mk-card mk-table-wrap">
            <table class="mk-table">
                <thead><tr><th>Channel</th><th>Measure</th><th class="num">Now</th><th class="num">Last 30 days</th></tr></thead>
                <tbody>
                {% for c in growth.channels %}
                    <tr><td>{% if c.url %}<a href="{% if not c.url.startswith('http') %}{{ path_prefix }}{% endif %}{{ c.url }}"{% if c.url.startswith('http') %} rel="noopener"{% endif %}>{{ c.name }}</a>{% else %}{{ c.name }}{% endif %}</td><td>{{ c.measure }}</td><td class="num">{{ c.now }}</td><td class="num">{{ c.change }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="mk-stats four">
            <div class="mk-stat"><div class="mk-stat-v">{{ au.last_week }}</div><div class="mk-stat-l">downloads in the last complete week{% if au.wow_pct is not none %} ({{ "%+.0f"|format(au.wow_pct) }}% on the week before){% endif %}</div></div>
            <div class="mk-stat"><div class="mk-stat-v">{{ au.youtube_views_28d }}</div><div class="mk-stat-l">YouTube views on videos published in the last 28 days</div></div>
            {% if au.shorts_view_pct %}<div class="mk-stat"><div class="mk-stat-v">{{ au.shorts_view_pct }}%</div><div class="mk-stat-l">of each Short watched, on average</div></div>{% endif %}
            {% if au.newsletter_subscribers %}<div class="mk-stat"><div class="mk-stat-v">{{ au.newsletter_subscribers }}</div><div class="mk-stat-l">newsletter subscribers</div></div>{% endif %}
        </div>

        {% if au.shows %}
        <h3>Most downloaded shows, last 30 days</h3>
        <div class="mk-card mk-table-wrap">
            <table class="mk-table">
                <thead><tr><th>Show</th><th class="num">Podcast downloads</th><th class="num">YouTube views, 28 days</th></tr></thead>
                <tbody>
                {% for r in au.shows %}
                    <tr><td>{% if r.page %}<a href="{{ path_prefix }}{{ r.page }}">{{ r.name }}</a>{% else %}{{ r.name }}{% endif %}</td><td class="num">{{ r.downloads_30d }}</td><td class="num">{{ r.youtube_views }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}

        <div class="mk-two">
            {% if au.channels %}
            <div class="mk-card">
                <h3 style="margin-top:0">YouTube channels</h3>
                <table class="mk-table">
                    <thead><tr><th>Channel</th><th class="num">Lifetime views</th><th class="num">Videos</th></tr></thead>
                    <tbody>
                    {% for c in au.channels %}
                        <tr><td><a href="{{ c.url }}" rel="noopener">{{ c.handle }}</a> <small style="color:var(--nn-text-muted)">{{ c.language }}</small></td><td class="num">{{ c.views }}</td><td class="num">{{ c.videos }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
            {% if au.ages %}
            <div class="mk-card">
                <h3 style="margin-top:0">Who watches</h3>
                <p class="mk-sub" style="margin-bottom:.6rem">English channel, last 28 days: {{ au.pct_over_35 }}% are aged 35 or over. YouTube reports age for signed-in viewers only.</p>
                <ul class="mk-bars">
                {% for a in au.ages %}
                    <li><span>Age {{ a.band }}</span><span class="mk-bar"><i style="width:{{ (100 * a.pct / (au.ages|map(attribute='pct')|max)) | round(0) | int }}%"></i></span><span>{{ a.pct }}%</span></li>
                {% endfor %}
                </ul>
            </div>
            {% endif %}
            {% if au.channels %}
            <div class="mk-card">
                <h3 style="margin-top:0">Where they are</h3>
                {% for c in au.channels if c.countries %}
                <p style="margin:0 0 .6rem"><b>{{ c.handle }}:</b> {% for g in c.countries %}{{ g.name }} {{ g.pct }}%{% if not loop.last %}, {% endif %}{% endfor %}</p>
                {% endfor %}
                {% if au.site_countries %}<p style="margin:0"><b>Website:</b> {{ au.site_countries|join(", ") }}</p>{% endif %}
            </div>
            {% endif %}
        </div>
    </section>

    <section class="mk-section" id="growth-next">
        <h2>Where growth is going</h2>
        <p class="mk-sub">What the numbers show, and what the network is building next. Plans are stated as work that exists or is under way, never as a forecast.</p>
        <ul class="mk-check" style="margin-bottom:var(--sp-5)">
            {% if growth.downloads_4w_pct is not none %}<li>Podcast downloads: {{ growth.downloads_4w }} in the last four complete weeks, {{ "%+d"|format(growth.downloads_4w_pct) }}% on the four weeks before.</li>{% endif %}
            {% if growth.subs_gain_30d %}<li>YouTube: {{ growth.subs_gain_30d }} new subscribers in 30 days across three channels.{% if growth.fastest_channel %} The fastest-growing is {{ growth.fastest_channel.handle }} ({{ growth.fastest_channel.language }}), up {{ growth.fastest_channel.pct_30d }}%.{% endif %}</li>{% endif %}
            {% for c in growth.youtube_channels if c.pct_30d is not none %}<li>{{ c.handle }}: {{ c.now }} subscribers, {{ c.gain_30d }} in 30 days ({{ "%+d"|format(c.pct_30d) }}%).</li>{% endfor %}
        </ul>
        <div class="mk-plans">
            {% for n in growth.next %}
            <div class="mk-card"><h3>{{ n.heading }}</h3><p>{{ n.body }}</p></div>
            {% endfor %}
        </div>
    </section>

    <section class="mk-section" id="book-a-guest">
        <h2>Book a guest</h2>
        <p>The network's two interview shows are hosted by Mira, an AI, in a live and unscripted conversation of about 45 minutes. Every episode says plainly that the host is an AI, and every guest decides whether their conversation is published.</p>
        {% for s in interview_shows %}
        <div class="mk-card mk-show">
            <img src="{{ path_prefix }}{{ s.podcast_image }}" alt="{{ s.name }} cover art" width="96" height="96" loading="lazy">
            <div>
                <h3>{{ s.name }}</h3>
                <p style="margin-bottom:.4rem">{{ s.description }}</p>
                <ul class="mk-pills">
                    <li>{{ s.episode_length }}</li>
                    <li>{% if s.episode_count %}{{ s.episode_count }} episode{{ "s" if s.episode_count != 1 }} published{% else %}Not published yet{% endif %}</li>
                    <li>Live, unscripted</li>
                    <li>No fee either way</li>
                </ul>
                <p class="mk-sub" style="margin:.2rem 0 .2rem"><b>Where the episode goes</b></p>
                <ul class="mk-check" style="margin-bottom:.6rem">{% for w in s.where %}<li>{{ w }}</li>{% endfor %}</ul>
                {% if s.guests %}
                <p class="mk-sub" style="margin:.6rem 0 0"><b>Recent guests</b></p>
                <ul class="mk-guests">
                {% for g in s.guests %}
                    <li>{% if g.post_url %}<a href="{{ path_prefix }}{{ g.post_url }}">{{ g.name }}</a>{% else %}{{ g.name }}{% endif %}{% if g.identifier %} <small>· {{ g.identifier }}</small>{% endif %}</li>
                {% endfor %}
                </ul>
                {% endif %}
                <div class="mk-actions" style="margin-top:var(--sp-4)">
                    {% if s.booking_url %}<a class="mk-btn mk-btn-primary" href="{{ s.booking_url }}" rel="noopener">Pick a time for {{ s.name }}</a>{% endif %}
                    {% if s.apply_page %}<a class="mk-btn" href="{{ path_prefix }}{{ s.apply_page }}">Apply with background</a>{% endif %}
                    <a class="mk-btn" href="{{ path_prefix }}{{ s.show_page }}">Hear past episodes</a>
                </div>
            </div>
        </div>
        {% endfor %}

        <div class="mk-two">
            <div class="mk-card">
                <h3 style="margin-top:0">What the guest does</h3>
                <ul class="mk-check">
                    <li>Books a time with their own email address, so the prep brief and studio link reach them directly.</li>
                    <li>Joins from a computer browser with headphones. There is nothing to install.</li>
                    <li>Sends up to five points they want covered; Mira reaches every one.</li>
                    <li>Gets a short prep brief the day before, with what Mira is curious about.</li>
                </ul>
            </div>
            <div class="mk-card">
                <h3 style="margin-top:0">What the guest keeps</h3>
                <ul class="mk-check">
                    <li>Their own transcript before anything is assembled, with a week to approve it, cut from it or refuse it. What they cut is removed from the audio, not bleeped.</li>
                    <li>A takedown, available after publication.</li>
                    <li>A human editor reviews every episode before release.</li>
                    <li>On publish day: the link, a short moment from the conversation and a share image.</li>
                </ul>
            </div>
        </div>
        <h3>How an interview runs</h3>
        {{ mira_steps_list(compact=true) }}
    </section>

    <section class="mk-section" id="mira">
        <h2>Mira, the AI host</h2>
        <p>{{ mira.summary }}</p>
        {{ mira_claim(heading='', show_footnote=true) }}
        <p>{{ mira.network_role }}</p>
        <div class="mk-grid" style="margin-bottom:var(--sp-4)">
            {% for show in mira_shows %}
            <a class="mk-tile" href="{{ path_prefix }}{{ show.show_page }}">
                <img src="{{ path_prefix }}{{ show.podcast_image }}" alt="" width="52" height="52" loading="lazy">
                <div><b>{{ show.name }}</b><span>{{ show.episode_label }} · {{ show.schedule }}</span></div>
            </a>
            {% endfor %}
        </div>
        <p>The full process, including the two points where a human decides something, is on <a href="{{ path_prefix }}mira.html">the Mira page</a>.</p>
    </section>

    <section class="mk-section" id="shows">
        <h2>The shows</h2>
        <p class="mk-sub">{{ shows_count }} free shows. Most publish daily; the rest weekly or when an interview is ready. Each show page lists its schedule, feeds and cover art.</p>
        <div class="mk-grid">
            {% for s in flagship_shows + kit_shows %}
            <a class="mk-tile" href="{{ path_prefix }}{{ s.show_page }}">
                <img src="{{ path_prefix }}{{ s.podcast_image }}" alt="" width="52" height="52" loading="lazy">
                <div><b>{{ s.name }}</b><span>{{ s.schedule }}{% if s.episode_length %} · {{ s.episode_length }}{% endif %}</span></div>
            </a>
            {% endfor %}
        </div>
        {% if books %}
        <h3>Books</h3>
        <p>The narrative shows are collected into books by Patrick Novak, as ebooks and audiobooks:</p>
        <ul>
        {% for b in books %}
            <li><a href="{{ b.link }}" rel="noopener"><i>{{ b.title }}</i></a>{% if b.subtitle %}: {{ b.subtitle }}{% endif %}</li>
        {% endfor %}
        </ul>
        {% endif %}
    </section>

    <section class="mk-section" id="trust">
        <h2>Trust record</h2>
        {% if trust %}
        <div class="mk-stats">
            <div class="mk-stat"><div class="mk-stat-v">{{ trust.claims }}</div><div class="mk-stat-l">claims checked in the last {{ trust.days }} days, across {{ trust.episodes }} episodes</div></div>
            {% if trust.verified_pct is not none %}<div class="mk-stat"><div class="mk-stat-v">{{ "%.0f"|format(trust.verified_pct) }}%</div><div class="mk-stat-l">verified against their sources</div></div>{% endif %}
            <div class="mk-stat"><div class="mk-stat-v">{{ trust.corrections }}</div><div class="mk-stat-l">corrections published in the same window</div></div>
        </div>
        {% endif %}
        <p>Every factual claim an episode makes is recorded with its source and checked against that source's text. A claim that cannot be verified is published with a public flag rather than hidden, and the whole record is open on the <a href="{{ path_prefix }}claims.html">claims and corrections ledger</a>. Corrections are dated on the episode's page and named in the next episode's show notes; audio is never edited silently.</p>
        <p><a href="{{ path_prefix }}editorial.html">Editorial standards</a> · <a href="{{ path_prefix }}ai-disclosure.html">AI disclosure</a> · <a href="{{ path_prefix }}sponsor.html#rules">Sponsor policy</a></p>
    </section>

    <section class="mk-section" id="founders">
        <h2>Founders</h2>
        <p class="mk-sub">The name is theirs: Novak plus Perra.</p>
        {% for f in founders %}
        <div class="mk-card mk-founder">
            <div class="mk-avatar" aria-hidden="true">{{ f.name.split()|map("first")|join }}</div>
            <div>
                <h3 style="margin:0">{{ f.name }}</h3>
                <p class="mk-role">{{ f.role }}</p>
                <p style="margin-bottom:.6rem">{{ f.bio }}</p>
                {% if f.topics %}
                <p class="mk-sub" style="margin:.4rem 0 .2rem"><b>Available to talk about</b></p>
                <ul style="margin:0;padding-left:1.1rem">{% for t in f.topics %}<li>{{ t }}</li>{% endfor %}</ul>
                {% endif %}
            </div>
        </div>
        {% endfor %}
        <p class="mk-sub">Photos, written Q&amp;A and interview requests: <a href="mailto:{{ press_email }}?subject=Founder%20interview">{{ press_email }}</a>.</p>
    </section>

    <section class="mk-section" id="boilerplate">
        <h2>Boilerplate</h2>
        <p class="mk-sub">Copy-ready descriptions for articles, show notes and introductions. The numbers update as the network grows.</p>
        {% for key, label in [("short", "Short"), ("medium", "Medium"), ("long", "Long")] %}
        <div class="mk-card mk-copy">
            <div class="mk-copy-head"><b>{{ label }} <small>· {{ boilerplate[key].split()|length }} words</small></b>
                <button type="button" class="mk-copy-btn" data-mk-copy="bp-{{ key }}">Copy</button></div>
            <blockquote id="bp-{{ key }}">{{ boilerplate[key] }}</blockquote>
        </div>
        {% endfor %}
    </section>

    <section class="mk-section" id="brand">
        <h2>Brand assets</h2>
        <p class="mk-sub">Free to use in coverage of Nerra Network. Please keep the logos unaltered: no recolouring, stretching, or combining with other marks.</p>
        <div class="mk-actions" style="margin-bottom:var(--sp-5)">
            <a class="mk-btn mk-btn-primary" href="{{ path_prefix }}{{ zip_path }}" download>Download every logo (.zip)</a>
        </div>
        <div class="mk-logos">
            {% for l in logos %}
            <div class="mk-logo">
                <div class="mk-logo-art{% if l.bg == 'light' %} light{% endif %}"><img src="{{ path_prefix }}{{ l.png or l.path }}" alt="{{ l.label }}" loading="lazy"></div>
                <div class="mk-logo-cap"><span>{{ l.label }}</span><span>{% if l.png %}<a href="{{ path_prefix }}{{ l.png }}" download>PNG</a> · {% endif %}<a href="{{ path_prefix }}{{ l.path }}" download>SVG</a></span></div>
            </div>
            {% endfor %}
        </div>
        <h3>Colours and type</h3>
        <ul class="mk-swatches">
            <li><i style="background:#6B47FF"></i>Purple #6B47FF</li>
            <li><i style="background:#00D4FF"></i>Cyan #00D4FF</li>
            <li><i style="background:#0B0F1A"></i>Night #0B0F1A</li>
            <li><i style="background:linear-gradient(135deg,#6B47FF,#00D4FF)"></i>Gradient, purple to cyan</li>
        </ul>
        <p>Headings are set in DM Sans, body text in Source Serif 4.</p>
        <h3>Network image for coverage</h3>
        <p>A 1200 × 630 image for articles and social posts. <a href="{{ path_prefix }}{{ art_path }}" download>Download it</a>; every show's art is in <a href="#marketing">Share Nerra</a> below.</p>
        <a href="{{ path_prefix }}{{ art_path }}" download><img class="mk-art" src="{{ path_prefix }}{{ art_path }}" alt="Nerra Network share image" width="1200" height="630" loading="lazy"></a>
    </section>

    {%- set mk = marketing %}
    <section class="mk-section" id="marketing">
        <h2>Share Nerra Network</h2>
        <p class="mk-sub">For anyone who wants to tell people about the network: guests, partners, writers, listeners. Everything here is free to use under the rules at the end of this section.</p>

        <h3>Ready-to-post copy</h3>
        <div class="mk-two">
        {% for post in mk.posts %}
            <div class="mk-card mk-copy">
                <div class="mk-copy-head"><div><b>{{ post.label }}</b><small style="display:block;margin-top:.15rem">{{ post.where }}</small></div>
                    <button type="button" class="mk-copy-btn" data-mk-copy="{{ post.key }}">Copy</button></div>
                <blockquote id="{{ post.key }}">{{ post.text }}</blockquote>
            </div>
        {% endfor %}
        </div>

        <h3>Show art</h3>
        <p>Each show's square cover (3000 × 3000, the size podcast apps use) and its 1200 × 630 share image, for articles, posts and show notes.</p>
        <div class="mk-card mk-table-wrap">
            <table class="mk-table mk-art-table">
                <thead><tr><th></th><th>Show</th><th>Cover</th><th>Share image</th><th class="mk-hide-sm">Listen</th></tr></thead>
                <tbody>
                {% for a in mk.show_art %}
                    <tr>
                        <td>{% if a.thumb %}<img src="{{ path_prefix }}{{ a.thumb }}" alt="" width="48" height="48" loading="lazy">{% endif %}</td>
                        <td><a href="{{ path_prefix }}{{ a.show_page }}">{{ a.name }}</a></td>
                        <td class="mk-dl">{% if a.cover %}<a href="{{ path_prefix }}{{ a.cover }}" download>JPG</a>{% else %}—{% endif %}</td>
                        <td class="mk-dl">{% if a.card %}<a href="{{ path_prefix }}{{ a.card }}" download>JPG</a>{% else %}—{% endif %}</td>
                        <td class="mk-hide-sm">{% if a.apple %}<a href="{{ a.apple }}" rel="noopener">Apple</a>{% endif %}{% if a.apple and a.spotify %} · {% endif %}{% if a.spotify %}<a href="{{ a.spotify }}" rel="noopener">Spotify</a>{% endif %}{% if (a.apple or a.spotify) and a.feed %} · {% endif %}{% if a.feed %}<a href="{{ a.feed }}">RSS</a>{% endif %}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if mk.page_cards %}
        <h3>Page images</h3>
        <p>Share images for the pages a new listener starts from. Each carries its page's address; post it with that link.</p>
        <div class="mk-cards">
            {% for c in mk.page_cards %}
            <figure>
                <img src="{{ path_prefix }}{{ c.path }}" alt="{{ c.label }} share image" width="1200" height="630" loading="lazy">
                <figcaption><span>{{ c.label }}</span><a href="{{ path_prefix }}{{ c.path }}" download>Download</a></figcaption>
            </figure>
            {% endfor %}
        </div>
        {% endif %}

        <h3>Links and handles</h3>
        <div class="mk-card">
            <dl class="mk-facts">
                <dt>Website</dt><dd><a href="https://nerranetwork.com">nerranetwork.com</a></dd>
                <dt>New listeners</dt><dd><a href="https://nerranetwork.com/start-here.html">nerranetwork.com/start-here.html</a></dd>
                <dt>Every feed</dt><dd><a href="https://nerranetwork.com/how-to-listen.html">nerranetwork.com/how-to-listen.html</a></dd>
                <dt>This media kit</dt><dd><a href="https://nerranetwork.com/media-kit.html">nerranetwork.com/media-kit.html</a></dd>
                {% for soc in mk.social %}<dt>{{ soc.label }}</dt><dd><a href="{{ soc.url }}" rel="noopener">{{ soc.handle }}</a></dd>{% endfor %}
            </dl>
            {% if mk.apple_badge %}<p style="margin:var(--sp-4) 0 0"><a href="{{ path_prefix }}{{ mk.apple_badge }}" download><img src="{{ path_prefix }}{{ mk.apple_badge }}" alt="Listen on Apple Podcasts badge" height="40" style="height:40px;width:auto;vertical-align:middle" loading="lazy"></a> <small class="mk-sub">Apple's badge, for a link to a show on Apple Podcasts.</small></p>{% endif %}
        </div>

        <h3>Using the brand</h3>
        <div class="mk-rules">
            <div class="mk-card"><b style="font-family:var(--font-heading);color:var(--nn-white)">Please do</b>
                <ul class="mk-check" style="margin-top:.6rem">{% for r in mk.usage.yes %}<li>{{ r }}</li>{% endfor %}</ul></div>
            <div class="mk-card"><b style="font-family:var(--font-heading);color:var(--nn-white)">Please don't</b>
                <ul class="mk-no" style="margin-top:.6rem">{% for r in mk.usage.no %}<li>{{ r }}</li>{% endfor %}</ul></div>
        </div>
        <p class="mk-sub">Something you need that is not here, such as a different size or a founder photo? Write to <a href="mailto:{{ press_email }}?subject=Marketing%20assets">{{ press_email }}</a>.</p>
    </section>

    <section class="mk-section" id="questions">
        <h2>Questions we are asked</h2>
        <dl class="mk-faq">
            <dt>Is the host really an AI?</dt>
            <dd>Yes. Mira is an AI. Every episode says so, and she introduces herself as the network's AI host when she first writes to a guest. Patrick Novak built her, and he joins an interview as co-host when a guest asks for him.</dd>
            <dt>Who decides what gets published?</dt>
            <dd>A human editor reviews every interview before release, and the guest has a week with their own transcript to approve it, cut from it or refuse it. A takedown stays available afterwards.</dd>
            <dt>Does anyone pay to appear?</dt>
            <dd>No. There is no fee in either direction, and sponsors have no say over who appears or what is covered.</dd>
            <dt>How are the news shows made?</dt>
            <dd>The pipeline fetches the day's reporting, AI writes and voices each episode under editorial rules people wrote, and every claim is checked against its source before publication; a claim that could not be verified is checked again each night for a week. The <a href="{{ path_prefix }}ai-disclosure.html">AI disclosure</a> sets out exactly what a person does and does not do.</dd>
            <dt>Can we quote an episode or use a clip?</dt>
            <dd>Yes, with credit to the show and a link to the episode. Every episode has a written article and transcript to quote from.</dd>
        </dl>
    </section>

    <section class="mk-section" id="contact">
        <h2>Contact</h2>
        <p>Media requests, interviews with the founders, fact-checks and partnerships go to one inbox that a person reads.</p>
        <div class="mk-actions">
            <a class="mk-btn mk-btn-primary" href="mailto:{{ press_email }}?subject=Media%20enquiry">{{ press_email }}</a>
            <a class="mk-btn" href="{{ network_social[0].url }}" rel="noopener">{{ network_social[0].handle }} on X</a>
            <a class="mk-btn" href="{{ path_prefix }}sponsor.html">Advertising and sponsorship kit</a>
            <a class="mk-btn" href="{{ path_prefix }}contact.html">All contact options</a>
        </div>
        <p class="mk-sub" style="margin-top:var(--sp-5)">This page lives at <a href="https://nerranetwork.com/press.html">nerranetwork.com/press.html</a> (also <a href="https://nerranetwork.com/media-kit.html">/media-kit.html</a>) and updates itself as the network grows. More: <a href="{{ path_prefix }}about.html">About</a> · <a href="{{ path_prefix }}faq.html">FAQ</a> · <a href="{{ path_prefix }}sponsor.html">Advertise and sponsor</a>.</p>
    </section>

</div>
</div>
{% endblock %}

{% block scripts %}
<script>
(function () {
    document.addEventListener("click", function (e) {
        var printBtn = e.target.closest("[data-mk-print]");
        if (printBtn) { window.print(); return; }
        var btn = e.target.closest("[data-mk-copy]");
        if (!btn) return;
        var el = document.getElementById(btn.getAttribute("data-mk-copy"));
        if (!el || !navigator.clipboard) return;
        navigator.clipboard.writeText(el.textContent.trim()).then(function () {
            btn.textContent = "Copied";
            setTimeout(function () { btn.textContent = "Copy"; }, 1500);
        });
    });
})();
</script>
{% endblock %}
