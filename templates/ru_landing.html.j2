{# ---------------------------------------------------------------------
   Russian-language funnel landing page (July 2026 pilot; the ask rewritten
   Nov 3 2026).

   ONE destination, ONE thing to do. Every @NerraRU Short and long-form
   description for a show with `funnel.destinations.ru` set points here
   instead of at the English homepage. The only ask above the fold is the
   one a Shorts-feed audience can act on: subscribe to the channel, or add
   the Russian RSS to a podcast app (`ask_links`, built by generate_html
   from engine.video_metadata.channel_subscribe_url and the show's own RU
   feed). The email form and its Sunday letter are gone — three months,
   zero captures (register `ru-spacex-pilot-2026-07-30`: MISS) — and no copy
   here may promise a letter again. One internal link (no UTM) leads to the
   Russian front page, `hub_link`.

   Everything below the ask is proof, not another ask: the next launch
   window, the latest Russian episodes, and where to listen in a podcast
   app. Deliberately no navigation-style link farm — a second call to
   action is how a landing page stops converting.
   --------------------------------------------------------------------- #}
{% extends "base.html.j2" %}
{% from "_macros.html.j2" import ai_badge %}

{% block head_extra %}
<style>
  .ru-hero {
    position: relative;
    /* Clear the fixed nav (72px): 4.5rem equalled it, and the phone rule's
       2rem put the eyebrow underneath it (Oct 7 2026). */
    padding: calc(var(--nav-height) + 3rem) 0 3rem;
    overflow: hidden;
  }
  .ru-hero::before {
    content: '';
    position: absolute;
    inset: -40% -20% auto -20%;
    height: 140%;
    background: radial-gradient(ellipse at 50% 0%,
                rgba(107, 71, 255, 0.28), transparent 62%);
    pointer-events: none;
  }
  .ru-hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }
  .ru-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-size: .8rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    font-family: var(--font-ui);
    color: var(--nn-cyan);
    margin-bottom: 1rem;
  }
  .ru-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.1rem, 5.2vw, 3.4rem);
    line-height: 1.08;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }
  .ru-hero-desc {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--nn-text-muted);
    max-width: 46ch;
    margin: 0 0 1.75rem;
  }
  .ru-hero-art img {
    width: 100%;
    max-width: 340px;
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, .5);
    display: block;
    margin-inline: auto;
  }

  /* ---- The one ask ---- */
  .ru-capture {
    background: var(--nn-card);
    border: 1px solid var(--nn-border);
    border-radius: 18px;
    padding: 1.6rem 1.6rem 1.35rem;
    max-width: 34rem;
  }
  .ru-capture h2 {
    font-size: 1.18rem;
    margin: 0 0 .4rem;
    letter-spacing: -0.01em;
  }
  .ru-capture p {
    font-size: .94rem;
    line-height: 1.55;
    color: var(--nn-text-muted);
    margin: 0 0 1rem;
  }
  .ru-ask { display: flex; gap: .6rem; flex-wrap: wrap; }
  .ru-ask a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    flex: 1 1 14rem;
    padding: .8rem 1.3rem;
    border-radius: 10px;
    border: 1px solid var(--nn-border-hover);
    color: var(--nn-text);
    text-decoration: none;
    font: inherit;
    font-weight: 700;
    text-align: center;
  }
  .ru-ask a:hover { border-color: var(--nn-cyan); color: var(--nn-cyan); }
  .ru-ask a.ru-ask-primary {
    border-color: transparent;
    background: var(--nn-gradient);
    color: #fff;
  }
  .ru-ask a.ru-ask-primary:hover { color: #fff; filter: brightness(1.08); }
  .ru-ask-note {
    font-size: .8rem;
    color: var(--nn-text-muted);
    margin: .8rem 0 0;
  }

  /* ---- Proof blocks ---- */
  .ru-panel {
    background: var(--nn-card);
    border: 1px solid var(--nn-border);
    border-radius: 16px;
    padding: 1.4rem 1.5rem;
  }
  .ru-launch-name {
    font-size: 1.1rem;
    font-weight: 700;
    margin: .2rem 0 .3rem;
  }
  .ru-launch-meta {
    font-size: .9rem;
    color: var(--nn-text-muted);
    line-height: 1.6;
    margin: 0;
  }
  .ru-countdown {
    font-variant-numeric: tabular-nums;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: .6rem 0 0;
  }
  .ru-eplist { display: grid; gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .ru-ep {
    background: var(--nn-card);
    border: 1px solid var(--nn-border);
    border-radius: 14px;
    padding: 1rem 1.1rem;
  }
  .ru-ep-date { font-size: .78rem; color: var(--nn-text-muted); }
  .ru-ep-title {
    font-size: 1rem;
    font-weight: 600;
    margin: .25rem 0 .6rem;
    line-height: 1.4;
  }
  .ru-ep audio { width: 100%; height: 34px; }
  .ru-listen { display: flex; flex-wrap: wrap; gap: .6rem; }
  .ru-listen a {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--nn-border-hover);
    color: var(--nn-text);
    text-decoration: none;
    font-size: .9rem;
    font-weight: 600;
  }
  .ru-listen a:hover { border-color: var(--nn-cyan); color: var(--nn-cyan); }
  .ru-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 860px) {
    .ru-hero { padding-top: calc(var(--nav-height) + 1.5rem); }
    .ru-hero-inner { grid-template-columns: 1fr; gap: 1.75rem; }
    /* The ask stays above the cover art on phones. Visitors arrive here
       from a Short, on a phone, with one thing to do — pushing the
       buttons a full screen down behind decorative artwork is how a
       landing page loses the traffic it just paid for. */
    .ru-hero h1 { font-size: clamp(1.9rem, 8vw, 2.4rem); }
    .ru-hero-desc { font-size: 1rem; margin-bottom: 1.25rem; }
    .ru-hero-art img { max-width: 180px; }
  }
  /* Prose links (Oct 7 2026): the global ``a`` rule inherits colour and
     drops the underline, so a link inside a sentence was invisible.
     Scoped to this page's content and to plain (class-less) links. */
  #main-content p a:not([class]), #main-content li a:not([class]) {
    color: var(--nn-cyan);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  #main-content p a:not([class]):hover, #main-content li a:not([class]):hover {
    color: var(--nn-white);
  }
</style>
{% endblock %}

{% block content %}
{#- base.html.j2 already wraps this block in <main id="main-content">; a
    second <main> nested inside it was invalid HTML and a duplicate id. -#}
<div class="ru-landing-main">

  <!-- ============ Hero + the one ask ============ -->
  <section class="ru-hero">
    <div class="container ru-hero-inner">
      <div>
        <span class="ru-eyebrow">🚀 Ежедневный подкаст · Русский</span>
        <h1>{{ hero_title }}</h1>
        <p class="ru-hero-desc">{{ hero_description }}</p>

        <div class="ru-capture">
          <h2>{{ ask_title }}</h2>
          <p>{{ ask_description }}</p>
          <div class="ru-ask" id="ru-ask">
            {%- for link in ask_links | default([]) %}
            <a href="{{ link.url }}" data-ask="{{ link.kind }}"{% if loop.first %} class="ru-ask-primary"{% endif %}{% if link.external %} target="_blank" rel="noopener"{% endif %}>{{ link.label }}</a>
            {%- endfor %}
          </div>
          <p class="ru-ask-note">{{ ask_note }}{% if hub_link %}
            <a href="{{ hub_link.url }}" hreflang="ru">{{ hub_link.label }}</a>{% endif %}</p>
        </div>
      </div>
      <div class="ru-hero-art">
        <img src="{{ cover_url }}" alt="Обложка подкаста «{{ show_name_ru }}»"
             width="640" height="640" loading="eager" decoding="async">
      </div>
    </div>
  </section>

  <!-- ============ Proof: next launch + how to listen ============ -->
  <section class="nn-section">
    <div class="container ru-grid-2">
      {% if show_launch_panel %}
      <div class="ru-panel" id="ru-launch-panel" hidden>
        <div class="ru-eyebrow" style="margin-bottom:.2rem">Следующий запуск</div>
        <p class="ru-launch-name" id="ru-launch-name">—</p>
        <p class="ru-countdown" id="ru-launch-countdown">—</p>
        <p class="ru-launch-meta" id="ru-launch-meta"></p>
      </div>
      {% endif %}

      <div class="ru-panel">
        <div class="ru-eyebrow" style="margin-bottom:.6rem">Слушать в приложении</div>
        <div class="ru-listen">
          {% for link in listen_links %}
          <a href="{{ link.url }}" rel="noopener"
             {% if link.external %}target="_blank"{% endif %}>{{ link.label }}</a>
          {% endfor %}
        </div>
        <p class="ru-launch-meta" style="margin-top:.9rem">{{ listen_note }}</p>
      </div>
    </div>
  </section>

  <!-- ============ Proof: recent Russian episodes ============ -->
  {% if episodes %}
  <section class="nn-section">
    <div class="container">
      <div class="nn-section-header">
        <h2>Последние выпуски по-русски</h2>
      </div>
      <ul class="ru-eplist">
        {% for ep in episodes %}
        <li class="ru-ep">
          <div class="ru-ep-date">{{ ep.date }} · Выпуск {{ ep.number }}</div>
          <div class="ru-ep-title">{{ ep.title }}</div>
          <audio controls preload="none" src="{{ ep.audio_url }}"></audio>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  {% endif %}

  <section class="nn-section">
    <div class="container" style="max-width:52rem">
      <p class="ru-launch-meta">
        {{ ai_disclosure }}
        {{ ai_badge(path_prefix, is_ru=true) }}
      </p>
    </div>
  </section>
</div>
{% endblock %}

{% block scripts %}
<script>
(function () {
  "use strict";

  // ---- Next launch (same api/spacex_launches.json the data hub reads) ----
  var panel = document.getElementById("ru-launch-panel");
  if (panel) {
    fetch({{ launch_feed_url | tojson }}, { cache: "no-store" })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        var next = data && data.next;
        if (!next || !next.net) { return; }
        var when = new Date(next.net);
        if (isNaN(when.getTime())) { return; }
        panel.hidden = false;
        document.getElementById("ru-launch-name").textContent =
          next.name || next.mission || "Запуск SpaceX";
        var meta = [];
        if (next.location) { meta.push(next.location); }
        if (next.orbit) { meta.push(next.orbit); }
        meta.push(when.toLocaleString("ru-RU", {
          dateStyle: "long", timeStyle: "short"
        }));
        document.getElementById("ru-launch-meta").textContent = meta.join(" · ");

        var out = document.getElementById("ru-launch-countdown");
        function tick() {
          var ms = when.getTime() - Date.now();
          if (ms <= 0) { out.textContent = "Идёт запуск"; return; }
          var s = Math.floor(ms / 1000);
          var d = Math.floor(s / 86400);
          var h = Math.floor((s % 86400) / 3600);
          var m = Math.floor((s % 3600) / 60);
          out.textContent = (d > 0 ? d + " д " : "") +
            h + " ч " + m + " мин";
        }
        tick();
        setInterval(tick, 30000);
      })
      .catch(function () { /* the panel simply stays hidden */ });
  }
})();
</script>
{% endblock %}
